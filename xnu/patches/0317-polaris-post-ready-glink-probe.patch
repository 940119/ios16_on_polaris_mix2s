+/* 0317: the first words of an SMEM item, byte-wise WCOMB, no memcpy.
+ * The GLINK descriptor (478) is 32 bytes, so all 8 words fit. */
+static void
+md_smem_words(uint32_t at, uint32_t size, uint32_t nw, const char *label)
+{
+	uint32_t w[8], i, n;
+	uint8_t *raw = (uint8_t *)w;
+
+	for (i = 0; i < (uint32_t)sizeof(w); i++) {
+		raw[i] = 0;
+	}
+	if (at == 0) {
+		MD_SAY("POLARIS MODEM:   W2f step 4:   %s: MISSING\n", label);
+		return;
+	}
+	n = nw < 8u ? nw : 8u;
+	if (size < n * 4u) {
+		n = size / 4u;
+	}
+	if (n == 0 || !md_smem_peek(at, w, n * 4u)) {
+		MD_SAY("POLARIS MODEM:   W2f step 4:   %s: unreadable\n", label);
+		return;
+	}
+	printf("POLARIS MODEM:   W2f step 4:   %s @%#x %u bytes:", label, at, size);
+	for (i = 0; i < n; i++) {
+		printf(" %#x", w[i]);
+	}
+	printf("\n");
+}
