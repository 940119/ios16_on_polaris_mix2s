+/* 0317: one verdict per sample.  0316 lost its only verdict to the long
+ * post-loop spin and the ring was grabbed before sample 5 ever printed. */
+static const char *
+md_smem_verdict(bool ever_435, bool ever_ready, bool ever_glink,
+    bool ever_fatal)
+{
+	if (!ever_435) {
+		return "NOT A WORD FROM THE MODEM IN SMEM: item 435 never appeared";
+	}
+	if (!ever_ready) {
+		return "item 435 APPEARED but slave-kernel never set DSP_READY";
+	}
+	if (ever_fatal) {
+		return "DSP_READY SET BUT DSP_FATAL ALSO SET: the modem signals a fatal state";
+	}
+	return ever_glink
+	    ? "THE MODEM IS READY AND GLINK ITEMS EXIST: the link can be started"
+	    : "THE MODEM IS READY but no GLINK items yet";
+}
