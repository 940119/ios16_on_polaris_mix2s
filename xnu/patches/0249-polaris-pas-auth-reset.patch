 #define MD_SCM_SIP		(2ull << 24)
 #define MD_SCM_SUPPORTED	0x207ull
+#define MD_SCM_PAS_AUTH_AND_RESET	0x205ull	/* PAS service 2, command 5 */
+#define MD_SCM_ONE_VALUE	1u
+#define MD_PAS_MSS		5u		/* dt: qcom,mss@4080000 */
 #define MD_PAS_FIRST		1u
