 /*
+ * 0249, level 6: the one call the whole chain depends on.
+ *
+ * Level 5 asked PAS_SUPPORTED, and the modem answered not "no" but "the call
+ * failed" (rc -3145792) while adsp / zap / spss / cdsp came back as clean nos.
+ * That only proves the SMC path and the encoding are right; it says nothing
+ * about whether the modem can actually be started, because PAS_SUPPORTED is a
+ * different question from the bring-up call.
+ *
+ * This level sends the real entry point - PAS_AUTH_AND_RESET(5), the same call
+ * Linux's qcom_q6v5_pas() makes and the dipper port makes - with no image
+ * loaded and no memory handed over. That is deliberate: the point is not to
+ * start the modem, it is to hear how TrustZone answers an unloaded modem id.
+ * The three cases and what each means:
+ *
+ *   "no memory"/"no image" style error   the id is real, the monitor would
+ *                                        carry on once the image is there;
+ *                                        the dipper chain is worth porting
+ *   the same -3145792 as PAS_SUPPORTED   this TZ does not recognise id 5 as a
+ *                                        PAS image at all: the modem line ends
+ *                                        here, three thousand lines saved
+ *   "yes, started"                       the modem was already loaded (ABL) and
+ *                                        the work becomes QMI-over-SMEM, which
+ *                                        is the Wi-Fi line's GLINK
+ *
+ * Nothing is mapped and nothing is written; it is one SMC, exactly the shape
+ * dipper's scm() sends, with the same retry rule.
+ */
+static void
+md_pas_auth_probe(void)
+{
+	const uint64_t how = MD_SCM_64 | MD_SCM_SIP | MD_SCM_PAS_AUTH_AND_RESET;
+	uint64_t res[3] = { 0, 0, 0 };
+	int64_t rc;
+
+	MD_SAY("POLARIS MODEM: phase F: PAS_AUTH_AND_RESET(5) on the modem, no image "
+	    "loaded, no memory handed over\n");
+	rc = md_scm_call(how, MD_SCM_ONE_VALUE, MD_PAS_MSS, 0, 0, res);
+	MD_SAY("POLARIS MODEM:   rc %lld, answer %#llx %#llx %#llx\n", rc, res[0],
+	    res[1], res[2]);
+	if (rc == 0) {
+		MD_SAY("POLARIS MODEM:   the monitor accepted the modem id: the "
+		    "dipper chain can be ported\n");
+	} else {
+		MD_SAY("POLARIS MODEM:   the monitor refused: rc %lld "
+		    "(compare 0243's PAS_SUPPORTED rc -3145792)\n", rc);
+	}
+}
+
+/*
