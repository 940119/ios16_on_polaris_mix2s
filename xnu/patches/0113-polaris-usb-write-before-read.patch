 /*
- * Attempt A: write nothing.
+ * Attempt A: one write, no read.
  *
- * ABL runs this port at high speed for fastboot, so the PHY it hands over is
- * a known-good one and the driver's only job is not to spoil it. The two DSTS
- * reads are there to settle the question 0109 raised: if the core really is
- * clocked by the PHY, DSTS at least has to be able to change. Reads only.
- */
-static void
-ud_cfg_abl_phy(void)
-{
-	uint32_t d1, d2;
-
-	ud_phy_state("A-in");
-	d1 = dwc_rd(DSTS);
-	ud_sleep_ms(120);
-	d2 = dwc_rd(DSTS);
-	printf("SWEET USB:   DSTS 0x%08x then 0x%08x (%s)\n", d1, d2,
-	    d1 == d2 ? "identical" : "CHANGED");
-}
-
-/*
- * Attempt B: put back the exact byte ABL was running with.
- *
- * This is the controlled version of attempt A's premise. If clear bit 0 is
- * what killed the lock, then setting it again has to bring the lock back -
- * and the log will show whether it does.
- */
-static void
-ud_cfg_pd23(void)
+ * 0x23 is the byte ABL was running this port with, and per the 0106 sweep it
+ * is also the byte that keeps the PLL locked: clearing bit 0 dropped
+ * PLL_STATUS from 0x64 to 0x17 and it never came back. So the whole premise
+ * is "stop clearing it" and this write makes that explicit rather than
+ * implicit. It is a write because a read here is what killed 0112.
+ */
+static void
+ud_cfg_keep23(void)
 {
 	vm_offset_t phy = ml_io_map(QUSB2_PA, QUSB2_SIZE);
 
 	if (phy == 0) {
+		printf("SWEET USB:   PHY map failed\n");
 		return;
 	}
 	qusb2_wr(phy, QUSB2_PORT_POWERDOWN, 0x23);
-	ud_sleep_ms(30);
-	ud_phy_state("B-out");
+	printf("SWEET USB:   POWERDOWN <- 0x23 (write only)\n");
 }
 
 /*
@@ -1370,20 +1359,20 @@
 	qusb2_wr(phy, QUSB2_PORT_TUNE1, 0x57);
 	qusb2_wr(phy, 0x230, 0x00);             /* pll_bias, as the stock kernel */
 	qusb2_wr(phy, QUSB2_PORT_POWERDOWN, powerdown);
-	ud_sleep_ms(40);
-	ud_phy_state(powerdown == 0x23 ? "D-out" : "C-out");
+	printf("SWEET USB:   DT table + TUNE1 0x57, POWERDOWN <- 0x%02x (write only)\n",
+	    powerdown);
 }
 
 static void
 ud_cfg_table57(void)
 {
+	ud_phy_table(0x23);
+}
+
+static void
+ud_cfg_table57off(void)
+{
 	ud_phy_table(0x22);
-}
-
-static void
-ud_cfg_table57pd(void)
-{
-	ud_phy_table(0x23);
