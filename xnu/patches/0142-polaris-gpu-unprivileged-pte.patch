+		printf("POLARIS GPU: 15 SQE slot 0 %#llx -> page %#llx, slot 8 %#llx -> %#llx\n",
+		    l3[0], kvtophys(pg_sqe_va[0]) & PG_PTE_ADDR, l3[8],
