+		    PG_CP_RING_IOVA, PG_CP_RING_IOVA + PG_CP_REGION - 1);
+		printf("POLARIS GPU: 15 tables: L1[0] %#llx L1[1] %#llx L2[%#x] %#llx L2[%#x] %#llx\n",
+		    ((uint64_t *)pg_l1_va)[0], ((uint64_t *)pg_l1_va)[1],
