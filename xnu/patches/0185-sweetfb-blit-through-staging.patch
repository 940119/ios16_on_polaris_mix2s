+/*
+ * Broadcast one pixel across n panel columns, two at a time.
+ *
+ * Used for the clamped ends of a stretched rectangle, where the source column
+ * is a constant. A four-byte store per pixel into the write-combined panel is
+ * the expensive thing this build is trying to stop doing, so even this small
+ * run goes out as 8-byte stores.
+ */
+static void
+sweet_fb_fill(uint32_t *d, int32_t n, uint32_t v)
+{
+	uint64_t pair = ((uint64_t)v << 32) | (uint64_t)v;
+
+	while (n > 0 && ((uintptr_t)d & 7) != 0) {
+		*d++ = v;
+		n--;
+	}
+	while (n >= 2) {
+		*(uint64_t *)(void *)d = pair;
+		d += 2;
+		n -= 2;
+	}
+	if (n > 0) {
+		*d = v;
+	}
+}
