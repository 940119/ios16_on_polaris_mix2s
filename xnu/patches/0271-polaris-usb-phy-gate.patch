 static uint32_t
 qusb2_rd(vm_offset_t phy, uint32_t off)
 {
+	/*
+	 * 0271: the one gate in front of every QUSB2 register read.
+	 *
+	 * There are eight places in this file that map 0x088e2000 and read
+	 * from it, and two of them have now killed the machine: 0112 on the
+	 * first read of the block, 0267 twenty seconds into the boot on the
+	 * same read. Guarding the call sites one at a time is what produced
+	 * ud_cfg_keep23() and its "this one is a write because a read killed
+	 * 0112" note, and it still left six other paths that read.
+	 *
+	 * So the guard goes here instead, at the only two functions that
+	 * actually touch the block. Off by default: no read reaches the PHY
+	 * unless sweetphytouch=1 is on the command line. Callers see zero,
+	 * which is a value they already have to tolerate, and each function
+	 * that gets a zero keeps going rather than aborting - this is a
+	 * bring-up, not a probe.
+	 */
+	if (!ud_phy_touch) {
+		return 0;
+	}
 	return usb_rd(phy, off) & 0xff;
 }
 
 static void
 qusb2_wr(vm_offset_t phy, uint32_t off, uint32_t val)
 {
+	if (!ud_phy_touch) {
+		return;
+	}
 	*(volatile uint32_t *)(phy + off) = val & 0xff;
 	__asm__ volatile ("dsb sy" ::: "memory");
 }
