+
+/* 0326: one Q_NEW_SERVER notice (dipper publish_notice():334).  The
+ * 20-byte payload is [type=4, service, version|instance<<8,
+ * local_node, port_id]; QRTR header is type 4, from CTRL, len 20,
+ * dst node 0 / port CTRL.  52 B QRTR -> 72 B GLINK DATA frame. */
+static uint32_t
+md_qrtr_publish(uint32_t head, uint32_t service, uint32_t instance,
+    uint32_t port_id)
+{
+        static const uint32_t base[13] = {
+                1u, MD_QRTR_Q_NEW_SERVER, MD_QRTR_LOCAL_NODE, MD_QRTR_CTRL,
+                0u, 20u, 0u, MD_QRTR_CTRL,
+                MD_QRTR_Q_NEW_SERVER, 0u, 0u, MD_QRTR_LOCAL_NODE, 0u
+        };
+        uint32_t pkt[13];
+        uint32_t i, iid = 0u, size = 0u, at = head;
+
+        for (i = 0u; i < 13u; i++) {
+                pkt[i] = base[i];
+        }
+        pkt[9] = service;
+        pkt[10] = 1u | (instance << 8);
+        pkt[12] = port_id;
+        for (i = 0u; i < md_foreign_count; i++) {
+                if (md_foreign_size[i] >= MD_QRTR_CTRL_LEN &&
+                    md_foreign_id[i] != 0u) {
+                        iid = md_foreign_id[i];
+                        size = md_foreign_size[i];
+                        break;
+                }
+        }
+        if (iid == 0u || head + MD_QRTR_CTRL_FRAME > MD_GLINK_FIFO_SIZE) {
+                MD_SAY("POLARIS MODEM: 0326 VERDICT: host service %u "
+                    "NOT published (foreign %u, tx head %u)\n",
+                    service, md_foreign_count, head);
+                return head;
+        }
+        md_smem_poke(md_glink_tx_at + at,
+            MD_GLINK_DATA | (MD_GLINK_CID << 16));
+        md_smem_poke(md_glink_tx_at + at + 4u, iid);
+        md_smem_poke(md_glink_tx_at + at + 8u, MD_QRTR_CTRL_LEN);
+        md_smem_poke(md_glink_tx_at + at + 12u, 0u);
+        for (i = 0u; i < 13u; i++) {
+                md_smem_poke(md_glink_tx_at + at + 16u + 4u * i, pkt[i]);
+        }
+        md_smem_poke(md_glink_tx_at + at + 68u, 0u);
+        md_hostsvc_published++;
+        MD_SAY("POLARIS MODEM: 0326 VERDICT: HOST SERVICE PUBLISHED "
+            "service %u v1 inst%u node %u port %#x (52 B, cid %u, "
+            "intent %u size %u, tx head %u -> %u)\n", service,
+            instance, MD_QRTR_LOCAL_NODE, port_id, MD_GLINK_CID,
+            iid, size, head, head + MD_QRTR_CTRL_FRAME);
+        return head + MD_QRTR_CTRL_FRAME;
+}
