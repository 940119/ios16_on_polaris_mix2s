+	/*
+	 * 0278: kmem_alloc_contig()'s fifth argument is max_pnum - the maximum
+	 * physical page number to allocate, 0 meaning no limit. The old loop
+	 * passed 0 and simply retried, hoping the allocator would hand back a
+	 * low page. With mkadt.py --highmem the whole kernel-managed bank
+	 * starts at 0x100000000, so all eight tries were >= 4 GiB and the
+	 * fallback knowingly used a high address anyway. Ask for a low page
+	 * directly instead.
+	 *
+	 * 0277-p2 showed GSTS 0x7e800010 after the ep0 prime; bit 4 is
+	 * DWC3_GSTS_BUS_ERR_ADDR_VLD, i.e. the core reported an AXI bus error
+	 * while fetching the SETUP TRB at 0x103b61000. The 64-bit AWIDTH only
+	 * describes the register width, not what the SDM845 AXI master can
+	 * actually reach. 0274 (no prime) never sets that bit.
+	 */
+	int lo = 1;
+	PE_parse_boot_argn("sweetusblo", &lo, sizeof(lo));
+	ppnum_t max_pnum = lo ? (ppnum_t)(atop_64(0x100000000ULL) - 1) : 0;
+	printf("SWEET USB: 0278 DMA max_pnum 0x%x (low=%d)\n", max_pnum, lo);
+	ud_flush();
 	for (; tries < 8; tries++) {
-		if (kmem_alloc_contig(kernel_map, &ud.dma, UD_SIZE, PAGE_MASK, 0, 0,
-		    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
-			printf("SWEET USB: no DMA memory\n");
-			return;
+		if (kmem_alloc_contig(kernel_map, &ud.dma, UD_SIZE, PAGE_MASK,
+		    max_pnum, 0, KMA_DATA | KMA_ZERO,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("SWEET USB: 0278 low-DMA alloc failed at try %d "
+			    "(max_pnum 0x%x)\n", tries, max_pnum);
+			ud_flush();
+			max_pnum = 0;           /* fall back, but say so */
+			if (kmem_alloc_contig(kernel_map, &ud.dma, UD_SIZE, PAGE_MASK,
+			    0, 0, KMA_DATA | KMA_ZERO,
+			    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+				printf("SWEET USB: no DMA memory\n");
+				return;
