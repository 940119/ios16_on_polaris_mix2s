diff -Nur a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp	2026-11-02 11:27:48.032767295 +0800
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp	2026-11-02 11:27:48.038848587 +0800
@@ -38,6 +38,17 @@
 
 extern "C" int sweet_console_muted;     /* osfmk/console/serial_console.c */
 
+/*
+ * Frame accounting, read once a second by the vsync timer.
+ *
+ * The per-swap line below is capped at 16 and the 1000-frame summary never
+ * fired, so "the screen is frozen" and "the log stopped counting" looked the
+ * same. A heartbeat fixes that: it says how many frames arrived, how many were
+ * copied into the panel, and how many rectangles were rejected, whether or not
+ * anything is happening.
+ */
+static uint64_t sweet_fb_swap_count;
+
 #if defined(SWEET)
 #include <IOKit/IOService.h>
 #include <IOKit/IOUserClient.h>
@@ -108,6 +119,10 @@
 	int           fScale;                   /* scale the logical display into the panel */
 	int32_t       fSrcOffX;                 /* logical column that lands on panel x 0 */
 	uint64_t      fBlitFrames;              /* panel copies in the current window */
+	uint64_t      fBlitsTotal;            /* panel copies since boot */
+	uint64_t      fBadRects;              /* rectangles that could not be copied */
+	uint64_t      fTicks;                 /* vsync ticks since boot */
+	uint64_t      fSwapSeen;              /* swap count at the last heartbeat */
 	uint64_t      fBlitMin, fBlitMax, fBlitSum;     /* mach ticks, per copy */
 	uintptr_t     fPixels;          /* kernel mapping of the panel memory */
 	IOMemoryMap  *fMap;
@@ -258,6 +273,21 @@
 	AppleCLCD *fb = (AppleCLCD *)owner;
 	uint64_t now = mach_absolute_time();
 	uint64_t count = ++fb->fVsyncCount;
+
+	/*
+	 * One line a second, whatever else happens. "new" is what the display has
+	 * been waiting for: if it is 0 while the tick climbs, the compositor
+	 * stopped presenting and the panel is showing a stale frame by definition.
+	 */
+	if ((++fb->fTicks % 60) == 0) {
+		uint64_t swaps = sweet_fb_swap_count;
+
+		IOLog("SWEET FB: tick %llu swaps %llu new %llu blits %llu bad %llu "
+		    "dirty %d poweroff %d\n", fb->fTicks, swaps,
+		    swaps - fb->fSwapSeen, fb->fBlitsTotal, fb->fBadRects,
+		    fb->fDirty ? 1 : 0, fb->fPowerOff ? 1 : 0);
+		fb->fSwapSeen = swaps;
+	}
 	uint64_t values[6] = {
 		(uint32_t)count, (uint32_t)(count >> 32),
 		(uint32_t)now, (uint32_t)(now >> 32),
@@ -333,7 +363,6 @@
 }
 
 static uint32_t sweet_fb_swaps_logged;
-static uint64_t sweet_fb_swap_count;
 
 /* Copy each enabled layer's surface into the panel memory (no scaling). */
 /*
@@ -349,8 +378,10 @@
 	memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
 	fDirty = true;
 	IOLockUnlock(fLock);
-	if ((++sweet_fb_swap_count % 1000) == 0) {
-		IOLog("SWEET FB: %llu swaps\n", sweet_fb_swap_count);
+	++sweet_fb_swap_count;
+	if (sweet_fb_swap_count <= 40 || (sweet_fb_swap_count % 600) == 0) {
+		IOLog("SWEET FB: frame %llu rec %u mask 0x%x\n", sweet_fb_swap_count,
+		    get32(rec, 0x50), get32(rec, 0x104));
 	}
 }
 
@@ -459,6 +490,7 @@
 			src = 0;
 		}
 		if (src != 0 && bpe == 4 && fScale) {
+			fBlitsTotal++;
 			/*
 			 * Fill the panel one destination row at a time. Horizontally
 			 * the logical frame is cropped 1:1, so a row is a plain
@@ -526,11 +558,14 @@
 				fBlitMin = fBlitMax = fBlitSum = 0;
 			}
 		} else if (src != 0 && bpe == 4) {
+			fBlitsTotal++;
 			for (int32_t y = 0; y < h; y++) {
 				memcpy((void *)(fPixels + (uint64_t)(dy + y) * fRowBytes + (uint64_t)dx * 4),
 				    (const void *)(src + s->offset + (uint64_t)(sy + y) * s->bytesPerRow + (uint64_t)sx * 4),
 				    (size_t)w * 4);
 			}
+		} else {
+			fBadRects++;
 		}
 		s->release();
 	}
