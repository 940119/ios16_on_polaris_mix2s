+/* open_channel():575 + offer():286, written as GLINK frames into 479.
+ * Returns the new tx head.  Every poke is a word-wise volatile store
+ * through the WCOMB map; no memcpy, no unmap (0310 / 0312). */
+static uint32_t
+md_glink_offer(uint32_t head)
+{
+	static const uint32_t sizes[3] = { 0x800u, 0x2000u, 0x4400u };
+	uint32_t i, at = head;
+
+	/* header(OPEN=2, cid=1, arg=7) + "IPCRTR\0" + one pad byte.
+	 * 0x52435049 0x00005254 is exactly what the modem wrote in 480. */
+	md_smem_poke(md_glink_tx_at + at, MD_GLINK_OPEN | (1u << 16));
+	md_smem_poke(md_glink_tx_at + at + 4u, 7u);
+	md_smem_poke(md_glink_tx_at + at + 8u, 0x52435049u);
+	md_smem_poke(md_glink_tx_at + at + 12u, 0x00005254u);
+	at += 16u;
+
+	/* header(INTENT=5, cid=1, arg=1) + {size, id}.  Reusable, so a
+	 * completed DATA is released with DONE_REUSE (pump():670). */
+	for (i = 0; i < 3u; i++) {
+		md_smem_poke(md_glink_tx_at + at,
+		    MD_GLINK_INTENT | (1u << 16));
+		md_smem_poke(md_glink_tx_at + at + 4u, 1u);
+		md_smem_poke(md_glink_tx_at + at + 8u, sizes[i]);
+		md_smem_poke(md_glink_tx_at + at + 12u, i + 1u);
+		at += 16u;
+	}
+	md_glink_offered = TRUE;
+	MD_SAY("POLARIS MODEM: 0321 VERDICT: AP OPENED IPCRTR (cid 1) AND "
+	    "OFFERED 3 INTENTS (0x800/0x2000/0x4400 ids 1..3), "
+	    "tx head %u -> %u\n", head, at);
+	return at;
+}
