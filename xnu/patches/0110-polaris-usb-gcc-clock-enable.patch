 		{ "C-phy-live",     ud_cfg_phy_live },
+		{ "D-clocks",       ud_cfg_clocks },
 	};
 	int saw_event = 0;
 	for (unsigned k = 0; k < sizeof(cfg) / sizeof(cfg[0]) && !saw_event; k++) {
