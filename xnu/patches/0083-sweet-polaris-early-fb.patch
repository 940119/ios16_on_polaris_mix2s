diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..2e3e441 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1833,17 +1833,25 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
  */
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
 
+static vm_map_address_t sweet_early_fb_va = SWEET_EARLY_FB_VA;
+
 static void
-sweet_early_map_final(void)
+sweet_early_map_final(boot_args *args)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
+	uint64_t fb = 0x9c000000ULL;
+	if (args != NULL && args->Video.v_baseAddr != 0) {
+		fb = args->Video.v_baseAddr;
+	}
+	uint64_t block = fb & ~((uint64_t)ARM_TT_L2_SIZE - 1);
+	sweet_early_fb_va = va + (vm_map_address_t)(fb - block);
 	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	*slot = block | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
@@ -2181,7 +2189,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 #if defined(SWEET)
 	/* phystokv() must still refer to the bootstrap aperture here. */
-	sweet_early_map_final();
+	sweet_early_map_final(args);
 #endif
 	arm_vm_physmap_init(args);
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
@@ -2190,7 +2198,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 #if defined(SWEET)
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
-	sweet_early_relocate(SWEET_EARLY_FB_VA);
+	sweet_early_relocate(sweet_early_fb_va);
 #endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..206d448 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -514,21 +514,33 @@ LEXT(start_first_cpu)
 	mov		x21, #0
 
 #if defined(SWEET)
-	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	/*
+	 * Stage 0: white 64x32 band at the bottom-left of the panel, no stack
+	 * or page tables needed. boot_args (saved in x20) carries the board's
+	 * real framebuffer base and geometry.
+	 */
+	ldr		x0, [x20, #40]			/* Video.v_baseAddr */
+	cbz		x0, Lsweet_mark_done
+	ldr		x4, [x20, #56]			/* Video.v_rowBytes */
+	cbz		x4, Lsweet_mark_done
+	ldr		x2, [x20, #72]			/* Video.v_height */
+	cmp		x2, #32
+	b.lo		Lsweet_mark_done
+	sub		x2, x2, #32
+	madd		x0, x2, x4, x0
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
 Lsweet_mark_pixel:
 	str		w1, [x5], #4
 	subs	x3, x3, #1
-	b.ne	Lsweet_mark_pixel
+	b.ne		Lsweet_mark_pixel
 	add		x0, x0, x4
 	subs	x2, x2, #1
-	b.ne	Lsweet_mark_row
+	b.ne		Lsweet_mark_row
+Lsweet_mark_done:
 	dsb		sy
 #endif
 
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 6928957..f0820fd 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -12,10 +12,11 @@
 #include <kern/misc_protos.h>
 
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+static unsigned int early_width = 1080, early_height = 2400, early_stride = 1080;
 #define EARLY_FB early_fb
-#define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
-#define EARLY_STRIDE (4320u / 4)
+#define EARLY_WIDTH early_width
+#define EARLY_HEIGHT early_height
+#define EARLY_STRIDE early_stride
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
@@ -28,6 +29,25 @@ extern unsigned char iso_font[256 * 16];
 static unsigned int early_row, early_col;
 static unsigned int early_started, early_disabled, early_panicking;
 
+/*
+ * The board's splash framebuffer is not at a fixed address (sweet:
+ * 0x9c000000, polaris: 0x9d400000), so start with the geometry the shim
+ * passed in boot_args. Called before the first marker.
+ */
+void
+sweet_early_init(const boot_args *args)
+{
+	if (args != NULL && args->Video.v_baseAddr != 0) {
+		early_fb = (volatile uint32_t *)(uintptr_t)args->Video.v_baseAddr;
+	}
+	if (args != NULL && args->Video.v_width != 0 && args->Video.v_height != 0 &&
+	    args->Video.v_rowBytes >= args->Video.v_width * 4) {
+		early_width = (unsigned int)args->Video.v_width;
+		early_height = (unsigned int)args->Video.v_height;
+		early_stride = (unsigned int)(args->Video.v_rowBytes / 4);
+	}
+}
+
