+		return -1;
+	}
+	printf("SWEET USB: QUSB2 in: PLL_STATUS 0x%02x POWERDOWN 0x%02x TUNE1 0x%02x REG04 0x%02x\n",
+	    qusb2_rd(phy, QUSB2_PLL_STATUS), qusb2_rd(phy, QUSB2_PORT_POWERDOWN),
+	    qusb2_rd(phy, QUSB2_PORT_TUNE1), qusb2_rd(phy, 0x004));
