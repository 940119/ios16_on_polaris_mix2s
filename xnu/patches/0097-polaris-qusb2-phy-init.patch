+#define QUSB2_PORT_POWERDOWN 0x210
+#define QUSB2_PORT_TUNE1    0x240
+#define QUSB2_PLL_LOCKED    (1u << 5)
+#define QUSB2_POWER_DOWN    (1u << 0)
