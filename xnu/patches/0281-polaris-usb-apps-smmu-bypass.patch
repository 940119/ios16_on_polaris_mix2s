+/*
+ * 0281: the apps SMMU, which nothing in this kernel has ever programmed.
+ *
+ * The last two builds changed only the DMA address and got the identical
+ * failure:
+ *
+ *   0278  STARTTRANSFER ep0 trb 0x1028ed000
+ *         GBUSERRADDR 0x00000001028ed000  GSTS 0x7e800010
+ *   0280  STARTTRANSFER ep0 trb 0xc0001000
+ *         GBUSERRADDR 0x00000000c0001000  GSTS 0x7e800010
+ *
+ * GBUSERRADDR is the core's own record of the AXI address it was refused,
+ * and in both builds it is byte-for-byte the TRB it had just been handed.
+ * So the transfer left the controller and something downstream answered
+ * with an error. Section 36 of POLARIS-ROUND ("the AXI master cannot reach
+ * the upper DDR bank") does not survive that pair; section 38 retracts it.
+ *
+ * What is downstream is in the device tree, read from recovery without a
+ * build in the loop:
+ *
+ *   /proc/device-tree/soc/ssusb@a600000/iommus
+ *     00 00 00 29  00 00 07 40  00 00 00 00
+ *   /proc/device-tree/soc/apps-smmu@0x15000000/compatible
+ *     "qcom,qsmmu-v500"   phandle 0x29, reg <0x15000000 0x80000>
+ *   dmesg, TWRP:
+ *     iommu: Adding device a600000.ssusb to group 10
+ *     arm-smmu 15000000.apps-smmu: stream matching with 76 register
+ *         groups, mask 0x7fff
+ *
+ * The DWC3 AXI master therefore reaches DRAM through the apps SMMU as
+ * StreamID 0x740. The same node carries qcom,smmu-s1-bypass, so the
+ * intended steady state is a bypass entry and not a translation. Nobody
+ * has written that entry here: XNU has no SMMU driver, the SMMU-500 reset
+ * value of S2CR is TYPE=FAULT, and a master whose SID matches no valid SMR
+ * is an unassigned StreamID whose transactions are terminated. The core
+ * then reports it in the only way it can - GSTS.BUS_ERR_ADDR_VLD with the
+ * aborted address in GBUSERRADDR - at whatever address was asked for.
+ * That is the one property every measurement since 0278 shares.
+ *
+ * Offsets and field positions below are from arm-smmu.h, not from
+ * recollection, because this file has already spent two builds on
+ * remembered register maps (section 28):
+ *
+ *   SMR(n)  = 0x800 + (n << 2)   VALID BIT(31), MASK[31:16], ID[15:0]
+ *   S2CR(n) = 0xc00 + (n << 2)   TYPE GENMASK(17,16), CBNDX GENMASK(7,0)
+ *   S2CR_TYPE_TRANS 0, S2CR_TYPE_BYPASS 1, S2CR_TYPE_FAULT 2
+ *   sCR0 0x00 CLIENTPD BIT(0)    ID0 0x20 NUMSMRG[7:0]   ID1 0x24
+ *   sGFSR 0x48, sGFSYNR0 0x50, sGFSYNR1 0x54
+ *
+ * S2CR.TYPE is bits 17:16 and not 1:0. Writing 0x1 there would land in
+ * CBNDX, which is the kind of quiet mistake this file specialises in.
+ *
+ * sweetusbsmmu=n
+ *   0  dump only, write nothing
+ *   1  dump, then install the bypass entry for SID 0x740 and clear
+ *      sCR0.CLIENTPD if it is set (default)
+ *   2  1, and put every S2CR in the array into bypass as well
+ */
+#define APPS_SMMU_PA		0x15000000
+#define APPS_SMMU_SIZE		0x4000
+#define SMMU_GR0_sCR0		0x0000
+#define SMMU_GR0_ID0		0x0020
+#define SMMU_GR0_ID1		0x0024
+#define SMMU_GR0_sGFSR		0x0048
+#define SMMU_GR0_sGFSYNR0	0x0050
+#define SMMU_GR0_sGFSYNR1	0x0054
+#define SMMU_GR0_SMR(n)		(0x0800u + ((n) << 2))
+#define SMMU_GR0_S2CR(n)	(0x0c00u + ((n) << 2))
+#define SMMU_SMR_VALID		0x80000000u
+#define SMMU_SMR_ID		0x0000ffffu
+#define SMMU_S2CR_TYPE_BYPASS	(1u << 16)
+#define SMMU_S2CR_CBNDX		0x000000ffu
+#define SMMU_USB_SID		0x740u
+#define SMMU_MAX_GROUPS		256u
+
+static void
+ud_smmu_setup(void)
+{
+	int mode = 1;
+	PE_parse_boot_argn("sweetusbsmmu", &mode, sizeof(mode));
+
+	vm_offset_t s = ml_io_map(APPS_SMMU_PA, APPS_SMMU_SIZE);
+	if (s == 0) {
+		printf("SWEET USB: 0281 apps-SMMU map failed\n");
+		ud_flush();
+		return;
+	}
+	uint32_t cr0  = usb_rd(s, SMMU_GR0_sCR0);
+	uint32_t id0  = usb_rd(s, SMMU_GR0_ID0);
+	uint32_t id1  = usb_rd(s, SMMU_GR0_ID1);
+	uint32_t gfsr = usb_rd(s, SMMU_GR0_sGFSR);
+	printf("SWEET USB: 0281 SMMU in: sCR0 0x%08x ID0 0x%08x ID1 0x%08x "
+	    "sGFSR 0x%08x SYNR0 0x%08x SYNR1 0x%08x\n",
+	    cr0, id0, id1, gfsr, usb_rd(s, SMMU_GR0_sGFSYNR0),
+	    usb_rd(s, SMMU_GR0_sGFSYNR1));
+	ud_flush();
+
+	if (id0 == 0 || id0 == 0xffffffffu) {
+		printf("SWEET USB: 0281 SMMU ID0 0x%08x - nothing mapped there, "
+		    "giving up\n", id0);
+		ud_flush();
+		return;
+	}
+	unsigned groups = (id0 & 0xffu) + 1u;
+	if (groups > SMMU_MAX_GROUPS) {
+		groups = SMMU_MAX_GROUPS;
+	}
+
+	int found = -1;
+	int free_idx = -1;
+	for (unsigned i = 0; i < groups; i++) {
+		uint32_t smr = usb_rd(s, SMMU_GR0_SMR(i));
+
+		if (!(smr & SMMU_SMR_VALID)) {
+			if (free_idx < 0) {
+				free_idx = (int)i;
+			}
+			continue;
+		}
+		if ((smr & SMMU_SMR_ID) == SMMU_USB_SID) {
+			found = (int)i;
+		}
+	}
+	printf("SWEET USB: 0281 SMMU %u groups: SID 0x%x %s, first free %d\n",
+	    groups, SMMU_USB_SID,
+	    (found >= 0) ? "already mapped" : "NOT mapped", free_idx);
+	ud_flush();
+
+	if (mode <= 0) {
+		printf("SWEET USB: 0281 sweetusbsmmu=0 - dump only, no writes\n");
+		ud_flush();
+		return;
+	}
+
+	int idx = found;
+	if (idx < 0) {
+		if (free_idx < 0) {
+			printf("SWEET USB: 0281 no free SMR for SID 0x%x\n",
+			    SMMU_USB_SID);
+			ud_flush();
+			return;
+		}
+		usb_wr(s, SMMU_GR0_SMR(free_idx), SMMU_SMR_VALID | SMMU_USB_SID);
+		printf("SWEET USB: 0281 SMR[%d] <- 0x%08x, reads 0x%08x\n",
+		    free_idx, SMMU_SMR_VALID | SMMU_USB_SID,
+		    usb_rd(s, SMMU_GR0_SMR(free_idx)));
+		idx = free_idx;
+		ud_flush();
+	}
+
+	uint32_t s2cr_old = usb_rd(s, SMMU_GR0_S2CR(idx));
+	usb_wr(s, SMMU_GR0_S2CR(idx), SMMU_S2CR_TYPE_BYPASS);
+	uint32_t s2cr_new = usb_rd(s, SMMU_GR0_S2CR(idx));
+	printf("SWEET USB: 0281 S2CR[%d] 0x%08x -> 0x%08x (type %u, want 1)\n",
+	    idx, s2cr_old, s2cr_new, (s2cr_new >> 16) & 3u);
+	ud_flush();
+	if (((s2cr_new >> 16) & 3u) != 1u) {
+		/*
+		 * Qualcomm firmware on this generation can refuse a bare
+		 * bypass and only accept it with CBNDX pointed at the last
+		 * context bank - arm-smmu-qcom carries the same workaround as
+		 * qsmmu->bypass_cbndx. Try it once before believing the
+		 * read-back.
+		 */
+		unsigned ncb = (id1 & 0xffu) + 1u;
+		uint32_t alt = SMMU_S2CR_TYPE_BYPASS |
+		    ((ncb - 1u) & SMMU_S2CR_CBNDX);
+
+		usb_wr(s, SMMU_GR0_S2CR(idx), alt);
+		printf("SWEET USB: 0281 S2CR[%d] CBNDX %u retry -> 0x%08x\n",
+		    idx, ncb - 1u, usb_rd(s, SMMU_GR0_S2CR(idx)));
+		ud_flush();
+	}
+
+	/*
+	 * CLIENTPD is 0 = clients enabled. If the bootloader left the SMMU
+	 * globally parked, no S2CR means anything until this bit is cleared.
+	 * Only clear it when it is set, so the other masters that ABL may
+	 * have configured keep the state they were given.
+	 */
+	if (cr0 & 1u) {
+		usb_wr(s, SMMU_GR0_sCR0, cr0 & ~1u);
+		printf("SWEET USB: 0281 sCR0 0x%08x -> 0x%08x (client port on)\n",
+		    cr0, usb_rd(s, SMMU_GR0_sCR0));
+		ud_flush();
+	}
+
+	if (mode >= 2) {
+		for (unsigned i = 0; i < groups; i++) {
+			usb_wr(s, SMMU_GR0_S2CR(i), SMMU_S2CR_TYPE_BYPASS);
+		}
+		printf("SWEET USB: 0281 all %u S2CR set to bypass\n", groups);
+		ud_flush();
+	}
+
+	/* Acknowledge whatever fault was already latched, so a later read
+	 * means something new rather than the same stuck bit. */
+	if (gfsr != 0 && gfsr != 0xffffffffu) {
+		usb_wr(s, SMMU_GR0_sGFSR, gfsr);
+	}
+	printf("SWEET USB: 0281 SMMU out: sCR0 0x%08x SMR[%d] 0x%08x "
+	    "S2CR[%d] 0x%08x sGFSR 0x%08x SYNR1 0x%08x\n",
+	    usb_rd(s, SMMU_GR0_sCR0), idx, usb_rd(s, SMMU_GR0_SMR(idx)),
+	    idx, usb_rd(s, SMMU_GR0_S2CR(idx)), usb_rd(s, SMMU_GR0_sGFSR),
+	    usb_rd(s, SMMU_GR0_sGFSYNR1));
+	ud_flush();
+}
+
+/*
+ * 0281: what the SMMU thinks just happened.
+ *
+ * The prime leaves the core with GSTS.BUS_ERR_ADDR_VLD set and the refused
+ * address in GBUSERRADDR, and the machine is still alive to print it, so the
+ * SMMU's own fault record can be read afterwards without inventing a new
+ * theory. sGFSYNR1 is the StreamID of the last global fault: if it reads
+ * 0x740, the apps SMMU is what refused the transfer. If sGFSR is 0 and SYNR1
+ * is not 0x740, the refusal came from somewhere else and this patch has
+ * proved that instead.
+ */
+static void
+ud_smmu_fault(const char *tag)
+{
+	vm_offset_t s = ml_io_map(APPS_SMMU_PA, APPS_SMMU_SIZE);
+
+	if (s == 0) {
+		printf("SWEET USB: 0281 %s SMMU map failed\n", tag);
+		ud_flush();
+		return;
+	}
+	printf("SWEET USB: 0281 %s SMMU sGFSR 0x%08x SYNR0 0x%08x SYNR1 0x%08x "
+	    "sCR0 0x%08x\n", tag, usb_rd(s, SMMU_GR0_sGFSR),
+	    usb_rd(s, SMMU_GR0_sGFSYNR0), usb_rd(s, SMMU_GR0_sGFSYNR1),
+	    usb_rd(s, SMMU_GR0_sCR0));
+	ud_flush();
+}
+
