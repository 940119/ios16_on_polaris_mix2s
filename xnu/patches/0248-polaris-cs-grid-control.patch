+	 */
+	if (pg_cs_cpctl) {
+		uint32_t fsr_a = 0, fsr_b = 0, w = pg_cp_wptr;
+		uint64_t far_a = pg_smmu_far(&fsr_a), far_b;
+
+		seq = polaris_gpu_fence_next();
+		pg_ring_put(w++, pg_pkt7(0x46u, 4u));		/* CP_EVENT_WRITE */
+		pg_ring_put(w++, 0x04u);
+		pg_ring_put(w++, (uint32_t)PG_CS_MISSING_IOVA);
+		pg_ring_put(w++, (uint32_t)(PG_CS_MISSING_IOVA >> 32));
+		pg_ring_put(w++, seq);
+		w &= PG_RING_WORDS - 1u;
+		pg_ring_flush();
+		pg_wr(pg_gpu3d + 4u * PG_CP_RB_WPTR, w);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		pg_cp_wptr = w;
+		pg_sleep_us(20000);
+		far_b = pg_smmu_far(&fsr_b);
+		printf("POLARIS GPU: 20 shader: the CP wrote %#llx: FSR %#010x -> "
+		    "%#010x FAR %#010x%08x -> %#010x%08x; %s\n",
