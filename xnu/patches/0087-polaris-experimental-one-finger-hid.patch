+/* Experimental: 0x08 is a finger-correlated candidate, NOT a proven F12
+ * Data1 layout. Do not invent a contact for unknown or malformed bytes. */
+static void
+pt_release(void)
+{
+	if (pt_down) {
+		sweet_hid_touch(0, 0, pt_x, pt_y);
+		pt_down = false;
+	}
+}
+
+static bool
+pt_frame(const uint8_t *b, int *x, int *y, bool *present)
+{
+	*present = false;
+	if (b[0] == 0 && b[1] == 0 && b[2] == 0 && b[3] == 0 &&
+	    b[4] == 0 && b[5] == 0 && b[6] == 0 && b[7] == 0) {
+		return true; /* only all-zero is an unambiguous release candidate */
+	}
+	/* Single finger object type 1, plausible observed tail, little-endian
+	 * coordinates inside Polaris panel. Any other object is invalid. */
+	*x = (int)((unsigned)b[1] | ((unsigned)b[2] << 8));
+	*y = (int)((unsigned)b[3] | ((unsigned)b[4] << 8));
+	if (b[0] != 1 || *x < 0 || *x >= 1080 || *y < 0 || *y >= 2160 ||
+	    b[5] == 0 || b[5] == 0xff || b[6] == 0 || b[6] > 0x20 ||
+	    b[7] == 0 || b[7] > 0x20) {
+		return false;
+	}
+	*present = true;
+	return true;
+}
