 /*
+ * 0302, level 20: the QMP mailbox's message path.
+ *
+ * Layout from Linux drivers/mailbox/qcom-qmp.c (sdm845) and dipper's
+ * mi8_rproc.c; the phone's own device tree agrees on both addresses:
+ *
+ *   /soc/qcom,qmp-aop@c300000
+ *     reg 0xc300000 0x100000   (msgram)
+ *     reg 0x1799000c 0x4       (irq-reg-base: APCS IPC)
+ *
+ * 0299 already defined MD_AOSS_QMP_PHYS / MD_QMP_MAGIC / MD_QMP_VERSION /
+ * MD_QMP_THEIR_LINK / MD_QMP_OUR_LINK; the rest of the block is here.
+ */
+#define MD_QMP_THEIR_LINK_ACK	0x10u
+#define MD_QMP_THEIR_CHANNEL	0x14u
+#define MD_QMP_THEIR_CHANNEL_ACK 0x18u
+#define MD_QMP_OUR_LINK_ACK	0x28u
+#define MD_QMP_OUR_CHANNEL	0x2cu
+#define MD_QMP_OUR_CHANNEL_ACK	0x30u
+#define MD_QMP_OUR_BOX_SIZE	0x34u
+#define MD_QMP_OUR_BOX		0x38u
+#define MD_QMP_MESSAGE		64u
+#define MD_QMP_UP		0x0000ffffu
+#define MD_QMP_DOWN		0xffff0000u
+#define MD_QMP_MAGIC_VALUE	0x4d41494cu	/* "MAIL" */
+#define MD_APCS_PHYS		0x17990000ull
+#define MD_APCS_IPC		0x0cu
+#define MD_APCS_AOP		(1u << 0)	/* the AOP's line */
+
+#define MD_QMP_POLL_MS		1000u
+
+/* ~1 ms: md_w2c_delay() is about 100 us of nops on this core. */
+static void
+md_qmp_ms(void)
+{
+	for (uint32_t i = 0; i < 10u; i++) {
+		md_w2c_delay();
+	}
+}
+
+static bool
+md_qmp_wait(vm_offset_t qmp, uint32_t off, uint32_t want, uint32_t ms)
+{
+	for (uint32_t t = 0; t < ms; t++) {
+		if (md_rd(qmp, off) == want) {
+			MD_SAY("POLARIS MODEM:   +0x%02x reached %#x after ~%u ms\n",
+			    off, want, t);
+			return true;
+		}
+		md_qmp_ms();
+	}
+	return false;
+}
+
+static void
+md_qmp_ring(vm_offset_t apcs)
+{
+	uint32_t before = md_rd(apcs, MD_APCS_IPC);
+
+	/*
+	 * dipper's ring() and this port's 0168 both store the mask outright
+	 * rather than OR-ing it: APCS IPC is a trigger, and the AOP owns every
+	 * other bit in it.
+	 */
+	md_wr(apcs, MD_APCS_IPC, MD_APCS_AOP);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	MD_SAY("POLARIS MODEM:   doorbell: APCS IPC %#x -> %#x\n", before,
+	    md_rd(apcs, MD_APCS_IPC));
+}
+
+static void
+md_qmp_state(vm_offset_t qmp, const char *when)
+{
+	MD_SAY("POLARIS MODEM:   [%s] link %#x/%#x channel %#x/%#x "
+	    "(ours/their) acks %#x/%#x\n", when,
+	    md_rd(qmp, MD_QMP_OUR_LINK), md_rd(qmp, MD_QMP_THEIR_LINK),
+	    md_rd(qmp, MD_QMP_OUR_CHANNEL), md_rd(qmp, MD_QMP_THEIR_CHANNEL),
+	    md_rd(qmp, MD_QMP_OUR_LINK_ACK), md_rd(qmp, MD_QMP_OUR_CHANNEL_ACK));
+}
+
+/* Linux's qmp_open(), the same three steps 0168 ran once. Idempotent. */
+static bool
+md_qmp_open(vm_offset_t qmp, vm_offset_t apcs)
+{
+	if (md_rd(qmp, MD_QMP_OUR_LINK) == MD_QMP_UP &&
+	    md_rd(qmp, MD_QMP_OUR_LINK_ACK) == MD_QMP_UP &&
+	    md_rd(qmp, MD_QMP_OUR_CHANNEL) == MD_QMP_UP &&
+	    md_rd(qmp, MD_QMP_THEIR_CHANNEL) == MD_QMP_UP &&
+	    md_rd(qmp, MD_QMP_OUR_CHANNEL_ACK) == MD_QMP_UP) {
+		MD_SAY("POLARIS MODEM:   the mailbox is open already; "
+		    "no handshake needed\n");
+		return true;
+	}
+	MD_SAY("POLARIS MODEM:   === opening the mailbox, three steps ===\n");
+	md_w2c_wr(qmp, MD_QMP_THEIR_LINK_ACK, md_rd(qmp, MD_QMP_THEIR_LINK),
+	    "THEIR_LINK_ACK");
+	md_w2c_wr(qmp, MD_QMP_OUR_LINK, MD_QMP_UP, "OUR_LINK");
+	md_qmp_ring(apcs);
+	if (!md_qmp_wait(qmp, MD_QMP_OUR_LINK_ACK, MD_QMP_UP, MD_QMP_POLL_MS)) {
+		MD_SAY("POLARIS MODEM:   THE AOP DOES NOT ACKNOWLEDGE OUR LINK\n");
+		md_w2c_wr(qmp, MD_QMP_OUR_LINK, MD_QMP_DOWN, "OUR_LINK");
+		return false;
+	}
+	md_w2c_wr(qmp, MD_QMP_OUR_CHANNEL, MD_QMP_UP, "OUR_CHANNEL");
+	md_qmp_ring(apcs);
+	if (!md_qmp_wait(qmp, MD_QMP_THEIR_CHANNEL, MD_QMP_UP, MD_QMP_POLL_MS)) {
+		MD_SAY("POLARIS MODEM:   THE AOP DOES NOT OPEN ITS CHANNEL\n");
+		md_w2c_wr(qmp, MD_QMP_OUR_CHANNEL, MD_QMP_DOWN, "OUR_CHANNEL");
+		md_w2c_wr(qmp, MD_QMP_OUR_LINK, MD_QMP_DOWN, "OUR_LINK");
+		return false;
+	}
+	md_w2c_wr(qmp, MD_QMP_THEIR_CHANNEL_ACK, MD_QMP_UP,
+	    "THEIR_CHANNEL_ACK");
+	md_qmp_ring(apcs);
+	if (!md_qmp_wait(qmp, MD_QMP_OUR_CHANNEL_ACK, MD_QMP_UP, MD_QMP_POLL_MS)) {
+		MD_SAY("POLARIS MODEM:   THE AOP DOES NOT ACKNOWLEDGE OUR CHANNEL\n");
+		md_w2c_wr(qmp, MD_QMP_OUR_CHANNEL, MD_QMP_DOWN, "OUR_CHANNEL");
+		md_w2c_wr(qmp, MD_QMP_OUR_LINK, MD_QMP_DOWN, "OUR_LINK");
+		return false;
+	}
+	MD_SAY("POLARIS MODEM:   THE MAILBOX TO THE AOP IS OPEN\n");
+	return true;
+}
+
+/* "{class: image, res: load_state, name: modem, val: off}", zero padded. */
+static const char md_qmp_off[] =
+    "{class: image, res: load_state, name: modem, val: off}";
+
+static void
+md_qmp_message_probe(void)
+{
+	vm_offset_t qmp, apcs;
+	uint32_t box, size, i, v, bad;
+	uint8_t raw[MD_QMP_MESSAGE];
+	uint32_t words[MD_QMP_MESSAGE / 4];
+	bool box_ok, took = false;
+
+	MD_SAY("POLARIS MODEM: ======== build 0302 alive: one QMP message to "
+	    "the AOP (level 20, no modem register touched) ========\n");
+	MD_SAY("POLARIS MODEM:   no GCC, no PDC, no AOSS_CC, no RMB, no Q6, "
+	    "no MBA, no owner, no MP_ASSIGN, no BOOT_CORE_START\n");
+	qmp = ml_io_map((vm_offset_t)MD_AOSS_QMP_PHYS, MD_MAP_SIZE);
+	apcs = ml_io_map((vm_offset_t)MD_APCS_PHYS, MD_MAP_SIZE);
+	MD_SAY("POLARIS MODEM:   maps: qmp %s apcs %s\n",
+	    qmp ? "ok" : "FAILED", apcs ? "ok" : "FAILED");
+	if (qmp == 0 || apcs == 0) {
+		MD_SAY("POLARIS MODEM:   a map failed; nothing was written\n");
+		return;
+	}
+
+	v = md_rd(qmp, MD_QMP_MAGIC);
+	MD_SAY("POLARIS MODEM:   magic %#x (want %#x), version %u\n", v,
+	    MD_QMP_MAGIC_VALUE, md_rd(qmp, MD_QMP_VERSION));
+	if (v != MD_QMP_MAGIC_VALUE) {
+		MD_SAY("POLARIS MODEM:   this is not the mailbox 0299 read; "
+		    "stopping\n");
+		return;
+	}
+	box = md_rd(qmp, MD_QMP_OUR_BOX);
+	size = md_rd(qmp, MD_QMP_OUR_BOX_SIZE);
+	MD_SAY("POLARIS MODEM:   our box at +%#x, %u bytes, first word %#x\n",
+	    box, size, md_rd(qmp, box));
+	MD_SAY("POLARIS MODEM:   APCS IPC %#x (AOP line %s)\n",
+	    md_rd(apcs, MD_APCS_IPC),
+	    (md_rd(apcs, MD_APCS_IPC) & MD_APCS_AOP) ? "raised" : "clear");
+
+	box_ok = size >= MD_QMP_MESSAGE + 4 && box >= 0x3c &&
+	    box + size <= MD_MAP_SIZE && (box & 3) == 0;
+	if (!box_ok) {
+		MD_SAY("POLARIS MODEM:   the box is not where a 64-byte message "
+		    "fits; nothing is written\n");
+		return;
+	}
+	if (md_rd(qmp, box) != 0) {
+		MD_SAY("POLARIS MODEM:   the box already holds a message of %u "
+		    "bytes; not sent\n", md_rd(qmp, box));
+		return;
+	}
+
+	md_qmp_state(qmp, "before");
+	if (!md_qmp_open(qmp, apcs)) {
+		MD_SAY("POLARIS MODEM: 0302 VERDICT: THE HANDSHAKE FAILED: "
+		    "no message was written\n");
+		return;
+	}
+	md_qmp_state(qmp, "after the handshake");
+
+	/*
+	 * The box must hold bytes before a doorbell is rung. The length word
+	 * stays 0 through this, so the AOP is never told anything.
+	 */
+	MD_SAY("POLARIS MODEM:   === writing 16 words at box + 4, with the "
+	    "length word left at 0 ===\n");
+	for (i = 0; i < MD_QMP_MESSAGE / 4; i++) {
+		md_wr(qmp, box + 4 + 4 * i, 0xc0de0000u | i);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	bad = 0;
+	for (i = 0; i < MD_QMP_MESSAGE / 4; i++) {
+		if (md_rd(qmp, box + 4 + 4 * i) != (0xc0de0000u | i)) {
+			bad++;
+		}
+	}
+	MD_SAY("POLARIS MODEM:   %u of 16 words read back wrong; length word "
+	    "still %#x\n", bad, md_rd(qmp, box));
+	for (i = 0; i < MD_QMP_MESSAGE / 4; i++) {
+		md_wr(qmp, box + 4 + 4 * i, 0);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (bad != 0) {
+		MD_SAY("POLARIS MODEM: 0302 VERDICT: THE BOX DOES NOT HOLD "
+		    "BYTES: no doorbell was rung\n");
+		return;
+	}
+
+	/* ---- the message itself ---- */
+	for (i = 0; i < MD_QMP_MESSAGE; i++) {
+		raw[i] = 0;
+	}
+	for (i = 0; i < MD_QMP_MESSAGE - 1 && md_qmp_off[i] != 0; i++) {
+		raw[i] = (uint8_t)md_qmp_off[i];
+	}
+	for (i = 0; i < MD_QMP_MESSAGE / 4; i++) {
+		words[i] = (uint32_t)raw[4 * i] |
+		    ((uint32_t)raw[4 * i + 1] << 8) |
+		    ((uint32_t)raw[4 * i + 2] << 16) |
+		    ((uint32_t)raw[4 * i + 3] << 24);
+	}
+	MD_SAY("POLARIS MODEM:   === telling the AOP \"%s\" ===\n", md_qmp_off);
+	for (i = 0; i < MD_QMP_MESSAGE / 4; i++) {
+		md_wr(qmp, box + 4 + 4 * i, words[i]);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	MD_SAY("POLARIS MODEM:   the box now reads %08x %08x %08x %08x ... "
+	    "(the string, little endian)\n", md_rd(qmp, box + 4),
+	    md_rd(qmp, box + 8), md_rd(qmp, box + 12), md_rd(qmp, box + 16));
+	MD_SAY("POLARIS MODEM:   about to WRITE the length %u at +%#x\n",
+	    MD_QMP_MESSAGE, box);
+	md_wr(qmp, box, MD_QMP_MESSAGE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	(void)md_rd(qmp, box);
+	md_qmp_ring(apcs);
+	if (md_qmp_wait(qmp, box, 0, MD_QMP_POLL_MS)) {
+		took = true;
+		MD_SAY("POLARIS MODEM:   THE AOP TOOK THE MESSAGE\n");
+	} else {
+		MD_SAY("POLARIS MODEM:   THE AOP DID NOT TAKE IT within a "
+		    "second; the length is put back to 0\n");
+		md_wr(qmp, box, 0);
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+
+	md_qmp_state(qmp, "after");
+	MD_SAY("POLARIS MODEM:   box first word %#x, APCS IPC %#x\n",
+	    md_rd(qmp, box), md_rd(apcs, MD_APCS_IPC));
+	MD_SAY("POLARIS MODEM: 0302 VERDICT: %s\n", took
+	    ? "THE AOP TOOK OUR MESSAGE: the QMP path works both ways and "
+	    "W2b may ask for modem on"
+	    : "THE MAILBOX IS OPEN BUT THE MESSAGE PATH IS NOT: the AOP "
+	    "never cleared the length");
+	MD_SAY("POLARIS MODEM: phase S done: no modem register was read or "
+	    "written; only the AOSS mailbox and the APCS doorbell\n");
+}
+
+static void
+md_qmp_message_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	md_qmp_message_probe();
+	MD_SAY("POLARIS MODEM: the QMP message thread returned\n");
+}
+
+/*
  * Level 2 stops after the GCC block: every register there belongs to a
  * controller that is never powered down, and the GPU probe already read five of
  * them in this same boot, so that phase is the one that cannot hurt.
