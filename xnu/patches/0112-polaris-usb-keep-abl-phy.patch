+ * ABL runs this port at high speed for fastboot, so the PHY it hands over is
+ * a known-good one and the driver's only job is not to spoil it. The two DSTS
+ * reads are there to settle the question 0109 raised: if the core really is
+ * clocked by the PHY, DSTS at least has to be able to change. Reads only.
+ */
+static void
+ud_cfg_abl_phy(void)
+{
+	uint32_t d1, d2;
+
+	ud_phy_state("A-in");
+	d1 = dwc_rd(DSTS);
+	ud_sleep_ms(120);
+	d2 = dwc_rd(DSTS);
+	printf("SWEET USB:   DSTS 0x%08x then 0x%08x (%s)\n", d1, d2,
+	    d1 == d2 ? "identical" : "CHANGED");
+}
+
+/*
+ * Attempt B: put back the exact byte ABL was running with.
+ *
+ * This is the controlled version of attempt A's premise. If clear bit 0 is
+ * what killed the lock, then setting it again has to bring the lock back -
+ * and the log will show whether it does.
+ */
+static void
+ud_cfg_pd23(void)
+{
+	vm_offset_t phy = ml_io_map(QUSB2_PA, QUSB2_SIZE);
+
+	if (phy == 0) {
+		return;
+	}
+	qusb2_wr(phy, QUSB2_PORT_POWERDOWN, 0x23);
+	ud_sleep_ms(30);
+	ud_phy_state("B-out");
+}
+
+/*
+ * Attempts C and D: the DT table, correctly, then the efuse TUNE1.
+ *
+ * 0x57 is not a guess. The stock kernel on this same board prints
+ * "qusb_phy_init(): Programming TUNE1 parameter as:57" and
+ * "Programming pll_bias parameter as:0", so those are the values a working
+ * boot uses. The table's own TUNE1 is 0x20 and ABL runs with 0x72; the
+ * sequence writes 0x57 and then, for D, the port power byte is 0x23 instead
+ * of the table's 0x22.
+ */
+static void
+ud_phy_table(uint32_t powerdown)
+{
+	vm_offset_t phy = ml_io_map(QUSB2_PA, QUSB2_SIZE);
+	unsigned i;
+
+	if (phy == 0) {
+		return;
+	}
+	for (i = 0; i < sizeof(qusb2_init_seq) / sizeof(qusb2_init_seq[0]); i++) {
+		qusb2_wr(phy, qusb2_init_seq[i].off, qusb2_init_seq[i].val);
+	}
+	qusb2_wr(phy, QUSB2_PORT_TUNE1, 0x57);
+	qusb2_wr(phy, 0x230, 0x00);             /* pll_bias, as the stock kernel */
+	qusb2_wr(phy, QUSB2_PORT_POWERDOWN, powerdown);
+	ud_sleep_ms(40);
+	ud_phy_state(powerdown == 0x23 ? "D-out" : "C-out");
+}
+
+static void
+ud_cfg_table57(void)
+{
+	ud_phy_table(0x22);
+}
+
+static void
+ud_cfg_table57pd(void)
+{
+	ud_phy_table(0x23);
 }
 
