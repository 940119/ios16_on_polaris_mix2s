+/* ---- 0316: the AP side of the handshake, written before the Q6 starts ---
+ * 0167 proved pw_make_item() works on this phone.  That allocator is
+ * UNLOCKED, so it is only safe while no other processor is allocating in
+ * the same partition -- hence md_smem_prepare() runs at the top of
+ * md_w2e_probe(), before W2e writes BOOT_CORE_START.  dipper takes a SMEM
+ * spinlock here (lock_take/lock_give) which this kernel does not have.
+ *
+ * Order matters: the 16-byte entry is written whole, its data is zeroed,
+ * and only THEN is free_uncached advanced.  The mark is what the other side
+ * watches, so it must never point at a half-written entry.  Every poke has
+ * its own dsb sy, so no store can be reordered past the mark.
+ * ------------------------------------------------------------------------- */
+static void
+md_smem_poke(uint32_t at, uint32_t value)
+{
+	if (md_smem_va == NULL || at > MD_SMEM_SIZE ||
+	    sizeof(value) > MD_SMEM_SIZE - at || (at & 3u) != 0) {
+		return;
+	}
+	*(volatile uint32_t *)(md_smem_va + at) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* Find the partition shared by hosts a and b, checking its $PRT. */
+static uint32_t
+md_smem_partition_of(uint16_t a, uint16_t b, uint32_t *cacheline, uint32_t *size)
+{
+	struct md_smem_toc toc;
+	struct md_smem_toc_entry e;
+	struct md_smem_part h;
+	uint32_t i;
+
+	if (!md_smem_toc(&toc)) {
+		return 0;
+	}
+	for (i = 0; i < toc.count; i++) {
+		if (!md_smem_toc_entry(&toc, i, &e)) {
+			break;
+		}
+		if (e.offset == 0 || e.size == 0 || e.size > MD_SMEM_TOC_AT ||
+		    e.offset > MD_SMEM_TOC_AT - e.size) {
+			continue;
+		}
+		if (!((e.host0 == a && e.host1 == b) ||
+		    (e.host0 == b && e.host1 == a))) {
+			continue;
+		}
+		if (!md_smem_peek(e.offset, &h, sizeof(h)) || !md_smem_prt(h.magic)) {
+			continue;
+		}
+		*cacheline = e.cacheline;
+		*size = e.size;
+		return e.offset;
+	}
+	return 0;
+}
+
+/* qcom_smem_alloc_private(), unlocked: make one zeroed item, or reuse it. */
+static bool
+md_smem_make_item(uint32_t part, uint32_t psize, uint32_t item,
+    uint32_t size, uint32_t *data_at)
+{
+	struct md_smem_part header;
+	struct md_smem_item entry;
+	uint32_t at, need, off;
+
+	*data_at = 0;
+	if ((size & 7u) != 0) {
+		MD_SAY("POLARIS MODEM:   0316: item %u: %u bytes is not a "
+		    "multiple of 8; nothing written\n", item, size);
+		return false;
+	}
+	need = (uint32_t)sizeof(entry) + size;
+	if (!md_smem_peek(part, &header, sizeof(header))) {
+		return false;
+	}
+	if (header.free_uncached > header.free_cached ||
+	    header.free_cached > header.size || header.size > psize) {
+		MD_SAY("POLARIS MODEM:   0316: item %u: bad marks (free %u/%u "
+		    "of %u, table says %u); nothing written\n", item,
+		    header.free_uncached, header.free_cached, header.size, psize);
+		return false;
+	}
+	for (at = (uint32_t)sizeof(header); at < header.free_uncached;) {
+		if (!md_smem_peek(part + at, &entry, sizeof(entry)) ||
+		    entry.canary != MD_SMEM_CANARY || entry.size > header.size) {
+			break;
+		}
+		if (entry.item == item) {
+			*data_at = part + at + (uint32_t)sizeof(entry) +
+			    entry.padding_header;
+			MD_SAY("POLARIS MODEM:   0316: item %u already there at "
+			    "%#x (%u bytes): left alone\n", item, *data_at,
+			    entry.size - entry.padding_data);
+			return true;
+		}
+		at += (uint32_t)sizeof(entry) + entry.padding_header + entry.size;
+	}
+	if (at != header.free_uncached) {
+		MD_SAY("POLARIS MODEM:   0316: item %u: entries end at +%#x but "
+		    "the mark says +%#x; nothing written\n", item, at,
+		    header.free_uncached);
+		return false;
+	}
+	if (at + need > header.free_cached) {
+		MD_SAY("POLARIS MODEM:   0316: item %u: %u bytes wanted, %u free; "
+		    "nothing written\n", item, need, header.free_cached - at);
+		return false;
+	}
+	md_smem_poke(part + at, MD_SMEM_CANARY | (item << 16));
+	md_smem_poke(part + at + 4, size);
+	md_smem_poke(part + at + 8, 0);		/* no padding either side */
+	md_smem_poke(part + at + 12, 0);
+	*data_at = part + at + (uint32_t)sizeof(entry);
+	for (off = 0; off < size; off += 4) {
+		md_smem_poke(*data_at + off, 0);
+	}
+	/* LAST: publish the entry only after it is completely there. */
+	md_smem_poke(part + (uint32_t)__offsetof(struct md_smem_part,
+	    free_uncached), at + need);
+	MD_SAY("POLARIS MODEM:   0316: item %u made at %#x, %u bytes, zeroed; "
+	    "free_uncached is now +%u\n", item, *data_at, size, at + need);
+	return true;
+}
+
+/* One 16-byte name, as four little-endian words, zero padded. */
+static void
+md_smem_put_name(uint32_t at, const char *s, uint32_t len)
+{
+	uint8_t b[16];
+	uint32_t i, w, v;
+
+	for (i = 0; i < (uint32_t)sizeof(b); i++) {
+		b[i] = 0;
+	}
+	for (i = 0; i < len && i < (uint32_t)sizeof(b); i++) {
+		b[i] = (uint8_t)s[i];
+	}
+	for (w = 0; w < 4; w++) {
+		v = (uint32_t)b[4 * w] | (uint32_t)b[4 * w + 1] << 8 |
+		    (uint32_t)b[4 * w + 2] << 16 | (uint32_t)b[4 * w + 3] << 24;
+		md_smem_poke(at + 4 * w, v);
+	}
+}
+
+/* dipper smp2p_fill() mi8_rproc.c:578-599: version is written LAST to make
+ * the item valid, so the modem never sees a half-filled SMP2P header. */
+static void
+md_smem_fill_ours(uint32_t at)
+{
+	uint32_t off;
+
+	for (off = 0; off < (uint32_t)sizeof(struct md_smp2p); off += 4) {
+		md_smem_poke(at + off, 0);
+	}
+	md_smem_poke(at, MD_SMP2P_MAGIC);
+	/* local = AP (0), remote = modem (1), in the one 32-bit word at +8 */
+	md_smem_poke(at + MD_SMP2P_AT_PROCESSORS,
+	    MD_SMEM_HOST_AP | (MD_SMEM_HOST_MODEM << 16));
+	md_smem_put_name(at + MD_SMP2P_AT_NAME(0), "master-kernel", 13u);
+	md_smem_put_name(at + MD_SMP2P_AT_NAME(1), "ipa-ap-to-modem", 15u);
+	md_smem_poke(at + MD_SMP2P_AT_COUNTS, 16u | (2u << 16));
+	md_smem_poke(at + MD_SMP2P_AT_FLAGS, 0);
+	md_smem_poke(at + MD_SMP2P_AT_VERSION, MD_SMP2P_RESTART_ACKS << 8);
+	md_smem_poke(at + MD_SMP2P_AT_VERSION,
+	    (MD_SMP2P_RESTART_ACKS << 8) | MD_SMP2P_VERSION);
+	MD_SAY("POLARIS MODEM:   0316: item 428 filled: magic %#x, "
+	    "version %#x, total 16 valid 2, master-kernel + ipa-ap-to-modem\n",
+	    MD_SMP2P_MAGIC, (MD_SMP2P_RESTART_ACKS << 8) | MD_SMP2P_VERSION);
+}
+
+/* modem_watch() rings this before waiting for the modem to say it is up. */
+static void
+md_smem_ring(void)
+{
+	static vm_offset_t apcs;
+
+	if (apcs == 0) {
+		apcs = ml_io_map((vm_offset_t)MD_APCS_PHYS, 0x1000);
+	}
+	if (apcs == 0) {
+		MD_SAY("POLARIS MODEM:   0316: no APCS map, doorbell NOT rung\n");
+		return;
+	}
+	*(volatile uint32_t *)(apcs + MD_APCS_IPC) = MD_IPC_SMP2P_MODEM;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	MD_SAY("POLARIS MODEM:   0316: SMP2P modem doorbell rung "
+	    "(APCS %#x + %#x = %#x)\n", (uint32_t)MD_APCS_PHYS,
+	    MD_APCS_IPC, MD_IPC_SMP2P_MODEM);
+}
+
+/* Called at the top of md_w2e_probe(), Q6 still in reset, no other writer. */
+static void
+md_smem_prepare(void)
+{
+	uint32_t cl = 0, psize = 0, part;
+	uint32_t at428 = 0, at478 = 0, at479 = 0;
+	bool ok428, ok478, ok479;
+
+	MD_SAY("POLARIS MODEM:   0316 pre-Q6 SMEM prepare: AP side "
+	    "428 / 478 / 479 (dipper mi8_rproc.c:3294)\n");
+	part = md_smem_partition_of(MD_SMEM_HOST_AP, MD_SMEM_HOST_MODEM,
+	    &cl, &psize);
+	if (part == 0) {
+		MD_SAY("POLARIS MODEM:   0316: no ap <-> modem partition; "
+		    "NOTHING was written\n");
+		return;
+	}
+	MD_SAY("POLARIS MODEM:   0316: ap <-> modem partition at %#x, "
+	    "%u bytes, cacheline %u\n", part, psize, cl);
+	ok428 = md_smem_make_item(part, psize, MD_SMEM_ITEM_MSS_AP,
+	    (uint32_t)((sizeof(struct md_smp2p) + 7u) & ~7u), &at428);
+	if (ok428 && at428 != 0) {
+		md_smem_fill_ours(at428);
+	}
+	ok478 = md_smem_make_item(part, psize, MD_SMEM_ITEM_GLINK_DESC,
+	    MD_GLINK_DESC_SIZE, &at478);
+	ok479 = md_smem_make_item(part, psize, MD_SMEM_ITEM_GLINK_FIFO,
+	    MD_GLINK_FIFO_SIZE, &at479);
+	MD_SAY("POLARIS MODEM:   0316 pre-Q6 prepare done: 428 %s (%#x), "
+	    "478 %s (%#x), 479 %s (%#x)\n", ok428 ? "ready" : "FAILED",
+	    at428, ok478 ? "ready" : "FAILED", at478,
+	    ok479 ? "ready" : "FAILED", at479);
+}
