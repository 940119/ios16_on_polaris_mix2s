+
+/*
+ * Endpoint 0 bring-up, tried in several orders because SETEPCONFIG never
+ * clears CMDACT on polaris with any single order we have tried so far:
+ *   0 - DEPSTARTCFG, SETEPCONFIG, SETTRANSFRESOURCE (what sweet does)
+ *   1 - SETTRANSFRESOURCE before SETEPCONFIG
+ *   2 - Run/Stop set before the endpoint commands at all
+ * Each attempt starts from a device soft reset so a stuck CMDACT cannot
+ * poison the next one.
+ */
+static int
+ud_bringup(unsigned strategy)
+{
+	int i;
+
+	dwc_wr(DCTL, DCTL_CSFTRST);
+	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+		delay(1000);
+	}
+	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+		printf("SWEET USB: strategy %u: soft reset stuck\n", strategy);
+		return -1;
+	}
+	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
+	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
+	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);
+	dwc_wr(GEVNTCOUNT, dwc_rd(GEVNTCOUNT) & 0xffff);
+	ud.evt_pos = 0;
+	dwc_wr(DCFG, dwc_rd(DCFG) & ~(7u | (0x7fu << 3)));
+	dwc_wr(DEVTEN, 0x7);
+	if (strategy >= 2) {
+		dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	}
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0)) {
+		printf("SWEET USB: strategy %u: DEPSTARTCFG failed\n", strategy);
+		return -1;
+	}
+	if (strategy == 1 && ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("SWEET USB: strategy %u: early XFERRES failed\n", strategy);
+		return -1;
+	}
+	if (ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3),
+	    (1u << 8) | (1u << 10) | (0u << 25), 0)) {
+		printf("SWEET USB: strategy %u: SETEPCONFIG(0) failed\n", strategy);
+		return -1;
+	}
+	if (ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("SWEET USB: strategy %u: XFERRES(0) failed\n", strategy);
+		return -1;
+	}
+	if (ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3),
+	    (1u << 8) | (1u << 10) | (1u << 25), 0)) {
+		printf("SWEET USB: strategy %u: SETEPCONFIG(1) failed\n", strategy);
+		return -1;
+	}
+	if (ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("SWEET USB: strategy %u: XFERRES(1) failed\n", strategy);
+		return -1;
+	}
+	printf("SWEET USB: strategy %u: endpoint 0 configured\n", strategy);
+	return 0;
+}
