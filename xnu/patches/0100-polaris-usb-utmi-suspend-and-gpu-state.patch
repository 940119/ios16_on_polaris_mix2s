+/*
+ * Register state probe - the part that was never done.
+ *
+ * The device tree says the Adreno 3D0 block is at 0x05000000 (0x40000), its
+ * GMU at 0x0506a000 (0x30000), the CX debug window at 0x05061000 and the GPU
+ * clock/power controller at 0x05090000 (0x9000). Nothing in this kernel has
+ * ever read one of those addresses, so "there is no GPU driver in this tree"
+ * was never the same statement as "the GPU is dead".
+ *
+ * Each window is sampled twice, 2 ms apart, and the words that changed are
+ * counted. A powered block with running counters moves; a collapsed one
+ * answers with a constant, or with 0/0xffffffff forever. That distinguishes
+ * "powered but undriven" from "not powered" without assuming that any
+ * particular register offset is correct.
+ */
+#define GPU_3D0_PA    0x05000000ull
+#define GPU_3D0_N     0x40000u
+#define GPU_GMU_PA    0x0506a000ull
+#define GPU_GMU_N     0x30000u
+#define GPU_CXDBG_PA  0x05061000ull
+#define GPU_CXDBG_N   0x800u
+#define GPU_CXMISC_PA 0x0509e000ull
+#define GPU_CXMISC_N  0x1000u
+#define GPUCC_PA      0x05090000ull
+#define GPUCC_N       0x9000u
+#define GPU_SAMPLE    16u
+
+/*
+ * The samples are spread across the window rather than taken from its first
+ * 64 bytes, because a register block's opening words are usually reserved
+ * and read back zero whether the block is alive or not. The header is
+ * printed before the first read: if one of these windows turns out to be
+ * behind a collapsed power domain, the access can stall the NoC and take the
+ * whole CPU with it, and then the last line in the ring buffer has to say
+ * which window did it.
+ */
+static void
+gpu_state_window(const char *name, uint64_t pa, uint32_t bytes)
+{
+	vm_offset_t map;
+	uint32_t first[GPU_SAMPLE];
+	uint32_t step = (bytes / GPU_SAMPLE) & ~3u;
+	uint32_t changed = 0;
+
+	map = ml_io_map(pa, bytes);
+	if (map == 0) {
+		printf("POLARIS GPU: %s map failed\n", name);
+		return;
+	}
+	printf("POLARIS GPU: %s %llx reading\n", name, pa);
+	for (unsigned int i = 0; i < GPU_SAMPLE; ++i) {
+		first[i] = *(volatile uint32_t *)(map + step * i);
+	}
+	printf("POLARIS GPU: %s:", name);
+	for (unsigned int i = 0; i < GPU_SAMPLE; ++i) {
+		printf(" +%x=%08x", step * i, first[i]);
+	}
+	printf("\n");
+
+	delay(2000);
+	for (unsigned int i = 0; i < GPU_SAMPLE; ++i) {
+		if (*(volatile uint32_t *)(map + step * i) != first[i]) {
+			changed++;
+		}
+	}
+	printf("POLARIS GPU: %s changed %u/%u words in 2 ms\n",
+	    name, changed, GPU_SAMPLE);
+}
+
+void
+polaris_gpu_state_probe(void)
+{
+	int optin = 0;
+
+	(void)PE_parse_boot_argn("polarisgpuprobe", &optin, sizeof(optin));
+	if (optin != 1) {
+		return;
+	}
+	printf("POLARIS GPU: register probe, read only\n");
+	gpu_state_window("gpucc", GPUCC_PA, GPUCC_N);
+	gpu_state_window("gpu-3d0", GPU_3D0_PA, GPU_3D0_N);
+	gpu_state_window("gpu-gmu", GPU_GMU_PA, GPU_GMU_N);
+	gpu_state_window("gpu-cxdbgc", GPU_CXDBG_PA, GPU_CXDBG_N);
+	gpu_state_window("gpu-cxmisc", GPU_CXMISC_PA, GPU_CXMISC_N);
+	printf("POLARIS GPU: probe done\n");
+}
 #endif
