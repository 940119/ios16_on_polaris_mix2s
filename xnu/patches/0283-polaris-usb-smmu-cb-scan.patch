 		    usb_rd(ud.dwc, 0xc134), usb_rd(ud.dwc, 0xc130),
 		    usb_rd(ud.dwc, 0xc118), ud.dma_pa);
 		ud_flush();
+		ud_smmu_cb_probe();
 	}
 
