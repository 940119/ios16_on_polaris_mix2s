+/*
+ * 0283: the context banks, and the only way left to talk to the S2CRs.
+ *
+ * 0282 settled half the question and left the other half open:
+ *
+ *   0282 pre-prime  SMMU sGFSR 0x00000000 SYNR0 0 SYNR1 0
+ *   0282 post-prime SMMU sGFSR 0x00000000 SYNR0 0 SYNR1 0
+ *   0278 GBUSERRADDR 0x00000000c0001000 GSTS 0x7e800010
+ *
+ * sCR0 has USFCFG 1, GFRE 1 and GFIE 1, so an *unassigned* StreamID would have
+ * latched sGFSR.USF with the SID in sGFSYNR1. It did not. That rules out the
+ * "no matching SMR" branch of the hypothesis - but not the SMMU itself: a fault
+ * raised inside a context bank lands in that bank's FSR/FAR, not in sGFSR. So
+ * the SMMU is either translating SID 0x740 with a stale table and faulting, or
+ * it is not in the path at all and XPU/NoC refused the transfer.
+ *
+ * Those two are told apart by one register read, if the register can be
+ * reached. Where GR1 lives is not a guess: the downstream qsmmu-v500 driver
+ * (MiCode/Xiaomi_Kernel_OpenSource, polaris-o-oss, drivers/iommu/arm-smmu.c)
+ * derives it from the DT resource itself:
+ *
+ *   #define ARM_SMMU_CB_BASE(smmu)  ((smmu)->base + ((smmu)->size >> 1))
+ *   #define ARM_SMMU_CB(smmu, n)    ((n) * (1 << (smmu)->pgshift))
+ *   #define ARM_SMMU_CB_FSR         0x58
+ *   #define ARM_SMMU_CB_FAR         0x60
+ *   #define ARM_SMMU_CB_FSYNR0      0x68
+ *
+ * reg = <0x15000000 0x80000> so CB_BASE = 0x15040000, ID1.NUMCB = 45 and
+ * ID1.PAGESIZE = 0, i.e. pgshift 12: bank n sits at 0x15040000 + n * 0x1000.
+ * The same file also gives the encodings this build writes:
+ *
+ *   S2CR_TYPE_SHIFT 16, BYPASS = 1        S2CR_CBNDX_SHIFT 0
+ *   S2CR_SHCFG_SHIFT 8, NSH = 3           -> a Linux bypass entry is 0x00010300
+ *   FSR_FAULT = MULTI|SS|UUT|EF|PF|TF|AFF|ASF|TLBMCF|TLBLKF = 0xc00001fe
+ *
+ * Every bank index is printed *before* its FSR is read. If the ring ends on
+ * "0283 cb NN", that bank's read is what stopped the machine, which is how this
+ * build keeps a dead end informative instead of just dead.
+ *
+ * The bypass write is gated twice: it runs when a bank actually latched a fault,
+ * or when sweetusbsmmu=2 asks for it anyway. It has to write the *whole* S2CR
+ * array because the index that matters is the SMR group SID 0x740 matches, and
+ * reading the SMR array is the access that killed 0281. Writing every entry is
+ * the only move that does not need to know the index - and on a bring-up kernel
+ * with nothing else behind this SMMU it is also the state the hardware wants:
+ * qcom,smmu-s1-bypass.
+ */
+#define APPS_SMMU_CB_PA		0x15040000
+#define APPS_SMMU_CB_SIZE	0x2d000
+#define SMMU_CB_STRIDE		0x1000
+#define SMMU_CB_SCTLR		0x000
+#define SMMU_CB_TTBR0		0x020
+#define SMMU_CB_FSR		0x058
+#define SMMU_CB_FAR		0x060
+#define SMMU_CB_FSYNR0		0x068
+#define SMMU_FSR_FAULT		0xc00001feu
+#define SMMU_S2CR_BYPASS	0x00010300u
+#define SMMU_NUM_SMR		76
+#define SMMU_NUM_CB		45
+
+static void
+ud_smmu_cb_probe(void)
+{
+	int mode = 1;
+	PE_parse_boot_argn("sweetusbsmmu", &mode, sizeof(mode));
+
+	vm_offset_t cb = ml_io_map(APPS_SMMU_CB_PA, APPS_SMMU_CB_SIZE);
+	if (cb == 0) {
+		printf("SWEET USB: 0283 CB window map failed\n");
+		ud_flush();
+		return;
+	}
+	printf("SWEET USB: 0283 CB scan: base 0x%x %u banks stride 0x%x\n",
+	    (unsigned)APPS_SMMU_CB_PA, SMMU_NUM_CB, SMMU_CB_STRIDE);
+	ud_flush();
+
+	int guilty = -1;
+	uint32_t guilty_fsr = 0;
+
+	for (unsigned n = 0; n < SMMU_NUM_CB; n++) {
+		uint32_t off = n * SMMU_CB_STRIDE;
+		uint32_t fsr;
+
+		/* Before the read, on purpose: see the comment above. */
+		printf("SWEET USB: 0283 cb %02u\n", n);
+		ud_flush();
+		fsr = usb_rd(cb, off + SMMU_CB_FSR);
+		if (fsr == 0 || fsr == 0xffffffffu) {
+			continue;
+		}
+		printf("SWEET USB: 0283 cb %02u fsr 0x%08x far 0x%08x "
+		    "fsynr0 0x%08x sctlr 0x%08x ttbr0 0x%08x\n",
+		    n, fsr, usb_rd(cb, off + SMMU_CB_FAR),
+		    usb_rd(cb, off + SMMU_CB_FSYNR0),
+		    usb_rd(cb, off + SMMU_CB_SCTLR),
+		    usb_rd(cb, off + SMMU_CB_TTBR0));
+		ud_flush();
+		if ((fsr & SMMU_FSR_FAULT) != 0 && guilty < 0) {
+			guilty = (int)n;
+			guilty_fsr = fsr;
+		}
+	}
+	printf("SWEET USB: 0283 CB scan done, first faulting bank %d\n", guilty);
+	ud_flush();
+
+	if (guilty < 0 && mode != 2) {
+		printf("SWEET USB: 0283 no bank latched a fault: the SMMU did not "
+		    "terminate that transfer, XPU/NoC did\n");
+		ud_flush();
+		return;
+	}
+
+	vm_offset_t gr0 = ml_io_map(APPS_SMMU_PA, APPS_SMMU_SIZE);
+	if (gr0 == 0) {
+		printf("SWEET USB: 0283 GR0 remap failed\n");
+		ud_flush();
+		return;
+	}
+	printf("SWEET USB: 0283 writing S2CR[0..%u] = 0x%08x\n",
+	    (unsigned)(SMMU_NUM_SMR - 1), SMMU_S2CR_BYPASS);
+	ud_flush();
+	for (unsigned i = 0; i < SMMU_NUM_SMR; i++) {
+		usb_wr(gr0, SMMU_GR0_S2CR(i), SMMU_S2CR_BYPASS);
+	}
+	printf("SWEET USB: 0283 S2CR readback %08x %08x %08x\n",
+	    usb_rd(gr0, SMMU_GR0_S2CR(0)), usb_rd(gr0, SMMU_GR0_S2CR(1)),
+	    usb_rd(gr0, SMMU_GR0_S2CR((unsigned)(SMMU_NUM_SMR - 1))));
+	ud_flush();
+
+	if (guilty >= 0) {
+		/* W1C, so a latched fault does not keep the combined interrupt
+		 * line asserted for a handler that does not exist. */
+		usb_wr(cb, guilty * SMMU_CB_STRIDE + SMMU_CB_FSR, guilty_fsr);
+		printf("SWEET USB: 0283 cb %d fsr cleared, reads 0x%08x\n", guilty,
+		    usb_rd(cb, guilty * SMMU_CB_STRIDE + SMMU_CB_FSR));
+		ud_flush();
+	}
+
+	printf("SWEET USB: 0283 re-priming ep0 with the SMMU bypassed\n");
+	ud_flush();
+	ud_start_setup();
+	printf("SWEET USB: 0283 after re-prime GSTS 0x%08x GBUSERRADDR 0x%08x%08x "
+	    "GEVNTCOUNT 0x%08x\n", dwc_rd(GSTS), usb_rd(ud.dwc, 0xc134),
+	    usb_rd(ud.dwc, 0xc130), dwc_rd(GEVNTCOUNT));
+	ud_flush();
+}
+
