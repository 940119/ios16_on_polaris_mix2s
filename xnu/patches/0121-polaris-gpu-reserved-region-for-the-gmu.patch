--- a/bsd/dev/polaris_gpu.c
+++ b/bsd/dev/polaris_gpu.c
@@ -881,15 +881,36 @@
  * The GMU's boot configuration carries the addresses of its regions in 32-bit
  * registers, so a region above 4 GB is not addressable at all: the register
  * would keep the low half and the firmware would read somewhere else. This
- * phone has 6 GB, and the first attempt at this step landed at 0x1_035a0000.
+ * phone has 6 GB - two DRAM windows, 0x80000000+4 GB and 0x180000000+ - and the
+ * allocator hands out the second one first: the first attempt at this step
+ * landed at 0x1_035a0000.
  *
- * kmem_alloc_contig() reads its fifth argument as "no bit of the physical
- * address may be in this mask", so naming the upper half of the address keeps
- * any allocation below the boundary. Passing the limit through max_pnum
- * instead (the sixth argument) does not: it made the allocation fail outright.
+ * kmem_alloc_contig() is declared in <vm/vm_kern.h> as
+ *
+ *     (map, addrp, size, mask, max_pnum, pnum_mask, flags, tag)
+ *
+ * where mask is the *address* alignment and max_pnum is the highest page
+ * number the allocation may use. An earlier attempt put the 4 GB limit in the
+ * fifth slot as a bit mask; ppnum_t is 32 bits, so it arrived as zero and the
+ * allocation came back above the boundary exactly as before. The limit
+ * belongs in max_pnum: 4 GB / 4 KB - 1.
  */
 #define PG_ADDRESS_LIMIT	0x100000000ull
-#define PG_NO_HIGH_BITS		0xffffffff00000000ull
+#define PG_MAX_PAGE_BELOW_4G	0xfffffu	/* the last page number wholly below 4 GB */
+
+/*
+ * Even asked that way the allocator has nothing to give: four adjacent pages
+ * low in the first DRAM window are all taken by the time this probe runs, so
+ * the request comes back KERN_RESOURCE_SHORTAGE at once. The last resort is
+ * memory the boot loader already reserved below the boundary and that nothing
+ * in this kernel ever touches: the IPS firmware region, 64 KB at 0x8c400000.
+ * The device tree marks it no-map, so the VM does not manage those pages and
+ * cannot hand them to anyone else, and IPS firmware belongs to the modem and
+ * IPA subsystems, which this kernel never starts. Its two 16 KB halves hold
+ * the log and the HFI queue table.
+ */
+#define PG_RESERVED_PHYS	0x8c400000ull
+#define PG_RESERVED_REGIONS	2u
 
 struct pg_hfi_table {
 	uint32_t version, size, qhdr0_offset, qhdr_size, num_queues, active_queues;
@@ -902,6 +923,7 @@
 
 static vm_offset_t pg_log_va, pg_hfi_va;
 static uint64_t pg_log_pa, pg_hfi_pa;
+static unsigned pg_region_count;		/* 0 while neither region exists */
 static bool pg_boot_configured;
 static uint32_t pg_old_ao_mask, pg_old_h2h_mask;
 static bool pg_masks_saved;
@@ -916,37 +938,62 @@
 	__asm__ volatile ("dsb sy" ::: "memory");
 }
 
+/* A reserved region is not zeroed for us and is mapped uncached, so the stores
+ * go straight to memory; the allocator's pages arrive zeroed already. */
+static void
+pg_zero(vm_offset_t start, vm_size_t size)
+{
+	volatile uint32_t *p = (volatile uint32_t *)start;
+
+	for (vm_size_t i = 0; i < size / 4; i++) {
+		p[i] = 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
 static bool
 pg_gmu_region(vm_offset_t *va, uint64_t *pa)
 {
-	static const vm_offset_t masks[2] = { PG_NO_HIGH_BITS, 0 };
+	unsigned index = pg_region_count;
 
 	if (*va != 0) {
 		return true;
 	}
-	for (unsigned m = 0; m < 2; m++) {
-		for (int attempt = 0; attempt < 3; attempt++) {
-			if (kmem_alloc_contig(kernel_map, va, PG_GMU_REGION_SIZE,
-			    PG_GMU_REGION_SIZE - 1, masks[m], 0,
-			    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
-				*va = 0;
-				printf("POLARIS GPU: 10 no allocation with address mask %#llx\n",
-				    (uint64_t)masks[m]);
-				break;		/* the next mask may do better */
-			}
-			*pa = kvtophys(*va);
-			if (*pa != 0 && *pa + PG_GMU_REGION_SIZE <= PG_ADDRESS_LIMIT) {
-				if (m != 0) {
-					printf("POLARIS GPU: 10 the region only came back below 4 GB "
-					    "on attempt %d without the mask\n", attempt + 1);
-				}
-				return true;
-			}
-			printf("POLARIS GPU: 10 that region came back at %#llx, above the 32-bit "
-			    "boundary the firmware can address: given back\n", *pa);
-			kmem_free(kernel_map, *va, PG_GMU_REGION_SIZE);
+	/* the kernel's own pages first: page aligned is all the firmware needs */
+	for (int attempt = 0; attempt < 4; attempt++) {
+		if (kmem_alloc_contig(kernel_map, va, PG_GMU_REGION_SIZE, PAGE_MASK,
+		    PG_MAX_PAGE_BELOW_4G, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
 			*va = 0;
+			printf("POLARIS GPU: 10 the allocator has no 16 KB below 4 GB (attempt %d)\n",
+			    attempt + 1);
+			break;		/* the reserved region may still do */
 		}
+		*pa = kvtophys(*va);
+		if (*pa != 0 && *pa + PG_GMU_REGION_SIZE <= PG_ADDRESS_LIMIT) {
+			printf("POLARIS GPU: 10 region %u from the allocator: %#llx\n", index, *pa);
+			pg_region_count = index + 1;
+			return true;
+		}
+		printf("POLARIS GPU: 10 that region came back at %#llx, above the 32-bit "
+		    "boundary the firmware can address: given back\n", *pa);
+		kmem_free(kernel_map, *va, PG_GMU_REGION_SIZE);
+		*va = 0;
+	}
+	if (index < PG_RESERVED_REGIONS) {
+		uint64_t phys = PG_RESERVED_PHYS + (uint64_t)index * PG_GMU_REGION_SIZE;
+		vm_offset_t mapped = ml_io_map((vm_offset_t)phys, PG_GMU_REGION_SIZE);
+
+		if (mapped != 0) {
+			*va = mapped;
+			*pa = phys;
+			pg_zero(mapped, PG_GMU_REGION_SIZE);
+			printf("POLARIS GPU: 10 region %u from the reserved IPS firmware memory "
+			    "at %#llx instead, mapped uncached\n", index, phys);
+			pg_region_count = index + 1;
+			return true;
+		}
+		printf("POLARIS GPU: 10 the reserved region at %#llx could not be mapped\n", phys);
 	}
 	return false;
 }
