+
+/* 0328: minimal QMI response to the two host-service requests the modem
+ * began sending in 0327.  dipper receive():360-390, rmtfs():221-249
+ * (R_OPEN = msg 1, TLV 0x10 len4 = handle id), pdm():320-341 (msg 0x21,
+ * TLV 0x10 total / 0x11 / 0x12 domain list).  QMI is byte-packed, so
+ * build it in a byte array and pack little-endian into QRTR words.
+ * Returns the new tx head. */
+static uint32_t
+md_hostsvc_reply(uint32_t head, uint32_t our_port, uint32_t their_port,
+    uint32_t req_at, uint32_t req_len, uint32_t slot)
+{
+        uint8_t rsp[40];
+        uint32_t pkt[16];
+        uint32_t i, n = 0u, tlv_len, chunk, frame;
+        uint32_t iid = 0u, isize = 0u, at = head;
+        uint16_t msg;
+
+        if (req_len < 7u || md_smem_byte(req_at) != 0u) {
+                return head;                    /* only answer requests */
+        }
+        msg = (uint16_t)(md_smem_byte(req_at + 3u) |
+            ((uint16_t)md_smem_byte(req_at + 4u) << 8));
+        if (msg == 1u && our_port == MD_HOSTSVC_PORT0) {
+                n = 21u;                        /* RMTFS R_OPEN */
+        } else if (msg == 0x21u && our_port == MD_HOSTSVC_PORT2) {
+                n = 28u;                        /* PDM empty domain list */
+        } else {
+                return head;                    /* not ours (e.g. 0x4000) */
+        }
+        for (i = 0u; i < sizeof(rsp); i++) {
+                rsp[i] = 0u;
+        }
+        rsp[0] = 2u;                           /* QMI response */
+        for (i = 1u; i < 5u; i++) {
+                rsp[i] = md_smem_byte(req_at + i);   /* txn + msg echoed */
+        }
+        tlv_len = n - 7u;
+        rsp[5] = (uint8_t)(tlv_len & 0xffu);
+        rsp[6] = (uint8_t)(tlv_len >> 8);
+        rsp[7] = 0x02u;                        /* TLV 0x02 result */
+        rsp[8] = 4u; rsp[9] = 0u;
+        rsp[10] = 0u; rsp[11] = 0u; rsp[12] = 0u; rsp[13] = 0u;
+        if (msg == 1u) {
+                /* TLV 0x10 len 4 = handle id 1 (rmtfs():248). */
+                rsp[14] = 0x10u; rsp[15] = 4u; rsp[16] = 0u;
+                rsp[17] = 1u; rsp[18] = 0u; rsp[19] = 0u; rsp[20] = 0u;
+        } else {
+                /* pdm():327-341 -- "tms/pddump_disabled" matches no
+                 * sdm845 domain, so total=0 and the list is empty. */
+                rsp[14] = 0x10u; rsp[15] = 2u; rsp[16] = 0u;
+                rsp[17] = 0u; rsp[18] = 0u;
+                rsp[19] = 0x11u; rsp[20] = 2u; rsp[21] = 0u;
+                rsp[22] = 1u; rsp[23] = 0u;
+                rsp[24] = 0x12u; rsp[25] = 1u; rsp[26] = 0u;
+                rsp[27] = 0u;
+        }
+        pkt[0] = 1u;                           /* QRTR version */
+        pkt[1] = MD_QRTR_Q_DATA;               /* type Q_DATA */
+        pkt[2] = MD_QRTR_LOCAL_NODE;           /* 1 */
+        pkt[3] = our_port;                     /* from our service port */
+        pkt[4] = 0u;                           /* confirm_rx */
+        pkt[5] = n;                            /* RAW QMI length */
+        pkt[6] = 0u;                           /* dst node = modem */
+        pkt[7] = their_port;                   /* dst port = requester */
+        for (i = 8u; i < 16u; i++) {
+                pkt[i] = 0u;
+        }
+        for (i = 0u; i < n; i++) {
+                pkt[8u + i / 4u] |= (uint32_t)rsp[i] << (8u * (i % 4u));
+        }
+        chunk = 32u + ((n + 3u) & ~3u);
+        frame = (16u + chunk + 7u) & ~7u;
+        for (i = (slot < md_foreign_count ? slot : 0u);
+             i < md_foreign_count; i++) {
+                if (md_foreign_size[i] >= chunk &&
+                    md_foreign_id[i] != 0u) {
+                        iid = md_foreign_id[i];
+                        isize = md_foreign_size[i];
+                        break;
+                }
+        }
+        if (iid == 0u || head + frame > MD_GLINK_FIFO_SIZE) {
+                MD_SAY("POLARIS MODEM: 0328 VERDICT: reply NOT sent "
+                    "(slot %u, foreign %u, head %u, frame %u)\n",
+                    slot, md_foreign_count, head, frame);
+                return head;
+        }
+        md_smem_poke(md_glink_tx_at + at,
+            MD_GLINK_DATA | (MD_GLINK_CID << 16));
+        md_smem_poke(md_glink_tx_at + at + 4u, iid);
+        md_smem_poke(md_glink_tx_at + at + 8u, chunk);
+        md_smem_poke(md_glink_tx_at + at + 12u, 0u);
+        for (i = 0u; i < chunk / 4u; i++) {
+                md_smem_poke(md_glink_tx_at + at + 16u + 4u * i, pkt[i]);
+        }
+        if (frame > 16u + chunk) {
+                md_smem_poke(md_glink_tx_at + at + 16u + chunk, 0u);
+        }
+        MD_SAY("POLARIS MODEM: 0328 VERDICT: QMI REPLY msg %#x "
+            "port %#x -> node 0 port %u, %u QMI bytes, %s, "
+            "cid %u slot %u intent %u size %u, chunk %u frame %u, "
+            "tx head %u -> %u\n", msg, our_port, their_port, n,
+            msg == 1u ? "RMTFS R_OPEN" : "PDM 0x21", MD_GLINK_CID,
+            slot, iid, isize, chunk, frame, head, head + frame);
+        return head + frame;
+}
