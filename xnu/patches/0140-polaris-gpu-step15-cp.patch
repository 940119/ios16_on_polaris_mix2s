+/*
+ * Which level 3 table owns an address. Two 2 MB windows are wired up: the one
+ * the GMU's queues live in (0x60000000) and the one the CP's microcode and ring
+ * live in (0x10000000). Anything else has no table and must not be mapped -
+ * a wrong slot here would silently rewrite another window's descriptors.
+ */
+static vm_offset_t
+pg_smmu_l3(uint64_t iova)
+{
+	uint32_t l2 = (uint32_t)((iova >> 21) & 0x1ff);
+
+	if (l2 == (uint32_t)((PG_GMU_IOVA_BASE >> 21) & 0x1ff)) {
+		return pg_l3_va;
+	}
+	if (l2 == PG_CP_WINDOW_L2) {
+		return pg_l3b_va;
+	}
+	return 0;
 }
 
