+	 * 0262: enable the endpoint events before the core is allowed to answer
+	 * anything. Two endpoints exist (ep0 in/out and ep1 in), and both need
+	 * their bit or their completions never reach the event ring.
+	 */
+	dwc_wr(DEPEVTENA, DEPEVTENA_EP(0) | DEPEVTENA_EP(1));
+	/*
