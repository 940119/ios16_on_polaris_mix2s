+/*
+ * 0262: the endpoint event enable, which this driver had never written.
+ *
+ * DEVTEN (0xc708) carries the *device-level* events - disconnect, USB reset,
+ * connect-done. The events that matter for a control transfer are endpoint
+ * events: XferComplete, XferNotReady. Those are gated by DEPEVTENA (0xc718),
+ * one bit per endpoint, and with it zero the core queues nothing when the host
+ * sends GET_DESCRIPTOR - so ep0 never answers and Windows says "unknown USB
+ * device" on a link that is electrically fine.
+ */
+#define DEPEVTENA       0xc718
+#define DEPEVTENA_EP(n) (1u << (n))
 #define DSTS            0xc70c
 #define DALEPENA        0xc720
 #define DEPCMDPAR2(n)   (0xc800 + 0x10 * (n))
@@ -1756,6 +1769,12 @@
