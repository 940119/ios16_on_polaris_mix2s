+#define PG_GPU3D_SIZE		0x00040000u
+
+#define PG_INIT_ADDRESS_BEGIN		0
+#define PG_INIT_ADDRESS_END		11
+#define PG_INIT_HWCG_BEGIN		11
+#define PG_INIT_HWCG_END		116
+#define PG_INIT_HWCG_COMMIT_BEGIN	116
