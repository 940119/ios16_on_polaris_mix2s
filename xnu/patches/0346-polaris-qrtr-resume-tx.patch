+/* 0346: dipper's qrtr_input() answers confirm_rx with Q_RESUME
+ * (RESUME_TX, type 7), not a zero-length Q_DATA; dipper drops size==0.
+ * control(g, Q_RESUME, dp, sn, sp, dn, dp, 0, 0) is reproduced here. */
+static uint32_t
+md_qrtr_resume(uint32_t head, uint32_t our_port, uint32_t their_port,
+    uint32_t dn, uint32_t dp, uint32_t slot)
+{
+	uint32_t pkt[16];
+	uint32_t i, chunk, frame, iid = 0u, isize = 0u;
+	uint32_t at = head;
+
+	for (i = 0u; i < sizeof(pkt) / sizeof(pkt[0]); i++) {
+		pkt[i] = 0u;
+	}
+	pkt[0] = 1u;                 /* version */
+	pkt[1] = 7u;                 /* Q_RESUME / RESUME_TX */
+	pkt[2] = MD_QRTR_LOCAL_NODE;
+	pkt[3] = our_port;           /* dipper: from = dp */
+	pkt[4] = 0u;                 /* confirm_rx */
+	pkt[5] = 20u;                /* control payload */
+	pkt[6] = 0u;                 /* dst node = sn = modem */
+	pkt[7] = their_port;         /* dst port = sp */
+	pkt[8] = 7u;                 /* payload: command */
+	pkt[9] = dn;                 /* payload: dn */
+	pkt[10] = dp;                /* payload: dp */
+	pkt[11] = 0u;
+	pkt[12] = 0u;
+	chunk = 32u + 20u;           /* 52 */
+	frame = (16u + chunk + 7u) & ~7u;
+	for (i = (slot < md_foreign_count ? slot : 0u);
+	     i < md_foreign_count; i++) {
+		if (md_foreign_size[i] >= chunk &&
+		    md_foreign_id[i] != 0u) {
+			iid = md_foreign_id[i];
+			isize = md_foreign_size[i];
+			break;
+		}
+	}
+	if (iid == 0u || head + frame > MD_GLINK_FIFO_SIZE) {
+		MD_SAY("POLARIS MODEM: 0346 VERDICT: RESUME not sent "
+		    "(slot %u, head %u, frame %u)\n", slot, head, frame);
+		return head;
+	}
+	md_smem_poke(md_glink_tx_at + at,
+	    MD_GLINK_DATA | (MD_GLINK_CID << 16));
+	md_smem_poke(md_glink_tx_at + at + 4u, iid);
+	md_smem_poke(md_glink_tx_at + at + 8u, chunk);
+	md_smem_poke(md_glink_tx_at + at + 12u, 0u);
+	for (i = 0u; i < chunk / 4u; i++) {
+		md_smem_poke(md_glink_tx_at + at + 16u + 4u * i, pkt[i]);
+	}
+	if (frame > 16u + chunk) {
+		md_smem_poke(md_glink_tx_at + at + 16u + chunk, 0u);
+	}
+	MD_SAY("POLARIS MODEM: 0346 VERDICT: QRTR RESUME_TX type 7 "
+	    "port %#x -> node 0 port %u, 20 bytes, cid %u slot %u "
+	    "intent %u size %u, chunk %u frame %u, head %u -> %u\n",
+	    our_port, their_port, MD_GLINK_CID, slot, iid, isize,
+	    chunk, frame, head, head + frame);
+	return head + frame;
+}
