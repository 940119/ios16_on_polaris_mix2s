+/* ---- step 23: the shader the SP runs --------------------------------------------------------- */
+
+/*
+ * Every step before this one ends in a packet the CP understands. This one ends
+ * in a program whose meaning comes from somewhere else: thirty-two dwords of
+ * ir3, and a block of SP registers that say how to launch it. Both are the other
+ * line's, unchanged -- 0251 reduced that program to the four instructions below
+ * and derived every register value from Mesa's own a6xx.xml.h. That build
+ * submitted it, watched a wave fetch, dispatch and honour its fence, and never
+ * saw the store at word 8 commit, because on that line CP_SET_SECURE_MODE had
+ * never been able to leave secure mode.
+ *
+ * Step 21 above shows SECVID_TRUST_CNTL reading 0x1 and then 0x0 with the ring
+ * having consumed CP_SET_SECURE_MODE(0) in between. So the same program is asked
+ * again, and its store is aimed at two addresses in one boot:
+ *
+ *   memptrs + 0x300   a page the 3D core has a PTE for -- the result is readable
+ *   0x10100000        a page with no PTE, which step 20 proved faults through ATOS
+ *
+ * One program, one launch sequence, only the immediate of the first mov differs.
+ * 0x0badf00d in the result word says the wave ran and its store committed; a
+ * translation fault with FAR 0x10100000 says the wave ran and its store reached
+ * the SMMU. Either is the first evidence this phone's SP has ever produced.
+ * Both staying silent is 0251's answer again -- and after a zap that really did
+ * authenticate, that would mean secure mode was not the gate either, and the
+ * next question is the launch state itself rather than the core's trust level.
+ *
+ * B37 checked every field of that sequence against Mesa's adreno_pm4.xml and
+ * fd6_compute.cc rather than trusting 0251's transcription, and the UAV view
+ * turned out to be aimed at the shader instruction block -- see cs_launch.
+ * There is one CP_LOAD_STATE6 now, for the program.
+ */
+#define CS_PROGRAM_WORDS	64u	/* B49: two 128-byte instruction groups */
+#define CS_PROGRAM_OFF		0x100u
+#define CS_UAV_OFF		0x200u
+#define CS_RESULT_OFF		0x300u
+#define CS_FENCE_OFF		0x380u
+/* B54: CS_PVT_OFF is retired -- private memory no longer shares the memptrs
+ * page. The 0x500 offset could hold a single dword of evidence but not a
+ * 4 KB slab, and the slab would have landed on CS_RB_OFF. See the
+ * "pvtmem" entry in g3d_regions[] for the arithmetic. */
+#define CS_RB_OFF		0x600u	/* where CP_REG_TO_MEM drops the register readback */
+/*
+ * B31: nine CP-visible marker slots, three per launch.
+ *
+ * The fence is useless as a completion signal here: CP_EVENT_WRITE drops the
+ * CP's timestamp into it, and a6xx's timestamp reads zero when the RBBM timer
+ * is not running, so a zero fence cannot tell "the CP never got here" from "the
+ * CP got here and wrote a zero". B30 read zero on all three launches while the
+ * ring had drained to WPTR every time -- the same confusion as 教训 38/42 on
+ * the modem line, where RPTR == WPTR only proved the bytes were read.
+ *
+ * A CP_MEM_WRITE of a constant has no such ambiguity: either the constant is
+ * in memory or the packet never executed. Three positions per launch split the
+ * sequence at the two places it can stall.
+ */
+#define CS_MARKER_OFF		0x3c0u
+#define CS_MARKER(tag, ph)	(0xc1de0000u | ((uint32_t)(ph) << 8) | (0x41u + (uint32_t)(tag)))
+#define CS_HOLE_IOVA		0x10100000ull
+/*
+ * B37: what a ring is allowed to contain. Splitting the state from the
+ * dispatch is the reference driver's own shape -- fd6_compute.cc emits
+ * SP_CS_* and the program once into a state object, and per launch emits only
+ * CP_SET_MARKER, the grid and CP_EXEC_CS -- and it is the only shape in which
+ * "the state is wrong" can be told from "the dispatch is refused".
+ */
+#define CS_F_STATE	0x1u	/* cs_ncr + the CS block + SP_CS_BASE + the program load */
+#define CS_F_EXEC	0x2u	/* CP_SET_MARKER(RM6_COMPUTE) + the grid + CP_EXEC_CS */
+#define CS_F_HOLE	0x4u	/* move only SP_CS_BASE, to a page with no PTE */
+/*
+ * B38: B37 changed four things at once and the SP ran. These put one of the
+ * three state-level changes back, so a ring whose result word is still empty
+ * names the change that was carrying the whole thing.
+ *
+ * The fourth change -- reading the state in its own ring -- needs no flag: a
+ * ring can simply carry CS_F_STATE | CS_F_EXEC.
+ */
+#define CS_F_Q_UAV	0x8u	/* the old UAV CP_LOAD_STATE6, aimed at block 0xd again */
+#define CS_F_Q_SIZE	0x10u	/* SP_CS_INSTR_SIZE back to 32, i.e. counted in dwords */
+#define CS_F_Q_REGS	0x20u	/* SP_CS_CNTL_0's FULLREGFOOTPRINT back to 2 */
+/*
+ * B39: B38 answered the question it was built to ask, and not the way anyone
+ * expected. The same state and the same dispatch store 0badf00d when they are
+ * submitted as two rings, and do not store it when they share one -- so the
+ * split is load-bearing and the per-field rings below it were confounded by it.
+ *
+ * So the question changes. It is no longer "which state field matters" but
+ * "what does the boundary between the two rings supply". Three candidates, one
+ * packet each, all of them things the reference driver already does.
+ */
+#define CS_F_Q_WFI	0x40u	/* CP_WAIT_FOR_IDLE between the state and the dispatch */
+#define CS_F_Q_MODE	0x80u	/* CP_SET_MODE(1) at the head: whether the CP defers state */
+#define CS_F_Q_MARK	0x100u	/* RM6_COMPUTE ahead of the state, where fd6 puts it */
+/*
+ * B41: B40 showed that a one-ring launch leaves the SP unable to store for the
+ * rest of the boot, and that reloading the state does not bring it back. Whatever
+ * it breaks, it is not the context registers -- or not only them.
+ *
+ * The reference driver has a comment that names a mechanism this probe has never
+ * used. fd6_launch_grid() works around a fetch-length bug by setting the FS
+ * instruction length and then doing "a dummy event to roll the context", because
+ * the core reads the wrong register context without it. If a6xx keeps two register
+ * contexts and only rolls them at an event, then a split ring rolls one at its ring
+ * end while a combined ring never does -- which is exactly the difference B38-B40
+ * measured. The event is FD_LABEL, DEBUG_LABEL 0x3f on a6xx, one dword.
+ */
+#define CS_F_Q_ROLL	0x200u	/* CP_EVENT_WRITE(DEBUG_LABEL): roll the register context */
+#define CS_F_Q_INV	0x400u	/* CACHE_INVALIDATE between the seed write and CP_EXEC_CS */
+#define CS_F_Q_NOALU	0x800u	/* B47: patch the add.u back to a nop in this ring */
+#define CS_F_Q_NOJUMP	0x1000u	/* B51: patch slot 7's compiled jump back to a nop */
+#define CS_F_Q_NOPVT	0x2000u	/* B53: patch the ten private-path slots back to nops */
+#define CS_F_Q_WHOLE	0x4000u	/* B60: real compiled body, no private path (expected3 = 0, no slot patched) */
+#define CS_PVT_FIRST	21u	/* B53: slot of the stp */
+#define CS_PVT_LAST	30u	/* B53: slot of the stg to result[6] */
+#define CS_JUMP_IDX	7u	/* B51: slot of the real compiled cat0 jump */
+#define CS_JUMP_IMM	2u	/* B51: target = slot 7 + 2 = slot 9 */
+#define CS_ALU_IMM	0x111u	/* add.u r1.y, r1.y, 0x111 */
+#define CS_ALU_IDX	8u	/* instruction slot of the add.u (dwords 16,17) */
+#define CS_ALU2_IMM	0x222u	/* B49: the second group's add.u immediate */
+#define CS_ALU2_IDX	16u	/* B49: slot of the second group's add.u */
+#define CS_GROUPS	2u	/* B49: instrlen / NUM_UNIT, 128-byte groups */
+#define CS_WANT		0x0badf00du
+#define CS_SEED_OFF	0x340u	/* result + 0x40: B48 sentinel, NOT read by the shader */
+/*
+ * B70: the render target. 32x32 RGBA8, and the only thing the render backend
+ * has ever been asked to write. The region exists so the CPU prefill and the
+ * invalidate that follows the GPU are a pair over the same bytes -- lesson 44:
+ * cache maintenance has to move with the data.
+ */
+#define RS_W		32u
+#define RS_H		32u
+#define RS_PITCH	(RS_W * 4u)			/* 128 B */
+#define RS_DWORDS	(RS_W * RS_H)			/* 1024 dwords = 4 KB */
+#define RS_TARGET_OFF	0u			/* inside the "rt" region */
+#define RS_FILL		0xcdcdcdcdu			/* what the CPU leaves behind */
+#define RS_COLOR0	0x80402010u			/* clear colour DW0, i.e. what RS2 must find */
+#define RS_TAG		4u			/* markers: 0..3 are the plans' */
+#define RS_MARK(ph)	(0xc1de0000u | ((uint32_t)(ph) << 8) | (0x41u + RS_TAG))
+#define RS_CNTL3	0x00000201u		/* B70b: BINW 32>>5 (0:5), BINH 32>>4 (8:14) */
+#define RS_RB_OFF	0x640u			/* where CP_REG_TO_MEM drops the resolve readback */
+
+/* ---- B77 / step 25: an A2D SCALE blit between buffers we own ---- */
+/* Every constant below was read out of registers/adreno/a6xx.xml,
+ * a6xx_enums.xml and adreno_pm4.xml; see contract section 10.3. Nothing
+ * here is guessed, and none of it is a display-path register. */
+#define BS_W            32u
+#define BS_H            32u
+#define BS_PITCH        (BS_W * 4u)                     /* 128 B, a multiple of 64 */
+#define BD_W            64u
+#define BD_H            64u
