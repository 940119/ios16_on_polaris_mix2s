+ * 4352-byte row is 68 * 64 and the shr=6 pitch field can hold it; the
+ * panel's own 4320-byte row is 67.5 * 64 and cannot be expressed at all. */
+#define BD_SCAN_W       1088u
+#define BD_SCAN_H       64u
+#define BD_X0           0u                              /* B89: the surface's own origin */
+#define BD_PITCH        1024u                           /* B89: 16 * 64, one surface row */
