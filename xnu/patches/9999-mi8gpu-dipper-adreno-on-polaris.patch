+	BS_BLIT_CNTL, BS_DEST_BR, BS_BLIT_CNTL, BS_DST_PITCH, BS_DST_INFO,
+	0x0000f180u, 0x00500030u, 0x00000400u, 0x80100180u,
+	B79_CCU_CNTL, B79_ECO_WANT,
