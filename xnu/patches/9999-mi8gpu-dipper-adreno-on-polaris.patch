@@ -0,0 +1,205 @@
+/*
+ * B87b staged early-IOKit probe (V2c).
+ *
+ * History: B86 proved a C TU can call a self-contained C++ TU. B87a proved
+ * this TU can include the REAL iokit/Kernel/arm/SweetSurface.h (relative
+ * path -- the -I list has NO xnu source root) and resolve the C++-mangled
+ * sweet_surface_create_physical symbol WITHOUT calling it.
+ *
+ * B87b finally CALLS the IOKit path. Because the driver runs from the
+ * sweet_ufs mount path while SweetFramebuffer publishes only after
+ * IOService::start(), early-IOKit readiness is a genuine unknown and a
+ * call may panic before the ring is written. So the work is split into five
+ * stages: the C driver prints PRE, calls ONE stage, prints POST. If the
+ * kernel dies, the last PRE line in the persistent ring names the stage
+ * (lesson 67). All stages are after the GPU evidence in the C driver.
+ *
+ * Include set is the same one SweetSurface.cpp uses, so every symbol below
+ * is known-visible under -nostdinc + EXPORT_HDRS.
+ */
+#include "../../iokit/Kernel/arm/SweetSurface.h"
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/system.h>
+#include <kern/task.h>
+#include <sys/proc.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>  /* rootvnode and struct vnode's fields */
+#include <sys/namei.h>
+#include <sys/mount.h>
+#include <sys/vfs_context.h>
+
+static SweetSurface *g_stage_surface = nullptr;
+
+extern "C" unsigned int
+mi8_surface_bridge_probe(void)
+{
+	SweetSurface *(*volatile fn)(uint64_t, uint32_t, uint32_t, uint32_t, uint32_t) =
+	    &sweet_surface_create_physical;
+	return fn != nullptr ? 0x53555246u : 0x0badf00du; /* "SURF" / "BADF00D" */
+}
+
+extern "C" uint64_t
+mi8_surface_bridge_stage(unsigned int stage, uint64_t phys,
+    unsigned int width, unsigned int height, unsigned int row,
+    unsigned int format)
+{
+	switch (stage) {
+	case 1: {	/* IOKit lock runtime */
+		IOLock *l = IOLockAlloc();
+		if (l == nullptr) {
+			return 0;
+		}
+		IOLockFree(l);
+		return 1;
+	}
+	case 2:		/* kernel_task must already be assigned */
+		return kernel_task != nullptr ? 1 : 0;
+	case 3: {	/* IOBufferMemoryDescriptor allocation */
+		IOBufferMemoryDescriptor *b =
+		    IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		        kIODirectionInOut | kIOMemoryKernelUserShared,
+		        page_size, page_size);
+		if (b == nullptr) {
+			return 0;
+		}
+		b->release();
+		return 1;
+	}
+	case 4:		/* the real surface create + publish */
+		g_stage_surface = sweet_surface_create_physical(phys, width, height,
+		    row, format);
+		return g_stage_surface == nullptr ? 0 :
+		    (uint64_t)g_stage_surface->id;
+	case 5:		/* lazy kernel mapping of the pixels */
+		return g_stage_surface == nullptr ? 0 :
+		    (uint64_t)g_stage_surface->kernelAddress();
+	default:
+		return 0;
+	}
+}
+
+/*
+ * B88: wrap a caller-supplied physical address in a SweetSurface.
+ *
+ * B87b's stages wrap the panel's fixed framebuffer phys -- memory the GPU can
+ * already reach because "screen" is a driver region. This entry point is the
+ * other direction: the driver allocates kernel-contiguous pages, maps them
+ * into the SMMU at an IOVA of its own, and then asks for a surface over the
+ * same pages. That is the shape Mesa uses (IOSurface as a render target), so
+ * only the return value of kernelAddress() is interesting here.
+ *
+ * Returns 0 if the create or the lazy write-combined mapping failed. The
+ * surface is left published in the id table on purpose: a one-shot experiment
+ * image reboots, and releasing it here would free pages the SMMU still maps.
+ */
+extern "C" unsigned long long
+mi8_surface_bridge_create(unsigned long long phys, unsigned int width,
+    unsigned int height, unsigned int row, unsigned int format)
+{
+	SweetSurface *s = sweet_surface_create_physical(phys, width, height,
+	    row, format);
+
+	if (s == nullptr) {
+		return 0;
+	}
+	return (unsigned long long)s->kernelAddress();
+}
+
+/*
+ * 5-a: the GPU ioctl surface, in the shape Mesa's msm backend expects.
+ *
+ * This is the command/argument convention ONLY -- there is no userland way to
+ * reach the kernel on this device yet (the iOS root is HFS+ on userdata, so
+ * TWRP cannot drop a binary in, and the USB gadget was disproved by sixteen
+ * builds). What CAN be proven today is that the numbering, the argument
+ * packing and the chip id are right, by calling the very same handler the
+ * user client would call.
+ *
+ * Command numbers are the msm DRM ioctls' low byte so the shim can map 1:1:
+ *   cmd 0  MSM_IOCTL_GET_PARAM   arg = MSM_PARAM_CHIP_ID   -> out = chip id
+ *   cmd 1  MSM_IOCTL_GET_PARAM   arg = MSM_PARAM_GPU_MODEL -> out = model
+ * A630: chip id 0x06030000, model 0x0603. Get either wrong and every later
+ * Mesa query is wrong, which is why this is worth an rung of its own.
+ */
+#define MI8_MSM_PARAM_CHIP_ID    0x02u
+#define MI8_MSM_PARAM_GPU_MODEL  0x03u
+#define MI8_A630_CHIP_ID         0x06030000ull
+#define MI8_A630_GPU_MODEL       0x0603ull
+
+/*
+ * 5-b1: can the kernel see the iOS root volume at driver-init time?
+ *
+ * Read-only on purpose. The root volume is HFS+ directly on `userdata`, so
+ * TWRP cannot put a file there; the only remaining injection channel would be
+ * the kernel itself writing through this mount. Before risking a write, this
+ * proves the mount is reachable at all -- and the honest possibility is that
+ * it is NOT: mi8_adreno_init() runs inside the sweet_ufs mount path, so
+ * rootvnode may not be set yet. A negative here kills the whole channel and
+ * saves every later step, which is exactly why it is the first thing to ask.
+ *
+ * Returns 0 and fills sbuf with the vnode's name when the lookup succeeds.
+ */
+extern "C" int
+mi8_root_probe(char *sbuf, unsigned int slen, unsigned long long *vid,
+    int *isroot)
+{
+	vnode_t vp = NULL;
+	int err;
+
+	if (sbuf == NULL || slen == 0) {
+		return -1;
+	}
+	sbuf[0] = 0;
+	if (vid != NULL) {
+		*vid = 0;
+	}
+	if (isroot != NULL) {
+		*isroot = rootvnode != NULL ? 1 : 0;
+	}
+	err = vnode_lookup("/", 0, &vp, vfs_context_current());
+	if (err != 0 || vp == NULL) {
+		return err != 0 ? err : -2;
+	}
+	const char *nm = vnode_getname(vp);
+	if (nm != NULL) {
+		unsigned int i = 0;
+
+		while (i + 1 < slen && nm[i] != 0) {
+			sbuf[i] = nm[i];
+			i++;
+		}
+		sbuf[i] = 0;
+		vnode_putname(nm);
+	}
+	if (vid != NULL) {
+		*vid = (unsigned long long)vp->v_id;
+	}
+	vnode_put(vp);
+	return 0;
+}
+
+extern "C" int
+mi8_gpu_ioctl(unsigned int cmd, unsigned long long arg, unsigned long long *out)
+{
+	if (out == nullptr) {
+		return -1;
+	}
+	*out = 0;
+	switch (cmd) {
+	case 0:			/* MSM_IOCTL_GET_PARAM */
+		switch ((unsigned int)arg) {
+		case MI8_MSM_PARAM_CHIP_ID:
+			*out = MI8_A630_CHIP_ID;
+			return 0;
+		case MI8_MSM_PARAM_GPU_MODEL:
+			*out = MI8_A630_GPU_MODEL;
+			return 0;
+		default:
+			return -2;	/* unknown param */
+		}
+	default:
+		return -3;		/* unknown ioctl */
+	}
+}
