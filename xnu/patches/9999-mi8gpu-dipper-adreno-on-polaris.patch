+#define BS_DST_PITCH    (BD_PITCH >> 6)                 /* shr=6 */
+#define BS_BLIT_CNTL    0x00f03000u /* COLOR_FORMAT<<8 | MASK<<20, ROTATE_0, IFMT=R2D_UNORM8 */
+#define BS_OUTPUT_INFO  0x0000f180u /* COLOR_FORMAT<<3 | MASK<<12, OUTPUT_IFMT_2D_FLOAT */
