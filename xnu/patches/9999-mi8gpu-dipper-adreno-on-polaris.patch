+ * nothing in this port has ever read them; the window match is a mask,
+ * (addr & ~MASK_LEN) == BASE_ADDR, which is why the mask is printed too. */
+#define PRT_CNTL	0x084fu			/* ACCESS_PROT_EN[0], FAULT_ON_VIOL_EN[1] */
+#define PRT_BASE	0x0850u			/* CP_PROTECT[0..31], one dword each */
+#define PRT_STATUS	0x0824u			/* ADDR[17:0], VIOL[22], HALTED[21], READ[20] */
+#define CS_CONST_SENTINEL 0xdeadbeefu	/* B48: memory value, deliberately != c0.x */
+static uint32_t cs_const_value;	/* B48: CP_LOAD_STATE6_FRAG uploads this as c0.x */
+
+/*
+ * B60: the whole compiled body. The private path is GONE.
+ *
+ * 32 slots: the result address, then Mesa's twelve instructions verbatim
+ * (log slots 0..11 = dwords 0..23, all inside the 128-byte dump at
+ * compute-a540.log:434-437), nops where the log had stgb (a buffer
+ * descriptor, B61) and its end, the B59 judge tail, one nop, and end at
+ * slot 31. Nothing about length or state moved: CS_PROGRAM_WORDS is still
+ * 64, CS_GROUPS / SP_CS_INSTR_SIZE / NUM_UNIT are still 2, and the const
+ * segment is still B59's five-vec4 upload with c4.x live and c0.x the
+ * deadbeef decoy. Every ring carries CS_F_Q_WHOLE, so result[6] is neither
+ * written nor compared -- there is no private path left to write it.
+ *
+ * The two stl/ldl are the shared-memory ops B52 PROVED
+ * (IR3_BARRIER_SHARED_R), at bytes 0..60 of the wave. They are not the
+ * private path: B52's stl round trip passed with pvtmem SIZE=0 while
+ * B53's stp at the same address produced nothing. r0.x is the local
+ * invocation id the hardware preloads (the log's own shader reads it at
+ * slot 1 with no preceding load), and the grid is 16x1x1, so the offsets
+ * stay inside 64 bytes.
+ *
+ * --- the B53 note that built the program this one replaces ---
+ *
+ * B53: private memory (stp -> ldp -> stg) with ZERO state changes.
+ *
+ * B52 proved a real compiled local-memory round trip runs on this minimal
+ * a6xx gen1 state. HANDOFF 5b.28 item 6 is now down to pvtmem / constlen
+ * management and loading a whole compiled program. B51 and B52 established
+ * the method: prove the REAL instruction runs on the minimal state FIRST,
+ * and add state only if it fails. B53 does that for private memory.
+ *
+ * Ground truth, not transcription:
+ *   isa/ir3-cat6.xml:423 (ldp) and :555 (stp) both extend the SAME
+ *     #instruction-cat6-a3xx-ld / #instruction-cat6-a3xx-st skeletons B52
+ *     calibrated against a real compiled shader. ONLY the 5-bit OPC changes:
+ *       stl 00100 -> stp 00101    ldl 00001 -> ldp 00010
+ *   ir3/tests/disasm.c:364,480-486: SEVEN Mesa disassembler unit-test words
+ *     covering f32/u16 TYPEs, negative and +256 offsets, sizes 1/2/3.
+ *     _ir3enc.py reproduces all seven bit-for-bit before deriving these
+ *     words (the sixth independent calibration chain).
+ *
+ * KEY FINDING: cs_launch() ALREADY emits all four SP_CS_PVT_MEM_* regs.
+ * As of B54 BASE points at the "pvtmem" region; PARAM=1 (512 B per
+ * fiber), SIZE=64 (64 KB per SP), STACK_OFFSET=0 (a6xx.xml:3734-3752;
+ * computerator/a6xx.cc:256-277 emits them only when pvtmem_size > 0).
+ * B53 ran the same program with PARAM=0 / SIZE=0 and produced nothing.
+ *
+ * THE ONE EXPERIMENTAL VARIABLE: two dwords.
+ *   slot 21 stl 0x0180000a 0xc1061300 -> stp 0x0180000a 0xc1461300
+ *   slot 27 ldl 0x01824001 0xc0460000 -> ldp 0x01824001 0xc0860000
+ * Every other instruction word, every state register, the const upload,
+ * the grid, CACHE_INVALIDATE, the fence and the cp-seed sentinel are
+ * byte-for-byte B52. The cat0 jump at slot 7 stays ON in every ring, so
+ * result[2] = c0.x and result[4] = c0.x + 0x222 are INVARIANTS.
+ *
+ *   no-pvt (A/D, CS_F_Q_NOPVT patches 21..30 to nops): result[6] = 0
+ *   pvt    (B/C):                                      result[6] = c0.x + 0x222
+ *
+ * 判据的判据: cs_probe() also clears and reads the pvtmem base directly and
+ * prints `pvt-raw`. If stp really wrote the pvt-memory base it follows
+ * c0.x; if it stays zero while result[6] matches, the hardware applied a
+ * fiber/wave address transform (a6xx.xml:3753-3763) and the reload still
+ * proves the store. pvt-raw must be ZERO on the nop controls.
+ *
+ * If result[6] stays 0 or the bank faults, the next rung changes ONLY
+ * SP_CS_PVT_MEM_PARAM.MEMSIZEPERITEM and SP_CS_PVT_MEM_SIZE.
+ * TOTALPVTMEMSIZE -- do NOT blame "real shaders cannot run".
+ */
+static const uint32_t cs_program[CS_PROGRAM_WORDS] = {
+	0xfeed0001u, 0x204cc008u,	/* mov.u32u32 r2.x, <result address> (patched) */
+	0x00000000u, 0x20554001u,	/* real 0: mov.s32s32 r0.y, 0 */
+	0x20020000u, 0x46d00000u,	/* real 1: shl.b r0.x, r0.x, 2 */
+	0x00000001u, 0x20554002u,	/* real 2: mov.s32s32 r0.z, 1 */
+	0x00000000u, 0x00000000u,	/* real 3: nop */
+	0x00000001u, 0x20154003u,	/* real 4: mov.s32s32 r0.w, r0.y */
+	0x00010000u, 0x42300000u,	/* real 5: add.s r0.x, r0.x, r0.y */
+	0x00000001u, 0x20154004u,	/* real 6: mov.s32s32 r1.x, r0.y */
+	0x01800002u, 0xc1060300u,	/* real 7: stl.u32 l[r0.y], r0.y, 1 */
+	0x00000000u, 0x00000400u,	/* real 8: (rpt4)nop */
+	0x01800004u, 0xc1060100u,	/* real 9: stl.u32 l[r0.x], r0.z, 1 */
+	0x01804001u, 0xc0460000u,	/* real 10: ldl.u32 r0.x, l[r0.y], 1 */
+	0x00000000u, 0x00001000u,	/* real 11: (ss)nop */
+	0x00000000u, 0x00000000u,	/* real 12 was stgb.untyped -- needs a descriptor, B61 */
+	0x00000000u, 0x00000000u,	/* real 13 was end -- the judge tail must run */
+	0x00000000u, 0x204cc009u,	/* tail: mov.u32u32 r2.y, 0 */
+	0x0badf00du, 0x204cc004u,	/* tail: mov.u32u32 r1.x, 0x0badf00d (control) */
+	0x00000000u, 0x00000000u,	/* tail: nop latency */
+	0x00000000u, 0x00000000u,	/* nop: B60c moved the control store to slot 30 */
+	0x00000010u, 0x202cc005u,	/* tail: mov.u32u32 r1.y, c4.x (B59 const num 16) */
+	0x00000000u, 0x00000000u,	/* tail: nop latency */
+	0x00000000u, 0x00000000u,	/* tail: nop latency */
+	0x0180000au, 0xd0c61108u,	/* tail: stg.u32 g[r2.x+8], r1.y, 1 (sy) -> result[2] */
+	0x00000000u, 0x00000000u,	/* B50 latency 1/3 */
+	0x00000000u, 0x00000000u,	/* B50 latency 2/3 */
+	0x22220005u, 0x52100005u,	/* tail: add.u r1.y, r1.y, 0x222 (sy) */
+	0x00000000u, 0x00000000u,	/* B50 latency 1/3 */
+	0x00000000u, 0x00000000u,	/* B50 latency 2/3 */
+	0x00000000u, 0x00000000u,	/* B50 latency 3/3 */
+	0x0180000au, 0xd0c61110u,	/* tail: stg.u32 g[r2.x+0x10], r1.y, 1 (sy) -> result[4] */
+	0x01800008u, 0xd0c61100u,	/* B60c: stg.u32 g[r2.x+0], r1.x, 1 (sy) -> result[0], 19 slots after the ldl */
+	0x00000000u, 0x03000000u,	/* end (slot 31) */
+};
+
+/*
+ * B30: the same program with every instruction that is not the terminator removed.
+ *
+ * B29 settled that the state block alone is clean: three submissions, the bank
+ * cleared between them, and the one that loads the state without dispatching
+ * left FSR at 0x400 with FSYNR0 0. The dispatch is what moves the bank
+ * (0x400 -> 0x402, FSYNR0 0x12, FAR 0), and FSYNR0's bit 0 is WnR -- zero, so
+ * the refused access is a READ, not the store this rung aims at. A read that is
+ * also privileged (bit 1) is what an instruction fetch looks like.
+ *
+ * So the next subtraction is the program itself: thirty-two nop and one end.
+ * It fetches, dispatches and terminates, and it contains no store at all.
+ *
+ *   A  state only, store program, no dispatch   control
+ *   B  dispatch, EMPTY program                  a fault here is the fetch/launch,
+ *                                               because there is no store to blame
+ *   C  dispatch, store program                  a fault here and clean B is the store
+ */
+static const uint32_t cs_program_empty[CS_PROGRAM_WORDS] = {
+	0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
+	0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
+	0x00000000u, 0x00000000u, 0x00000000u, 0x03000000u,	/* end */
+	0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
+	0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
+	0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
+};
+
+struct cs_word {
+	uint32_t reg;
+	uint32_t value;
+};
+
+/* fd_ncrb: the non-context registers, as type-4 writes, in the order computerator does them. */
+static const struct cs_word cs_ncr[] = {
+	{ 0x0ae0f, 0x00000020 },	/* SP_PERFCTR_SHADER_MASK: .cs */
+	{ 0x0ae04, 0x00000000 },	/* SP_NC_MODE_CNTL_2 */
+	{ 0x09804, 0x0000001f }, { 0x09805, 0x00000001 }, { 0x0a0f8, 0x00000001 },
+	{ 0x0b600, 0x00108000 }, { 0x08600, 0x00000880 }, { 0x0ae03, 0x00001430 },
+	{ 0x0ae00, 0x00000000 }, { 0x0be04, 0x00080000 }, { 0x09600, 0x00000000 },
+	{ 0x00e12, 0x10000001 }, { 0x08e01, 0x00000001 }, { 0x08e04, 0x04100000 },
+};
+
+/* cs_program_emit_regs(): the CS block. Every value here was read back correct from 0219 onward. */
+static const struct cs_word cs_ctx[] = {
+	{ 0x0ab00, 0x00000005 },	/* SP_MODE_CNTL: ISAMMODE_GL, constant demotion */
+	{ 0x0bb08, 0x000000ff },	/* SP_UPDATE_CNTL: all eight bits, as fd6 sets them */
+	{ 0x0b987, 0x00000102 },	/* B59: SP_CS_CONST_CONFIG: CONSTLEN=8 vec4, enabled */
+	{ 0x0a9bb, 0x00000100 },	/* SP_CS_CONFIG: enabled, nuav 0 (the stg uses no descriptor) */
+	{ 0x0a9b1, 0x00000001 },	/* SP_CS_CNTL_1: 1 KB shared, const ram 128 */
+	{ 0x0b997, 0x00fcfcfc },	/* SP_CS_CONST_CONFIG_0: every constid INVALID */
+	{ 0x0b998, 0x000002fc },	/* SP_CS_WGE_CNTL: THREAD128, no linear local id */
+};
+
+/*
+ * B70: the destination description, in the order the resolve engine wants it.
+ * Only the address is runtime, so it is emitted by rs_launch() before this
+ * table rather than living here. Values verified against
+ * registers/adreno/a6xx.xml (offsets) and a6xx_enums.xml (formats).
+ *
+ * RB_RESOLVE_SYSTEM_BUFFER_PITCH is shr=6 in the XML -- the field holds bytes
+ * per row divided by 64, so 128 B of pitch is written as 2. RB_RESOLVE_CNTL_3
+ * (the bin size) is deliberately absent: Turnip's own resolve-into-sysmem path
+ * (event_blit_run) does not touch it, and its value comes from tiling->tile0,
+ * which is per-format and per-arch. A guessed bin size in place of a linear
+ * target is a worse first rung than no bin size at all.
+ */
+static const struct cs_word rs_ctx[] = {
+	{ 0x88d7, 0x00001800u },	/* SYSTEM_BUFFER_INFO: FMT6_8_8_8_8_UNORM (0x30) << 7, TILE6_LINEAR */
+	{ 0x88da, 0x00000002u },	/* SYSTEM_BUFFER_PITCH: 128 B >> 6 -- the field is shr=6 */
+	{ 0x88db, 0x00000000u },	/* SYSTEM_BUFFER_ARRAY_PITCH: one layer */
+	{ 0x88d5, 0x00000000u },	/* GMEM_BUFFER_INFO: SAMPLES = 0 (1x) */
+	{ 0x88d6, 0x00000000u },	/* GMEM_BUFFER_BASE: offset 0 inside GMEM, 4 KB units */
+	{ 0x88d0, 0x00000000u },	/* CNTL_0: YUV plane 0 */
+	{ 0x88d1, 0x00000000u },	/* CNTL_1: rect top-left (0,0) */
+	{ 0x88d2, 0x001f001fu },	/* CNTL_2: rect bottom-right (31,31), inclusive */
+};
+
+/*
+ * One ring. Returns false only when the CP stopped reading it.
+ *
+ * B37: the state and the dispatch live in separate rings now, and the state is
+ * the one fd6_compute.cc writes. Everything below was checked field by field
+ * against Mesa's adreno_pm4.xml and fd6_compute.cc rather than derived from
+ * 0251's sequence, and three of those checks were being violated:
+ *
+ *   - the UAV CP_LOAD_STATE6 named state_block 0xd, which is SB6_CS_SHADER,
+ *     not SB6_CS_UAV (0xf) -- that is the shader instruction store, so the
+ *     packet was aimed at the same block the program had just been loaded
+ *     into, with 128 bytes of zeros. It is gone: the stg uses no descriptor.
+ *   - SP_CS_INSTR_SIZE is in 128-byte instruction groups (ir3_shader.h:
+ *     "the instructions length is in units of instruction groups ... each
+ *     instruction is 2 dwords"), so a 32-dword program is 1, not 32.
+ *   - SP_CS_CNTL_0's FULLREGFOOTPRINT is max_reg + 1, and this program uses
+ *     r0 through r2, so 3 -- not 2.
+ *
+ * The reference also writes SP_CS_PROGRAM_COUNTER_OFFSET and the four
+ * SP_CS_PVT_MEM_* registers on every compute launch; all five were missing
+ * here, and they are written now with fd6's own values.
+ */
+static bool
+cs_launch(uint32_t flags, uint32_t tag, const char *what)
+{
+	uint32_t *ring = (uint32_t *)g3d_regions[1].memory;
+	uint32_t w = cp_wptr & 8191u;
+	const uint32_t n_ctx = (uint32_t)(sizeof(cs_ctx) / sizeof(cs_ctx[0]));
+	const uint64_t program_iova = g3d_regions[2].address + CS_PROGRAM_OFF;
+	const uint64_t pvt_iova = g3d_regions[G3D_R_PVTMEM].address;
+	const uint64_t fence_iova = g3d_regions[2].address + CS_FENCE_OFF;
+	const uint64_t sp_base = (flags & CS_F_HOLE) != 0 ? CS_HOLE_IOVA : program_iova;
+	const bool state = (flags & CS_F_STATE) != 0;
+	const bool exec = (flags & CS_F_EXEC) != 0;
+
+#define CS_PUT(v)	(ring[w++ & 8191u] = (uint32_t)(v))
+	/*
+	 * B31: a marker the CP has to write itself. Unlike the fence there is no
+	 * value it could produce spontaneously -- a slot that still reads zero after
+	 * the ring drained was never written, and the packet before it therefore
+	 * never executed.
+	 *
+	 * B33: the count is 3, not 4. CP_MEM_WRITE's payload is the 64-bit address
+	 * followed by the data dwords, and cnt counts payload dwords only, so one
+	 * data dword is cnt 3. B32 wrote 4 and the CP dutifully wrote a second
+	 * dword taken from the ring itself:
+	 *
+	 *   mark[0] 0xc1de0041   our constant, at the address we asked for
+	 *   mark[1] 0x70268000   == pkt7(0x26, 0), the CP_WAIT_FOR_IDLE header
+	 *                        that happened to follow the packet
+	 *
+	 * -- bit for bit the next ring dword, which is what an over-read by one
+	 * looks like. Everything after it was one dword out of phase, so the ring
+	 * never reached its last marker and the CP stopped.
+	 */
+#define CS_MARK(ph)	do {							\
+		uint64_t m_ = g3d_regions[2].address + CS_MARKER_OFF			\
+		    + 4u * (3u * (uint32_t)tag + (uint32_t)(ph));			\
+		CS_PUT(pkt7(CP_MEM_WRITE_OPCODE, 3u));					\
+		CS_PUT((uint32_t)m_);							\
+		CS_PUT((uint32_t)(m_ >> 32));						\
+		CS_PUT(CS_MARKER(tag, ph));						\
+	} while (0)
+	/*
+	 * B39: the two packets the reference driver puts in front of the compute state,
+	 * neither of which this probe has ever emitted.
+	 *
+	 * fd6_emit_cs_state() opens with CP_SET_MODE(1) and says why: "we want
+	 * CP_SET_DRAW_STATE to execute immediately, otherwise we need to emit consts as
+	 * draw state groups" -- the PROG group has to execute before the const loads
+	 * rather than be deferred until CP_EXEC_CS. If a6xx defers context state to the
+	 * dispatch by default, that alone would explain B38: in the split ring the
+	 * deferred state is applied when the ring retires, and in the combined ring the
+	 * dispatch arrives before it.
+	 *
+	 * The marker is the other half. fd6_launch_grid() calls set_render_mode(RM6_
+	 * COMPUTE) *before* emitting the state; this probe has always set it after.
+	 */
+	if ((flags & CS_F_Q_MODE) != 0) {
+		CS_PUT(pkt7(0x63u, 1u));		/* CP_SET_MODE */
+		CS_PUT(1u);				/* state groups execute immediately */
+	}
+	if ((flags & CS_F_Q_MARK) != 0) {
+		CS_PUT(pkt7(0x65u, 1u));		/* CP_SET_MARKER */
+		CS_PUT(8u);				/* RM6_COMPUTE, ahead of the state */
+	}
+	if (state) {
+		for (uint32_t i = 0; i < (uint32_t)(sizeof(cs_ncr) / sizeof(cs_ncr[0])); i++) {
+			CS_PUT(pkt4(cs_ncr[i].reg, 1u));
+			CS_PUT(cs_ncr[i].value);
+		}
+		/*
+		 * fd_crb: the block, then the addresses inside it, then the length --
+		 * one bunch, as computerator writes it. Nine pairs follow cs_ctx: the
+		 * instruction size, the program counter offset, the 64-bit SP_CS_BASE,
+		 * the four pvt-memory registers (fd6 writes them even when the shader
+		 * asks for no private memory, with a size of zero).
+		 */
+		CS_PUT(pkt7(0x5cu, 2u * (n_ctx + 10u)));
+		for (uint32_t i = 0; i < n_ctx; i++) {
+			CS_PUT(cs_ctx[i].reg);
+			CS_PUT(cs_ctx[i].value);
+		}
+		/*
+		 * B38: CNTL_0 is the one state field a ring may put back, so it is not
+		 * in the constant table any more. 3 = max_reg + 1 for r0..r2; 2 is what
+		 * 0251 wrote, one register short.
+		 */
+		CS_PUT(0x0a9b0u);
+		CS_PUT(((flags & CS_F_Q_REGS) != 0) ? 0x80100100u : 0x80100180u);
+		/* B49: instrlen is in 128-byte groups, so 64 dwords is TWO.
+		 * fd6_emit_shader() uses MIN2(instrlen, instr_cache_size) as
+		 * CP_LOAD_STATE6's NUM_UNIT, so both values move together. */
+		CS_PUT(0x0a9bcu);
+		CS_PUT(((flags & CS_F_Q_SIZE) != 0) ? 32u : CS_GROUPS);
+		CS_PUT(0x0a9b3u); CS_PUT(0u);		/* SP_CS_PROGRAM_COUNTER_OFFSET */
+		CS_PUT(0x0a9b4u); CS_PUT((uint32_t)sp_base);
+		CS_PUT(0x0a9b5u); CS_PUT((uint32_t)(sp_base >> 32));
+		CS_PUT(0x0a9b6u); CS_PUT(1u);		/* B54: SP_CS_PVT_MEM_PARAM.MEMSIZEPERITEM = 1 -> 512 B/fiber (shr9, a6xx.xml:3735) */
+		CS_PUT(0x0a9b7u); CS_PUT((uint32_t)pvt_iova);
+		CS_PUT(0x0a9b8u); CS_PUT((uint32_t)(pvt_iova >> 32));
+		CS_PUT(0x0a9b9u); CS_PUT(64u);		/* B54: SP_CS_PVT_MEM_SIZE.TOTALPVTMEMSIZE = 64 -> 64 KB/SP (shr12, a6xx.xml:3752), PERWAVEMEMLAYOUT = 0 */
+		CS_PUT(0x0a9bdu); CS_PUT(0u);		/* SP_CS_PVT_MEM_STACK_OFFSET */
+		/* B49: ST6_SHADER / SS6_INDIRECT / SB6_CS_SHADER / NUM_UNIT 2.
+		 * 0x00b60000 is derived from adreno_pm4.xml's CP_LOAD_STATE6
+		 * domain; NUM_UNIT 1 reproduces B37's 0x00760000 exactly. */
+		CS_PUT(pkt7(0x34u, 3u));
+		CS_PUT(0x00b60000u);
+		CS_PUT((uint32_t)program_iova);
+		CS_PUT((uint32_t)(program_iova >> 32));
+		if ((flags & CS_F_Q_UAV) != 0) {
+			/*
+			 * The exact packet B37 removed. state_block 0xd is SB6_CS_SHADER --
+			 * the store the program was just loaded into -- so this pushes 128
+			 * zero bytes over it. If a ring with this flag still stores, the
+			 * clobber was never what kept the SP quiet.
+			 */
+			const uint64_t uav_iova = g3d_regions[2].address + CS_UAV_OFF;
+
+			CS_PUT(pkt7(0x34u, 3u));
+			CS_PUT(0x0076c000u);		/* ST6_UAV / INDIRECT / 0xd / 1 */
+			CS_PUT((uint32_t)uav_iova);
+			CS_PUT((uint32_t)(uav_iova >> 32));
+		}
+	}
+	if ((flags & CS_F_HOLE) != 0) {
+		/* only the base moves, so the program is still the one already loaded */
+		CS_PUT(pkt7(0x5cu, 4u));
+		CS_PUT(0x0a9b4u); CS_PUT((uint32_t)sp_base);
+		CS_PUT(0x0a9b5u); CS_PUT((uint32_t)(sp_base >> 32));
+	}
+	if ((flags & CS_F_Q_ROLL) != 0) {
+		/*
+		 * One dword is the whole packet: plain events need no address and no
+		 * value (info.needs_seqno is false for DEBUG_LABEL, so Mesa emits len 1).
+		 */
+		CS_PUT(pkt7(0x46u, 1u));		/* CP_EVENT_WRITE */
+		CS_PUT(0x3fu);				/* DEBUG_LABEL, per adreno_pm4.xml */
+	}
+	if ((flags & CS_F_Q_WFI) != 0) {
+		/*
+		 * The cheapest of the three: if the split's whole contribution is that the CP
+		 * drains between the state writes and the dispatch, one wait reproduces it
+		 * inside a single ring. This is the packet ring A already ends with, moved to
+		 * where the boundary would be.
+		 */
+		CS_PUT(pkt7(0x26u, 0u));		/* CP_WAIT_FOR_IDLE */
+	}
+	{
+		uint64_t s_ = g3d_regions[2].address + CS_SEED_OFF;
+
+		/*
+		 * B45: cnt is 3 -- CP_MEM_WRITE counts its payload dwords only, and a
+		 * single data dword is address-lo, address-hi and the value (B33).
+		 * The CP writes it before CP_EXEC_CS, so the shader's ldg cannot see
+		 * a stale line from a previous launch.
+		 */
+		CS_PUT(pkt7(CP_MEM_WRITE_OPCODE, 3u));
+		CS_PUT((uint32_t)s_);
+		CS_PUT((uint32_t)(s_ >> 32));
+		CS_PUT(CS_CONST_SENTINEL);	/* B48: != c0.x, so a memory read cannot pass */
+	}
+	if ((flags & CS_F_Q_INV) != 0) {
+		/*
+		 * B46: 0x31 is A6XX's CACHE_INVALIDATE, documented in adreno_pm4.xml as
+		 * "Invalidates UCHE". fd_gpu_event.h says FD_CACHE_INVALIDATE has
+		 * needs_seqno = false, so fd6_event_write() emits CP_EVENT_WRITE with
+		 * ONE dword and no address -- exactly DEBUG_LABEL's shape. It must sit
+		 * after the CP_MEM_WRITE that planted the seed and before CP_EXEC_CS,
+		 * or the shader's ldg keeps hitting the previous launch's cache line.
+		 */
+		CS_PUT(pkt7(0x46u, 1u));		/* CP_EVENT_WRITE */
+		CS_PUT(0x31u);				/* CACHE_INVALIDATE */
+	}
+	CS_MARK(0);				/* everything above executed */
+	if (exec) {
+		if ((flags & CS_F_Q_MARK) == 0) {	/* B39: a head-marker ring already set it */
+			CS_PUT(pkt7(0x65u, 1u));	/* CP_SET_MARKER */
+			CS_PUT(8u);			/* RM6_COMPUTE, per a6xx_marker in adreno_pm4.xml */
+		}
+		/*
+		 * B59: explicit constlen management. a6xx.cc:162 does
+		 *   constlen = align(v->constlen, 4) -> SP_CS_CONST_CONFIG,
+		 * and a6xx.xml:4621-4625 has CONSTLEN shr=2, so five vec4 of real
+		 * constants need 8 vec4 -> field 2 -> 0x102 | ENABLED (0x100).
+		 * SP_CS_CNTL_1's constantrammode stays CONSTLEN_128 (5 <= 128).
+		 * a6xx.cc:304-325 emit_const(): dst_off = regid/4,
+		 * num_unit = DIV_ROUND_UP(sizedwords,4) = 5, cnt = 3+20 = 23;
+		 * dword0 0x01744000 is B48's 0x00744000 with NUM_UNIT 1 -> 5.
+		 *
+		 * The shader reads c4.x (const num 16), NOT c0.x. c0.x is a fixed
+		 * decoy: if the first vec4 were still being read, all four rings
+		 * would return deadbeef and the judge's invariants would fail.
+		 */
+		CS_PUT(pkt7(0x34u, 23u));		/* CP_LOAD_STATE6_FRAG */
+		CS_PUT(0x01744000u);
+		CS_PUT(0u);				/* EXT_SRC_ADDR lo */
+		CS_PUT(0u);				/* EXT_SRC_ADDR hi */
+		CS_PUT(CS_CONST_SENTINEL);		/* c0.x  <- fixed decoy */
+		CS_PUT(0u);		/* c0.y */
+		CS_PUT(0u);		/* c0.z */
+		CS_PUT(0u);		/* c0.w */
+		CS_PUT(0u);		/* c1.x */
+		CS_PUT(0u);		/* c1.y */
+		CS_PUT(0u);		/* c1.z */
+		CS_PUT(0u);		/* c1.w */
+		CS_PUT(0u);		/* c2.x */
+		CS_PUT(0u);		/* c2.y */
+		CS_PUT(0u);		/* c2.z */
+		CS_PUT(0u);		/* c2.w */
+		CS_PUT(0u);		/* c3.x */
+		CS_PUT(0u);		/* c3.y */
+		CS_PUT(0u);		/* c3.z */
+		CS_PUT(0u);		/* c3.w */
+		CS_PUT(cs_const_value);		/* c4.x  <- c4.x, the per-ring value */
+		CS_PUT(0u);		/* c4.y */
+		CS_PUT(0u);		/* c4.z */
+		CS_PUT(0u);		/* c4.w */
+		/*
+		 * B57: the grid is one group of SIXTEEN invocations. NDRANGE_1 is
+		 * local times groups (fd6: localsize_x * num_groups[0]), and
+		 * NDRANGE_0's local sizes are minus one, so kerneldim 3 / local
+		 * 16x1x1 / global 16x1x1: 0x3f = 3 | ((16-1) << 2).
+		 * This is the ONLY variable: B56 had 8 invocations and produced two
+		 * 2 KB windows of four fibers, 32 KB apart. 16 tells us whether the
+		 * 4-fiber group is a wave-like index (two more windows appear at
+		 * 0x17800 / 0x1f800) or an SP-like share (the same two windows get
+		 * eight hits each). NGROUPS_X stays 1; CS_GROUPS is the instruction
+		 * length and must NOT be touched.
+		 */
+		CS_PUT(pkt7(0x5cu, 20u));
+		CS_PUT(0x0b990u); CS_PUT(0x0000003fu);	/* B57: SP_CS_NDRANGE_0: dim 3, local 16x1x1 */
+		CS_PUT(0x0b991u); CS_PUT(16u);		/* B57: SP_CS_NDRANGE_1: global x */
+		CS_PUT(0x0b992u); CS_PUT(0u);		/* SP_CS_NDRANGE_2: offset x */
+		CS_PUT(0x0b993u); CS_PUT(1u);		/* SP_CS_NDRANGE_3: global y */
+		CS_PUT(0x0b994u); CS_PUT(0u);		/* SP_CS_NDRANGE_4: offset y */
+		CS_PUT(0x0b995u); CS_PUT(1u);		/* SP_CS_NDRANGE_5: global z */
+		CS_PUT(0x0b996u); CS_PUT(0u);		/* SP_CS_NDRANGE_6: offset z */
+		CS_PUT(0x0b999u); CS_PUT(1u);		/* SP_CS_KERNEL_GROUP_X */
+		CS_PUT(0x0b99au); CS_PUT(1u);		/* SP_CS_KERNEL_GROUP_Y */
+		CS_PUT(0x0b99bu); CS_PUT(1u);		/* SP_CS_KERNEL_GROUP_Z */
+		CS_PUT(pkt7(0x33u, 4u));		/* CP_EXEC_CS */
+		CS_PUT(0u);
+		CS_PUT(1u);				/* NGROUPS_X */
+		CS_PUT(1u);				/* NGROUPS_Y */
+		CS_PUT(1u);				/* NGROUPS_Z */
+		CS_MARK(1);				/* the CP accepted the dispatch */
+	}
+	CS_PUT(pkt7(0x26u, 0u));		/* CP_WAIT_FOR_IDLE */
+	/*
+	 * B34: the fence goes back in, with a value that can be read.
+	 *
+	 * B33 removed this packet on the grounds that it never produced a signal.
+	 * That was wrong, and the reference driver on the same a630 says why
+	 * (_dipper/bsd/dev/mi8_adreno.c:3026):
+	 *
+	 *     keep_ring_cmd(CP_EVENT_WRITE_OP, 4);
+	 *     keep_ring(EVENT_CACHE_FLUSH_TS);
+	 *     keep_ring(lo); keep_ring(hi); keep_ring(keep_fence);
+	 *
+	 * The last dword is not a timestamp the hardware fills in -- it is a value
+	 * the driver supplies, and CACHE_FLUSH_TS flushes the core's caches and then
+	 * writes that value. Every version of this rung before B34 supplied zero, so
+	 * of course every version read zero.
+	 *
+	 * It also carries the flush. Without it a shader store can sit in the core's
+	 * own cache and never reach DRAM, where the CPU reads.
+	 */
+	CS_PUT(pkt7(0x46u, 4u));		/* CP_EVENT_WRITE */
+	CS_PUT(0x04u);				/* EVENT_CACHE_FLUSH_TS */
+	CS_PUT((uint32_t)fence_iova);
+	CS_PUT((uint32_t)(fence_iova >> 32));
+	CS_PUT(0xf00d0000u | (0x41u + (uint32_t)tag));
+	CS_MARK(2);				/* the ring ran to its end */
+#undef CS_MARK
+#undef CS_PUT
+	/*
+	 * gpu_wait_ring() is not used here: its second condition is a6xx_idle's
+	 * "RBBM_STATUS with bit 0 masked out is zero", and a compute dispatch
+	 * leaves bits that a quiet ring does not clear. Draining the ring is the
+	 * judgement this probe needs, and CP_WAIT_FOR_IDLE plus the fence inside
+	 * that same ring already order the wave before the drain completes.
+	 */
+	{
+		const uint32_t target_wptr = w & 8191u;
+
+		to_memory(g3d_regions[1].memory, g3d_regions[1].size);
+		wr(gpu3d + 4 * 0x0807, target_wptr);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (uint32_t i = 0; i < 20000; i++) {
+			if (rd(gpu3d + 4 * 0x0806) == target_wptr) {
+				break;
+			}
+			sleep_us(10);
+		}
+		cp_wptr = target_wptr;
+		printf("mi8gpu: step 23: %s: RB_RPTR %u WPTR %u, RBBM_STATUS %#010x INT_0_STATUS %#010x\n", what,
+		    rd(gpu3d + 4 * 0x0806), target_wptr, rd(gpu3d + 4 * 0x0210), rd(gpu3d + 4 * 0x0201));
+		return rd(gpu3d + 4 * 0x0806) == target_wptr;
+	}
+}
+
+/*
+ * B37: did any of it land?
+ *
+ * Seven rounds have now argued about what the core does with this state while
+ * never establishing that the state is there at all. CP_CONTEXT_REG_BUNCH
+ * writes through the CP, so from the CPU the registers might be write-only,
+ * and a read of zero would then mean nothing -- 教训 30 exactly. So the state
+ * ring runs first, alone, and only then is the core read:
+ *
+ *   - eight registers through the CPU's own aperture, which cannot lie when it
+ *     returns a value only we could have written;
+ *   - the same eight through CP_REG_TO_MEM, whose format msm uses for its
+ *     performance counters (reg, address lo, address hi), in case the CPU's
+ *     view is the one that is blind.
+ *
+ * If both are zero the state never reached the core and nothing downstream of
+ * it has ever been a test of the shader.
+ */
+static void
+cs_state_readback(void)
+{
+	static const struct {
+		const char *name;
+		uint32_t reg;
+	} r[] = {
+		{ "SP_CS_CNTL_0",     0x0a9b0u },
+		{ "SP_CS_BASE_LO",    0x0a9b4u },
+		{ "SP_CS_BASE_HI",    0x0a9b5u },
+		{ "SP_CS_CONFIG",     0x0a9bbu },
+		{ "SP_CS_INSTR_SIZE", 0x0a9bcu },
+		{ "SP_CS_NDRANGE_0",  0x0b990u },
+		{ "SP_UPDATE_CNTL",   0x0bb08u },
+		{ "SP_MODE_CNTL",     0x0ab00u },
+	};
+	const uint32_t n = (uint32_t)(sizeof(r) / sizeof(r[0]));
+	const uint64_t rb = g3d_regions[2].address + CS_RB_OFF;
+	volatile uint32_t *slot = (volatile uint32_t *)((vm_offset_t)g3d_regions[2].memory + CS_RB_OFF);
+	uint32_t *ring = (uint32_t *)g3d_regions[1].memory;
+	uint32_t w = cp_wptr & 8191u;
+	uint32_t cpu[8], cpv[8], landed = 0;
+
+	for (uint32_t i = 0; i < n; i++) {
+		slot[i] = 0;
+		cpu[i] = rd(gpu3d + 4 * r[i].reg);
+	}
+	to_memory((vm_offset_t)slot, 4u * n);
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t d = (rb + 4u * i);
+
+		ring[w++ & 8191u] = pkt7(0x3eu, 3u);	/* CP_REG_TO_MEM, CNT 0 == one dword */
+		ring[w++ & 8191u] = r[i].reg & 0x3ffffu;
+		ring[w++ & 8191u] = d;
+		ring[w++ & 8191u] = 0u;
+	}
+	{
+		const uint32_t target_wptr = w & 8191u;
+
+		to_memory(g3d_regions[1].memory, g3d_regions[1].size);
+		wr(gpu3d + 4 * 0x0807, target_wptr);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (uint32_t i = 0; i < 20000; i++) {
+			if (rd(gpu3d + 4 * 0x0806) == target_wptr) {
+				break;
+			}
+			sleep_us(10);
+		}
+		cp_wptr = target_wptr;
+		if (rd(gpu3d + 4 * 0x0806) != target_wptr) {
+			printf("mi8gpu: step 23 READBACK: the CP did not drain the readback ring; nothing here can be trusted\n");
+			return;
+		}
+	}
+	sleep_us(1000);
+	from_memory((vm_offset_t)slot, 4u * n);
+	for (uint32_t i = 0; i < n; i++) {
+		cpv[i] = slot[i];
+		if (cpu[i] != 0 || cpv[i] != 0) {
+			landed++;
+		}
+		printf("mi8gpu: step 23 READBACK %-18s reg %#07x: the CPU reads %#010x, CP_REG_TO_MEM wrote %#010x\n",
+		    r[i].name, r[i].reg, cpu[i], cpv[i]);
+	}
+	printf("mi8gpu: step 23 READBACK: %u of %u registers are non-zero -> %s\n", landed, n,
+	    landed == 0 ? "NOTHING LANDED. Either CP_CONTEXT_REG_BUNCH reaches nothing readable, or the block/offset pair is not this core's -- and nothing downstream of the state has ever tested the shader" :
+	    "the state IS on the core, so every earlier silence was the dispatch, not the state");
+}
+
+/*
+ * B36: is the page with no PTE a sensor at all?
+ *
+ * B35 concluded "no wave is ever created" from one observation: the dispatch
+ * whose SP_CS_BASE named 0x10100000 produced no fault. That conclusion is only
+ * as good as the assumption that an access to 0x10100000 does fault, and nothing
+ * in this line has ever demonstrated it. B29 tried, but its ring was desynced so
+ * the reading was meaningless. 教训 30 is exactly this: when a judgement has no
+ * signal, first establish that the instrument can produce one.
+ *
+ * So the CP -- which has demonstrably written to the memptrs page all night
+ * through the same context bank -- is asked to write to 0x10100000. If that
+ * faults, the hole is a sensor and B35's silence means the SP really never
+ * fetched. If it does not, the hole proves nothing and "no wave" is unproven.
+ *
+ * It runs last, after the four launches: a write that faults may leave the CP
+ * waiting for a completion that never comes, and the dispatch evidence is worth
+ * more than the calibration.
+ */
+static void
+cs_hole_sensor(void)
+{
+	uint32_t *ring = (uint32_t *)g3d_regions[1].memory;
+	uint32_t w = cp_wptr & 8191u;
+	uint32_t fsr0, fsr1, seen, rptr;
+	vm_offset_t cb = smmu_cb(G3D_CTX);
+	const uint32_t target_wptr = (w + 4u) & 8191u;
+
+	seen = rd(cb + CB_FSR);
+	if (seen != 0) {
+		wr(cb + CB_FSR, seen);
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	fsr0 = rd(cb + CB_FSR);
+	ring[w++ & 8191u] = pkt7(CP_MEM_WRITE_OPCODE, 3u);
+	ring[w++ & 8191u] = (uint32_t)CS_HOLE_IOVA;
+	ring[w++ & 8191u] = (uint32_t)(CS_HOLE_IOVA >> 32);
+	ring[w++ & 8191u] = 0xdeadbeefu;
+	to_memory(g3d_regions[1].memory, g3d_regions[1].size);
+	wr(gpu3d + 4 * 0x0807, target_wptr);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t i = 0; i < 20000; i++) {
+		if (rd(gpu3d + 4 * 0x0806) == target_wptr) {
+			break;
+		}
+		sleep_us(10);
+	}
+	rptr = rd(gpu3d + 4 * 0x0806);
+	cp_wptr = target_wptr;
+	sleep_us(2000);
+	fsr1 = rd(cb + CB_FSR);
+	printf("mi8gpu: step 23 HOLE SENSOR: the CP was told to write %#llx; CB1 FSR %#010x -> %#010x, FSYNR0 %#010x, FAR %#llx%08x, ring %u/%u -> %s\n",
+	    CS_HOLE_IOVA, fsr0, fsr1, rd(cb + CB_FSYNR0),
+	    (uint64_t)rd(cb + CB_FAR_LO + 4), rd(cb + CB_FAR_LO), rptr, target_wptr,
+	    fsr1 != fsr0 ? "THE HOLE IS A SENSOR, so an unmapped access does fault and B35's silence is real" :
+	    "THE HOLE IS NOT A SENSOR, so a quiet bank there proves nothing either way");
+}
+
+/*
+ * B34: where did the magic go?
+ *
+ * The stg stores 0badf00d at the address in r2.xy. If it lands there, *result
+ * reads it and nothing else is needed. If it lands somewhere else -- because the
+ * store's address form is not the absolute one 0251 assumed, or because the core
+ * adds a base we did not think of -- then the CPU sees nothing at the target
+ * while the write is still perfectly real, and the only unmapped-page probe that
+ * would catch it is the one that faults. So before concluding "nothing wrote",
+ * walk every page the core can reach and look for the constant.
+ *
+ * The program itself contains 0badf00d as an immediate (mov r1.x), so the
+ * program page always reports one hit at its own offset; that hit is expected
+ * and is not evidence.
+ */
+static void
+cs_scan_magic(uint32_t tag)
+{
+	uint32_t hits = 0;
+	uint32_t total = 0;
+
+	for (uint32_t r = 0; r < G3D_REGIONS; r++) {
+		uint32_t *p = (uint32_t *)g3d_regions[r].memory;
+		uint32_t n;
+
+		if (p == NULL) {
+			continue;
+		}
+		n = g3d_regions[r].size / 4u;
+		total += g3d_regions[r].size;
+		/* the core may have written behind our cache: read what is in DRAM */
+		from_memory(g3d_regions[r].memory, g3d_regions[r].size);
+		for (uint32_t i = 0; i < n && hits < 6; i++) {
+			if (p[i] == 0x0badf00du) {
+				printf("mi8gpu: step 23 launch %c: 0badf00d in %s at %#llx (region offset %#x)\n",
+				    'A' + tag, g3d_regions[r].name, g3d_regions[r].address + 4ull * i, 4u * i);
+				hits++;
+			}
+		}
+	}
+	if (hits == 0) {
+		printf("mi8gpu: step 23 launch %c: 0badf00d is nowhere in the %u KiB of GPU-mapped memory either\n",
+		    'A' + tag, total / 1024u);
+	}
+}
+
+static void
+cs_probe(void)
+{
+	volatile uint32_t *memptrs = (volatile uint32_t *)g3d_regions[2].memory;
+	const uint64_t base = g3d_regions[2].address;
+	uint32_t *shader = (uint32_t *)((vm_offset_t)memptrs + CS_PROGRAM_OFF);
+	/*
+	 * B53: does a REAL compiled private-memory round trip work with the
+	 * pvtmem registers at their B52 values (PARAM=0, SIZE=0)?
+	 *
+	 * Slots 21..30 are B52's shape with ONLY the two OPC fields changed:
+	 * stp -> five nops -> ldp -> (ss)nop -> nop -> stg. The cat0 jump at
+	 * slot 7 stays ON IN EVERY RING, so
+	 *
+	 *   result[2] = c0.x         (invariant, group 1's add.u is skipped)
+	 *   result[4] = c0.x + 0x222 (invariant, group 2's add.u landed)
+	 *   result[6] = 0            on A/D (CS_F_Q_NOPVT patches 21..30 to nops)
+	 *             = c0.x + 0x222 on B/C (the private round trip)
+	 *
+	 * result[6] can ONLY be written by the new stg at slot 30. Four distinct
+	 * uploads, all INVated, one shared cleared target, the 0xdeadbeef
+	 * sentinel at cp-seed, SP_CS_INSTR_SIZE reads back 2, zero faults.
+	 * EXTRA: the pvtmem region's first word is cleared before each launch and
+	 * read back by the CPU as `pvt-raw` -- a direct check that stp wrote the
+	 * pvt base rather than ldp merely re-reading a stale line. Slot 2 is
+	 * mov.u32u32 r2.y, 0, so p[r2.y] addresses BASE + 0 and pvt-raw must
+	 * equal c0.x + 0x222 once the configuration takes effect.
+	 *
+	 * B54 IS THE CONFIGURATION RUNG: B53 proved PARAM=0 / SIZE=0 produces
+	 * nothing at all (run 42824810251, no fault, no write, no reload). It
+	 * changed ONLY g3d_regions[]/pvt_iova, PARAM 0->1, SIZE 0->64 and the
+	 * two pvt-raw addresses; the 32 instruction words were byte-for-byte
+	 * B53. It worked: result[6] followed c0.x + 0x222 (run 42835349817).
+	 *
+	 * B55 IS THE LOCALISATION RUNG: B54's pvt-raw (the region's FIRST dword)
+	 * was still 0 while result[6] matched, so the store landed somewhere the
+	 * fiber/wave/SP transform of a6xx.xml:3753-3763 chose, not at BASE+0.
+	 * This rung keeps the region size, pvt_iova, PARAM, SIZE and every one
+	 * of the 32 instruction words identical to B54; it only clears the whole
+	 * region before each launch and scans the whole region afterwards, so
+	 * pvt-first / pvt-last / pvt-hits / pvt-nz say WHERE the writes went.
+	 * pvt-nz is what makes a nop control that writes some OTHER value
+	 * visible; hits alone would only see the value the pvt path stores.
+	 */
+	static const struct {
+		uint32_t flags;
+		uint32_t tag;
+		uint32_t constval;
+		const char *what;
+	} plan[4] = {
+		{ CS_F_STATE | CS_F_EXEC | CS_F_Q_INV | CS_F_Q_WHOLE, 0u, 0x5eedc0deu, "WHOLE 1: the real compiled body must store the control and c4.x" },
+		{ CS_F_STATE | CS_F_EXEC | CS_F_Q_INV | CS_F_Q_WHOLE, 1u, 0xa5a5c3c3u, "WHOLE 2: second upload through the same real body" },
+		{ CS_F_STATE | CS_F_EXEC | CS_F_Q_INV | CS_F_Q_WHOLE, 2u, 0x1badb002u, "WHOLE 3: third upload, same body" },
+		{ CS_F_STATE | CS_F_EXEC | CS_F_Q_INV | CS_F_Q_WHOLE, 3u, 0x2f00d123u, "WHOLE 4: closing upload, same body" },
+	};
+	const uint32_t n_plan = (uint32_t)(sizeof(plan) / sizeof(plan[0]));
+	vm_offset_t cb = smmu_cb(G3D_CTX);
+	bool faulted[4] = { false, false, false, false };
+	int reached[4] = { 0, 0, 0, 0 };
+	uint32_t ctl[4] = { 0, 0, 0, 0 };
+	uint32_t loaded[4] = { 0, 0, 0, 0 };
+	uint32_t loaded2[4] = { 0, 0, 0, 0 };
+	uint32_t loaded3[4] = { 0, 0, 0, 0 };	/* B52: result[6] */
+	uint32_t expected[4] = { 0, 0, 0, 0 };
+	uint32_t expected2[4] = { 0, 0, 0, 0 };
+	uint32_t expected3[4] = { 0, 0, 0, 0 };	/* B52: result[6] */
+	/* B55: the region is walked as a whole, so its base and word count are
+	 * computed once. The probe no longer asks "what is at BASE+0" but
+	 * "where inside the 256 KB did anything land". */
+	volatile uint32_t *pvt_mem = (volatile uint32_t *)((vm_offset_t)g3d_regions[G3D_R_PVTMEM].memory);
+	const uint32_t pvt_words = g3d_regions[G3D_R_PVTMEM].size / 4u;
+	uint32_t t;
+
+	printf("mi8gpu: step 23: a shader whose body is real compiled code, SECVID_TRUST_CNTL %#x (%s)\n",
+	    rd(gpu3d + 4 * 0xf400), gpu_nonsecure ? "out of secure mode" : "STILL SECURE");
+	for (t = 0; t < n_plan; t++) {
+		volatile uint32_t *result = (volatile uint32_t *)((vm_offset_t)memptrs + CS_RESULT_OFF);
+		volatile uint32_t *fence = (volatile uint32_t *)((vm_offset_t)memptrs + CS_FENCE_OFF);
+		volatile uint32_t *mark = (volatile uint32_t *)((vm_offset_t)memptrs + CS_MARKER_OFF + 12u * t);
+		uint32_t fsr_before, fsr_after, seen;
+		bool drained;
+
+		for (uint32_t k = 0; k < 8u; k++) {
+			result[k] = 0;
+		}
+		/* B55: clear the WHOLE region, not just its first word. Every non-zero
+		 * dword the scan finds afterwards then belongs to THIS launch, and a
+		 * nop control that writes anywhere is as visible as one that writes at
+		 * BASE+0. 256 KB is microseconds; not doing it fills the scan with the
+		 * previous launch's values and makes every offset meaningless. */
+		for (uint32_t k = 0; k < pvt_words; k++) {
+			pvt_mem[k] = 0;
+		}
+		*(volatile uint32_t *)((vm_offset_t)memptrs + CS_SEED_OFF) = 0;
+		*fence = 0;
+		mark[0] = mark[1] = mark[2] = 0;
+		memcpy(shader, cs_program, sizeof(cs_program));
+		shader[0] = (uint32_t)(base + CS_RESULT_OFF);
+		if ((plan[t].flags & CS_F_Q_NOPVT) != 0) {
+			/* the A/D control: put the whole private-memory path back to nops.
+			 * Slots 22..26 and 29 are already nops, so numerically only
+			 * 21 (stp), 27 (ldp), 28 ((ss)nop) and 30 (stg) change. */
+			for (uint32_t k = CS_PVT_FIRST; k <= CS_PVT_LAST; k++) {
+				shader[2u * k] = 0;
+				shader[2u * k + 1u] = 0;
+			}
+		}
+		/* B53: the cat0 jump stays ON in all four rings, so result[2] and
+		 * result[4] are invariants. The ONLY variable is the private path. */
+		expected[t] = plan[t].constval;
+		expected2[t] = (uint32_t)(plan[t].constval + CS_ALU2_IMM);
+		expected3[t] = ((plan[t].flags & (CS_F_Q_NOPVT | CS_F_Q_WHOLE)) != 0)
+		    ? 0u : (uint32_t)(plan[t].constval + CS_ALU2_IMM);
+		to_memory((vm_offset_t)memptrs, 0x1000);
+		/* B54: the pvt clear above is a CPU write like any other. Without this
+		 * flush the core would read stale DRAM, and pvt-raw would read the
+		 * cached zero back -- B53's exact signature, for free, as a false
+		 * negative. The clear and the region must travel together. */
+		to_memory((vm_offset_t)g3d_regions[G3D_R_PVTMEM].memory, g3d_regions[G3D_R_PVTMEM].size);
+		cs_const_value = plan[t].constval;
+		printf("mi8gpu: step 23 launch %c: %s (const 0x%08x, sentinel 0x%08x)\n",
+		    'A' + t, plan[t].what, plan[t].constval, (uint32_t)CS_CONST_SENTINEL);
+		seen = rd(cb + CB_FSR);
+		if (seen != 0) {
+			wr(cb + CB_FSR, seen);
+			__asm__ volatile ("dsb sy" ::: "memory");
+		}
+		fsr_before = rd(cb + CB_FSR);
+		drained = cs_launch(plan[t].flags, plan[t].tag, plan[t].what);
+		sleep_us(2000);
+		from_memory((vm_offset_t)memptrs, 0x1000);
+		/* B54: drop the cached copy of the pvt page before reading it, or the
+		 * CPU returns the zero it wrote and never sees the core's store. */
+		from_memory((vm_offset_t)g3d_regions[G3D_R_PVTMEM].memory, g3d_regions[G3D_R_PVTMEM].size);
+		fsr_after = rd(cb + CB_FSR);
+		ctl[t] = result[0];
+		loaded[t] = result[2];
+		loaded2[t] = result[4];
+		loaded3[t] = result[6];	/* B52: only the new stg can write this */
+		/* the instrument's own instrument: did the CP write the sentinel? */
+		uint32_t seed_seen = *(volatile uint32_t *)((vm_offset_t)memptrs + CS_SEED_OFF);
+		/* B53/B54: did stp really write the pvt base? CPU reads the region back. */
+		uint32_t pvt_raw = pvt_mem[0];
+		/* B55: WHERE did it write? The region was cleared and flushed before the
+		 * launch, so every non-zero dword now belongs to this launch. pvt-hits
+		 * counts dwords equal to c0.x + 0x222 (what the private path stores);
+		 * pvt-nz counts every non-zero dword, so a nop control that writes some
+		 * OTHER value is caught too. Offsets are bytes from the region base. */
+		uint32_t want3 = (uint32_t)(plan[t].constval + CS_ALU2_IMM);
+		uint32_t pvt_hits = 0, pvt_nz = 0, pvt_first = 0xffffffffu, pvt_last = 0;
+		/* B55b: up to four non-zero dwords that are NOT c0.x + 0x222, so a
+		 * region holding something else can be named without another boot. */
+		uint32_t pvt_strays = 0, pvt_stray_off[4], pvt_stray_val[4];
+		/* B56: the hit offsets themselves. first/last alone cannot separate a
+		 * 4+4 split from any other set with the same ends. */
+		uint32_t pvt_noff = 0, pvt_off[32];
+
+		for (uint32_t k = 0; k < pvt_words; k++) {
+			uint32_t v = pvt_mem[k];
+
+			if (v == 0) {
+				continue;
+			}
+			pvt_nz++;
+			if (v == want3) {
+				if (pvt_hits == 0) {
+					pvt_first = k * 4u;
+				}
+				pvt_last = k * 4u;
+				if (pvt_noff < 32u) {
+					pvt_off[pvt_noff] = k * 4u;
+				}
+				pvt_noff++;
+				pvt_hits++;
+			} else if (pvt_strays < 4u) {
+				pvt_stray_off[pvt_strays] = k * 4u;
+				pvt_stray_val[pvt_strays] = v;
+				pvt_strays++;
+			}
+		}
+		/* the B38-onward shape, so the judge's result/fence/FSR regex still fits */
+		printf("mi8gpu: step 23 launch %c: result 0x%08x, fence 0x%08x, CB1 FSR 0x%08x -> 0x%08x\n",
+		    'A' + t, ctl[t], *fence, fsr_before, fsr_after);
+		/* B55b: this row is byte-for-byte B54's (236 bytes in the ring). B55
+		 * appended four fields and the message rendered 291 bytes; the ring's
+		 * 255-byte message buffer cut it at "pvt-last 0x" and swallowed the
+		 * newline, so the judge saw no row at all while the run had succeeded.
+		 * The four new fields travel on their own line from here on. */
+		printf("mi8gpu: step 23 launch %c: computed 0x%08x, computed2 0x%08x, computed3 0x%08x, const 0x%08x, expected 0x%08x, expected2 0x%08x, expected3 0x%08x, cp-seed 0x%08x, pvt-raw 0x%08x, inv %u, pvt %u, groups %u\n",
+		    'A' + t, loaded[t], loaded2[t], loaded3[t], plan[t].constval,
+		    expected[t], expected2[t], expected3[t], seed_seen, pvt_raw,
+		    ((plan[t].flags & CS_F_Q_INV) != 0) ? 1u : 0u,
+		    ((plan[t].flags & (CS_F_Q_NOPVT | CS_F_Q_WHOLE)) == 0) ? 1u : 0u,
+		    (uint32_t)CS_GROUPS);
+		printf("mi8gpu: step 23 launch %c: pvt-hits %u, pvt-first 0x%x, pvt-last 0x%x, pvt-nz %u\n",
+		    'A' + t, pvt_hits, pvt_first, pvt_last, pvt_nz);
+		/* only when the region held a value the private path did not store */
+		for (uint32_t k = 0; k < pvt_strays; k++) {
+			printf("mi8gpu: step 23 launch %c: pvt-nz at 0x%x is 0x%08x\n",
+			    'A' + t, pvt_stray_off[k], pvt_stray_val[k]);
+		}
+		/* B56: one line per hit. pvt-hits above says how many there really
+		 * were, so if the dump is ever cut short the count disagrees with the
+		 * lines and the judge says so instead of reading a truncated set. */
+		for (uint32_t k = 0; k < pvt_noff && k < 32u; k++) {
+			printf("mi8gpu: step 23 launch %c: pvt-hit[%u] 0x%x\n",
+			    'A' + t, k, pvt_off[k]);
+		}
+		printf("mi8gpu: step 23 launch %c: FSYNR0 0x%08x, FAR 0x%llx%08x\n", 'A' + t,
+		    rd(cb + CB_FSYNR0), (uint64_t)rd(cb + CB_FAR_LO + 4), rd(cb + CB_FAR_LO));
+		if (*fence != (0xf00d0000u | (0x41u + plan[t].tag))) {
+			printf("mi8gpu: step 23 launch %c: the fence did NOT arrive (want %#010x)\n",
+			    'A' + t, 0xf00d0000u | (0x41u + plan[t].tag));
+		}
+		cs_scan_magic(plan[t].tag);
+		printf("mi8gpu: step 23 launch %c markers: state-reached %#010x, exec-accepted %#010x, ring-finished %#010x (want %#010x %#010x %#010x)\n",
+		    'A' + t, mark[0], mark[1], mark[2],
+		    CS_MARKER(plan[t].tag, 0), ((plan[t].flags & CS_F_EXEC) != 0) ? CS_MARKER(plan[t].tag, 1) : 0u,
+		    CS_MARKER(plan[t].tag, 2));
+		if (mark[2] == CS_MARKER(plan[t].tag, 2)) {
+			reached[t] = 3;
+		} else if (((plan[t].flags & CS_F_EXEC) != 0) && mark[1] == CS_MARKER(plan[t].tag, 1)) {
+			reached[t] = 2;
+		} else if (mark[0] == CS_MARKER(plan[t].tag, 0)) {
+			reached[t] = 1;
+		} else {
+			reached[t] = 0;
+		}
+		if (reached[t] != 3) {
+			printf("mi8gpu: step 23 VERDICT launch %c: STALLED after %d of 3 markers\n", 'A' + t, reached[t]);
+		} else if (fsr_after != fsr_before) {
+			faulted[t] = true;
+			printf("mi8gpu: step 23 VERDICT launch %c: the bank faulted (%#010x -> %#010x)\n", 'A' + t,
+			    fsr_before, fsr_after);
+		} else if (ctl[t] == CS_WANT && loaded[t] == expected[t] && loaded2[t] == expected2[t]
+		    && loaded3[t] == expected3[t]) {
+			printf("mi8gpu: step 23 VERDICT launch %c: ALL THREE STORES MATCHED\n", 'A' + t);
+		} else if (ctl[t] == CS_WANT && loaded[t] == expected[t] && loaded2[t] == expected2[t]) {
+			printf("mi8gpu: step 23 VERDICT launch %c: THE PRIVATE ROUND TRIP DID NOT MATCH\n", 'A' + t);
+		} else if (ctl[t] == CS_WANT && loaded[t] == expected[t]) {
+			printf("mi8gpu: step 23 VERDICT launch %c: GROUP 1 STORED, GROUP 2 DID NOT\n", 'A' + t);
+		} else if (ctl[t] == CS_WANT) {
+			printf("mi8gpu: step 23 VERDICT launch %c: control stored, THE VALUE IS NOT THE EXPECTED ONE\n", 'A' + t);
+		} else {
+			printf("mi8gpu: step 23 VERDICT launch %c: even the control store is missing\n", 'A' + t);
+		}
+		if (t == 0 && reached[0] == 3) {
+			cs_state_readback();
+			printf("mi8gpu: step 23 READBACK SP_CS_CONST_CONFIG reg 0x0b987: the CPU reads 0x%08x\n", rd(gpu3d + 4u * 0x0b987u));
+		}
+		if (!drained) {
+			printf("mi8gpu: step 23: the CP stopped at launch %c; the rest is not attempted\n", 'A' + t);
+			break;
+		}
+	}
+	printf("mi8gpu: step 23 WHOLE1 TABLE: 12 real compiled instructions verbatim from Mesa's own dump, 2 nop placeholders (stgb, end), 15-slot judge tail + closing control store, 64 dwords / 2 groups, no private path, control 0badf00d, c4.x/(+0x222) invariants\n");
+	for (t = 0; t < n_plan; t++) {
+		const char *v;
+
+		if (reached[t] != 3) {
+			v = "no reading (ring did not finish)";
+		} else if (faulted[t]) {
+			v = "the bank faulted";
+		} else if (ctl[t] != CS_WANT) {
+			v = "the program did not store";
+		} else if ((plan[t].flags & CS_F_Q_WHOLE) != 0
+		    && loaded[t] == expected[t] && loaded2[t] == expected2[t]) {
+			v = "WHOLE BODY OK (real code ran; control, c4.x and +0x222 stored)";
+		} else if (loaded[t] == expected[t] && loaded2[t] == expected2[t]
+		    && loaded3[t] == expected3[t]) {
+			v = ((plan[t].flags & CS_F_Q_NOPVT) != 0) ? "PVT3 NOP CONTROL OK (region stayed empty)" : "PVT3 ROUND TRIP OK (result[6] == c0.x + 0x222)";
+		} else if (loaded[t] == expected[t] && loaded2[t] == expected2[t]) {
+			v = "PRIVATE ROUND-TRIP VALUE WRONG (the invariant pair still matched)";
+		} else if (loaded3[t] == CS_CONST_SENTINEL || loaded3[t] == (uint32_t)(CS_CONST_SENTINEL + CS_ALU2_IMM)) {
+			v = "READ THE SENTINEL -- memory path, not private";
+		} else {
+			v = "unexpected value";
+		}
+		printf("mi8gpu: step 23   %c  %-52s  %s\n", 'A' + t, plan[t].what, v);
+	}
+	{
+		uint32_t n_ok = 0;
+
+		for (t = 0; t < n_plan; t++) {
+			if (reached[t] == 3 && !faulted[t] && ctl[t] == CS_WANT
+			    && loaded[t] == expected[t] && loaded2[t] == expected2[t]
+			    && ((plan[t].flags & CS_F_Q_WHOLE) != 0
+			        || loaded3[t] == expected3[t])) {
+				n_ok++;
+			}
+		}
+		printf("mi8gpu: step 23 SUMMARY: %u of %u launches produced the expected value in all three stores\n", n_ok, n_plan);
+		if (ctl[0] != CS_WANT) {
+			printf("mi8gpu: step 23 SUMMARY: even the control store failed; not comparable\n");
+		} else if (n_ok == n_plan) {
+			printf("mi8gpu: step 23 SUMMARY: THE REAL COMPILED BODY RAN -- four uploads through Mesa's own 12-instruction stream, and the judge tail still stored the control, c4.x and c4.x+0x222\n");
+		} else {
+			printf("mi8gpu: step 23 SUMMARY: the real compiled body did not reproduce the judge tail's three stores\n");
+		}
+	}
+
+	/*
+	 * B75: this sensor IS a deliberate page fault -- CP_MEM_WRITE to 0x10100000
+	 * with no PTE under it -- and its own comment says what that costs: "a write
+	 * that faults may leave the CP waiting for a completion that never comes".
+	 * It is last inside step 23, but step 24 is submitted to the SAME CP in the
+	 * SAME boot, so "last" was never last. B74 measured the consequence: all
+	 * three arms executed zero clock ticks, RS3 stalled 16 words short, and the
+	 * bare CP_MEM_WRITE after them never landed -- the engine was already parked
+	 * before the resolve stream was written. The calibration it buys (B35: an
+	 * unmapped access does fault, FSR 0x400 -> 0x402) is in the record, so it is
+	 * skipped when step 24 needs a live CP.
+	 */
+	if (gmu_last_step < 24) {
+		cs_hole_sensor();
+	} else {
+		printf("mi8gpu: step 23 HOLE SENSOR: SKIPPED -- a write that faults parks the CP, and step 24 runs after it in the same boot (B74)\n");
+	}
+}
+
+
+/*
+ * B70: one ring against the RB resolve engine.
+ *
+ * The packets are all things this driver already emits elsewhere: a type-4
+ * register write per field (pkt4, the same shape cs_ncr uses), CP_WAIT_FOR_IDLE,
+ * CP_EVENT_WRITE, and a CACHE_FLUSH_TS fence whose last dword the driver
+ * supplies -- that fence is also what pushes the core's caches to DRAM, without
+ * which a store can sit in the core and never reach the memory the CPU reads
+ * (B34, and the reason a resolve needs it too).
+ *
+ * Order matters and follows Turnip's clear_gmem_attachment + event_blit_run:
+ * the destination first, then RB_RESOLVE_OPERATION, then the clear colour when
+ * there is one, then CCU_RESOLVE. Two events with a WAIT_FOR_IDLE between them
+ * when the clear is on, so the clear has retired before the store reads GMEM.
+ *
+ * B76 finally implements that sentence for RS2: B75 proved the STORE path but
+ * wrote zeros, because the four clear-colour registers were never written and
+ * OPERATION stayed TYPE=STORE(0). RS1/RS3 are untouched (the control arms).
+ */
+static bool
+rs_launch(uint32_t phase, const char *what, bool drop_lead)
+{
+	uint32_t *ring = (uint32_t *)g3d_regions[1].memory;
+	uint32_t w = cp_wptr & 8191u;
+	const uint64_t fence_iova = g3d_regions[2].address + CS_FENCE_OFF;
+	const uint64_t rt_iova = g3d_regions[G3D_R_RT].address + RS_TARGET_OFF;
+	const uint64_t clock_iova = g3d_regions[2].address + RS_CLOCK_OFF + 4u * (uint64_t)RS_CLOCK_STRIDE * (uint64_t)phase;
+
+#define RS_PUT(v)	(ring[w++ & 8191u] = (uint32_t)(v))
+/*
+* B74: one clock tick. CP_MEM_WRITE with cnt 3 -- address lo, address hi and one
+* data dword -- is the packet step 23's own markers use and it writes a dword
+* the CPU reads back directly, so the tick cannot be lost the way a CP-side
+* instrument can. Each tick is 4 dwords, and the value names its own index.
+*/
+#define RS_TICK(n)	do {							\
+		const uint64_t c_ = clock_iova + 4u * ((uint32_t)(n) - 1u);	\
+										\
+		RS_PUT(pkt7(CP_MEM_WRITE_OPCODE, 3u));				\
+		RS_PUT((uint32_t)c_);							\
+		RS_PUT((uint32_t)(c_ >> 32));					\
+		RS_PUT(RS_CLOCK(n));							\
+	} while (0)
+	/* tick 1: the very first packet of this stream. If it is missing, the CP
+	 * does not execute this stream at all and no packet in it is to blame. */
+	RS_TICK(1);
+	if (!drop_lead) {
+		/* B74's suspect: the only packet step 23 never puts first. */
+		RS_PUT(pkt7(0x26u, 0u));				/* CP_WAIT_FOR_IDLE */
+	}
+	RS_TICK(2);
+	/* the one runtime value: where the resolve lands */
+	RS_PUT(pkt4(0x88d8u, 1u));
+	RS_PUT((uint32_t)rt_iova);
+	RS_PUT(pkt4(0x88d9u, 1u));
+	RS_PUT((uint32_t)(rt_iova >> 32));
+	for (uint32_t i = 0; i < (uint32_t)(sizeof(rs_ctx) / sizeof(rs_ctx[0])); i++) {
+		RS_PUT(pkt4(rs_ctx[i].reg, 1u));
+		RS_PUT(rs_ctx[i].value);
+	}
+	RS_TICK(3);
+	if (phase == 1u) {
+		/* B76: the clear arm now really clears. B75's comment promised the
+		 * clear colour and a second event, but neither was ever emitted.
+		 * turnip writes RB_RESOLVE_CLEAR_COLOR_DW0..3 as ONE pkt4 and then
+		 * BLIT_EVENT_CLEAR(2); for RGBA8 only DW0 carries the pixel, so the
+		 * other three dwords are zero. BUFFER_ID is 0 for a colour target. */
+		RS_PUT(pkt4(0x88dfu, 4u));		/* CLEAR_COLOR_DW0..3 */
+		RS_PUT(RS_COLOR0);
+		RS_PUT(0u);
+		RS_PUT(0u);
+		RS_PUT(0u);
+		RS_PUT(pkt4(0x88e3u, 1u));
+		RS_PUT(0x000000f2u);			/* TYPE=CLEAR(2) | CLEAR_MASK 0xf */
+		RS_PUT(pkt7(0x46u, 1u));		/* CP_EVENT_WRITE */
+		RS_PUT(0x0000001eu);			/* CCU_RESOLVE: clear GMEM */
+		RS_PUT(pkt7(0x26u, 0u));		/* CP_WAIT_FOR_IDLE */
+	}
+	RS_PUT(pkt4(0x88e3u, 1u));
+	RS_PUT(0x000000f0u);				/* TYPE=STORE(0) | CLEAR_MASK 0xf */
+	RS_PUT(pkt7(0x46u, 1u));			/* CP_EVENT_WRITE */
+	RS_PUT(0x0000001eu);				/* CCU_RESOLVE: GMEM -> our buffer */
+	RS_TICK(4);
+	RS_PUT(pkt7(0x26u, 0u));			/* CP_WAIT_FOR_IDLE */
+	RS_TICK(5);
+	RS_PUT(pkt7(0x46u, 4u));			/* CP_EVENT_WRITE */
+	RS_PUT(0x04u);					/* EVENT_CACHE_FLUSH_TS */
+	RS_PUT((uint32_t)fence_iova);
+	RS_PUT((uint32_t)(fence_iova >> 32));
+	RS_PUT(0xf00d0000u | (0x51u + phase));	/* the value the driver supplies */
+	RS_TICK(6);
+	RS_PUT(pkt7(CP_MEM_WRITE_OPCODE, 3u));	/* the last marker: the ring ran out */
+	RS_PUT((uint32_t)(g3d_regions[2].address + CS_MARKER_OFF + 4u * (3u * RS_TAG + 2u)));
+	RS_PUT((uint32_t)((g3d_regions[2].address + CS_MARKER_OFF + 4u * (3u * RS_TAG + 2u)) >> 32));
+	RS_PUT(RS_MARK(2));
+#undef RS_TICK
+#undef RS_PUT
+	{
+		const uint32_t target_wptr = w & 8191u;
+
+		to_memory(g3d_regions[1].memory, g3d_regions[1].size);
+		wr(gpu3d + 4 * 0x0807, target_wptr);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (uint32_t i = 0; i < 20000; i++) {
+			if (rd(gpu3d + 4 * 0x0806) == target_wptr) {
+				break;
+			}
+			sleep_us(10);
+		}
+		cp_wptr = target_wptr;
+		/* the line the B70-B73 judge already reads, unchanged */
+		printf("mi8gpu: step 24: %s: RB_RPTR %u WPTR %u, FSR %#010x\n", what,
+		    rd(gpu3d + 4 * 0x0806), target_wptr, rd(smmu_cb(G3D_CTX) + CB_FSR));
+		/* B74: what step 23 waits for and rs_launch never did */
+		printf("mi8gpu: step 24 IDLE %s: RBBM_STATUS %#010x INT_0_STATUS %#010x\n", what,
+		    rd(gpu3d + 4 * 0x0210), rd(gpu3d + 4 * 0x0201));
+		return rd(gpu3d + 4 * 0x0806) == target_wptr;
+	}
+}
+
+/*
+ * B70b: the same destination, and one ring that adds bin geometry to it.
+ *
+ * The readback in front of the verdict is an instrument, not a variable: it
+ * asks the CP what the four geometry registers hold, so a silent engine can be
+ * told from a register write that never arrived.
+ */
+static void
+rs_state_readback(void)
+{
+	static const struct {
+		const char *name;
+		uint32_t reg;
+	} r[] = {
+		{ "RB_RESOLVE_CNTL_3",          0x88d3u },
+		{ "RB_RESOLVE_SYS_BUF_PITCH",   0x88dau },
+		{ "RB_RESOLVE_OPERATION",       0x88e3u },
+		{ "RB_RESOLVE_SYS_BUF_INFO",    0x88d7u },
+	};
+	const uint32_t n = (uint32_t)(sizeof(r) / sizeof(r[0]));
+	const uint64_t rb = g3d_regions[2].address + RS_RB_OFF;
+	volatile uint32_t *slot = (volatile uint32_t *)((vm_offset_t)g3d_regions[2].memory + RS_RB_OFF);
+	uint32_t *ring = (uint32_t *)g3d_regions[1].memory;
+	uint32_t w = cp_wptr & 8191u;
+	uint32_t cpu[4], cpv[4], landed = 0;
+
+	for (uint32_t i = 0; i < n; i++) {
+		slot[i] = 0;
+		cpu[i] = rd(gpu3d + 4 * r[i].reg);
+	}
+	to_memory((vm_offset_t)slot, 4u * n);
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t d = (uint32_t)(rb + 4u * i);
+
+		ring[w++ & 8191u] = pkt7(0x3eu, 3u);	/* CP_REG_TO_MEM, CNT 0 == one dword */
+		ring[w++ & 8191u] = r[i].reg & 0x3ffffu;
+		ring[w++ & 8191u] = d;
+		ring[w++ & 8191u] = 0u;
+	}
+	{
+		const uint32_t target_wptr = w & 8191u;
+
+		to_memory(g3d_regions[1].memory, g3d_regions[1].size);
+		wr(gpu3d + 4 * 0x0807, target_wptr);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (uint32_t i = 0; i < 20000; i++) {
+			if (rd(gpu3d + 4 * 0x0806) == target_wptr) {
+				break;
+			}
+			sleep_us(10);
+		}
+		cp_wptr = target_wptr;
+		if (rd(gpu3d + 4 * 0x0806) != target_wptr) {
+			printf("mi8gpu: step 24 READBACK: the CP did not drain the readback ring; nothing below is evidence\n");
+			return;
+		}
+	}
+	sleep_us(1000);
+	from_memory((vm_offset_t)slot, 4u * n);
+	for (uint32_t i = 0; i < n; i++) {
+		cpv[i] = slot[i];
+		if (cpv[i] != 0) {
+			landed++;
+		}
+		printf("mi8gpu: step 24 RBREAD %-24s reg %#07x: the CPU reads %#010x, CP_REG_TO_MEM wrote %#010x\n",
+		    r[i].name, r[i].reg, cpu[i], cpv[i]);
+	}
+	printf("mi8gpu: step 24 RBREAD: %u of %u resolve registers are non-zero on the core -> %s\n",
+	    landed, n,
+	    landed == 0
+	    ? "THE WRITES DID NOT REACH THE CORE, so no geometry theory applies yet"
+	    : "the resolve state IS on the core, so any silence is the engine and not the write");
+}
+
+/*
+ * B71: three questions, one ring, no behaviour changed.
+ *
+ * The resolve rung has produced two nulls, and the instrument meant to explain
+ * them returned values nobody wrote. A null read through a blind instrument is
+ * not evidence, so this runs before any more theory: can the CPU write and read
+ * this block, does a type-4 packet from the CP reach it, and can the CP read it
+ * back at all -- with a control register step 23 already reads non-zero through
+ * the same packet.
+ */
+static void
+rs_calibrate(void)
+{
+	uint32_t *ring = (uint32_t *)g3d_regions[1].memory;
+	uint32_t w = cp_wptr & 8191u;
+	const uint64_t rb = g3d_regions[2].address + RS_RB_OFF + 0x20u;
+	volatile uint32_t *slot = (volatile uint32_t *)((vm_offset_t)g3d_regions[2].memory
+	    + RS_RB_OFF + 0x20u);
+	uint32_t a0, a2, az, landed;
+
+	/* A0: the block answered in B71; ask again, so this boot carries its own
+	 * control and a change in A0 alone would already be news. */
+	wr(gpu3d + 4 * RS_CAL_A, RS_CAL_VA);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a0 = rd(gpu3d + 4 * RS_CAL_A);
+	printf("mi8gpu: step 24 CAL A0: CPU %#07x <- %#010x, reads %#010x\n",
+	    RS_CAL_A, RS_CAL_VA, a0);
+
+	/* A2: A could only prove 0x88d0 writable. Until 0x88d1 is proven writable,
+	 * "the CP wrote and nothing landed" and "no write can ever land" are the
+	 * same picture -- which is exactly the mistake B71 was built to avoid. */
+	wr(gpu3d + 4 * RS_CAL_B, RS_CAL_VB);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	a2 = rd(gpu3d + 4 * RS_CAL_B);
+	wr(gpu3d + 4 * RS_CAL_B, 0u);		/* B must be seen as a change */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	az = rd(gpu3d + 4 * RS_CAL_B);
+	printf("mi8gpu: step 24 CAL A2: CPU %#07x <- %#010x, reads %#010x, zeroed reads %#010x\n",
+	    RS_CAL_B, RS_CAL_VB, a2, az);
+
+	/* C1, the type-4, C2. Same register, same packet, order is the only
+	 * difference -- so any difference between C1 and C2 is the type-4's doing. */
+	slot[0] = 0;
+	slot[1] = 0;
+	to_memory((vm_offset_t)slot, 8u);
+	ring[w++ & 8191u] = pkt7(0x3eu, 3u);		/* C1: control, before */
+	ring[w++ & 8191u] = RS_CAL_CTL & 0x3ffffu;
+	ring[w++ & 8191u] = (uint32_t)rb;
+	ring[w++ & 8191u] = 0u;
+	ring[w++ & 8191u] = pkt4(RS_CAL_B, 1u);		/* B: the packet under test */
+	ring[w++ & 8191u] = RS_CAL_VB;
+	ring[w++ & 8191u] = pkt7(0x3eu, 3u);		/* C2: control, after */
+	ring[w++ & 8191u] = RS_CAL_CTL & 0x3ffffu;
+	ring[w++ & 8191u] = (uint32_t)(rb + 4u);
+	ring[w++ & 8191u] = 0u;
+	{
+		const uint32_t target_wptr = w & 8191u;
+
+		to_memory(g3d_regions[1].memory, g3d_regions[1].size);
+		wr(gpu3d + 4 * 0x0807, target_wptr);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (uint32_t i = 0; i < 20000; i++) {
+			if (rd(gpu3d + 4 * 0x0806) == target_wptr) {
+				break;
+			}
+			sleep_us(10);
+		}
+		cp_wptr = target_wptr;
+		if (rd(gpu3d + 4 * 0x0806) != target_wptr) {
+			printf("mi8gpu: step 24 CAL: the CP did not drain the calibration ring; nothing below is evidence\n");
+			wr(gpu3d + 4 * RS_CAL_A, 0u);
+			wr(gpu3d + 4 * RS_CAL_B, 0u);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			return;
+		}
+	}
+	sleep_us(1000);
+	from_memory((vm_offset_t)slot, 8u);
+	landed = rd(gpu3d + 4 * RS_CAL_B);
+	printf("mi8gpu: step 24 CAL B: after pkt4 %#07x <- %#010x the CPU reads %#010x\n",
+	    RS_CAL_B, RS_CAL_VB, landed);
+	printf("mi8gpu: step 24 CAL C1: control %#07x BEFORE the pkt4 reads %#010x\n",
+	    RS_CAL_CTL, slot[0]);
+	printf("mi8gpu: step 24 CAL C2: control %#07x AFTER the pkt4 reads %#010x\n",
+	    RS_CAL_CTL, slot[1]);
+
+	wr(gpu3d + 4 * RS_CAL_A, 0u);
+	wr(gpu3d + 4 * RS_CAL_B, 0u);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * B70a: two phases against one target, so one boot answers both questions.
+ *
+ *   RS1  TYPE=STORE only. The CPU fills the target with 0xcdcdcdcd first, so
+ *        "GMEM reached our buffer" is visible without knowing GMEM's contents.
+ *   RS2  TYPE=CLEAR(0x80402010, ...) then STORE. 0xcd is still the pattern
+ *        outside the rectangle, so three outcomes are distinguishable:
+ *          the whole target still 0xcd      -> the resolve path did not run
+ *          the whole target is the colour   -> the rectangle did not clip
+ *          inside is the colour, outside 0xcd -> the engine obeyed both
+ *
+ * What is NOT here on purpose: RB_CCU_CNTL. See the header.
+ */
+/*
+ * B73: reads only. rs_launch already leaves two marks of how far the CP got --
+ * a fence written by CP_EVENT_WRITE(CACHE_FLUSH_TS) and a marker written by
+ * CP_MEM_WRITE as the last packet of RS3 -- and nobody has ever read them back.
+ * If the marker is there the CP executed the whole statement and its silence is
+ * the engine's; if the fence is not, it stopped inside RS1. CP_PROTECT is read
+ * too: it is the one gate the CPU's MMIO path bypasses, and the one thing on
+ * this path that has never been looked at.
+ */
+static void
+rs_protect(void)
+{
+	const vm_offset_t base = (vm_offset_t)g3d_regions[2].memory;
+	uint32_t cntl, status, i, live = 0, covers = 0;
+	uint32_t fence, mark;
+
+	from_memory(base + CS_FENCE_OFF, 4u);
+	from_memory(base + CS_MARKER_OFF + 4u * (3u * RS_TAG + 2u), 4u);
+	fence = *(volatile uint32_t *)(base + CS_FENCE_OFF);
+	mark = *(volatile uint32_t *)(base + CS_MARKER_OFF + 4u * (3u * RS_TAG + 2u));
+	printf("mi8gpu: step 24 AFTER: fence %#010x (want %#010x), marker %#010x (want %#010x)\n",
+	    fence, 0xf00d0000u | 0x53u, mark, RS_MARK(2u));
+
+	cntl = rd(gpu3d + 4 * PRT_CNTL);
+	printf("mi8gpu: step 24 PROT CNTL %#010x: EN %u, FAULT_ON_VIOL %u, LAST_SPAN_INF %u\n",
+	    cntl, cntl & 1u, (cntl >> 1) & 1u, (cntl >> 3) & 1u);
+
+	for (i = 0; i < 32u; i++) {
+		const uint32_t v = rd(gpu3d + 4 * (PRT_BASE + i));
+		const uint32_t wbase = v & 0x3ffffu;
+		const uint32_t mask = (v >> 18) & 0x1fffu;
+
+		if (v == 0u) {
+			continue;
+		}
+		live++;
+		if ((RS_CAL_B & ~mask) == wbase) {
+			covers++;
+		}
+		printf("mi8gpu: step 24 PROT[%u] %#010x: base %#07x mask %#05x read %u%s\n",
+		    i, v, wbase, mask, (v >> 31) & 1u,
+		    ((RS_CAL_B & ~mask) == wbase) ? " COVERS 0x88d1" : "");
+	}
+	printf("mi8gpu: step 24 PROT: %u of 32 windows are set, %u of them cover %#07x\n",
+	    live, covers, RS_CAL_B);
+
+	status = rd(gpu3d + 4 * PRT_STATUS);
+	printf("mi8gpu: step 24 PROT STATUS %#010x: addr %#07x viol %u halted %u read %u\n",
+	    status, status & 0x3fffu, (status >> 22) & 1u, (status >> 21) & 1u,
+	    (status >> 20) & 1u);
+}
+
+/*
+* B74: the clock, read from the CPU. Nothing here emits a packet.
+*/
+static void
+rs_clock_clear(void)
+{
+	vm_offset_t base = (vm_offset_t)g3d_regions[2].memory + RS_CLOCK_OFF;
+	const uint32_t words = RS_CLOCK_STRIDE * (RS_CLOCK_ARMS + 1u);
+
+	for (uint32_t i = 0; i < words; i++) {
+		*(volatile uint32_t *)(base + 4u * i) = 0;
+	}
+	to_memory(base, 4u * words);
+	printf("mi8gpu: step 24 CLOCK: %u arms of %u ticks zeroed at offset %#x, one CP_MEM_WRITE per tick\n",
+	    RS_CLOCK_ARMS + 1u, RS_CLOCK_N, RS_CLOCK_OFF);
+}
+
+static void
+rs_clock_report(uint32_t phase, const char *what)
+{
+	vm_offset_t base = (vm_offset_t)g3d_regions[2].memory + RS_CLOCK_OFF
+	    + 4u * (vm_offset_t)RS_CLOCK_STRIDE * phase;
+	uint32_t last = 0;
+
+	from_memory(base, 4u * RS_CLOCK_N);
+	for (uint32_t i = 0; i < RS_CLOCK_N; i++) {
+		if (*(volatile uint32_t *)(base + 4u * i) == RS_CLOCK(i + 1u)) {
+			last = i + 1u;
+		}
+	}
+	printf("mi8gpu: step 24 CLOCK %s: %08x %08x %08x %08x %08x %08x\n", what,
+	    *(volatile uint32_t *)(base + 0u), *(volatile uint32_t *)(base + 4u),
+	    *(volatile uint32_t *)(base + 8u), *(volatile uint32_t *)(base + 12u),
+	    *(volatile uint32_t *)(base + 16u), *(volatile uint32_t *)(base + 20u));
+	printf("mi8gpu: step 24 CLOCK %s: highest tick that ran %u of %u%s\n", what, last, RS_CLOCK_N,
+	    last == RS_CLOCK_N
+	    ? " (the whole stream executed)"
+	    : " (the CP stopped before the next tick)");
+}
+
+/*
+* B74: the last question the three arms cannot answer. If a bare CP_MEM_WRITE
+* submitted on its own, after everything, still does not land, the CP is wedged
+* for good and every later step in this boot is meaningless. If it does land,
+* the wedge is per-stream and the ring drains back to a usable state.
+*/
+static void
+rs_after_control(void)
+{
+	uint32_t *ring = (uint32_t *)g3d_regions[1].memory;
+	vm_offset_t slot = (vm_offset_t)g3d_regions[2].memory + RS_CLOCK_OFF
+	    + 4u * (vm_offset_t)RS_CLOCK_STRIDE * RS_CLOCK_ARMS;
+	const uint64_t iova = g3d_regions[2].address + RS_CLOCK_OFF
+	    + 4u * (uint64_t)RS_CLOCK_STRIDE * (uint64_t)RS_CLOCK_ARMS;
+	uint32_t w = cp_wptr & 8191u;
+	uint32_t target, got;
+
+	*(volatile uint32_t *)slot = 0;
+	to_memory(slot, 4u);
+	ring[w++ & 8191u] = pkt7(CP_MEM_WRITE_OPCODE, 3u);
+	ring[w++ & 8191u] = (uint32_t)iova;
+	ring[w++ & 8191u] = (uint32_t)(iova >> 32);
+	ring[w++ & 8191u] = RS_CLOCK(1u);
+	target = w & 8191u;
+	to_memory(g3d_regions[1].memory, g3d_regions[1].size);
+	wr(gpu3d + 4 * 0x0807, target);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t i = 0; i < 20000; i++) {
+		if (rd(gpu3d + 4 * 0x0806) == target) {
+			break;
+		}
+		sleep_us(10);
+	}
+	cp_wptr = target;
+	from_memory(slot, 4u);
+	got = *(volatile uint32_t *)slot;
+	printf("mi8gpu: step 24 AFTER-CTL: one bare CP_MEM_WRITE after step 24, RB_RPTR %u WPTR %u, slot %#010x (%s)\n",
+	    rd(gpu3d + 4 * 0x0806), target, got,
+	    got == RS_CLOCK(1u)
+	    ? "LANDED, the CP still executes"
+	    : "did NOT land, the CP is wedged for good");
+}
+
+static void
+rs_probe(void)
+{
+	uint32_t *rt = (uint32_t *)g3d_regions[G3D_R_RT].memory;
+	const uint32_t bytes = g3d_regions[G3D_R_RT].size;
+	uint32_t changed, exact, i;
+	uint32_t changed3, rs2_exact;
+	bool rs2_clipped, rs3_clipped;
+	bool drained;
+
+	printf("mi8gpu: step 24: the render backend writes a buffer we own, RB resolve, %ux%u RGBA8, no shader\n",
+	    (unsigned)RS_W, (unsigned)RS_H);
+	printf("mi8gpu: step 24 RS TABLE: eleven resolve registers and CCU_RESOLVE 0x1e, linear RGBA8, GMEM offset 0, %u bytes, TYPE=STORE then TYPE=CLEAR\n",
+	    (unsigned)(RS_DWORDS * 4u));
+	printf("mi8gpu: step 24 B76: RS2 writes RB_RESOLVE_CLEAR_COLOR_DW0..3, "
+	    "TYPE=CLEAR(2) then TYPE=STORE(0), one WAIT_FOR_IDLE between them\n");
+
+	rs_clock_clear();
+	/*
+	 * B75: CB_FSR is sticky and already holds 0x400 at boot, so rs_launch's FSR
+	 * column would read the same whether or not this stream faulted. Clear it
+	 * and say what was cleared -- exactly what the hole sensor does before it
+	 * arms itself -- so the column means "did THIS stream fault".
+	 */
+	{
+		uint32_t fsr = rd(smmu_cb(G3D_CTX) + CB_FSR);
+
+		wr(smmu_cb(G3D_CTX) + CB_FSR, fsr);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("mi8gpu: step 24 FSR: cleared %#010x before the three streams\n", fsr);
+	}
+
+	/* arm 1: B73's stream exactly, opening CP_WAIT_FOR_IDLE kept, ticks added */
+	for (i = 0; i < bytes / 4u; i++) {
+		rt[i] = RS_FILL;
+	}
+	to_memory(g3d_regions[G3D_R_RT].memory, bytes);
+	drained = rs_launch(0u, "RS1 STORE", false);
+	from_memory(g3d_regions[G3D_R_RT].memory, bytes);
+	changed = 0;
+	for (i = 0; i < RS_DWORDS; i++) {
+		if (rt[i] != RS_FILL) {
+			changed++;
+		}
+	}
+	printf("mi8gpu: step 24 RS1: %u of %u dwords differ from the CPU pattern, first %#010x %#010x, drained %u\n",
+	    changed, (unsigned)RS_DWORDS, rt[0], rt[RS_DWORDS - 1u], drained ? 1u : 0u);
+	rs_clock_report(0u, "RS1 STORE");
+
+	/* arm 2: unchanged from B73 -- the same STORE with a clear in front of it */
+	for (i = 0; i < bytes / 4u; i++) {
+		rt[i] = RS_FILL;
+	}
+	to_memory(g3d_regions[G3D_R_RT].memory, bytes);
+	drained = rs_launch(1u, "RS2 CLEAR", false);
+	from_memory(g3d_regions[G3D_R_RT].memory, bytes);
+	exact = 0;
+	for (i = 0; i < RS_DWORDS; i++) {
+		if (rt[i] == RS_COLOR0) {
+			exact++;
+		}
+	}
+	printf("mi8gpu: step 24 RS2: %u of %u dwords are %#010x, last %#010x, just past the rect %#010x, drained %u\n",
+	    exact, (unsigned)RS_DWORDS, RS_COLOR0, rt[RS_DWORDS - 1u], rt[RS_DWORDS], drained ? 1u : 0u);
+	rs2_exact = exact;
+	rs2_clipped = (rt[RS_DWORDS] == RS_FILL);
+	rs_clock_report(1u, "RS2 CLEAR");
+
+	/* arm 3: arm 1 minus the opening CP_WAIT_FOR_IDLE -- ONE variable */
+	for (i = 0; i < bytes / 4u; i++) {
+		rt[i] = RS_FILL;
+	}
+	to_memory(g3d_regions[G3D_R_RT].memory, bytes);
+	drained = rs_launch(2u, "RS3 NOWAIT", true);
+	from_memory(g3d_regions[G3D_R_RT].memory, bytes);
+	changed3 = 0;
+	for (i = 0; i < RS_DWORDS; i++) {
+		if (rt[i] != RS_FILL) {
+			changed3++;
+		}
+	}
+	rs3_clipped = (rt[RS_DWORDS] == RS_FILL);
+	printf("mi8gpu: step 24 RS3: %u of %u dwords differ from the CPU pattern, first %#010x, past the rect %#010x, drained %u\n",
+	    changed3, (unsigned)RS_DWORDS, rt[0], rt[RS_DWORDS], drained ? 1u : 0u);
+	rs_clock_report(2u, "RS3 NOWAIT");
+
+	rs_after_control();
+	rs_state_readback();
+	rs_calibrate();
+	rs_protect();
+	printf("mi8gpu: step 24 VERDICT: %s\n",
+	    (changed3 > 0 && rs3_clipped)
+	    ? "WITHOUT THE OPENING WAIT THE RESOLVE WROTE THE BUFFER, AND STOPPED AT THE RECTANGLE"
+	    : (changed3 > 0)
+	    ? "WITHOUT THE OPENING WAIT IT WROTE, but past the rectangle"
+	    : (rs2_exact == RS_DWORDS && rs2_clipped)
+	    ? "THE RESOLVE WROTE THE COLOUR WE ASKED FOR AND STOPPED AT THE RECTANGLE"
+	    : (rs2_exact == 0 && rs2_clipped)
+	    ? "STILL NOTHING -- the CLOCK lines say how far each stream got"
+	    : "PARTIAL -- count the dwords above: the rectangle or the pitch is off");
+}
+
+/*
+ * B77: the first GPU scaling statement on this ladder.
+ *
+ * One CP_BLIT packet does the whole 2x stretch. The six ticks, the WFI
+ * after the blit, the CACHE_FLUSH_TS fence and the closing CP_MEM_WRITE
+ * marker are B76's own instruments on their own memptrs slots, so a
+ * silent engine can be told from a CP that stopped reading the ring.
+ * The CPU pattern is a per-row colour, not a flat fill: a flat fill
+ * cannot distinguish "blitted" from "cleared", and cannot tell whether
+ * the scale factor was applied at all.
+ */
+static void
+bl_probe(void)
+{
+	volatile uint32_t *src = (volatile uint32_t *)g3d_regions[G3D_R_BLITSRC].memory;
+	volatile uint32_t *dst = (volatile uint32_t *)g3d_regions[G3D_R_SURF].memory;
+	volatile uint32_t *memptrs = (volatile uint32_t *)g3d_regions[2].memory;
+	uint32_t *ring = (uint32_t *)g3d_regions[1].memory;
+	const uint64_t src_iova = g3d_regions[G3D_R_BLITSRC].address;
+	const uint64_t dst_iova = g3d_regions[G3D_R_SURF].address;
+	const uint64_t clock_iova = g3d_regions[2].address + BS_CLOCK_OFF;
+	const uint64_t fence_iova = g3d_regions[2].address + BS_FENCE_OFF;
+	const uint64_t mark_iova = g3d_regions[2].address + BS_MARK_OFF;
+	const uint64_t rb_iova = g3d_regions[2].address + BL_RB_OFF;
+	const uint64_t ev_iova = g3d_regions[2].address + B79_EV_OFF;
+	const uint32_t dst_words = g3d_regions[G3D_R_SURF].size / 4u;
+	uint32_t w = cp_wptr & 8191u;
+	uint32_t i, ok_rows = 0, matched = 0, guard = 0, last = 0, drained;
+
+	printf("mi8gpu: step 25 B77 TABLE: A2D SCALE 32x32 -> 64x64 RGBA8, one CP_BLIT, nearest, no shader, no UBWC, 2x row colours\n");
+	printf("mi8gpu: step 25 REGS: BLT %#010x OUT %#010x SRCINFO %#010x SRCPITCH %#010x DSTPITCH %#010x SIZE %#010x BR %#010x SRCMAX %#010x\n",
+	    BS_BLIT_CNTL, BS_OUTPUT_INFO, BS_SRC_INFO, BS_SRC_PITCH,
+	    BS_DST_PITCH, BS_SRC_SIZE, BS_DEST_BR, BS_SRC_MAX);
+	{
+		PE_Video pv;
+
+		memset(&pv, 0, sizeof(pv));
+		if (PE_current_console(&pv) == 0) {
+			printf("mi8gpu: step 25 PANEL: base %#llx row %lu w %lu h %lu depth %lu, fmt %.8s, row/64 %lu rem %lu\n",
+			    (unsigned long long)pv.v_baseAddr, pv.v_rowBytes, pv.v_width,
+			    pv.v_height, pv.v_depth, pv.v_pixelFormat,
+			    pv.v_rowBytes / 64u, pv.v_rowBytes % 64u);
+		} else {
+			printf("mi8gpu: step 25 PANEL: PE_current_console refused\n");
+		}
+	}
+
+	/* CPU owns both buffers before the statement: fill, then the pattern. */
+	for (i = 0; i < g3d_regions[G3D_R_BLITSRC].size / 4u; i++) {
+		src[i] = BS_FILL;
+	}
+	for (uint32_t y = 0; y < BS_H; y++) {
+		for (uint32_t x = 0; x < BS_W; x++) {
+			src[y * (BS_PITCH / 4u) + x] = BS_PIX(x, y);
+		}
+		if (src[y * (BS_PITCH / 4u)] == BS_PIX(0u, y)) {
+			ok_rows++;
+		}
+	}
+	for (i = 0; i < dst_words; i++) {
+		dst[i] = BS_FILL;
+	}
+	memptrs[BS_FENCE_OFF >> 2] = 0;
+	memptrs[BS_MARK_OFF >> 2] = 0;
+	for (i = 0; i < 6u; i++) {
+		memptrs[(BS_CLOCK_OFF >> 2) + i] = 0;
+	}
+	for (i = 0; i < BL_NREG; i++) {
+		memptrs[(BL_RB_OFF >> 2) + i] = 0;
+	}
+	for (i = 0; i < 4u; i++) {
+		memptrs[(B79_EV_OFF >> 2) + i] = 0;
+	}
+	to_memory(g3d_regions[G3D_R_BLITSRC].memory, g3d_regions[G3D_R_BLITSRC].size);
+	to_memory(g3d_regions[G3D_R_SURF].memory, g3d_regions[G3D_R_SURF].size);
+	to_memory((vm_offset_t)memptrs, 0x1000);
+	printf("mi8gpu: step 25 SRC: %u of %u rows start with BS_PIX(0,y), first %#010x last %#010x\n",
+	    ok_rows, (unsigned)BS_H, src[0], src[(BS_H - 1u) * (BS_PITCH / 4u)]);
+
+#define B_PUT(v)	(ring[w++ & 8191u] = (uint32_t)(v))
+#define B_TICK(n)	do {							\
+		const uint64_t c_ = clock_iova + 4u * ((uint32_t)(n) - 1u);	\
+										\
+		B_PUT(pkt7(CP_MEM_WRITE_OPCODE, 3u));				\
+		B_PUT((uint32_t)c_);						\
+		B_PUT((uint32_t)(c_ >> 32));					\
+		B_PUT(BS_CLOCK(n));						\
+	} while (0)
+	/* tick 1 first: B74 proved a leading WFI is the one packet to suspect. */
+	B_TICK(1);
+	/* B81: the only change from B79 is that this block is GONE.
+	 * B80 already proved POST is load-bearing; this rung asks whether the
+	 * 19-dword PRE block is load-bearing at all, by deleting it from the
+	 * CLOSED B79 sequence and keeping POST, the core and the readbacks.
+	 * The footnote in adreno_pm4.xml:1832 says RM6_BLIT2DSCALE is a
+	 * "no-op (at least on current sqe fw)", so the interesting part of
+	 * PRE is the four CCU events and the pkt4(0x8e07,1) write.
+	 * 19 dwords: statement 137 -> 118, WPTR 973 -> 954. */
+	B_PUT(pkt7(0x26u, 0u));			/* CP_WAIT_FOR_IDLE, not the first packet */
+	B_TICK(2);
+	B_PUT(pkt4(0xb4c0u, 5u));			/* TPL1_A2D_SRC_TEXTURE_INFO..PITCH */
+	B_PUT(BS_SRC_INFO);
+	B_PUT(BS_SRC_SIZE);
+	B_PUT((uint32_t)src_iova);
+	B_PUT((uint32_t)(src_iova >> 32));
+	B_PUT(BS_SRC_PITCH);
+	B_PUT(pkt4(0x8c17u, 4u));			/* RB_A2D_DEST_BUFFER_INFO..PITCH */
+	B_PUT(BS_DST_INFO);
+	B_PUT((uint32_t)dst_iova);
+	B_PUT((uint32_t)(dst_iova >> 32));
+	B_PUT(BS_DST_PITCH);
+	B_PUT(pkt4(0x8c01u, 1u));			/* RB_A2D_PIXEL_CNTL: everything disabled */
+	B_PUT(0u);
+	B_PUT(pkt4(0x8c00u, 1u));			/* RB_A2D_BLT_CNTL */
+	B_PUT(BS_BLIT_CNTL);
+	B_PUT(pkt4(0x8400u, 1u));			/* GRAS_A2D_BLT_CNTL */
+	B_PUT(BS_BLIT_CNTL);
+	B_PUT(pkt4(0xacc0u, 1u));			/* SP_A2D_OUTPUT_INFO, A6XX offset */
+	B_PUT(BS_OUTPUT_INFO);
+	B_PUT(pkt4(0x8405u, 2u));			/* GRAS_A2D_DEST_TL / DEST_BR */
+	B_PUT(BS_DEST_TL);			/* B84: (960,0) -- was a literal 0 */
+	B_PUT(BS_DEST_BR);
+	B_PUT(pkt4(0x8401u, 4u));			/* SRC_XMIN/XMAX/YMIN/YMAX, 16.8 */
+	B_PUT(0u);
+	B_PUT(BS_SRC_MAX);
+	B_PUT(0u);
+	B_PUT(BS_SRC_MAX);
+	B_TICK(3);
+	/* B78: read the A2D state back BEFORE the blit, while the type-4 writes
+	 * are still live. CP_REG_TO_MEM is the packet B71/B73 calibrated; CNT 0
+	 * is one dword. Eleven packets, 44 dwords, no state changed by them. */
+	for (i = 0; i < BL_NREG; i++) {
+		const uint32_t d_ = (uint32_t)(rb_iova + 4u * i);
+
+		B_PUT(pkt7(0x3eu, 3u));			/* CP_REG_TO_MEM */
+		B_PUT(bl_regs[i] & 0x3ffffu);
+		B_PUT(d_);
+		B_PUT(0u);
+	}
+	B_PUT(pkt7(0x2cu, 1u));			/* CP_BLIT */
+	B_PUT(3u);					/* BLIT_OP_SCALE */
+	/* B79 part 2, trimmed in B82: adreno_pm4.xml:517 says the 2D blit
+	 * writes THROUGH the CCU cache in the PS stage. B77/B78 flushed only
+	 * UCHE, so a blit that worked could still be invisible to a CPU read;
+	 * B80 proved this block is the load-bearing half and B81 proved PRE
+	 * contributes nothing. What remains is the clean itself. 6 dwords. */
+	B_PUT(pkt7(0x26u, 0u));			/* CP_WAIT_FOR_IDLE */
+	B_PUT(pkt7(0x46u, 4u));			/* CP_EVENT_WRITE FLUSH_COLOR_TS */
+	B_PUT(0x1du);
+	B_PUT((uint32_t)(ev_iova + 8u));
+	B_PUT((uint32_t)((ev_iova + 8u) >> 32));
+	B_PUT(0xb79cc03u);
+	/* B82: the two invalidates are gone, the clean stays. B80 proved this
+	 * block is load-bearing; B81 proved PRE is decoration. What is left is
+	 * WFI + FLUSH_COLOR_TS only: wait for the 2D blit to retire, then clean
+	 * the colour CCU so the next CPU read sees the pixels.
+	 * 4 dwords removed: statement 118 -> 114, WPTR 954 -> 950. */
+	B_TICK(4);
+	B_PUT(pkt7(0x26u, 0u));			/* CP_WAIT_FOR_IDLE: let the blit retire */
+	B_TICK(5);
+	B_PUT(pkt7(0x46u, 4u));			/* CP_EVENT_WRITE CACHE_FLUSH_TS */
+	B_PUT(0x04u);
+	B_PUT((uint32_t)fence_iova);
+	B_PUT((uint32_t)(fence_iova >> 32));
+	B_PUT(BS_FENCE);
+	B_TICK(6);
+	B_PUT(pkt7(CP_MEM_WRITE_OPCODE, 3u));	/* the last packet of the stream */
+	B_PUT((uint32_t)mark_iova);
+	B_PUT((uint32_t)(mark_iova >> 32));
+	B_PUT(BS_MARK);
+#undef B_TICK
+#undef B_PUT
+	{
+		const uint32_t target_wptr = w & 8191u;
+
+		to_memory(g3d_regions[1].memory, g3d_regions[1].size);
+		wr(gpu3d + 4 * 0x0807, target_wptr);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (i = 0; i < 20000; i++) {
+			if (rd(gpu3d + 4 * 0x0806) == target_wptr) {
+				break;
+			}
+			sleep_us(10);
+		}
+		cp_wptr = target_wptr;
+		drained = (rd(gpu3d + 4 * 0x0806) == target_wptr) ? 1u : 0u;
+		printf("mi8gpu: step 25 A2D: RB_RPTR %u WPTR %u, FSR %#010x, drained %u\n",
+		    rd(gpu3d + 4 * 0x0806), target_wptr,
+		    rd(smmu_cb(G3D_CTX) + CB_FSR), drained);
+	}
+	sleep_us(1000);
+	from_memory(g3d_regions[G3D_R_SURF].memory, g3d_regions[G3D_R_SURF].size);
+	from_memory((vm_offset_t)memptrs, 0x1000);
+
+	/* the verdict is RECOMPUTED here, not taken from a kernel sentence */
+	for (i = 0; i < BS_TOTAL; i++) {
+		const uint32_t row = i / BD_W;
+
+		if (dst[row * BD_STRIDE + BD_X0 + (i % BD_W)]
+		    == BS_PIX((i % BD_W) / 2u, row / 2u)) {
+			matched++;
+		}
+	}
+	for (i = 0; i < dst_words; i++) {
+		const uint32_t gy = i / BD_STRIDE, gx = i % BD_STRIDE;
+
+		if (gy < BD_H && gx >= BD_X0 && gx < BD_X0 + BD_W) {
+			continue;
+		}
+		if (dst[i] == BS_FILL) {
+			guard++;
+		}
+	}
+	for (i = 0; i < 6u; i++) {
+		if (memptrs[(BS_CLOCK_OFF >> 2) + i] == BS_CLOCK(i + 1u)) {
+			last = i + 1u;
+		}
+	}
+	printf("mi8gpu: step 25 CLOCK: %08x %08x %08x %08x %08x %08x, highest tick %u of 6\n",
+	    memptrs[(BS_CLOCK_OFF >> 2) + 0u], memptrs[(BS_CLOCK_OFF >> 2) + 1u],
+	    memptrs[(BS_CLOCK_OFF >> 2) + 2u], memptrs[(BS_CLOCK_OFF >> 2) + 3u],
+	    memptrs[(BS_CLOCK_OFF >> 2) + 4u], memptrs[(BS_CLOCK_OFF >> 2) + 5u], last);
+	printf("mi8gpu: step 25 DST: %u of %u dwords match the 2x mapping, first %#010x last %#010x, drained %u\n",
+	    matched, (unsigned)BS_TOTAL, dst[BD_X0],
+	    dst[(BD_H - 1u) * BD_STRIDE + BD_X0 + BD_W - 1u], drained);
+	printf("mi8gpu: step 25 GUARD: %u of %u dwords outside the rect still hold %#010x\n",
+	    guard, dst_words - (unsigned)BS_TOTAL, BS_FILL);
+	printf("mi8gpu: step 25 ROWS: r0 %#010x r1 %#010x r2 %#010x r3 %#010x\n",
+	    dst[BD_X0], dst[BD_STRIDE + BD_X0], dst[2u * BD_STRIDE + BD_X0],
+	    dst[3u * BD_STRIDE + BD_X0]);
+	printf("mi8gpu: step 25 AFTER: fence %#010x (want %#010x), marker %#010x (want %#010x)\n",
+	    memptrs[BS_FENCE_OFF >> 2], BS_FENCE,
+	    memptrs[BS_MARK_OFF >> 2], BS_MARK);
+	printf("mi8gpu: step 25 VERDICT: %s\n",
+	    (matched == BS_TOTAL && guard == dst_words - BS_TOTAL && last == 6u && drained)
+	    ? "A2D SCALE WROTE EVERY ROW OF THE 2x MAPPING AND STOPPED AT THE RECTANGLE"
+	    : (last == 6u && drained)
+	    ? "THE STATEMENT RETIRED BUT THE COLOURS DID NOT LAND"
+	    : "THE CP STOPPED INSIDE THE STATEMENT");
+}
+
+/*
+ * B78: zero packets. The CPU's MMIO view and the CP's own view of the
+ * very same nine registers, printed side by side with what we wrote.
+ * A silent engine with all eight values on the core is a different
+ * failure from a silent engine whose type-4 writes never arrived.
+ */
+/*
+ * B79: zero packets. Eleven CP_REG_TO_MEM slots, CPU MMIO side by side.
+ * The ninth is B71's control; the last two are the CCU registers the
+ * reference setup writes. B81 writes neither of them, so 0x8e07 is a
+ * PRE-IMAGE here: whatever it reads is the value B79's write left, or
+ * the hardware reset value if that write was a no-op.
+ */
+/* B88: is a driver-owned buffer both an SMMU target and a SweetSurface?
+ *
+ * The "surf" region above is ordinary kernel-contiguous memory that the SMMU
+ * already maps (its ATOS verification ran in g3d_smmu_setup with the rest of
+ * the regions, so the IOVA half of this rung costs no new code). What is new
+ * here is that the SAME physical pages are wrapped in a SweetSurface and then
+ * read back through the surface's own write-combined mapping.
+ *
+ * Why it matters: until B87 the only surface the driver held was the panel's
+ * memory, reachable by the GPU because "screen" is a region with a fixed phys.
+ * Mesa and the swap skeleton need the opposite -- allocate, map, wrap -- so a
+ * negative here is a blocker, not a curiosity.
+ *
+ * Called once, next to mi8_okit_probe(): that is the one place already proven
+ * safe for early-IOKit calls (B87b created a surface there and returned).
+ * No GPU packet is added; WPTR stays 950.
+ */
+static void
+mi8_surf_alias_probe(void)
+{
+	vm_offset_t kva = g3d_regions[G3D_R_SURF].memory;
+	volatile uint32_t *k = (volatile uint32_t *)kva;
+	volatile uint32_t *s;
+	uint64_t pa, atos_pa = 0;
+	unsigned long long va;
+	uint32_t i, fwd = 0, rev = 0, span = 0, pix = 0;
+
+	if (kva == 0) {
+		printf("mi8gpu: step 29 SURF: the %s region was never allocated\n", g3d_regions[G3D_R_SURF].name);
+		return;
+	}
+	pa = kvtophys(kva);
+	va = mi8_surface_bridge_create(pa, 256u, 128u, 1024u, 0x42475241u);
+	if (va == 0) {
+		printf("mi8gpu: step 29 SURF: no surface for phys %#llx (create or map failed)\n", (unsigned long long)pa);
+		return;
+	}
+	s = (volatile uint32_t *)va;
+	printf("mi8gpu: step 29 SURF: driver-owned %s at phys %#llx, surface kernelAddress %#llx\n",
+	    g3d_regions[G3D_R_SURF].name, (unsigned long long)pa, va);
+	if (smmu_translate_in(G3D_CTX, g3d_regions[G3D_R_SURF].address, &atos_pa) == SMMU_TRANSLATED) {
+		printf("mi8gpu: step 29 SURF IOVA: the 3D core sees %#llx as %#llx (%s)\n",
+		    g3d_regions[G3D_R_SURF].address, (unsigned long long)atos_pa,
+		    atos_pa == pa ? "the surface's own pages" : "DIFFERENT PAGES");
+	} else {
+		printf("mi8gpu: step 29 SURF IOVA: the SMMU does not translate %#llx\n",
+		    g3d_regions[G3D_R_SURF].address);
+	}
+	/* B89: the GPU's own pixels, read through the surface's own mapping.
+	 * The blit wrote BS_PIX(x/2, y/2) into this buffer, so four points inside
+	 * the 64 x 64 rect must read back that pattern HERE. B88 tied the two CPU
+	 * views together; this says the bytes the GPU put in are visible through
+	 * the SweetSurface mapping. Read BEFORE the marker writes below, which
+	 * overwrite rows 0 and 0 again. */
+	from_memory((vm_offset_t)s, 64u * 1024u);
+	for (i = 0; i < 4; i++) {
+		uint32_t gx = (i & 1u) * 32u, gy = (i >> 1) * 32u;
+		uint32_t want = 0x5a000000u | ((gy / 2u) << 8) | (gx / 2u + 1u);
+
+		pix += s[gy * 256u + gx] == want;
+	}
+	printf("mi8gpu: step 29 SURF PIXELS: %u of 4 dwords read through the surface are BS_PIX(x/2,y/2)\n", pix);
+	/* direction 1: write through the region's kernel mapping, read through the surface */
+	for (i = 0; i < 64; i++) {
+		k[i] = 0x5ea10000u | i;
+	}
+	to_memory(kva, 256);
+	for (i = 0; i < 64; i++) {
+		fwd += s[i] == (0x5ea10000u | i);
+	}
+	/* direction 2: write through the surface's write-combined mapping, read through the region */
+	for (i = 0; i < 64; i++) {
+		s[128 + i] = 0x5ea20000u | i;
+	}
+	to_memory((vm_offset_t)&s[128], 256);
+	from_memory(kva + 512, 256);
+	for (i = 0; i < 64; i++) {
+		rev += k[128 + i] == (0x5ea20000u | i);
+	}
+	printf("mi8gpu: step 29 SURF ALIAS: region->surface %u of 64, surface->region %u of 64 dwords agree\n", fwd, rev);
+	/* a partial mapping would pass the two 256-byte windows above, so sample
+	 * one dword in every one of 32 rows spread across the whole 128 KB */
+	for (i = 0; i < 32; i++) {
+		uint32_t off = i * 1024u;
+		span += s[off] == k[off];
+	}
+	printf("mi8gpu: step 29 SURF SPAN: %u of 32 sampled rows are the same bytes in both mappings\n", span);
+}
+
+/* B87b: staged early-IOKit probe. Every stage prints PRE, calls ONE C++
+ * function, prints POST. If the kernel panics, the last PRE line in the
+ * persistent ring names the stage (lesson 67).
+ *
+ * Called from two places, runs once (the static flag):
+ *   - the end of bl_readback(): the normal path, AFTER every GPU line, so a
+ *     panic cannot cost the DST/GUARD/readback/CCU regression evidence;
+ *   - right after gpu_zap_and_command(): the bail-out path, so a GPU failure
+ *     (zap not authenticated, core still secure) cannot mask the V2c answer.
+ * Geometry is the panel's own (SweetFramebuffer.cpp:218), not a new variable:
+ * 0x9d400000 / 1080 / 2160 / 4320 / 'BGRA'. */
+static void
+mi8_okit_probe(void)
+{
+	static int done;
+	static const char *const stage_name[5] = {
+		"IOLockAlloc", "kernel_task", "IOBufferMemoryDescriptor",
+		"sweet_surface_create_physical", "kernelAddress"
+	};
+
+	if (done) {
+		return;
+	}
+	done = 1;
+	for (uint32_t st = 1; st <= 5; st++) {
+		uint64_t rc;
+
+		printf("mi8gpu: step 28 IOKIT stage %u PRE: %s\n",
+		    st, stage_name[st - 1]);
+		rc = mi8_surface_bridge_stage(st, G3D_FB_PHYS, 1080u, 2160u,
+		    4320u, 0x42475241u);
+		printf("mi8gpu: step 28 IOKIT stage %u POST: %#llx\n",
+		    st, (unsigned long long)rc);
+	}
+}
+
+static void
+bl_readback(void)
+{
+	vm_offset_t slots = (vm_offset_t)g3d_regions[2].memory + BL_RB_OFF;
+	uint32_t landed = 0, i, cpv, cpu, control, ccu_cp, ccu_cpu, eco_cp, eco_cpu;
+
+	from_memory(slots, 4u * BL_NREG);
+	control = *(volatile uint32_t *)(slots + 4u * BL_CTRL_IDX);
+	ccu_cp = *(volatile uint32_t *)(slots + 4u * BL_CCU_IDX);
+	ccu_cpu = rd(gpu3d + 4 * 0x8e07u);
+	eco_cp = *(volatile uint32_t *)(slots + 4u * BL_ECO_IDX);
+	eco_cpu = rd(gpu3d + 4 * 0x8e04u);
+	/* B86: the SAME 114 dwords. The only new variable is a C-linkage call into the C++ SweetSurface TU; the probe returns a magic and touches no IOKit object, so a negative can only be "the link failed". */
+	printf("mi8gpu: step 27 BRIDGE: C TU reached the C++ SweetSurface TU, magic %#010x (want %#010x)\n",
+	    mi8_surface_bridge_probe(), 0x53555246u);
+	/* B88: the emitted statement is still byte-identical. The bridge now CALLS the real IOKit path in five stages; every PRE/POST pair is printed so a panic names its own stage (lesson 67). */
+	printf("mi8gpu: step 26 B89 TABLE: same 114 dwords, 256 x 128 at pitch 16, GRAS_A2D_DEST_TL (0,0), 2D BS_PIX pattern, 11 CP_REG_TO_MEM reads, THE DESTINATION IS THE DRIVER-OWNED SURFACE\n");
+	for (i = 0; i < BL_NREG; i++) {
+		cpv = *(volatile uint32_t *)(slots + 4u * i);
+		cpu = rd(gpu3d + 4 * bl_regs[i]);
+		if (i < 8u && cpv == bl_want[i]) {
+			landed++;
+		}
+		printf("mi8gpu: step 26 B89 REG %-10s %#07x: CPU %#010x, CP %#010x, want %#010x, %s\n",
+		    bl_names[i], bl_regs[i], cpu, cpv, bl_want[i],
+		    (cpv == bl_want[i]) ? "MATCH" : "differs");
+	}
+	printf("mi8gpu: step 26 B89 READBACK: %u of 8 A2D registers hold what we wrote, control %#010x (want %#010x), %s\n",
+	    landed, control, 0x80100180u,
+	    (control == 0x80100180u) ? "CP_REG_TO_MEM IS ALIVE" : "CP_REG_TO_MEM IS BLIND");
+	printf("mi8gpu: step 26 B89 CCU: RB_CCU_CNTL CPU %#010x CP %#010x (B79 wrote %#010x, not written here), RB_DBG_ECO_CNTL CPU %#010x CP %#010x, %s\n",
+	    ccu_cpu, ccu_cp, B79_CCU_CNTL, eco_cpu, eco_cp,
+	    (ccu_cpu == ccu_cp) ? "CCU PRE-IMAGE CPU==CP" : "CCU PRE-IMAGE BLIND");
+
+	mi8_okit_probe();
+}
+
+static void
+gpu_zap_and_command(void)
+{
+	uint32_t *ring = (uint32_t *)g3d_regions[1].memory, wptr = cp_wptr;
+	volatile uint32_t *memptrs = (volatile uint32_t *)g3d_regions[2].memory;
+
+	if (!cp_ok || !g3d_ready) {
+		printf("mi8gpu: the CP has not taken CP_ME_INIT; no zap\n");
+		return;
+	}
+	printf("mi8gpu: SECVID_TRUST_CNTL before: %#x\n", rd(gpu3d + 4 * 0xf400));
+	bool ok;
+
+	if (rd(gpu3d + 4 * 0xf400) == 0) {
+		/* a slumber leaves the core where it was (EXP-0114): out of secure mode, with the zap still authenticated if it was kept */
+		printf("mi8gpu: the 3D core is already out of secure mode: the zap shader is not loaded again, no CP_SET_SECURE_MODE\n");
+		ok = true;
+	} else {
+		if (!zap_load(true)) {
+			printf("mi8gpu: zap not authenticated; the secure mode is left as it is\n");
+			return;
+		}
+		ring[wptr++] = pkt7(CP_SET_SECURE_MODE_OPCODE, 1);
+		ring[wptr++] = 0;
+		printf("mi8gpu: CP_SET_SECURE_MODE(0) submitted\n");
+		ok = gpu_wait_ring(wptr, "after CP_SET_SECURE_MODE");
+	}
+	printf("mi8gpu: SECVID_TRUST_CNTL after: %#x (%s); GPU idle: %s\n", rd(gpu3d + 4 * 0xf400),
+	    rd(gpu3d + 4 * 0xf400) == 0 ? "NON-SECURE MODE" : "still secure", ok ? "yes" : "NO");
+	gpu_nonsecure = ok && rd(gpu3d + 4 * 0xf400) == 0;
+	if (!ok) {
+		return;
+	}
+	/* the first real command: CP_MEM_WRITE of two words into the memptrs page, read back by us afterwards */
+	memptrs[2] = memptrs[3] = 0;
+	to_memory((vm_offset_t)memptrs, 0x1000);
+	ring[wptr++] = pkt7(CP_MEM_WRITE_OPCODE, 4);
+	ring[wptr++] = (uint32_t)(g3d_regions[2].address + 8);
+	ring[wptr++] = (uint32_t)((g3d_regions[2].address + 8) >> 32);
+	ring[wptr++] = 0xc0ffee21;
+	ring[wptr++] = 0x0badf00d;
+	printf("mi8gpu: CP_MEM_WRITE submitted (iova %#llx <- c0ffee21 0badf00d)\n", g3d_regions[2].address + 8);
+	ok = gpu_wait_ring(wptr, "after CP_MEM_WRITE");
+	cp_wptr = wptr;
+	to_memory((vm_offset_t)memptrs, 0x1000);
+	printf("mi8gpu: memptrs[2..3] = %#010x %#010x -> the CP's first write %s\n", memptrs[2], memptrs[3],
+	    (memptrs[2] == 0xc0ffee21 && memptrs[3] == 0x0badf00d) ? "ARRIVED in memory" : "did NOT arrive");
+	/*
+	 * Step 23 runs before the paint, and only when the CP has been shown to
+	 * write memory: the shader test needs a working ring and a fence that
+	 * arrives, and it must not be read through a picture that step 22 has
+	 * just put on the screen.
+	 */
+	if (ok && gmu_last_step >= 23) {
+		cp_wptr = wptr;
+		cs_probe();
+		wptr = cp_wptr;
+	}
+	/* B70: the render backend, right after compute has proved the ring works */
+	if (ok && gmu_last_step >= 23) {
+		cp_wptr = wptr;
+		rs_probe();
+		wptr = cp_wptr;
+	}
+	/* B77: A2D scale, after step 24 proved the CP and the RB are alive */
+	if (ok && gmu_last_step >= 24) {
+		cp_wptr = wptr;
+		bl_probe();
+		bl_readback();
+		wptr = cp_wptr;
+	}
+	if (ok && gmu_last_step >= 22 && memptrs[2] == 0xc0ffee21 && memptrs[3] == 0x0badf00d) {
+		uint32_t passes = 1;
+
+		PE_parse_boot_argn("mi8gpu_paints", &passes, sizeof(passes));
+		cp_wptr = wptr;
+		for (uint32_t pass = 0; pass < passes && pass < 60; pass++) {
+			printf("mi8gpu: painting pass %u of %u\n", pass + 1, passes);
+			gpu_fill_screen();
+			if (pass + 1 < passes) {
+				/*
+				 * B27: one 700 ms sample cannot tell "slowly overwritten" from
+				 * "erased once". Sample four times, and read the two known rows
+				 * at every stop. The 700 ms label is kept exactly as it was so
+				 * the judge still finds its next_before sample.
+				 */
+				sleep_us(100000);
+				screen_check("100 ms after the pass");
+				probe_report("100 ms after the pass");
+				sleep_us(200000);
+				screen_check("300 ms after the pass");
+				probe_report("300 ms after the pass");
+				sleep_us(200000);
+				screen_check("500 ms after the pass");
+				probe_report("500 ms after the pass");
+				sleep_us(200000);
+				screen_check("before the next pass (what is on the screen now)");
+				probe_report("before the next pass (what is on the screen now)");
+			}
+		}
+	}
+}
+
+
+/* ---- step 22: the CP, not the CPU, writes the picture into the screen's frame buffer ------------------------ */
+
+
+static uint32_t
+screen_expected(uint32_t x, uint32_t y)
+{
+	static const uint32_t bars[8] = { 0xffffffff, 0xffffff00, 0xff00ffff, 0xff00ff00, 0xffff00ff, 0xffff0000, 0xff0000ff, 0xff000000 };
+
+	if (y >= G3D_FB_HEIGHT - 240) {
+		uint32_t v = x * 255 / (G3D_FB_WIDTH - 1);
+
+		return 0xff000000u | (v << 16) | (v << 8) | v;
+	}
+	if (y < 8 || x < 8 || x >= G3D_FB_WIDTH - 8) {
+		return 0xffffffff;
+	}
+	return bars[x * 8 / G3D_FB_WIDTH];
+}
+
+/* Read the frame buffer back through the console's mapping (write-combining: no CPU cache holds old pixels). */
+static void
+screen_check(const char *when)
+{
+	volatile uint32_t *fb = (volatile uint32_t *)vinfo.v_baseaddr;
+	uint32_t same = 0, differ = 0, seed = 12345;
+
+	if (fb == NULL || vinfo.v_rowbytes != G3D_FB_WIDTH * 4 || vinfo.v_height != G3D_FB_HEIGHT) {
+		printf("mi8gpu: %s: the console's mapping is not usable for a check (base %#lx rowbytes %u height %u)\n", when, vinfo.v_baseaddr,
+		    vinfo.v_rowbytes, vinfo.v_height);
+		return;
+	}
+	for (uint32_t i = 0; i < 4000; i++) {
+		uint32_t x, y;
+
+		seed = seed * 1664525u + 1013904223u;
+		x = (seed >> 8) % G3D_FB_WIDTH;
+		seed = seed * 1664525u + 1013904223u;
+		y = (seed >> 8) % G3D_FB_HEIGHT;
+		if ((fb[y * G3D_FB_WIDTH + x] & 0xffffffu) == (screen_expected(x, y) & 0xffffffu)) {
+			same++;
+		} else {
+			differ++;
+		}
+	}
+	printf("mi8gpu: %s: %u of 4000 sampled pixels are the CP's pattern, %u are something else\n", when, same, differ);
+	/* Where the pattern is and is not: thirds of the screen, the same 400
+	 * (x, y-within-band) pairs in each. A partial overwrite by the window
+	 * server shows up as a top band that fails while the bottom holds; a
+	 * paint that never landed fails all three alike. Without this the single
+	 * total cannot tell the two apart. */
+	{
+		static const char *const band_name[3] = { "top", "middle", "bottom" };
+		const uint32_t band_height = G3D_FB_HEIGHT / 3;
+
+		for (uint32_t band = 0; band < 3; band++) {
+			uint32_t held = 0, band_seed = 12345;
+
+			for (uint32_t i = 0; i < 400; i++) {
+				uint32_t x, y;
+
+				band_seed = band_seed * 1664525u + 1013904223u;
+				x = (band_seed >> 8) % G3D_FB_WIDTH;
+				band_seed = band_seed * 1664525u + 1013904223u;
+				y = band * band_height + (band_seed >> 8) % band_height;
+				if ((fb[y * G3D_FB_WIDTH + x] & 0xffffffu) == (screen_expected(x, y) & 0xffffffu)) {
+					held++;
+				}
+			}
+			printf("mi8gpu: %s: %s third %u of 400 pixels are the CP's pattern\n", when, band_name[band], held);
+		}
+	}
+}
+
+/*
+ * Where the paint actually landed, row by row.
+ *
+ * The pattern is identical on every row outside the bottom strip, so a row that
+ * holds the expected colour was painted and a row that holds anything else was
+ * not. Three x positions catch a horizontal shift as well as a vertical one.
+ * The three-band count says "some of it is missing"; this says which rows, and
+ * that is the difference between a ring that wrapped, a mapping that stops
+ * short and a screen that something repainted.
+ */
+static void
+screen_scan(const char *when)
+{
+	static const uint32_t xs[3] = { 100, 540, 1000 };
+	volatile uint32_t *fb = (volatile uint32_t *)vinfo.v_baseaddr;
+
+	if (fb == NULL || vinfo.v_rowbytes != G3D_FB_WIDTH * 4 || vinfo.v_height != G3D_FB_HEIGHT) {
+		return;
+	}
+	printf("mi8gpu: scan %s: row, the pixel at x 100/540/1000, and what it should be\n", when);
+	for (uint32_t y = 0; y < G3D_FB_HEIGHT; y += 60) {
+		printf("mi8gpu: scan y %4u: %06x %06x %06x  want %06x %06x %06x\n", y,
+		    fb[y * G3D_FB_WIDTH + xs[0]] & 0xffffffu,
+		    fb[y * G3D_FB_WIDTH + xs[1]] & 0xffffffu,
+		    fb[y * G3D_FB_WIDTH + xs[2]] & 0xffffffu,
+		    screen_expected(xs[0], y) & 0xffffffu,
+		    screen_expected(xs[1], y) & 0xffffffu,
+		    screen_expected(xs[2], y) & 0xffffffu);
+	}
+}
+
+/*
+ * B27 probes: two rows of four dwords, both inside the pattern's black bar
+ * (x 960..983, y 200 and y 260), so writing them only spoils 8 of the 4000
+ * samples. The CPU writes one row itself and the CP writes the other, both
+ * AFTER the bulk paint. Whichever row survives tells us who is allowed to keep
+ * data on that page:
+ *   CPU row survives, CP row gone   -> only what the core wrote gets erased
+ *   both rows survive               -> the bulk paint's loss is about the paint
+ *   both rows gone                  -> the whole page is being rewritten
+ * A 700 ms single sample could never separate those three.
+ */
+#define PROBE_X         960u
+#define PROBE_CPU_Y     200u
+#define PROBE_GPU_Y     260u
+#define PROBE_WORDS     4u
+#define PROBE_CPU_VALUE 0x00ff00ffu
+#define PROBE_GPU_VALUE 0x00dead00u
+
+static void
+probe_report(const char *when)
+{
+	volatile uint32_t *fb = (volatile uint32_t *)vinfo.v_baseaddr;
+	uint32_t cpu_at = PROBE_CPU_Y * G3D_FB_WIDTH + PROBE_X;
+	uint32_t gpu_at = PROBE_GPU_Y * G3D_FB_WIDTH + PROBE_X;
+	uint32_t cpu_held = 0, gpu_held = 0;
+
+	for (uint32_t i = 0; i < PROBE_WORDS; i++) {
+		cpu_held += (fb[cpu_at + i] & 0xffffffu) == (PROBE_CPU_VALUE & 0xffffffu);
+		gpu_held += (fb[gpu_at + i] & 0xffffffu) == (PROBE_GPU_VALUE & 0xffffffu);
+	}
+	printf("mi8gpu: B27 %s: the CPU's own row %u/%u, the CP's row %u/%u\n",
+	    when, cpu_held, PROBE_WORDS, gpu_held, PROBE_WORDS);
+}
+
+static void
+gpu_fill_screen(void)
+{
+	uint32_t *ring = (uint32_t *)g3d_regions[1].memory, wptr = cp_wptr & 8191u, sent = 0;
+	volatile uint32_t *memptrs = (volatile uint32_t *)g3d_regions[2].memory;
+	const uint32_t total = G3D_FB_WIDTH * G3D_FB_HEIGHT, chunk = 1000, ring_words = 8192;
+	/* BGRA words 0xAARRGGBB: white, yellow, cyan, green, magenta, red, blue, black */
+	static const uint32_t bars[8] = { 0xffffffff, 0xffffff00, 0xff00ffff, 0xff00ff00, 0xffff00ff, 0xffff0000, 0xff0000ff, 0xff000000 };
+	uint64_t t0 = mach_absolute_time(), t1;
+	uint32_t batches = 0;
+	bool ok = true;
+
+	printf("mi8gpu: painting the screen: %u x %u pixels, %u dwords, from iova %#llx (phys %#llx); kernel's own screen: base %#lx rowbytes %lu %lux%lu\n",
+	    G3D_FB_WIDTH, G3D_FB_HEIGHT, total, (uint64_t)G3D_FB_IOVA, (uint64_t)G3D_FB_PHYS, PE_state.video.v_baseAddr,
+	    PE_state.video.v_rowBytes, PE_state.video.v_width, PE_state.video.v_height);
+	/*
+	 * The console cleared this frame buffer to black early in the boot. Those
+	 * dirty D-cache lines still belong to this CPU, while the 3D core writes
+	 * straight to DDR through the SMMU -- so every line the CPU later evicts
+	 * is written back ON TOP of the picture. That is why the paint looks
+	 * partly there, why the two passes cover complementary halves, and why
+	 * 700 ms later it is gone: it is the eviction schedule of stale CPU lines,
+	 * not a partial paint, not a ring wrap, and not the window server (whose
+	 * swaps are still 0 at this point in the boot). The selftest already
+	 * avoids this exact trap with mi8_gpu_to_memory(page, PAGE_SIZE) before
+	 * letting the core write. Clean and invalidate here, before the CP starts.
+	 */
+	to_memory((vm_offset_t)vinfo.v_baseaddr,
+	    (vm_size_t)vinfo.v_rowbytes * vinfo.v_height);
+	printf("mi8gpu: CPU frame buffer mapping cleaned before the CP painted (%lu bytes)\n",
+	    (unsigned long)vinfo.v_rowbytes * vinfo.v_height);
+	/* The control: what the screen holds BEFORE the CP touches it. Without
+	 * this number the "after" count has nothing to be compared against, and a
+	 * partial overwrite cannot be told from a paint that never landed. */
+	screen_check("before the CP paints");
+	while (sent < total && ok) {
+		uint32_t batch_start = wptr;
+
+		for (uint32_t c = 0; c < 6 && sent < total; c++) {
+			uint32_t n = total - sent < chunk ? total - sent : chunk;
+			uint64_t addr = G3D_FB_IOVA + 4ull * sent;
+			uint32_t w = wptr;
+
+			ring[w++ & (ring_words - 1)] = pkt7(CP_MEM_WRITE_OPCODE, n + 2);
+			ring[w++ & (ring_words - 1)] = (uint32_t)addr;
+			ring[w++ & (ring_words - 1)] = (uint32_t)(addr >> 32);
+			for (uint32_t i = 0; i < n; i++) {
+				uint32_t pixel = sent + i, x = pixel % G3D_FB_WIDTH, y = pixel / G3D_FB_WIDTH, v;
+
+				if (y >= G3D_FB_HEIGHT - 240) {                 /* the bottom strip: a grey ramp, shows the row/column order */
+					v = x * 255 / (G3D_FB_WIDTH - 1);
+					ring[w++ & (ring_words - 1)] = 0xff000000u | (v << 16) | (v << 8) | v;
+				} else if (y < 8 || x < 8 || x >= G3D_FB_WIDTH - 8) {  /* a white frame at the top and the sides */
+					ring[w++ & (ring_words - 1)] = 0xffffffff;
+				} else {
+					ring[w++ & (ring_words - 1)] = bars[x * 8 / G3D_FB_WIDTH];
+				}
+			}
+			wptr = w & (ring_words - 1);
+			sent += n;
+		}
+		(void)batch_start;
+		/* flush the whole ring to memory, move WPTR, wait until the CP has read it all */
+		to_memory(g3d_regions[1].memory, g3d_regions[1].size);
+		wr(gpu3d + 4 * 0x0807, wptr);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		bool drained = false;
+		for (uint32_t i = 0; i < 20000; i++) {
+			if (rd(gpu3d + 4 * 0x0806) == wptr) {
+				drained = true;
+				break;
+			}
+			sleep_us(10);
+		}
+		if (!drained) {
+			printf("mi8gpu: the CP stopped reading the ring: RPTR %u WPTR %u after %u dwords; RBBM_STATUS %#x INT_0 %#x CB1 FSR %#x FAR %#x\n",
+			    rd(gpu3d + 4 * 0x0806), wptr, sent, rd(gpu3d + 4 * 0x0210), rd(gpu3d + 4 * 0x0201),
+			    rd(smmu_cb(G3D_CTX) + CB_FSR), rd(smmu_cb(G3D_CTX) + CB_FAR_LO));
+			ok = false;
+		}
+		batches++;
+	}
+	t1 = mach_absolute_time();
+	cp_wptr = wptr;
+	printf("mi8gpu: the CP read %u dwords in %u submissions (%s); RBBM_STATUS %#x INT_0 %#x CB1 FSR %#x; timer ticks %llu\n", sent, batches,
+	    ok ? "all" : "STOPPED", rd(gpu3d + 4 * 0x0210), rd(gpu3d + 4 * 0x0201), rd(smmu_cb(G3D_CTX) + CB_FSR), t1 - t0);
+	/*
+	 * Make the core's writes visible before sampling them.
+	 *
+	 * The ring drain only proves the CP has READ the commands; the writes
+	 * themselves sit in the core's cache until something pushes them out. The
+	 * keep path always ends a submission with CACHE_FLUSH_TS for exactly this
+	 * reason, and without it the readback sees whatever the core happened to
+	 * evict -- which looks identical to "the paint only covered half the
+	 * screen" but is a property of the sample, not of the paint.
+	 */
+	memptrs[4] = memptrs[5] = 0;
+	to_memory((vm_offset_t)memptrs, 0x1000);
+	{
+		uint32_t w = wptr;
+		uint64_t flush_iova = g3d_regions[2].address + 0x10;
+
+		ring[w++ & (ring_words - 1)] = pkt7(0x46u /* CP_EVENT_WRITE */, 4);
+		ring[w++ & (ring_words - 1)] = 0x04u;   /* EVENT_CACHE_FLUSH_TS */
+		ring[w++ & (ring_words - 1)] = (uint32_t)flush_iova;
+		ring[w++ & (ring_words - 1)] = (uint32_t)(flush_iova >> 32);
+		ring[w++ & (ring_words - 1)] = 0;
+		wptr = w & (ring_words - 1);
+		to_memory(g3d_regions[1].memory, g3d_regions[1].size);
+		wr(gpu3d + 4 * 0x0807, wptr);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (uint32_t i = 0; i < 20000; i++) {
+			if (rd(gpu3d + 4 * 0x0806) == wptr) {
+				break;
+			}
+			sleep_us(10);
+		}
+		to_memory((vm_offset_t)memptrs, 0x1000);
+		printf("mi8gpu: cache flush submitted (ring up to %u); the timestamp it wrote is %#010x %#010x\n",
+		    wptr, memptrs[4], memptrs[5]);
+	}
+	cp_wptr = wptr;
+	/*
+	 * The control sample filled this CPU's cache with the pre-paint black
+	 * pixels. Those lines are clean but stale, so a plain read would still
+	 * hit them. Invalidate without writing back: the next read refetches the
+	 * DDR the core just wrote. A "dc civac" here would be the same mistake
+	 * as leaving the boot-time dirty lines in place.
+	 */
+	from_memory((vm_offset_t)vinfo.v_baseaddr,
+	    (vm_size_t)vinfo.v_rowbytes * vinfo.v_height);
+	printf("mi8gpu: CPU frame buffer mapping invalidated before the readback\n");
+	screen_check("right after the CP finished");
+	screen_scan("after this pass");
+	/*
+	 * B27: two known rows, written after the pattern was sampled, so the pattern
+	 * statistics above stay clean. The CP goes first, then the CPU, then both are
+	 * read back once so the log holds a t=0 value for each.
+	 */
+	{
+		uint32_t w = wptr;
+		uint64_t at = G3D_FB_IOVA + 4ull * (PROBE_GPU_Y * G3D_FB_WIDTH + PROBE_X);
+
+		ring[w++ & (ring_words - 1)] = pkt7(CP_MEM_WRITE_OPCODE, PROBE_WORDS + 2);
+		ring[w++ & (ring_words - 1)] = (uint32_t)at;
+		ring[w++ & (ring_words - 1)] = (uint32_t)(at >> 32);
+		for (uint32_t i = 0; i < PROBE_WORDS; i++) {
+			ring[w++ & (ring_words - 1)] = PROBE_GPU_VALUE;
+		}
+		wptr = w & (ring_words - 1);
+		to_memory(g3d_regions[1].memory, g3d_regions[1].size);
+		wr(gpu3d + 4 * 0x0807, wptr);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (uint32_t i = 0; i < 20000; i++) {
+			if (rd(gpu3d + 4 * 0x0806) == wptr) {
+				break;
+			}
+			sleep_us(10);
+		}
+		cp_wptr = wptr;
+		printf("mi8gpu: B27 the CP wrote %#x into the frame buffer at (%u,%u)..(%u,%u)\n",
+		    PROBE_GPU_VALUE, PROBE_X, PROBE_GPU_Y, PROBE_X + PROBE_WORDS - 1, PROBE_GPU_Y);
+	}
+	{
+		volatile uint32_t *fb = (volatile uint32_t *)vinfo.v_baseaddr;
+		uint32_t at = PROBE_CPU_Y * G3D_FB_WIDTH + PROBE_X;
+
+		for (uint32_t i = 0; i < PROBE_WORDS; i++) {
+			fb[at + i] = PROBE_CPU_VALUE;
+		}
+		to_memory((vm_offset_t)(fb + at), PROBE_WORDS * 4);
+		from_memory((vm_offset_t)vinfo.v_baseaddr,
+		    (vm_size_t)vinfo.v_rowbytes * vinfo.v_height);
+		printf("mi8gpu: B27 the CPU wrote %#x into the frame buffer at (%u,%u)..(%u,%u)\n",
+		    PROBE_CPU_VALUE, PROBE_X, PROBE_CPU_Y, PROBE_X + PROBE_WORDS - 1, PROBE_CPU_Y);
+	}
+	probe_report("immediately after both wrote");
+}
+
+
+/* ---- step 23: the GPU kept on for the window server (RedwoodGPU service; bsd/sys/redwood_input.h) --------------- */
+
+/*
+ * What Mesa's freedreno (through tools/mesa/redwood-drm and iokit/Kernel/RedwoodGPU.cpp) needs of the kernel: addresses
+ * for buffers (the kernel is the allocator, buffers are asked MSM_INFO_GET_IOVA once), pages mapped at them in the 3D
+ * core's context (CB1), the ring, submissions with a fence the core writes into memory, and Linux's GET_PARAM answers
+ * for an a630. This follows the structure of bsd/dev/redwood_adreno.c's "GPU kept on", for this phone's registers.
+ */
+#define KEEP_VA_START           0x40000000ull   /* above the steps' own blocks, below 4 GB (a630: ADRENO_QUIRK_4GB_VA) */
+#define KEEP_VA_SIZE            0xb0000000ull
+#define KEEP_GRANULE            0x10000ull
+#define KEEP_FENCE_AT           0x40u           /* in the memptrs page: where the core writes the finished submission */
+#define KEEP_RING_WORDS         8192u
+#define CP_INDIRECT_BUFFER_OP   0x3fu
+#define CP_EVENT_WRITE_OP       0x46u
+#define EVENT_CACHE_FLUSH_TS    0x04u
+#define EVENT_PC_CCU_INV_DEPTH  0x18u
+#define EVENT_PC_CCU_INV_COLOR  0x19u
+#define KEEP_PTE_READ_ONLY      (1ull << 7)
+
+static struct { uint64_t start, size; } keep_free[1024];
+static unsigned keep_free_count, keep_free_most;
+static uint64_t keep_used, keep_lost;
+static uint32_t keep_live, keep_refused, keep_fence, keep_ring_at, keep_ring_sent;
+static struct { uint64_t phys; vm_offset_t virt; } keep_tables[512];
+static uint32_t keep_tables_n;
+static vm_offset_t keep_pool;
+static uint32_t keep_pool_used = 4;     /* of the 4 tables one page holds */
+
+static uint64_t *
+keep_table_virt(uint64_t phys)
+{
+	for (uint32_t i = 1; i < G3D_TABLE_POOL / 0x1000; i++) {
+		if (kvtophys(g3d_tables + 0x1000 * i) == phys) {
+			return (uint64_t *)(g3d_tables + 0x1000 * i);
+		}
+	}
+	for (uint32_t i = 0; i < keep_tables_n; i++) {
+		if (keep_tables[i].phys == phys) {
+			return (uint64_t *)keep_tables[i].virt;
+		}
+	}
+	return NULL;
+}
+
+/* One new (zeroed) 4 KB table of the 3D core's page tables. */
+static uint64_t *
+keep_table_new(uint64_t *phys)
+{
+	vm_offset_t v;
+
+	if (keep_pool == 0 || keep_pool_used >= PAGE_SIZE / 0x1000) {
+		if (keep_tables_n + PAGE_SIZE / 0x1000 > sizeof(keep_tables) / sizeof(keep_tables[0]) ||
+		    kmem_alloc(kernel_map, &keep_pool, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return NULL;
+		}
+		keep_pool_used = 0;
+	}
+	v = keep_pool + 0x1000 * keep_pool_used++;
+	*phys = kvtophys(v);
+	keep_tables[keep_tables_n].phys = *phys;
+	keep_tables[keep_tables_n++].virt = v;
+	to_memory(v, 0x1000);
+	return (uint64_t *)v;
+}
+
+static uint64_t keep_attr_index;        /* boot-arg mi8gpu_attr=N: memory attribute index of the core's pages (0 not cached, 1 cached) */
+
+static bool
+keep_map(uint64_t va, uint64_t pa, uint64_t attributes)
+{
+	uint64_t *l1 = (uint64_t *)g3d_tables, *l2, *l3, phys;
+	uint64_t *e1 = &l1[(va >> 30) & 0x1ff], *e2, *e3;
+
+	if (*e1 == 0) {
+		l2 = keep_table_new(&phys);
+		if (l2 == NULL) {
+			return false;
+		}
+		*e1 = phys | PTE_TABLE;
+		to_memory((vm_offset_t)e1, 8);
+	}
+	l2 = keep_table_virt(*e1 & PTE_ADDRESS);
+	if (l2 == NULL) {
+		return false;
+	}
+	e2 = &l2[(va >> 21) & 0x1ff];
+	if (*e2 == 0) {
+		l3 = keep_table_new(&phys);
+		if (l3 == NULL) {
+			return false;
+		}
+		*e2 = phys | PTE_TABLE;
+		to_memory((vm_offset_t)e2, 8);
+	}
+	l3 = keep_table_virt(*e2 & PTE_ADDRESS);
+	if (l3 == NULL) {
+		return false;
+	}
+	e3 = &l3[(va >> 12) & 0x1ff];
+	*e3 = pa ? (pa | PTE_GMU | PTE_AP_UNPRIV | PTE_PAGE | (keep_attr_index << 2) | attributes) : 0;
+	to_memory((vm_offset_t)e3, 8);
+	return true;
+}
+
+static void
+keep_tlb(void)
+{
+	vm_offset_t cb = smmu_cb(G3D_CTX);
+
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(cb + CB_TLBIASID, G3D_CTX);
+	wr(cb + CB_TLBSYNC, 1);
+	for (int i = 0; i < 1000 && (rd(cb + CB_TLBSTATUS) & 1); i++) {
+		sleep_us(1);
+	}
+}
+
+static void
+keep_ring(uint32_t word)
+{
+	((uint32_t *)g3d_regions[1].memory)[keep_ring_at] = word;
+	keep_ring_at = (keep_ring_at + 1) & (KEEP_RING_WORDS - 1);
+}
+
+static void
+keep_ring_cmd(uint32_t command, uint32_t words)
+{
+	keep_ring(pkt7(command, words));
+}
+
+static void
+keep_ring_send(void)
+{
+	if (keep_ring_at >= keep_ring_sent) {
+		to_memory(g3d_regions[1].memory + 4 * keep_ring_sent, 4 * (keep_ring_at - keep_ring_sent));
+	} else {
+		to_memory(g3d_regions[1].memory + 4 * keep_ring_sent, 4 * (KEEP_RING_WORDS - keep_ring_sent));
+		to_memory(g3d_regions[1].memory, 4 * keep_ring_at);
+	}
+	keep_ring_sent = keep_ring_at;
+	wr(gpu3d + 4 * 0x0807, keep_ring_at);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+bool
+mi8_gpu_kept(void)
+{
+	return gpu_kept;
+}
+
+/* Linux's adreno_get_param for an a630 (the numbers are msm_drm.h's). */
+bool
+mi8_gpu_parameter(uint32_t which, uint64_t *value)
+{
+	switch (which) {
+	case 0x01:      /* GPU_ID */
+	case 0x06:      /* GMEM_BASE */
+	case 0x08:      /* PP_PGTABLE */
+	case 0x09:      /* FAULTS */
+	case 0x0a:      /* SUSPENDS */
+	case 0x11:      /* RAYTRACING */
+		*value = 0;
+		return true;
+	case 0x02:      /* GMEM_SIZE: 1 MiB (a6xx_catalog.c, TASK-002) */
+		*value = 1024 * 1024;
+		return true;
+	case 0x03:      /* CHIP_ID */
+		*value = 0x06030001ull;
+		return true;
+	case 0x04:      /* MAX_FREQ */
+		*value = 710000000ull;
+		return true;
+	case 0x05:      /* TIMESTAMP */
+		*value = mach_absolute_time();
+		return true;
+	case 0x07:      /* PRIORITIES */
+		*value = 1;
+		return true;
+	case 0x10:      /* HIGHEST_BANK_BIT (qcom,highest-bank-bit = 15) */
+		*value = 15;
+		return true;
+	case 0x12:      /* UBWC_SWIZZLE (sdm845_data) */
+		*value = 6;
+		return true;
+	case 0x13:      /* MACROTILE_MODE (sdm845_data: 0) */
+		*value = 0;
+		return true;
+	default:
+		return false;
+	}
+}
+
+uint64_t
+mi8_gpu_address(uint64_t size)
+{
+	size = (size + (KEEP_GRANULE - 1)) & ~(KEEP_GRANULE - 1);
+	for (unsigned i = 0; i < keep_free_count; i++) {
+		if (keep_free[i].size >= size) {
+			uint64_t address = keep_free[i].start;
+
+			keep_free[i].start += size;
+			keep_free[i].size -= size;
+			if (keep_free[i].size == 0) {
+				memmove(&keep_free[i], &keep_free[i + 1], (--keep_free_count - i) * sizeof(keep_free[0]));
+			}
+			keep_used += size;
+			keep_live++;
+			return address;
+		}
+	}
+	keep_refused++;
+	return 0;
+}
+
+void
+mi8_gpu_address_free(uint64_t address, uint64_t size)
+{
+	unsigned at;
+
+	size = (size + (KEEP_GRANULE - 1)) & ~(KEEP_GRANULE - 1);
+	for (at = 0; at < keep_free_count && keep_free[at].start < address; at++) {
+	}
+	keep_used -= size;
+	keep_live--;
+	if (at > 0 && keep_free[at - 1].start + keep_free[at - 1].size == address) {
+		keep_free[at - 1].size += size;
+		if (at < keep_free_count && address + size == keep_free[at].start) {
+			keep_free[at - 1].size += keep_free[at].size;
+			memmove(&keep_free[at], &keep_free[at + 1], (--keep_free_count - at) * sizeof(keep_free[0]));
+		}
+	} else if (at < keep_free_count && address + size == keep_free[at].start) {
+		keep_free[at].start = address;
+		keep_free[at].size += size;
+	} else if (keep_free_count < sizeof(keep_free) / sizeof(keep_free[0])) {
+		memmove(&keep_free[at + 1], &keep_free[at], (keep_free_count - at) * sizeof(keep_free[0]));
+		keep_free[at].start = address;
+		keep_free[at].size = size;
+		keep_free_count++;
+		if (keep_free_count > keep_free_most) {
+			keep_free_most = keep_free_count;
+		}
+	} else {
+		keep_lost += size;
+	}
+}
+
+void
+mi8_gpu_space(uint64_t *used, uint32_t *live, uint64_t *largest, unsigned *holes, unsigned *most, uint64_t *lost, uint32_t *refused)
+{
+	*largest = 0;
+	for (unsigned i = 0; i < keep_free_count; i++) {
+		if (keep_free[i].size > *largest) {
+			*largest = keep_free[i].size;
+		}
+	}
+	*used = keep_used;
+	*live = keep_live;
+	*holes = keep_free_count;
+	*most = keep_free_most;
+	*lost = keep_lost;
+	*refused = keep_refused;
+}
+
+bool
+mi8_gpu_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	return keep_map(address, phys, read_only ? KEEP_PTE_READ_ONLY : 0);
+}
+
+void
+mi8_gpu_mapped(void)
+{
+	keep_tlb();
+}
+
+static uint32_t keep_unmap_busy;
+
+void
+mi8_gpu_unmap(uint64_t address, uint64_t size)
+{
+	if (!mi8_gpu_done(keep_fence)) {
+		keep_unmap_busy++;                      /* U-063: taken away while the core still has work */
+		if (keep_unmap_busy <= 8) {
+			printf("mi8gpu: unmap %#llx+%#llx while the core has done %u of %u\n", address, size,
+			    *(volatile uint32_t *)(g3d_regions[2].memory + KEEP_FENCE_AT), keep_fence);
+		}
+	}
+	for (uint64_t offset = 0; offset < size; offset += 0x1000) {
+		keep_map(address + offset, 0, 0);
+	}
+	keep_tlb();
+}
+
+static uint64_t keep_flush_ticks, keep_flush_bytes, keep_flush_calls, keep_submit_ticks;
+
+void
+mi8_gpu_to_memory(void *start, uint64_t size)
+{
+	uint64_t began = mach_absolute_time();
+
+	to_memory((vm_offset_t)start, size);
+	keep_flush_ticks += mach_absolute_time() - began;
+	keep_flush_bytes += size;
+	keep_flush_calls++;
+}
+
+bool
+mi8_gpu_done(uint32_t fence)
+{
+	volatile uint32_t *word = (volatile uint32_t *)(g3d_regions[2].memory + KEEP_FENCE_AT);
+
+	to_memory((vm_offset_t)word, 4);
+	return (int32_t)(*word - fence) >= 0;
+}
+
+uint32_t
+mi8_gpu_last(void)
+{
+	return keep_fence;
+}
+
+void
+mi8_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7])
+{
+	*microseconds = 0;
+	*submissions = 0;
+	bzero(by, 7 * sizeof(uint32_t));
+}
+
+/* Command buffers for the core to run, in order, each an address and a count of words (Linux's a6xx_submit, as
+ * redwood_adreno.c puts them): the new fence is returned; 0: the ring is full and the core is not reading it. */
+static uint32_t keep_submissions, keep_ibs;
+static uint64_t keep_words;
+
+extern unsigned int ml_phys_read_word(vm_offset_t paddr);
+#define KEEP_HISTORY 4096
+static struct { uint64_t address; uint32_t words, submission; } keep_history[KEEP_HISTORY];
+
+/* the word at a GPU address, by the table we built (0xdeadbeef: not mapped) */
+static uint32_t
+keep_peek(uint64_t va)
+{
+	uint64_t *l1 = (uint64_t *)g3d_tables, *l2, *l3;
+	uint64_t e = l1[(va >> 30) & 0x1ff];
+
+	if (e == 0 || (l2 = keep_table_virt(e & PTE_ADDRESS)) == NULL || (e = l2[(va >> 21) & 0x1ff]) == 0 ||
+	    (l3 = keep_table_virt(e & PTE_ADDRESS)) == NULL || (e = l3[(va >> 12) & 0x1ff]) == 0) {
+		return 0xdeadbeef;
+	}
+	return ml_phys_read_word((e & PTE_ADDRESS) + (va & 0xfff));
+}
+
+static uint32_t mi8_gpu_submit_inner(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+
+uint32_t
+mi8_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint64_t began = mach_absolute_time();
+	uint32_t fence = mi8_gpu_submit_inner(addresses, words, count);
+
+	keep_submit_ticks += mach_absolute_time() - began;
+	return fence;
+}
+
+static uint32_t
+mi8_gpu_submit_inner(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint32_t wanted = 16 + 4 * count, room = 0;
+	uint64_t fence_iova = g3d_regions[2].address + KEEP_FENCE_AT;
+
+	for (int i = 0; i < 20000; i++) {
+		room = (rd(gpu3d + 4 * 0x0806) + KEEP_RING_WORDS - keep_ring_at - 1) % KEEP_RING_WORDS;
+		if (room >= wanted) {
+			break;
+		}
+		sleep_us(100);
+	}
+	if (room < wanted) {
+		return 0;
+	}
+	if (++keep_fence == 0) {
+		keep_fence = 1;
+	}
+	keep_ring_cmd(CP_EVENT_WRITE_OP, 1);
+	keep_ring(EVENT_PC_CCU_INV_DEPTH);
+	keep_ring_cmd(CP_EVENT_WRITE_OP, 1);
+	keep_ring(EVENT_PC_CCU_INV_COLOR);
+	for (uint32_t i = 0; i < count; i++) {
+		keep_ring_cmd(CP_INDIRECT_BUFFER_OP, 3);
+		keep_ring((uint32_t)addresses[i]);
+		keep_ring((uint32_t)(addresses[i] >> 32));
+		keep_ring(words[i]);
+	}
+	keep_ring_cmd(CP_EVENT_WRITE_OP, 4);
+	keep_ring(EVENT_CACHE_FLUSH_TS);
+	keep_ring((uint32_t)fence_iova);
+	keep_ring((uint32_t)(fence_iova >> 32));
+	keep_ring(keep_fence);
+	keep_ring_send();
+	keep_submissions++;
+	keep_ibs += count;
+	for (uint32_t i = 0; i < count; i++) {
+		keep_words += words[i];
+		keep_history[(keep_ibs - count + i) % KEEP_HISTORY].address = addresses[i];
+		keep_history[(keep_ibs - count + i) % KEEP_HISTORY].words = words[i];
+		keep_history[(keep_ibs - count + i) % KEEP_HISTORY].submission = keep_submissions;
+	}
+	/* proof that the system's own frames reach the core: the first few and then every 256th */
+	if (keep_submissions <= 40) {
+		for (uint32_t i = 0; i < count; i++) {
+			printf("mi8gpu: submission %u buffer %u: %#llx, %u words\n", keep_submissions, i, addresses[i], words[i]);
+		}
+	}
+	if ((keep_submissions & 63) == 0) {
+		uint64_t flush_ns, submit_ns;
+
+		absolutetime_to_nanoseconds(keep_flush_ticks, &flush_ns);
+		absolutetime_to_nanoseconds(keep_submit_ticks, &submit_ns);
+		printf("mi8gpu: cost: %u submissions: %llu us in the ring code, %llu us flushing %llu KB in %llu calls\n", keep_submissions,
+		    submit_ns / 1000, flush_ns / 1000, keep_flush_bytes >> 10, keep_flush_calls);
+	}
+	if (keep_submissions <= 3 || (keep_submissions & 255) == 0) {
+		printf("mi8gpu: submission %u (fence %u): %u buffers, %u words in the first; ring written up to %u\n", keep_submissions,
+		    keep_fence, count, count ? words[0] : 0, keep_ring_at);
+	}
+	return keep_fence;
+}
+
+void
+mi8_gpu_report(const char *why)
+{
+	printf("mi8gpu: gpu: FAR %#x%08x, unmapped while busy %u times\n", rd(smmu_cb(G3D_CTX) + CB_FAR_LO + 4), rd(smmu_cb(G3D_CTX) + CB_FAR_LO),
+	    keep_unmap_busy);
+	{
+		uint64_t ib1 = ((uint64_t)rd(gpu3d + 4 * 0x0929) << 32) | rd(gpu3d + 4 * 0x0928);
+		uint32_t rem1 = rd(gpu3d + 4 * 0x092A), rem2 = rd(gpu3d + 4 * 0x092D);
+		uint64_t ib2 = ((uint64_t)rd(gpu3d + 4 * 0x092C) << 32) | rd(gpu3d + 4 * 0x092B);
+
+		printf("mi8gpu: gpu: CP IB1 %#llx remaining %u, IB2 %#llx remaining %u, SQE_STAT?\n", ib1, rem1, ib2, rem2);
+		for (uint32_t i = 0; i < KEEP_HISTORY && ib1 != 0; i++) {
+			uint32_t at = (keep_ibs + KEEP_HISTORY - 1 - i) % KEEP_HISTORY;
+
+			if (keep_history[at].address == ib1 && keep_history[at].words >= rem1) {
+				uint32_t pos = keep_history[at].words - rem1, from = pos > 24 ? pos - 24 : 0;
+
+				printf("mi8gpu: gpu: IB1 is of submission %u, %u words, the core is at word %u:\n", keep_history[at].submission,
+				    keep_history[at].words, pos);
+				(void)from;
+				for (uint32_t w = 0; w < keep_history[at].words; w += 6) {
+					printf("mi8gpu: gpu:  [%u] %08x %08x %08x %08x %08x %08x\n", w, keep_peek(ib1 + 4 * w), keep_peek(ib1 + 4 * w + 4),
+					    keep_peek(ib1 + 4 * w + 8), keep_peek(ib1 + 4 * w + 12), keep_peek(ib1 + 4 * w + 16), keep_peek(ib1 + 4 * w + 20));
+				}
+				printf("mi8gpu: gpu: IB2 words follow\n");
+				for (uint32_t w = 0; ib2 != 0 && w < 3600; w += 6) {
+					printf("mi8gpu: gpu: 2[%u] %08x %08x %08x %08x %08x %08x\n", w, keep_peek(ib2 + 4 * w), keep_peek(ib2 + 4 * w + 4),
+					    keep_peek(ib2 + 4 * w + 8), keep_peek(ib2 + 4 * w + 12), keep_peek(ib2 + 4 * w + 16), keep_peek(ib2 + 4 * w + 20));
+				}
+				break;
+			}
+		}
+	}
+	printf("mi8gpu: gpu: %s: submission %u is the last, the core has done %u; ring: read up to %u, written up to %u; RBBM_STATUS %#x INT_0 %#x; "
+	    "CB1 FSR %#x FSYNR0 %#x\n", why, keep_fence, *(volatile uint32_t *)(g3d_regions[2].memory + KEEP_FENCE_AT), rd(gpu3d + 4 * 0x0806),
+	    keep_ring_at, rd(gpu3d + 4 * 0x0210), rd(gpu3d + 4 * 0x0201), rd(smmu_cb(G3D_CTX) + CB_FSR), rd(smmu_cb(G3D_CTX) + CB_FSYNR0));
+}
+
+bool
+mi8_gpu_recover(void)
+{
+	return false;
+}
+
+
+/*
+ * boot-arg mi8_cpufreq=N (EXP-0127): the two CPU clusters' frequency domains (Linux qcom-cpufreq-hw, sdm845.dtsi:
+ * cpufreq@17d43000, domain 0 the little cores and domain 1 at 17d45800 the big): their table of frequencies and the
+ * state they are in, and, for N != 0xffff, that state asked for -- N = the table row (the last one is the highest).
+ */
+/*
+ * What mi8_cpufreq() changed is put back when the run ends (mi8_gpu_stop()): PERF_STATE keeps its value across kernel runs (nothing
+ * resets it but a restart of the phone), and EXP-0172 ran at the 2092 MHz that EXP-0171 had asked for without anyone saying so.
+ * A run that asks for nothing also takes the big cluster back to row 22 (2649 MHz: what the firmware leaves, EXP-0170) if a
+ * run before left it somewhere else.
+ */
+static vm_offset_t cpufreq_base[2];
+static uint32_t cpufreq_original[2];
+static bool cpufreq_changed[2];
+
+#define CPUFREQ_BIG_DEFAULT_ROW 22
+
+static void
+mi8_cpufreq_restore(void)
+{
+	for (int d = 0; d < 2; d++) {
+		if (cpufreq_changed[d] && cpufreq_base[d] != 0) {
+			wr(cpufreq_base[d] + 0x920, cpufreq_original[d]);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			printf("mi8gpu: cpufreq domain %d: PERF_STATE put back to %u (now %u)\n", d, cpufreq_original[d],
+			    rd(cpufreq_base[d] + 0x920));
+			cpufreq_changed[d] = false;
+		}
+	}
+}
+
+static void
+mi8_cpufreq(uint32_t want, uint32_t want_big)
+{
+	static const uint64_t bases[2] = { 0x17d43000ull, 0x17d45800ull };
+
+	for (int d = 0; d < 2; d++) {
+		vm_offset_t base = (vm_offset_t)ml_io_map(bases[d], 0x1400);
+		uint32_t rows = 0, state;
+
+		if (base == 0) {
+			printf("mi8gpu: cpufreq domain %d: no mapping\n", d);
+			continue;
+		}
+		printf("mi8gpu: cpufreq domain %d: ENABLE %#x, PERF_STATE %#x\n", d, rd(base + 0x0), rd(base + 0x920));
+		for (uint32_t row = 0; row < 40; row++) {
+			uint32_t lut = rd(base + 0x110 + 32 * row), volt = rd(base + 0x114 + 32 * row);
+
+			if (lut == 0) {
+				break;
+			}
+			rows = row + 1;
+			/* LUT row: bits 31:30 clock source, 7:0 L value (multiples of the 19.2 MHz XO), 18:16 cores; source 0: GPLL0/2 */
+			printf("mi8gpu: cpufreq domain %d row %u: lut %#010x -> %u MHz, volt %#x\n", d, row, lut,
+			    (lut >> 30) ? (uint32_t)((lut & 0xff) * 192 / 10) : 300, volt);
+		}
+		/* EXP-0171: boot-arg mi8_cpufreq_big=N asks the big cluster (domain 1) for row N and leaves the little one alone */
+		uint32_t asked = d == 1 && want_big != 0xffff ? want_big : want;
+
+		if (asked != 0xffff && rows != 0) {
+			uint32_t row = asked < rows ? asked : rows - 1;
+
+			if (!cpufreq_changed[d]) {
+				cpufreq_base[d] = base;
+				cpufreq_original[d] = rd(base + 0x920);
+				cpufreq_changed[d] = true;
+			}
+			wr(base + 0x920, row);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			sleep_us(2000);
+			state = rd(base + 0x920);
+			printf("mi8gpu: cpufreq domain %d: row %u asked for, PERF_STATE now %#x\n", d, row, state);
+		}
+	}
+}
+
+/* MDSS at ae00000, mapped in 64 KB pieces as they are needed: the I/O window of the kernel is 8 MB all told, and a failed
+ * allocation in it panics (io_map.c: KMA_NOFAIL), so one big mapping of the whole block is not an option (EXP-0128). */
+static vm_offset_t
+dpu_va(uint32_t off)
+{
+	static vm_offset_t piece[0x100000 / 0x10000];
+	uint32_t n = off >> 16;
+
+	if (piece[n] == 0) {
+		piece[n] = (vm_offset_t)ml_io_map(0x0ae00000ull + (n << 16), 0x10000);
+		printf("mi8dpu: MDSS +%#x mapped at %#lx\n", n << 16, (unsigned long)piece[n]);
+	}
+	return piece[n] + (off & 0xffff);
+}
+
+/*
+ * boot-arg mi8disp=N (EXP-0128): reads only, nothing is written or kicked. What the boot loaders left of the display:
+ * levels: 1 DISP_CC, 2 + map MDSS, 3 + read HW_VERSION, 4 + INTR/CTL/SSPP, 5 + PP config, 6 + PP sampling, 7 + DSI0.
+ * N >= 1 the display clock controller (DISP_CC at af00000: MDSS_GDSCR at 3000, the AHB/AXI/MDP/VSYNC branch CBCRs;
+ * addresses from EXP-0120, sdm845 dispcc), and only when the power domain and the AHB clock say "on", N >= 2 the DPU
+ * itself (MDSS at ae00000; blocks at stock offset + ae00000, EXP-0120 audit-display.py): CTL top, the source pipes,
+ * the four ping-pong blocks' tear-check / auto-refresh / counters, DSI0, and 100 ms of the ping-pong frame counter
+ * sampled to see whether a 60 Hz tearing-effect signal arrives. CBCR bit 31 = CLK_OFF, GDSCR bit 31 = PWR_ON.
+ */
+static void
+mi8_dpu_probe(uint32_t level)
+{
+	static const struct { const char *name; uint32_t off; } cc[] = {
+		{ "MDSS_GDSCR", 0x3000 }, { "AHB_CBCR", 0x4004 }, { "AXI_CBCR", 0x4008 },
+		{ "MDP_CBCR", 0x200c }, { "VSYNC_CBCR", 0x2024 },
+	};
+	vm_offset_t dcc = (vm_offset_t)ml_io_map(0x0af00000ull, 0x5000);
+	uint32_t v[5];
+
+	if (dcc == 0) {
+		printf("mi8dpu: no mapping of DISP_CC\n");
+		return;
+	}
+	for (int i = 0; i < 5; i++) {
+		v[i] = rd(dcc + cc[i].off);
+		printf("mi8dpu: %-11s %#07x = %#010x\n", cc[i].name, cc[i].off, v[i]);
+	}
+	if (!(v[0] & 0x80000000u) || (v[1] & 0x80000000u)) {
+		printf("mi8dpu: the display power domain / AHB clock is not on: not going on\n");
+		return;
+	}
+	if (level < 2) {
+		return;
+	}
+	(void)dpu_va(0);
+	if (level < 3) {
+		return;
+	}
+	printf("mi8dpu: reading HW_VERSION\n");
+	printf("mi8dpu: MDSS HW_VERSION %#010x\n", rd(dpu_va(0)));
+	if (level < 4) {
+		return;
+	}
+	printf("mi8dpu: MDSS HW_INTR_STATUS %#010x\n", rd(dpu_va(0x10)));
+	for (int i = 0; i < 5; i++) {
+		vm_offset_t b = dpu_va(0x2000 + 0x200 * i);
+
+		printf("mi8dpu: CTL%d TOP %#010x FLUSH %#010x START %#010x\n", i, rd(b + 0x14), rd(b + 0x18), rd(b + 0x1c));
+	}
+	{
+		static const uint32_t sspp[8] = { 0x5000, 0x7000, 0x9000, 0xb000, 0x25000, 0x27000, 0x29000, 0x2b000 };
+
+		for (int i = 0; i < 8 && level >= 4; i++) {
+			vm_offset_t b = dpu_va(sspp[i]);
+
+			printf("mi8dpu: SSPP@%#x SIZE %#010x ADDR0 %#010x YSTRIDE0 %#010x FORMAT %#010x OPMODE %#010x\n", sspp[i],
+			    rd(b), rd(b + 0x14), rd(b + 0x24), rd(b + 0x30), rd(b + 0x38));
+		}
+	}
+	{
+		static const uint32_t pp[4] = { 0x71000, 0x71800, 0x72000, 0x72800 };
+		uint32_t enabled = 0;
+
+		for (int i = 0; i < 4 && level >= 5; i++) {
+			vm_offset_t b = dpu_va(pp[i]);
+			uint32_t en = rd(b);
+
+			printf("mi8dpu: PP%d TEAR_EN %#x VSYNC_CFG %#010x HEIGHT %#010x INIT %#010x COUNT %#010x LINE %#010x AUTOREF %#010x\n",
+			    i, en, rd(b + 4), rd(b + 8), rd(b + 0x10), rd(b + 0x14), rd(b + 0x2c), rd(b + 0x30));
+			if (en & 1) {
+				enabled |= 1u << i;
+			}
+		}
+		for (int i = 0; i < 4 && level >= 6; i++) {
+			vm_offset_t b = dpu_va(pp[i]);
+			uint64_t t0, now, last_change = 0, ns;
+			uint32_t prev, cur, changes = 0, lmin = ~0u, lmax = 0, reads = 0;
+
+			if (!(enabled & (1u << i))) {
+				continue;
+			}
+			/* INT_COUNT_VAL low 16 bits: the read-pointer line count, counting up on the vsync clock and reloaded
+			 * (VSYNC_INIT) by each tearing-effect pulse: a drop = one pulse seen */
+			prev = rd(b + 0x14) & 0xffff;
+			t0 = mach_absolute_time();
+			do {
+				uint32_t line = rd(b + 0x2c) & 0xffff;
+
+				cur = rd(b + 0x14) & 0xffff;
+				now = mach_absolute_time();
+				reads++;
+				if (cur < lmin) {
+					lmin = cur;
+				}
+				if (cur > lmax) {
+					lmax = cur;
+				}
+				if (line != 0) {
+					changes += 1000;        /* the write pointer moved: noted below */
+				}
+				if (cur + 100 < prev) {
+					absolutetime_to_nanoseconds(now - (last_change ? last_change : t0), &ns);
+					if ((changes % 1000) < 12) {
+						printf("mi8dpu: PP%d read-pointer line %u -> %u, %u us after the last drop\n", i, prev, cur, (uint32_t)(ns / 1000));
+					}
+					changes++;
+					last_change = now;
+				}
+				prev = cur;
+				absolutetime_to_nanoseconds(now - t0, &ns);
+			} while (ns < 100000000ull);
+			printf("mi8dpu: PP%d over 100 ms: %u reads, %u drops (write pointer moved: %u), read-pointer line %u..%u\n",
+			    i, reads, changes % 1000, changes / 1000, lmin, lmax);
+		}
+	}
+	for (int i = 0; i < 7 && level >= 7; i++) {
+		static const uint32_t o[7] = { 0x0, 0x4, 0x8, 0x58, 0x5c, 0x84, 0x14 };
+
+		printf("mi8dpu: DSI0 +%#x = %#010x\n", o[i], rd(dpu_va(0x94000 + o[i])));
+	}
+}
+
+/*
+ * boot-arg mi8flip=N (EXP-0129): the first writes to the display. Two buffers of the panel's size, physically contiguous
+ * (the DPU's pipe SSPP0 reads 1080x2248 ARGB with stride 4320 from SRC0_ADDR; EXP-0128 found it reading the boot frame
+ * buffer 0x9d400000 under tear-check/auto-refresh), are filled with vertical bars and shown in turn by writing SSPP0's
+ * SRC0_ADDR and CTL0's FLUSH (bit 0 = VIG0, dpu_hw_catalog SDM845); the time until the FLUSH bit reads back 0 says when the
+ * hardware took the new address. At the end the original address is restored. N rounds; a round = A, B (3 s each).
+ */
+static void
+mi8_dpu_flip(uint32_t rounds)
+{
+	const uint32_t width = 1080, height = 2248, stride = 4320;
+	vm_size_t size = round_page((vm_size_t)stride * height);
+	vm_offset_t buf[2] = { 0, 0 };
+	vm_offset_t src = dpu_va(0x5000), ctl = dpu_va(0x2000);
+	uint32_t orig = rd(src + 0x14), ostride = rd(src + 0x24);
+
+	printf("mi8flip: SSPP0 source %#x stride %#x; buffers of %lu bytes\n", orig, ostride, (unsigned long)size);
+	if (ostride != stride || (rd(src) != ((height << 16) | width))) {
+		printf("mi8flip: SSPP0 is not what EXP-0128 saw: not going on\n");
+		return;
+	}
+	for (int b = 0; b < 2; b++) {
+		static const uint32_t color[2][4] = {
+			{ 0xffffffff, 0xffff0000, 0xff00ff00, 0xff0000ff },
+			{ 0xff000000, 0xff00ffff, 0xffff00ff, 0xffffff00 },
+		};
+
+		if (kmem_alloc_contig(kernel_map, &buf[b], size, PAGE_MASK, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("mi8flip: no contiguous memory for buffer %d\n", b);
+			goto done;
+		}
+		for (uint32_t y = 0; y < height; y++) {
+			uint32_t *row = (uint32_t *)(buf[b] + (vm_offset_t)y * stride);
+
+			for (uint32_t x = 0; x < width; x++) {
+				/* four bars; the bar's colour darkens down the screen so that a wrong stride or offset shows */
+				row[x] = (y % 200 < 8) ? 0xff808080u : color[b][(x * 4) / width];
+			}
+		}
+		to_memory(buf[b], size);
+		printf("mi8flip: buffer %d at physical %#llx\n", b, kvtophys(buf[b]));
+	}
+	for (uint32_t r = 0; r < rounds * 2; r++) {
+		uint64_t pa = kvtophys(buf[r & 1]), t0, t1, ns = 0;
+		uint32_t flush;
+
+		wr(src + 0x14, (uint32_t)pa);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		t0 = mach_absolute_time();
+		wr(ctl + 0x18, 1);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		do {
+			flush = rd(ctl + 0x18);
+			t1 = mach_absolute_time();
+			absolutetime_to_nanoseconds(t1 - t0, &ns);
+		} while ((flush & 1) && ns < 200000000ull);
+		printf("mi8flip: showing buffer %lu: SRC0_ADDR now %#x, FLUSH read back %#x after %u us\n",
+		    (unsigned long)(r & 1), rd(src + 0x14), flush, (uint32_t)(ns / 1000));
+		for (int i = 0; i < 300; i++) {
+			sleep_us(10000);
+		}
+	}
+done:
+	wr(src + 0x14, orig);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(ctl + 0x18, 1);
+	for (int i = 0; i < 100; i++) {
+		sleep_us(1000);
+	}
+	printf("mi8flip: original source %#x restored: SRC0_ADDR %#x, FLUSH %#x\n", orig, rd(src + 0x14), rd(ctl + 0x18));
+}
+
+/*
+ * boot-arg mi8bl=1 (EXP-0138): the panel's brightness. The EA8074 OLED takes it as DCS command 0x51 with two bytes, high
+ * first, 0x002..0x3ff (the phone's device tree: bl_ctrl_dcs, bl-dcs-type-ss, bl-max-level 0x3ff). Sent as Linux's msm DSI
+ * host does (dsi_host.c dsi_cmd_dma_add/msm_dsi_host_cmd_xfer_commit): the packet in memory in the controller's own
+ * order (word count low, high, data type, flags 0xc0 = last + long), DMA_BASE, DMA_LEN, TRIG_DMA = 1; TRIG_CTRL's DMA
+ * trigger is software already (4, EXP-0128). DSI0 is the 6G kind: registers at XML offset + 4 (DSI_6G_REG_SHIFT).
+ */
+#define DSI0_REG(off)   (0x94000 + 4 + (off))
+static vm_offset_t dsi_packet;
+static uint32_t mi8bl_hs;          /* mi8bl=2: the commands in high speed */
+static bool mi8bl_quiet;           /* the slider's commands: a line only for one that fails */
+static uint64_t dsi_packet_pa;
+
+static bool mi8_dsi_send(const uint8_t *packet, uint32_t len, const char *what);
+
+static bool
+mi8_dsi_brightness(uint32_t level)
+{
+	uint8_t pk[8];
+
+	level = level > 0x3ff ? 0x3ff : level;     /* 0 is dark: only mi8_panel_set(false) asks for it */
+	pk[0] = 3;              /* word count: 0x51 and two bytes */
+	pk[1] = 0;
+	pk[2] = 0x39;           /* DCS long write, virtual channel 0 */
+	pk[3] = 0xc0;           /* the last packet, a long one */
+	pk[4] = 0x51;
+	pk[5] = (uint8_t)(level >> 8);
+	pk[6] = (uint8_t)level;
+	pk[7] = 0xff;
+	return mi8_dsi_send(pk, 8, "brightness");
+}
+
+/* A DCS command without a parameter (short write, data type 0x05): 0x21 inverts the picture, 0x20 puts it back. */
+static bool
+mi8_dsi_short(uint8_t command)
+{
+	uint8_t pk[4] = { command, 0, 0x05, 0x80 };
+
+	return mi8_dsi_send(pk, 4, "short command");
+}
+
+static bool mi8_dsi_send(const uint8_t *packet, uint32_t len, const char *what);
+
+/*
+ * Read a DCS register of the panel (Linux dsi_host.c: SET_MAXIMUM_RETURN_PACKET_SIZE, then a DCS read with bit 5 of the
+ * flags = a turnaround for the answer, in low power), and the four read-back words RDBK_DATA0..3 (XML 0x68..0x74).
+ */
+static void
+mi8_dsi_read(uint8_t command, uint8_t size)
+{
+	uint8_t max[4] = { size, 0, 0x37, 0x80 }, rd_pk[4] = { command, 0, 0x06, 0xa0 };
+
+	mi8_dsi_send(max, 4, "max return size");
+	mi8_dsi_send(rd_pk, 4, "DCS read");
+	sleep_us(2000);
+	printf("mi8bl: read of DCS %#x: RDBK %#010x %#010x %#010x %#010x, ACK_ERR %#x, INTR_CTRL %#x, STATUS0 %#x\n", command,
+	    rd(dpu_va(DSI0_REG(0x68))), rd(dpu_va(DSI0_REG(0x6c))), rd(dpu_va(DSI0_REG(0x70))), rd(dpu_va(DSI0_REG(0x74))),
+	    rd(dpu_va(DSI0_REG(0x64))), rd(dpu_va(DSI0_REG(0x10c))), rd(dpu_va(DSI0_REG(0x04))));
+}
+
+static bool
+mi8_dsi_send(const uint8_t *packet, uint32_t len, const char *what)
+{
+	uint64_t t0, ns = 0;
+	uint32_t status, intr;
+
+	if (dsi_packet == 0) {
+		/* DMA_BASE is 32 bits. Ask VM for a low physical page rather than
+		 * rejecting an unconstrained allocation after userspace has started. */
+		if (kmem_alloc_contig(kernel_map, &dsi_packet, PAGE_SIZE, PAGE_MASK, (ppnum_t)(0xffffffffull >> PAGE_SHIFT), 0,
+		    KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("mi8bl: no memory for the command\n");
+			return false;
+		}
+		dsi_packet_pa = kvtophys(dsi_packet);
+		if (dsi_packet_pa > 0x100000000ull - PAGE_SIZE) {
+			printf("mi8bl: the command's memory is above 4 GB (%#llx): the DSI DMA address has 32 bits\n", dsi_packet_pa);
+			kmem_free(kernel_map, dsi_packet, PAGE_SIZE);
+			dsi_packet = 0;
+			dsi_packet_pa = 0;
+			return false;
+		}
+		printf("mi8bl: command buffer at %#llx, %lu bytes within the 32-bit DMA range\n", dsi_packet_pa, (unsigned long)PAGE_SIZE);
+	}
+	memcpy((void *)dsi_packet, packet, len);
+	to_memory(dsi_packet, 64);
+	/* INTR_CTRL: its status bits are cleared by writing 1 (the mask bits written back as they are): the DMA's "done" seen
+	 * afterwards is this command's */
+	intr = rd(dpu_va(DSI0_REG(0x10c)));
+	wr(dpu_va(DSI0_REG(0x10c)), (intr & 0x02220202u) | 1u);
+	wr(dpu_va(DSI0_REG(0x44)), (uint32_t)dsi_packet_pa);    /* DMA_BASE */
+	wr(dpu_va(DSI0_REG(0x48)), len);                        /* DMA_LEN */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	t0 = mach_absolute_time();
+	wr(dpu_va(DSI0_REG(0x8c)), 1);                          /* TRIG_DMA */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	do {
+		intr = rd(dpu_va(DSI0_REG(0x10c)));
+		status = rd(dpu_va(DSI0_REG(0x04)));
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	} while (!(intr & 1) && ns < 50000000ull);
+	if (!mi8bl_quiet || !(intr & 1)) {
+		printf("mi8bl: %s %02x %02x %02x %02x %02x %02x %02x %02x (%u bytes): DMA done %s after %u us; STATUS0 %#x INTR_CTRL %#x "
+		    "ACK_ERR %#x\n", what, packet[0], packet[1], packet[2], packet[3], len > 4 ? packet[4] : 0, len > 5 ? packet[5] : 0,
+		    len > 6 ? packet[6] : 0, len > 7 ? packet[7] : 0, len, (intr & 1) ? "yes" : "NO", (uint32_t)(ns / 1000), status, intr,
+		    rd(dpu_va(DSI0_REG(0x64))));
+	}
+	return (intr & 1) != 0;
+}
+
+static void mi8_bl_test(void);
+
+/*
+ * sysctl kern.mi8_brightness (EXP-0139, 0142): 0 (the screen off while locked) or 2..1023, the panel's brightness, written by our library in backboardd when iOS's
+ * brightness system is told a new display brightness (userland/src/inject.c); reads give the last level sent, 0 before
+ * any. One command at a time; only while DSI0 is as the boot loaders left it (command mode, software DMA trigger).
+ */
+static LCK_GRP_DECLARE(mi8bl_lck_grp, "mi8-brightness");
+static LCK_MTX_DECLARE(mi8bl_lock, &mi8bl_lck_grp);
+static int mi8bl_level;
+static bool mi8bl_off;             /* the panel is told DCS 0x28 (display off) and its brightness is 0 */
+
+/* The panel dark (EXP-0142): brightness 0, then DCS 0x28 display off; on again with 0x29 first. Called with mi8bl_lock held. */
+static bool
+mi8_panel_set(bool on, uint32_t level)
+{
+	bool ok = true;
+
+	if (on && mi8bl_off) {
+		ok = mi8_dsi_short(0x29);
+		mi8bl_off = !ok;
+	}
+	if (on) {
+		return ok && mi8_dsi_brightness(level < 2 ? 2 : level);
+	}
+	ok = mi8_dsi_brightness(0) && mi8_dsi_short(0x28);
+	mi8bl_off = ok;
+	return ok;
+}
+
+/* For the way back to the loader (osfmk/arm64/loader_return.c): the loader's screen must not stay dark. */
+void
+mi8_panel_restore(void)
+{
+	if (mi8bl_off) {
+		mi8bl_quiet = true;
+		lck_mtx_lock(&mi8bl_lock);
+		mi8_panel_set(true, 0x155);
+		lck_mtx_unlock(&mi8bl_lock);
+	}
+}
+
+static int
+mi8_brightness_sysctl(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int level = mi8bl_level, error = sysctl_handle_int(oidp, &level, 0, req);
+
+	if (error != 0 || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	if (level < 0 || level == 1 || level > 0x3ff) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&mi8bl_lock);
+	mi8bl_quiet = true;
+	if ((rd(dpu_va(DSI0_REG(0))) & 5) != 5 || (rd(dpu_va(DSI0_REG(0x80))) & 7) != 4) {
+		error = ENXIO;
+	} else if (mi8_panel_set(level != 0, (uint32_t)level)) {
+		mi8bl_level = level;
+	} else {
+		error = EIO;
+	}
+	lck_mtx_unlock(&mi8bl_lock);
+	return error;
+}
+SYSCTL_PROC(_kern, OID_AUTO, mi8_brightness, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, NULL, 0,
+    mi8_brightness_sysctl, "I", "the panel's brightness, 2..1023 (DCS 0x51); 0 = display off (DCS 0x28)");
+
+static void
+mi8_bl_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	delay_for_interval(70, NSEC_PER_SEC);
+	printf("mi8bl: 70 s on: the brightness steps now\n");
+	mi8_bl_test();
+	thread_terminate(current_thread());
+}
+
+static void
+mi8_bl_test(void)
+{
+	static const uint32_t levels[] = { 0x080, 0x3ff, 0x020, 0x200, 0x300 };
+
+	printf("mi8bl: DSI0 CTRL %#x STATUS0 %#x CMD_DMA_CTRL %#x CMD_CFG0 %#x CMD_CFG1 %#x DMA_BASE %#x DMA_LEN %#x TRIG_CTRL %#x "
+	    "ERR_INT_MASK0 %#x INTR_CTRL %#x\n", rd(dpu_va(DSI0_REG(0))), rd(dpu_va(DSI0_REG(0x04))), rd(dpu_va(DSI0_REG(0x38))),
+	    rd(dpu_va(DSI0_REG(0x3c))), rd(dpu_va(DSI0_REG(0x40))), rd(dpu_va(DSI0_REG(0x44))), rd(dpu_va(DSI0_REG(0x48))),
+	    rd(dpu_va(DSI0_REG(0x80))), rd(dpu_va(DSI0_REG(0x108))), rd(dpu_va(DSI0_REG(0x10c))));
+	if ((rd(dpu_va(DSI0_REG(0))) & 5) != 5 || (rd(dpu_va(DSI0_REG(0x80))) & 7) != 4) {
+		printf("mi8bl: DSI0 is not in command mode with a software DMA trigger: nothing sent\n");
+		return;
+	}
+	{
+		/* the last command the boot loaders sent: its packet is still where DMA_BASE says (free memory, not ours) */
+		uint32_t base = rd(dpu_va(DSI0_REG(0x44))), len = rd(dpu_va(DSI0_REG(0x48)));
+		vm_offset_t page = (base != 0 && len != 0 && len <= 256) ? ml_io_map(base & ~0x3fffu, 0x4000) : 0;
+
+		if (page != 0) {
+			const uint8_t *b = (const uint8_t *)(page + (base & 0x3fff));
+			printf("mi8bl: the boot loaders' last command (%u bytes at %#x): %02x %02x %02x %02x  %02x %02x %02x %02x  "
+			    "%02x %02x %02x %02x  %02x %02x %02x %02x\n", len, base, b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7],
+			    b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]);
+		}
+	}
+	if (!mi8bl_hs) {
+		wr(dpu_va(DSI0_REG(0x38)), rd(dpu_va(DSI0_REG(0x38))) | (1u << 26));      /* low power, as the boot loaders had it */
+	}
+	mi8_dsi_read(0x0a, 1);          /* power mode: 0x9c when the panel is awake and showing */
+	mi8_dsi_read(0x52, 2);          /* the brightness it has */
+	mi8_dsi_brightness(0x155);
+	mi8_dsi_read(0x52, 2);          /* ... and after 0x155 was written */
+	mi8_dsi_read(0x54, 1);          /* CTRL display (0x53's value: 0x20 = brightness control on) */
+	mi8_dsi_read(0xda, 1);          /* ID1 */
+	if (mi8bl_hs) {
+		/* high speed instead of the boot loaders' low power (CMD_DMA_CTRL bit 26) */
+		wr(dpu_va(DSI0_REG(0x38)), rd(dpu_va(DSI0_REG(0x38))) & ~(1u << 26));
+		printf("mi8bl: commands in high speed: CMD_DMA_CTRL %#x\n", rd(dpu_va(DSI0_REG(0x38))));
+	}
+	for (unsigned i = 0; i < sizeof(levels) / sizeof(levels[0]); i++) {
+		if (!mi8_dsi_brightness(levels[i])) {
+			printf("mi8bl: the command DMA did not finish: stopping\n");
+			return;
+		}
+		for (int j = 0; j < 250; j++) {
+			sleep_us(10000);
+		}
+	}
+}
+
+/*
+ * boot-arg mi8_ddr=N (EXP-0127): the memory system's bandwidth votes, which nothing here makes (Linux: interconnect
+ * drivers, bwmon). The Apps RSC's HLOS DRV (drv-2 of apps_rsc@179c0000, sdm845.dtsi; qcom,tcs-offset 0xd00,
+ * TCS 0 and 1 are the active-only ones) is given one request with the BCMs "MC0" (the memory controller) and "SH0"
+ * (the LLCC / system cache) voted for bandwidth. BCM command word (bcm-voter): commit << 30 | valid << 29 |
+ * vote_x << 14 | vote_y, each 14 bits; N is the share of the biggest vote (0x3fff) in 1/16ths, 16 = all of it.
+ * Registers and sequence as rpmh-rsc.c (version 2.7 offsets).
+ */
+static void
+mi8_ddr_vote(uint32_t sixteenths)
+{
+	const struct cmd_db_header *db = (const struct cmd_db_header *)cmd_db_map();
+	static vm_offset_t rsc_va;
+	vm_offset_t base, tcs;
+	const char *const names[2] = { "MC0", "SH0" };
+	uint32_t address[2], vote = (0x3fffu * (sixteenths > 16 ? 16 : sixteenths)) / 16, id;
+
+	if (rsc_va == 0) {
+		rsc_va = (vm_offset_t)ml_io_map(0x179e0000ull, 0x10000);
+	}
+	base = rsc_va;
+	tcs = base + 0xd00;
+	if (base == 0) {
+		printf("mi8gpu: ddr: no mapping of the Apps RSC\n");
+		return;
+	}
+	printf("mi8gpu: ddr: reading the Apps RSC (drv-2 mapped at %#lx)\n", (unsigned long)base);
+	id = rd(base + 0);
+	printf("mi8gpu: ddr: apps_rsc drv-2 ID %#x, PRNT_CHLD_CONFIG %#x, SOLVER %#x; TCS 0: CONTROL %#x CMD_ENABLE %#x IRQ_STATUS %#x\n", id,
+	    rd(base + 0x0c), rd(base + 0x04), rd(tcs + 0x14), rd(tcs + 0x1c), rd(tcs + 0x04));
+	if (sixteenths >= 100) {
+		return;         /* mi8_ddr=100: only looked */
+	}
+	for (int i = 0; i < 2; i++) {
+		address[i] = rpmh_address(db, names[i]);
+		if (address[i] == 0) {
+			printf("mi8gpu: ddr: no resource %s\n", names[i]);
+			return;
+		}
+	}
+	/* a free TCS 0: nothing enabled in it, no transfer under way */
+	if (rd(tcs + 0x1c) != 0 || (rd(tcs + 0x14) & (1u << 24))) {
+		printf("mi8gpu: ddr: TCS 0 is in use (CONTROL %#x CMD_ENABLE %#x): not touched\n", rd(tcs + 0x14), rd(tcs + 0x1c));
+		return;
+	}
+	for (int i = 0; i < 2; i++) {
+		uint32_t command = (1u << 30) | (1u << 29) | (vote << 14) | vote;
+
+		wr(tcs + 0x30 + 20 * i, (1u << 16) | (1u << 8) | 8u);  /* MSGID: write, response requested, length 8 */
+		wr(tcs + 0x34 + 20 * i, address[i]);
+		wr(tcs + 0x38 + 20 * i, command);
+		printf("mi8gpu: ddr: command %d: %s at %#x <- %#010x\n", i, names[i], address[i], command);
+	}
+	wr(tcs + 0x1c, 3);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(tcs + 0x14, 1u << 16);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(tcs + 0x14, (1u << 16) | (1u << 24));
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (int t = 0; t < 20000; t++) {
+		if (rd(tcs + 0x04) & 1u) {
+			break;
+		}
+		sleep_us(10);
+	}
+	printf("mi8gpu: ddr: IRQ_STATUS %#x, command status %#x %#x, CONTROL %#x\n", rd(tcs + 0x04), rd(tcs + 0x3c), rd(tcs + 0x3c + 20), rd(tcs + 0x14));
+	wr(tcs + 0x14, 0);
+	wr(tcs + 0x1c, 0);
+	wr(tcs + 0x08, 1u);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* boot-arg mi8_cmddb=1 (EXP-0127): every resource of the command database that is a BCM (address 0x5xxxx) with its aux data. */
+static void
+mi8_cmddb_dump(void)
+{
+	const struct cmd_db_header *db = (const struct cmd_db_header *)cmd_db_map();
+
+	for (unsigned sl = 0; sl < 8; sl++) {
+		const struct cmd_db_slave *slave = &db->slave[sl];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(db->data + slave->header_offset);
+
+		if (slave->id == 0 || slave->header_offset >= CMD_DB_SIZE - 0x1000 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			char name[9] = { 0 };
+			const uint8_t *aux;
+
+			memcpy(name, entry[i].id, 8);
+			if ((entry[i].address & 0xff0000) != 0x50000 && sl != 0) {
+				continue;
+			}
+			aux = db->data + slave->data_offset + entry[i].offset;
+			if (entry[i].length == 0 || entry[i].length > 64 || slave->data_offset + entry[i].offset + entry[i].length >= CMD_DB_SIZE - 0x1000) {
+				printf("mi8gpu: cmddb slave %u: %-8s at %#x (%u bytes of aux: not shown)\n", slave->id, name, entry[i].address, entry[i].length);
+				continue;
+			}
+			printf("mi8gpu: cmddb slave %u: %-8s at %#x, aux %u bytes:", slave->id, name, entry[i].address, entry[i].length);
+			for (unsigned b = 0; b < entry[i].length && b < 32; b++) {
+				printf(" %02x", aux[b]);
+			}
+			printf("\n");
+		}
+	}
+}
+
+/* boot-arg mi8_membench=1 (EXP-0127): what the processor gets out of the memory, in MB/s, three times each. */
+static void
+mi8_membench(void)
+{
+	const size_t size = 32u << 20;
+	vm_offset_t buffer;
+
+	if (kmem_alloc(kernel_map, &buffer, size, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("mi8gpu: membench: no 32 MB\n");
+		return;
+	}
+	{
+		/* the processor's own clock: a chain of dependent additions is one cycle each */
+		uint64_t t0, t1, ns, x = 1;
+
+		t0 = mach_absolute_time();
+		for (uint64_t i = 0; i < 100000000ull; i++) {
+			__asm__ volatile ("add %0, %0, #1" : "+r" (x));
+		}
+		t1 = mach_absolute_time();
+		absolutetime_to_nanoseconds(t1 - t0, &ns);
+		printf("mi8gpu: membench: 100 M dependent additions took %llu us: about %llu MHz (%llu)\n", ns / 1000, 100000ull * 1000 / (ns / 1000 ? ns / 1000 : 1), x & 1);
+	}
+	for (int round = 0; round < 3; round++) {
+		uint64_t t0, t1, t2, t3, ns_w, ns_c, ns_r, sum = 0;
+		const uint64_t * volatile in = (const uint64_t *)buffer;
+
+		t0 = mach_absolute_time();
+		memset((void *)buffer, round + 1, size);
+		t1 = mach_absolute_time();
+		memcpy((void *)(buffer + size / 2), (void *)buffer, size / 2);
+		t2 = mach_absolute_time();
+		for (size_t i = 0; i < size / 8; i += 4) {
+			sum += in[i] + in[i + 1] + in[i + 2] + in[i + 3];
+		}
+		t3 = mach_absolute_time();
+		absolutetime_to_nanoseconds(t1 - t0, &ns_w);
+		absolutetime_to_nanoseconds(t2 - t1, &ns_c);
+		absolutetime_to_nanoseconds(t3 - t2, &ns_r);
+		printf("mi8gpu: membench %d: write 32 MB %llu MB/s, copy 16 MB %llu MB/s (read+write), read 32 MB %llu MB/s (%llu)\n", round,
+		    (uint64_t)size * 1000 / ns_w, (uint64_t)(size / 2) * 1000 / ns_c, (uint64_t)size * 1000 / ns_r, sum & 0xff);
+	}
+	kmem_free(kernel_map, buffer, size);
+}
