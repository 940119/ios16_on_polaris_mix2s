+/* B74: the packet clock. RS_CLOCK_STRIDE dwords per arm, RS_CLOCK_ARMS arms of
+* real work plus one spare arm for the after-control. The value carries its own
+* index, so a slot that was never written and a slot written with somebody
+* else's value are different readings. */
+#define RS_CLOCK_OFF		0x680u			/* memptrs page, past the CAL slot at 0x660 */
+#define RS_CLOCK_N		6u			/* ticks 1..6; the closing marker is separate */
+#define RS_CLOCK_STRIDE		8u
+#define RS_CLOCK_ARMS		3u
+#define RS_CLOCK(n)		(0xd0d00000u | (uint32_t)(n))	/* tick n -> 0xd0d0000n */
+/* B71: the calibration probes. All five are C macros generated from the very
+ * constants this script asserts on, so the C and the model cannot drift. */
+#define RS_CAL_A	0x88d0u			/* RB_RESOLVE_CNTL_0: YUV plane, harmless */
+#define RS_CAL_B	0x88d1u			/* RB_RESOLVE_CNTL_1: rect origin, harmless */
+#define RS_CAL_CTL	0x0a9b0u			/* SP_CS_CNTL_0: the positive control */
+#define RS_CAL_VA	0x0000000au
+#define RS_CAL_VB	0x0000000bu
