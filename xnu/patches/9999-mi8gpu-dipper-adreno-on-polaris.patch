+#define BS_PIX(x, y)    (0x5a000000u | ((uint32_t)(y) << 8) | ((uint32_t)(x) + 1u))
+#define BS_ROW(y)       BS_PIX(0u, y)          /* first pixel of row y */
+#define BS_FILL         0xcdcdcdcdu
+#define BS_FENCE_OFF    0x720u      /* memptrs, past the step-24 clock at 0x680 */
+#define BS_MARK_OFF     0x724u
+#define BS_CLOCK_OFF    0x740u
+#define BS_CLOCK(n)     (0xd1d00000u | (uint32_t)(n))
+#define BS_FENCE        (0xf00d0000u | 0x61u)
+#define BS_MARK         0xc1de0547u
+#define BS_SRC_INFO     0x00500030u /* FMT6_8_8_8_8_UNORM, linear, WZYX, UNK20|UNK22, FILTER=0 */
+#define BS_SRC_SIZE     (BS_W | (BS_H << 15))           /* WIDTH[14:0], HEIGHT[29:15] */
+#define BS_SRC_PITCH    ((BS_PITCH >> 6) << 9)          /* PITCH[23:9], shr=6 */
