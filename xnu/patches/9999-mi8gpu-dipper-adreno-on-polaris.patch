diff --git a/bsd/dev/mi8gpu_sweet.h b/bsd/dev/mi8gpu_sweet.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/mi8gpu_sweet.h
@@ -0,0 +1,79 @@
+#ifndef _BSD_DEV_MI8GPU_SWEET_H_
+#define _BSD_DEV_MI8GPU_SWEET_H_
+/*
+ * dipper's bsd/dev/mi8_adreno.c was written for HackiOS's <sys/redwood_input.h>.
+ * On SWEET/polaris (xnu-8796.141.3) these headers supply processor_t,
+ * PROCESSOR_NULL, ml_get_max_cpu_number(), cpu_number() and ml_phys_read_word()
+ * with the signatures the driver uses.
+ *
+ * thread_bind() is NOT visible from a BSD translation unit: the build uses a
+ * trimmed EXPORT_HDRS copy of sched_prim.h. dipper declared it locally too
+ * (xnu-mi8.patch, mi8_bind_thread), so we do the same here. First CI run
+ * 42512155412 failed with "call to undeclared function 'thread_bind'" when
+ * the local extern was removed -- do not remove it again.
+ */
+#include <kern/processor.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/cpu_number.h>
+#include <pexpert/pexpert.h>
+
+extern processor_t thread_bind(processor_t processor);
+
+/* dipper also echoes every log byte to the loader's serial log. On SWEET,
+ * printf() already reaches the persistent log ring synchronously, so there is
+ * no second sink; keeping say() intact costs one no-op macro. */
+#define loader_log_putc(c) ((void)(c))
+
+void mi8_adreno_init(void);     /* boot-arg mi8gpu=N; default off */
+
+/* B86: the C -> C++ link probe. Defined in bsd/dev/mi8_surface_bridge.cpp,
+ * a C++ translation unit that includes NO iokit header and touches NO IOKit
+ * object. mi8_adreno.c is a C TU and must NEVER include SweetSurface.h:
+ * that header declares `class SweetSurface : public OSObject` (lesson 86).
+ * An extern "C" declaration on the C side is the whole bridge; the magic
+ * returned by the C++ side proves the linker resolved it. */
+extern unsigned int mi8_surface_bridge_probe(void);
+/* B87b: staged early-IOKit probe. Each call does exactly ONE thing, so the
+ * PRE/POST pair printed by the C driver names the stage on a panic. */
+extern uint64_t mi8_surface_bridge_stage(unsigned int stage, uint64_t phys,
+    unsigned int width, unsigned int height, unsigned int row,
+    unsigned int format);
+/* B88: wrap a driver-OWNED buffer's physical pages in a SweetSurface and
+ * return its kernel address (0 on failure). The SMMU side of the same pages
+ * is mapped by the "surf" region, so this is the allocate -> map -> wrap
+ * path Mesa needs, not the panel's fixed-phys special case. */
+extern unsigned long long mi8_surface_bridge_create(unsigned long long phys,
+    unsigned int width, unsigned int height, unsigned int row,
+    unsigned int format);
+/* 5-a: the GPU ioctl surface. Returns 0 on success and writes one 64-bit
+ * answer; the command numbering is described where it is implemented. */
+extern int mi8_gpu_ioctl(unsigned int cmd, unsigned long long arg,
+    unsigned long long *out);
+/* 5-b1: read-only probe of the mounted iOS root. Returns 0 and fills the
+ * name buffer on success; the driver prints the result into the ring. */
+extern int mi8_root_probe(char *sbuf, unsigned int slen, unsigned long long *vid,
+    int *isroot);
+
+/* Forward declarations that lived in HackiOS's bsd/sys/redwood_input.h.
+ * mi8_gpu_done() is called at line ~2913 but defined at ~2940; without these,
+ * C99's implicit-int declaration clashes with the bool definition below
+ * ("call to undeclared function" + "conflicting types", CI 42512155412).
+ * Verbatim from patches/xnu-mi8.patch, redwood_input.h hunk @@ -122,6 +125,24 @@. */
+bool mi8_gpu_kept(void);
+bool mi8_gpu_parameter(uint32_t which, uint64_t *value);
+uint64_t mi8_gpu_address(uint64_t size);
+void mi8_gpu_address_free(uint64_t address, uint64_t size);
+void mi8_gpu_space(uint64_t *used, uint32_t *live, uint64_t *largest, unsigned *holes, unsigned *most, uint64_t *lost, uint32_t *refused);
+bool mi8_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+void mi8_gpu_mapped(void);
