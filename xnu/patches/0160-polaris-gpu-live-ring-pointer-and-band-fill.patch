+/*
+ * Write a run of dwords into the panel's window: one packet per PG_DRAW_CHUNK,
+ * PG_DRAW_PER_BATCH packets per submission, drain between submissions.
+ *
+ * `first` is the dword offset into the panel, not into the run, so the pixel a
+ * dword gets is still derived from where it lands. Build 0158 and 0159 filled
+ * from offset 0 with a ring pointer captured before the rewrite test had moved
+ * it, which put the command processor's read pointer in the middle of a packet:
+ * it decoded the data as a header, stopped, and never took another word - the
+ * "the CP takes nothing at all" of 0159. The caller now passes the live ring
+ * pointer in, and this function hands the advanced one back.
+ */
+static uint32_t
+pg_panel_fill(uint32_t first, uint32_t count, uint32_t width, uint32_t height,
+    uint32_t stride, uint32_t *wptrp)
+{
+	uint32_t wptr = *wptrp, rptr = 0, sent = 0, batches = 0;
+	uint32_t per_row = stride / 4u;
+	bool stalled = false;
+
+	while (sent < count && !stalled) {
+		for (uint32_t c = 0; c < PG_DRAW_PER_BATCH && sent < count; c++) {
+			uint32_t n = count - sent < PG_DRAW_CHUNK ? count - sent : PG_DRAW_CHUNK;
+			uint64_t addr = PG_PANEL_IOVA + 4ull * (uint64_t)(first + sent);
+
+			pg_ring_put(wptr++, pg_pkt7(PG_CP_MEM_WRITE, n + 2u));
+			pg_ring_put(wptr++, (uint32_t)addr);
+			pg_ring_put(wptr++, (uint32_t)(addr >> 32));
+			for (uint32_t i = 0; i < n; i++) {
+				uint32_t at = first + sent + i;
+
+				pg_ring_put(wptr++, pg_panel_pixel(at / per_row, at % per_row,
+				    width, height));
+			}
+			sent += n;
+		}
+		wptr &= PG_RING_WORDS - 1u;
+		pg_ring_flush();
+		pg_wr(pg_gpu3d + 4u * PG_CP_RB_WPTR, wptr);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		{
+			bool drained = false;
+
+			/*
+			 * One second. Build 0155 gave up after 200 ms at 83% and
+			 * reported a stop that may only have been the CP falling
+			 * behind; waiting longer costs boot time only if the CP
+			 * really has stopped, and then the message says so.
+			 */
+			for (uint32_t i = 0; i < 100000; i++) {
+				rptr = pg_rd(pg_gpu3d + 4u * PG_CP_RB_RPTR);
+				if (rptr == wptr) {
+					drained = true;
+					break;
+				}
+				pg_sleep_us(10);
+			}
+			if (!drained) {
+				vm_offset_t cb = pg_smmu_cb(PG_GMU_CTX);
+
+				printf("POLARIS GPU: 18 the CP stopped at %u of %u dwords of this "
+				    "run (%u%%), %u submissions in: RPTR %u WPTR %u, "
+				    "RBBM_STATUS %#010x\n", sent, count,
+				    (uint32_t)((uint64_t)sent * 100u / count), batches, rptr,
+				    pg_rd(pg_gpu3d + 4u * PG_CP_RB_WPTR),
+				    pg_rd(pg_gpu3d + 4u * PG_RBBM_STATUS));
+				printf("POLARIS GPU: 18 context bank %u FSR %#010x FSYNR0 %#010x "
+				    "FAR %#010x%08x INT_0_STATUS %#010x\n", PG_GMU_CTX,
+				    pg_rd(cb + PG_CB_FSR), pg_rd(cb + 0x5c), pg_rd(cb + 0x64),
+				    pg_rd(cb + 0x60),
+				    pg_rd(pg_gpu3d + 4u * PG_RBBM_INT_STATUS));
+				pg_cp_watch("the batch did not drain in one second", wptr);
+				pg_cp_probe("after the fill stopped");
+				stalled = true;
+			}
+		}
+		batches++;
+	}
+	*wptrp = wptr;
+	printf("POLARIS GPU: 18 dwords %u..%u (rows %u..%u): the CP took %u of %u in %u "
+	    "submissions\n", first, first + count - 1u, first / per_row,
+	    (first + count - 1u) / per_row, sent, count, batches);
+	return sent;
+}
