diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -210,23 +210,6 @@
 #define UD_FRAME_MAX    0x800
 #define UD_SIZE         0x4000
 
-/*
- * Low (below 4 GiB) DMA windows, in the gaps of this phone's reserved-memory
- * map as read out of the stock polaris DTB: 0x98000000 sits between
- * pil_spss_region and cont_splash_region, 0xa1800000 between cont_splash_
- * region and ramdump_fb_region, and 0xb0000000 above every carve-out (the
- * last one ends exactly there). The DWC3 master cannot reach XNU's memory on
- * polaris: the kernel is mapped at 0x1_00000000 (mkadt.py --highmem) while on
- * sweet it sits at 0xb0000000, below 4 GiB, which is why the same code works
- * there. With a buffer above 4 GiB no event ever lands (GEVNTCOUNT stays 0)
- * and SETEPCONFIG never clears CMDACT.
- */
-static const uint64_t ud_low_pa[] = {
-	0xa1800000,
-	0x98000000,
-	0xb0000000,
-};
-
 /* Physical endpoints: 2n = OUT, 2n+1 = IN */
 #define EP_RX           2               /* 0x01 bulk OUT */
 #define EP_TX           3               /* 0x81 bulk IN */
@@ -290,7 +273,15 @@
 	dwc_wr(DEPCMDPAR1(ep), p1);
 	dwc_wr(DEPCMDPAR2(ep), p2);
 	dwc_wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
-	for (int i = 0; i < 1000; i++) {
+	/*
+	 * delay() is in microseconds here (see the soft-reset loop below, which
+	 * uses delay(1000) per millisecond). 1000 iterations of delay(1) were
+	 * therefore a 1 ms timeout, while Linux's dwc3_wait_gadget_ep_cmd allows
+	 * 500 ms: DEPCMD_SETEPCONFIG never cleared CMDACT inside that window even
+	 * though the command engine was alive (DEPCMD_DEPSTARTCFG kept
+	 * completing right after), so it only looked like a hardware failure.
+	 */
+	for (int i = 0; i < 5000; i++) {
 		uint32_t v = dwc_rd(DEPCMD(ep));
 		if (!(v & DEPCMD_CMDACT)) {
 			uint32_t status = (v >> 12) & 0xf;
@@ -302,7 +293,7 @@
 			printf("SWEET USB: ep%u cmd 0x%x ok polls %d\n", ep, cmd & 0xf, i);
 			return 0;
 		}
-		delay(1);
+		delay(100);
 	}
 	printf("SWEET USB: ep%u cmd 0x%x timeout: DEPCMD 0x%08x status %u PAR0 0x%08x PAR1 0x%08x PAR2 0x%08x\n",
 	    ep, cmd & 0xf, dwc_rd(DEPCMD(ep)), (dwc_rd(DEPCMD(ep)) >> 12) & 0xf,
@@ -948,48 +939,6 @@
 	printf("SWEET USB: evt buf programmed: ADR 0x%08x%08x SIZ 0x%08x COUNT %u\n",
 	    dwc_rd(GEVNTADRHI), dwc_rd(GEVNTADRLO), dwc_rd(GEVNTSIZ), dwc_rd(GEVNTCOUNT) & 0xffff);
 
-	/* Find a window the controller can actually DMA into (see ud_low_pa). */
-	vm_offset_t low_va = 0;
-	int chosen = -1;
-	for (unsigned i = 0; i < sizeof(ud_low_pa) / sizeof(ud_low_pa[0]); i++) {
-		vm_offset_t va = ml_io_map((vm_offset_t)ud_low_pa[i], UD_SIZE);
-		if (va == 0) {
-			printf("SWEET USB: low 0x%llx: map failed\n", ud_low_pa[i]);
-			continue;
-		}
-		dwc_wr(GEVNTADRLO, (uint32_t)(ud_low_pa[i] + UD_EVT));
-		dwc_wr(GEVNTADRHI, (uint32_t)((ud_low_pa[i] + UD_EVT) >> 32));
-		dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);
-		dwc_wr(GEVNTCOUNT, 0);
-		for (unsigned w = 0; w < 8; w++) {
-			*(volatile uint32_t *)(va + UD_EVT + 4 * w) = 0;
-		}
-		(void)ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0);
-		int cnt = 0;
-		for (unsigned t = 0; t < 200; t++) {
-			cnt = (int)(dwc_rd(GEVNTCOUNT) & 0xffff);
-			if (cnt) {
-				break;
-			}
-			delay(1000);
-		}
-		printf("SWEET USB: probe 0x%llx: GEVNTCOUNT %d\n", ud_low_pa[i], cnt);
-		if (cnt != 0 && chosen < 0) {
-			chosen = (int)i;
-			low_va = va;
-		}
-	}
-	if (chosen >= 0) {
-		ud.dma_pa = ud_low_pa[chosen];
-		ud.dma = low_va;
-		dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
-		dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
-		dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);
-		dwc_wr(GEVNTCOUNT, 0);
-		ud.evt_pos = 0;
-		printf("SWEET USB: using low DMA window pa 0x%llx\n", ud.dma_pa);
-	}
-
 	/* High speed, address 0 */
 	uint32_t dcfg = dwc_rd(DCFG) & ~(7u | (0x7fu << 3));
 	dwc_wr(DCFG, dcfg | 0);
