+/* 0319: the modem consumed our VERSION_ACK (tx tail 0 -> 8) and wrote
+ * a batch of commands (rx head 8 -> 0x50), then stopped to wait for
+ * OPEN_ACK.  Parse the frames exactly like pump() (mi8_glink.c:592-620),
+ * answer the OPEN, consume the whole batch, and ring the GLINK line. */
+static void
+md_glink_open_ack(uint32_t elapsed_ms)
+{
+	uint32_t d[4], i, txtail, txhead, rxtail, rxhead;
+	uint32_t at, h0, h1, cmd, cid, arg, n;
+	uint32_t open_cid = 0;
+	bool have_open = FALSE;
+
+	if (md_glink_opened || !md_glink_acked ||
+	    md_glink_desc_at == 0 || md_glink_tx_at == 0 ||
+	    md_glink_rx_at == 0) {
+		return;
+	}
+	for (i = 0; i < 4u; i++) {
+		d[i] = 0;
+		if (!md_smem_peek(md_glink_desc_at + 4u * i, &d[i], 4u)) {
+			return;
+		}
+	}
+	txtail = d[0]; txhead = d[1]; rxtail = d[2]; rxhead = d[3];
+	/* 0318 left tx head and rx tail at 8; the modem must have read it. */
+	if (txtail < 8u || txhead < 8u || rxtail < 8u ||
+	    rxhead <= rxtail || rxhead > MD_GLINK_FIFO_SIZE ||
+	    (txhead & 7u) || (rxhead & 7u)) {
+		return;
+	}
+	at = rxtail;
+	while (at + 8u <= rxhead) {
+		h0 = md_smem_word(md_glink_rx_at + at);
+		h1 = md_smem_word(md_glink_rx_at + at + 4u);
+		cmd = h0 & 0xffffu;
+		cid = (h0 >> 16) & 0xffffu;
+		arg = h1;
+		n = 8u;
+		if (cmd == MD_GLINK_OPEN) {
+			n += arg & 0xffffu;
+			have_open = TRUE;
+			open_cid = cid;
+		} else if (cmd == MD_GLINK_INTENT) {
+			n += 8u * arg;
+		}
+		n = (n + 7u) & ~7u;
+		MD_SAY("POLARIS MODEM:   0319: 480 frame at +%u: cmd %u "
+		    "cid %u arg %#x frame %u bytes\n", at, cmd, cid, arg, n);
+		if (n < 8u || n > rxhead - at) {
+			break;
+		}
+		at += n;
+	}
+	if (!have_open || open_cid == 0) {
+		MD_SAY("POLARIS MODEM:   0319: no OPEN in the batch "
+		    "(rx tail %u -> head %u); no OPEN_ACK sent\n", rxtail, rxhead);
+		return;
+	}
+	MD_SAY("POLARIS MODEM:   0319: modem opened channel cid %u at "
+	    "t=+%u ms; tx tail %u tx head %u rx tail %u rx head %u\n",
+	    open_cid, elapsed_ms, txtail, txhead, rxtail, rxhead);
+	md_smem_poke(md_glink_desc_at + 8u, rxhead);	/* consume the batch */
+	md_smem_poke(md_glink_tx_at + txhead,
+	    MD_GLINK_OPEN_ACK | (open_cid << 16));
+	md_smem_poke(md_glink_tx_at + txhead + 4u, 0u);
+	md_smem_poke(md_glink_desc_at + 4u, txhead + 8u);
+	md_glink_ring();
+	md_glink_opened = TRUE;
+	MD_SAY("POLARIS MODEM: 0319 VERDICT: GLINK OPEN_ACK SENT "
+	    "(cid %u, tx head %u, rx tail %u); watching for QRTR data / "
+	    "INTENT_REQ\n", open_cid, txhead + 8u, rxhead);
+}
