+ *   #define DWC3_GSTS    0xc118     <- the real one
+ *   #define DWC3_GUCTL1  0xc11c
+ *   #define DWC3_GSNPSID 0xc120
+ *   #define DWC3_GUCTL   0xc12c     <- not adjacent at all
+ *
+ * GEVTEN is the global event enable and resets to zero, which is exactly what
+ * every build since 0258 printed as "GSTS 0x00000000". The conclusion those
+ * builds drew - cable/session/bvalid all clear - happens to survive, because
+ * the real GSTS (0x7e800000) has bits 12, 13 and 14 clear too, but the
+ * instrument has to say the right thing.
+ */
+#define GSTS                0xc118
+#define GEVTEN              0xc114
+#define GUCTL               0xc12c
