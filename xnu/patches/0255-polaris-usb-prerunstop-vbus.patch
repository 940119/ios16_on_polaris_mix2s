 /*
+ * pre_run_stop helper: re-assert UTMI_OTG_VBUS_VALID without the SS_PHY_CTRL
+ * write or the print storm. dwc3_qcom_run_stop_notifier() only touches the HS
+ * QSCRATCH VBUS_VALID bit; the SS PHY is not involved in a high-speed gadget,
+ * and 0254's extra LANE0_PWR_PRESENT write is a leftover from the dual-role
+ * path that can stay out of the per-attach hot path. This runs before every
+ * DCTL.RUN_STOP set, so it must be cheap and quiet.
+ */
+static void
+ud_vbus_override_quiet(void)
+{
+	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
+
+	if (qs == 0) {
+		return;
+	}
+	uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL);
+	*(volatile uint32_t *)(qs + QSCRATCH_HS_PHY_CTRL) = hs | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
