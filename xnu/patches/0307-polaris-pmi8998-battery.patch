+/*
+ * 0294 (yinliang): ONE owner for the three arbiter windows, whichever driver
+ * gets there first.  On this phone SweetBattery::start() runs during IOKit
+ * registration (boot-0298-shared.txt line 33) but sweet_keys_init() only runs
+ * after the UFS root is mounted (line 115).  Borrowing "the keys' windows"
+ * from the battery is therefore backwards: the battery would map its own
+ * three, then keys would map three more, and every ml_io_map() consumes I/O
+ * window for good (Mi 8 EXP-0145 panicked at boot with three drivers).
+ * Both drivers call here instead; the first caller maps exactly once, every
+ * later caller reuses the same three addresses.  A failed attempt is latched
+ * so we never burn a second set of windows on a retry.
+ */
+bool
+sweet_spmi_windows(vm_offset_t *core, vm_offset_t *cnfg, vm_offset_t *observer)
+{
+	if (!sp_map_attempted) {
+		sp_map_attempted = true;
+		sp_core = ml_io_map(SP_CORE_PA, 0x2000);
+		sp_cfg  = ml_io_map(SP_CFG_PA, 0x1000);
+		sp_obs  = ml_io_map(SP_OBS_PA, 0x10000); /* EE 0, 512 * 0x80 */
+	}
+	if (!sp_core || !sp_cfg || !sp_obs) {
+		return false;
+	}
+	*core = sp_core;
+	*cnfg = sp_cfg;
+	*observer = sp_obs;
+	return true;
+}
