+/* 0294: PMI8998 (slave 2) fuel gauge + SMB2, read only, no PMIC writes.
+ * Offsets and scaling are the ones the Mi 8 port verified on this same PMIC
+ * pair (redwood_buttons.c / EXP-0135: 98%, 4.34 V, 35 C, USB bit follows the
+ * cable): BATT_MONOTONIC_SOC 0x09, BATT_TEMP 0x50, VOLTAGE 0xa0, CURRENT
+ * 0xa2, BATTERY_CHARGER_STATUS_1 0x06, USBIN INT_RT_STS 0x10. Absolute
+ * addresses are (peripheral << 8) | offset; sid 2 makes the PPIDs 0x240,
+ * 0x241, 0x210 and 0x213. */
+void
+SweetBattery::pollPMI8998(void)
+{
+	/* All zeroed: the && chain short-circuits on the first failed read, and
+	 * the raw values must never be used uninitialised on that path. */
+	uint8_t soc0 = 0, soc1 = 0, vlo = 0, vhi = 0, clo = 0, chi = 0;
+	uint8_t tlo = 0, thi = 0, st0 = 0, st1 = 0, usb = 0;
+	bool ok =
+	    !sweet_spmi_read(2, 0x4009, &soc0) &&	/* FG batt-soc: MONOTONIC_SOC */
+	    !sweet_spmi_read(2, 0x400a, &soc1) &&	/* its shadow copy */
+	    !sweet_spmi_read(2, 0x41a0, &vlo) &&	/* FG batt-info: VOLTAGE */
+	    !sweet_spmi_read(2, 0x41a1, &vhi) &&
+	    !sweet_spmi_read(2, 0x41a2, &clo) &&	/* CURRENT */
+	    !sweet_spmi_read(2, 0x41a3, &chi) &&
+	    !sweet_spmi_read(2, 0x4150, &tlo) &&	/* BATT_TEMP */
+	    !sweet_spmi_read(2, 0x4151, &thi) &&
+	    !sweet_spmi_read(2, 0x1006, &st0) &&	/* SMB2 charger status 1 */
+	    !sweet_spmi_read(2, 0x1007, &st1) &&
+	    !sweet_spmi_read(2, 0x1310, &usb);	/* USB input RT status */
+	static bool logged = false;
+
+	if (!ok) {
+		fTemp = 2500;
+		fTempMeasured = false;
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	uint8_t low = soc0 < soc1 ? soc0 : soc1;
+	/* The FG's monotonic SOC, NOT a voltage curve: dipper's own conversion. */
+	unsigned percent = low ? ((unsigned)(low - 1) * 98u + 126u) / 253u + 1u : 0u;
+	uint16_t volt = (uint16_t)((unsigned)vlo | ((unsigned)vhi << 8));
+	uint16_t cur = (uint16_t)((unsigned)clo | ((unsigned)chi << 8));
+	uint16_t temp = (uint16_t)((unsigned)tlo | ((unsigned)thi << 8));
+	unsigned mv = (unsigned)(((uint64_t)volt * 122070u) / 1000000u);
+	int ma = (int)(-((int64_t)(int16_t)cur * 488281) / 1000000);
+	int t10 = (int)((((unsigned)temp & 0x7ffu) * 10u + 2u) / 4u) - 2730;
+	bool external = (usb & 0x10u) != 0;
+	unsigned state = st0 & 7u;
+	bool charging = external && state >= 1 && state <= 4 && ma > 0;
+	bool full = external && (state == 5 || percent >= 100);
+	if (!low || mv < 2800 || mv > 4600 || percent > 100) {
+		fTemp = 2500;
+		fTempMeasured = false;
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	if (t10 < -200 || t10 > 800) {
+		t10 = 250;
+		fTempMeasured = false;
+	} else {
+		fTempMeasured = true;
+	}
+	fTemp = (UInt32)(t10 * 10);
+	if (!logged) {
+		logged = true;
+		IOLog("SWEET BATTERY: PMI8998 raw soc=%#x/%#x volt=%#x cur=%#x "
+		    "temp=%#x chg=%#x/%#x usb=%#x -> %u%% %umV %dmA %d.%dC\n",
+		    soc0, soc1, volt, cur, temp, st0, st1, usb, percent, mv, ma,
+		    t10 / 10, (t10 < 0 ? -t10 : t10) % 10);
+	}
+	publish(percent, mv, ma, external, external, charging, full, true, true);
+}
