+/* a6xx_gmu_hfi_start(): open the channel, then the two messages every a6xx boot sends. */
+static bool
+pg_step_hfi(void)
+{
+	uint32_t init[5] = { 0 }, ver[2] = { 0 }, version = 0;
+	bool ok = true;
+
+	if (!pg_boot_configured || pg_gmu == 0 || pg_hfi_va == 0) {
+		printf("POLARIS GPU: 12 no boot configuration or no HFI table: the channel is not opened\n");
+		return false;
+	}
+	if (pg_rd(pg_gmu + PG_GMU_WORD(0x5000)) == 1 && !pg_gmu_release("12")) {
+		printf("POLARIS GPU: 12 the firmware did not come up a second time\n");
+		pg_gmu_hold();
+		pg_gmu_unmask();
+		return false;
+	}
+
+	pg_wr(pg_gmu + PG_GMU_WORD(PG_HFI_CTRL_INIT), 1);
+	ok = pg_poll(pg_gmu + PG_GMU_WORD(PG_HFI_CTRL_STATUS), 1, 1, 100, 100);
+	printf("POLARIS GPU: 12 HFI_CTRL_INIT: HFI_CTRL_STATUS %#010x (%s)\n",
+	    pg_rd(pg_gmu + PG_GMU_WORD(PG_HFI_CTRL_STATUS)), ok ? "the channel is up" : "NOT up");
+	if (!ok) {
+		goto out;
+	}
+	/* the debug region the firmware keeps its own messages in */
+	if (pg_dbg_va == 0 && !pg_gmu_region(&pg_dbg_va, &pg_dbg_pa)) {
+		printf("POLARIS GPU: 12 no region for the debug buffer\n");
+		ok = false;
+		goto out;
+	}
+	init[2] = (uint32_t)pg_dbg_pa;
+	init[3] = PG_GMU_REGION_SIZE;
+	init[4] = 1;				/* GMU_COLD_BOOT */
+	printf("POLARIS GPU: 12 GMU_INIT: segment %#010x size %#x, cold boot\n", init[2], init[3]);
+	ok = pg_hfi_send(PG_HFI_MSG_INIT, init, 5, NULL, 0);
+	if (!ok) {
+		goto out;
+	}
+	ver[1] = (1u << 28) | (1u << 19) | (1u << 17);	/* the version a6xx asks for, 1.10 */
+	ok = pg_hfi_send(PG_HFI_MSG_FW_VERSION, ver, 2, &version, 1);
+	if (ok) {
+		printf("POLARIS GPU: 12 the firmware reports HFI version %#x\n", version);
+	}
+out:
+	if (pg_log_va != 0) {
+		const volatile uint32_t *log = (const volatile uint32_t *)pg_log_va;
+
+		printf("POLARIS GPU: 12 log[0..7] = %#010x %#010x %#010x %#010x %#010x %#010x %#010x %#010x\n",
+		    log[0], log[1], log[2], log[3], log[4], log[5], log[6], log[7]);
+	}
+	pg_gmu_hold();
+	printf("POLARIS GPU: 12 processor %s (SYSRESET %#x)\n",
+	    pg_rd(pg_gmu + PG_GMU_WORD(0x5000)) == 1 ? "HELD in reset again" : "NOT HALTED",
+	    pg_rd(pg_gmu + PG_GMU_WORD(0x5000)));
+	pg_gmu_unmask();
+	return ok;
 }
 
