+/* 0330: dipper mi8_hostsvc.c:44-57, the sdm845 PD domain table the
+ * PDM endpoint answers from.  Services: avs/audio, tms/servreg,
+ * kernel/elf_loader, wlan/fw.  pdm():303-345 semantics: the request's
+ * TLV 0x01 is a SERVICE name, the answer is the list of domains that
+ * serve it (TLV 0x10 total, 0x11 = 1, 0x12 = [count][entries]). */
+#define MD_PD_SVC_AUDIO	0x1u
+#define MD_PD_SVC_SRN	0x2u
+#define MD_PD_SVC_ELF	0x4u
+#define MD_PD_SVC_FW	0x8u
+static const struct md_pd_domain {
+        const char *name;
+        uint32_t instance;
+        uint32_t services;
+} md_pd_domains[] = {
+        { "msm/adsp/audio_pd",   74u, MD_PD_SVC_AUDIO | MD_PD_SVC_SRN },
+        { "msm/adsp/root_pd",    74u, MD_PD_SVC_SRN },
+        { "msm/cdsp/root_pd",    76u, MD_PD_SVC_SRN },
+        { "msm/modem/root_pd",  180u, MD_PD_SVC_SRN },
+        { "msm/modem/wlan_pd",  180u,
+          MD_PD_SVC_SRN | MD_PD_SVC_ELF | MD_PD_SVC_FW },
+        { "msm/slpi/root_pd",    90u, MD_PD_SVC_SRN },
+        { "msm/slpi/sensor_pd",  90u, MD_PD_SVC_SRN }
+};
+#define MD_PD_DOMAINS \
+        (sizeof(md_pd_domains) / sizeof(md_pd_domains[0]))
+
+/* Exact match of a QMI TLV string against a C string. */
+static uint32_t
+md_hs_same(uint32_t at, uint32_t len, const char *s)
+{
+        uint32_t i;
+
+        for (i = 0u; i < len; i++) {
+                if (s[i] == 0 || md_smem_byte(at + i) != (uint8_t)s[i]) {
+                        return 0u;
+                }
+        }
+        return s[len] == 0 ? 1u : 0u;
+}
+
+static uint32_t
+md_pd_service_bit(uint32_t at, uint32_t len)
+{
+        if (md_hs_same(at, len, "avs/audio")) {
+                return MD_PD_SVC_AUDIO;
+        }
+        if (md_hs_same(at, len, "tms/servreg")) {
+                return MD_PD_SVC_SRN;
+        }
+        if (md_hs_same(at, len, "kernel/elf_loader")) {
+                return MD_PD_SVC_ELF;
+        }
+        if (md_hs_same(at, len, "wlan/fw")) {
+                return MD_PD_SVC_FW;
+        }
+        return 0u;
+}
