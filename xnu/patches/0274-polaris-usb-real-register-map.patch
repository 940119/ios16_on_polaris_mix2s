+	    usb_rd(dwc, 0xc14c), usb_rd(dwc, 0xc150), usb_rd(dwc, 0xc154),
+	    usb_rd(dwc, 0xc158), usb_rd(dwc, 0xc15c));
+	printf("SWEET USB: 0274 GGPIO %08x GUID %08x GUCTL %08x GUCTL1 %08x "
+	    "DGCMDPAR %08x DGCMD %08x\n",
+	    usb_rd(dwc, 0xc124), usb_rd(dwc, 0xc128), usb_rd(dwc, 0xc12c),
+	    usb_rd(dwc, 0xc11c), usb_rd(dwc, 0xc710), usb_rd(dwc, 0xc714));
+	printf("SWEET USB: 0274 OTG OCFG %08x OCTL %08x OEVT %08x OEVTEN %08x OSTS %08x\n",
+	    usb_rd(dwc, 0xcc00), usb_rd(dwc, 0xcc04), usb_rd(dwc, 0xcc08),
+	    usb_rd(dwc, 0xcc0c), usb_rd(dwc, 0xcc10));
