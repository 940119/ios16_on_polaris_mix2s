+	/*
+	 * 0274: the register map above is wrong, and it has been driving the
+	 * diagnosis since 0258. Checked against Linux drivers/usb/dwc3/core.h
+	 * (DWC3 3.30a, GSNPSID 0x5533300a):
+	 *
+	 *   GGPIO 0xc124   GUID 0xc128   GUCTL 0xc12c
+	 *   GHWPARAMS0 0xc140 ... GHWPARAMS7 0xc15c
+	 *   DGCMDPAR 0xc710  DGCMD 0xc714   (0xc718 is NOT a register)
+	 *   OCFG 0xcc00  OCTL 0xcc04  OEVT 0xcc08  OEVTEN 0xcc0c  OSTS 0xcc10
+	 *
+	 * So "GHWPARAMS0 0xc124" was reading GGPIO (always 0), the value
+	 * 0x4020400a labelled GHWPARAMS7 was really GHWPARAMS0, and the
+	 * GOTGCTL 0xc000 override was writing a reserved address - its
+	 * [REFUSED] was never a hardware refusal. GSTS has no BSESSVLD /
+	 * BCABLE / BVALID bits either; Linux defines only bits 0..10
+	 * (CURMOD 1:0, BUS_ERR_ADDR_VLD 4, CSR_TIMEOUT 5, DEVICE_IP 6,
+	 * HOST_IP 7, ADP_IP 8, BC_IP 9, OTG_IP 10).
+	 *
+	 * This dump is deliberately raw. It is the first reading of the real
+	 * hardware capabilities this project has ever taken.
+	 */
+	printf("SWEET USB: 0274 REAL HWPARAMS 0:%08x 1:%08x 2:%08x 3:%08x "
+	    "4:%08x 5:%08x 6:%08x 7:%08x\n",
