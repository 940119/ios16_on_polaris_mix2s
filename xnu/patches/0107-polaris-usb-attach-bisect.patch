+/*
+ * The attach bisect. Each entry changes one more thing on a halted core, then
+ * ud_attach_and_wait() raises the pull-up and listens. The winner is whichever
+ * one makes the host reset the bus.
+ */
+#define GCTL_PRTCAP_MASK   0x00003000u
+#define GCTL_PRTCAP_DEVICE 0x00002000u
+
+static void
+ud_cfg_none(void)
+{
+	printf("SWEET USB:   (no change)\n");
+}
+
+static void
+ud_cfg_device(void)
+{
+	uint32_t g = dwc_rd(GCTL);
+	dwc_wr(GCTL, (g & ~GCTL_PRTCAP_MASK) | GCTL_PRTCAP_DEVICE);
+	printf("SWEET USB:   GCTL 0x%08x -> 0x%08x (PrtCapDir device)\n",
+	    g, dwc_rd(GCTL));
+}
+
+static void
+ud_cfg_hs(void)
+{
+	uint32_t d = dwc_rd(DCFG);
+	dwc_wr(DCFG, d & ~0x7u);
+	printf("SWEET USB:   DCFG 0x%08x -> 0x%08x (DevSpd high-speed)\n",
+	    d, dwc_rd(DCFG));
+}
+
+static void
+ud_cfg_wrapper(void)
+{
+	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
+	uint32_t g, h;
+	if (qs == 0) {
+		printf("SWEET USB:   QSCRATCH map failed\n");
+		return;
+	}
+	g = usb_rd(qs, QSCRATCH_GENERAL_CFG);
+	*(volatile uint32_t *)(qs + QSCRATCH_GENERAL_CFG) =
+	    (g & ~PIPE_UTMI_CLK_DIS) | PIPE_UTMI_CLK_SEL | (1u << 3);
+	h = usb_rd(qs, QSCRATCH_HS_PHY_CTRL);
+	*(volatile uint32_t *)(qs + QSCRATCH_HS_PHY_CTRL) = h | (1u << 20) | (1u << 28);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(1000);
+	printf("SWEET USB:   GENERAL_CFG 0x%08x -> 0x%08x HS_PHY_CTRL 0x%08x -> 0x%08x\n",
+	    g, usb_rd(qs, QSCRATCH_GENERAL_CFG), h, usb_rd(qs, QSCRATCH_HS_PHY_CTRL));
+}
+
+static void
+ud_cfg_phy(void)
+{
+	uint32_t g2 = dwc_rd(GUSB2PHYCFG);
+	dwc_wr(GUSB2PHYCFG, g2 | PHYSOFTRST);
+	delay(1000);
+	dwc_wr(GUSB2PHYCFG, (g2 & ~PHYSOFTRST) & ~(1u << 6));
+	delay(1000);
+	printf("SWEET USB:   GUSB2PHYCFG 0x%08x -> 0x%08x (PHY soft reset, SUSPHY off)\n",
+	    g2, dwc_rd(GUSB2PHYCFG));
+	printf("SWEET USB:   QUSB2 PLL 0x%02x POWERDOWN 0x%02x\n",
+	    (unsigned)(usb_rd(ml_io_map(QUSB2_PA, QUSB2_SIZE), QUSB2_PLL_STATUS) & 0xff),
+	    (unsigned)(usb_rd(ml_io_map(QUSB2_PA, QUSB2_SIZE), QUSB2_PORT_POWERDOWN) & 0xff));
+}
+
+static void
+ud_cfg_device_hs(void)
+{
+	ud_cfg_device();
+	ud_cfg_hs();
+}
+
+static void
+ud_cfg_all(void)
+{
+	ud_cfg_device();
+	ud_cfg_hs();
+	ud_cfg_wrapper();
+}
+
+static void
+ud_cfg_everything(void)
+{
+	ud_cfg_device();
+	ud_cfg_hs();
+	ud_cfg_wrapper();
+	ud_cfg_phy();
+}
+
