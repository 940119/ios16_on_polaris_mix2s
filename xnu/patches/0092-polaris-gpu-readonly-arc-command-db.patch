diff --git a/bsd/dev/polaris_gpu_arc_diag.c b/bsd/dev/polaris_gpu_arc_diag.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/polaris_gpu_arc_diag.c
@@ -0,0 +1,159 @@
+/*
+ * Opt-in, read-only Polaris command-db ARC discovery. Not a rail driver.
+ * No RSC/TCS/GPU/GMU/SMMU access and no voltage or bandwidth votes.
+ * The exact reserved RAM range is from this handset's recovery /proc/iomem;
+ * the locator is from MiCode SDM845 DT. Fail closed if they disagree.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define ARC_LOCATOR_PAGE 0x0c3f0000u
+#define ARC_LOCATOR_OFF  0x0cu
+#define ARC_DB_PA       0x85fe0000u
+#define ARC_DB_LIMIT    0x0dc0u
+#define ARC_HEADER      144u
+#define ARC_ENTRY       24u
+#define ARC_MAGIC       0x0c0330dbu
+#define ARC_SLAVE       3u
+
+static const char *const arc_names[] = { "gfx.lvl", "cx.lvl", "mx.lvl" };
+static vm_offset_t arc_db;
+static uint32_t arc_size;
+
+static uint32_t
+arc_word(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static bool
+arc_range(uint32_t off, uint32_t size)
+{
+	return off <= arc_size && size <= arc_size - off;
+}
+
+/* Read DB unaligned bytes only through aligned 32-bit bus operations. */
+static uint8_t
+arc_byte(uint32_t off)
+{
+	return (uint8_t)(arc_word(arc_db, off & ~3u) >> (8u * (off & 3u)));
+}
+
+static uint16_t
+arc_half(uint32_t off)
+{
+	return (uint16_t)arc_byte(off) | ((uint16_t)arc_byte(off + 1u) << 8);
+}
+
+static uint32_t
+arc_value(uint32_t off)
+{
+	return (uint32_t)arc_half(off) | ((uint32_t)arc_half(off + 2u) << 16);
+}
+
+static bool
+arc_id(uint32_t entry, const char *name)
+{
+	unsigned length = (unsigned)strlen(name);
+	if (length > 8) {
+		return false;
+	}
+	for (unsigned i = 0; i < 8; ++i) {
+		uint8_t expected = i < length ? (uint8_t)name[i] : 0;
+		if (arc_byte(entry + i) != expected) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void
+polaris_gpu_arc_diag(void)
+{
+	vm_offset_t locator = ml_io_map(ARC_LOCATOR_PAGE, 0x1000);
+	uint32_t found[3] = {0}, values[3][16] = {{0}}, counts[3] = {0};
+	uint32_t addresses[3] = {0}, versions[3] = {0};
+	if (!locator) {
+		printf("POLARIS GPU ARC: locator unavailable; no GPU access\n");
+		return;
+	}
+	uint32_t pa = arc_word(locator, ARC_LOCATOR_OFF);
+	uint32_t size = arc_word(locator, ARC_LOCATOR_OFF + 4u);
+	if (pa != ARC_DB_PA || size < ARC_HEADER || size > ARC_DB_LIMIT || (size & 3u)) {
+		printf("POLARIS GPU ARC: DB locator mismatch pa=%#x bytes=%u; no mapping\n", pa, size);
+		return;
+	}
+	arc_db = ml_io_map(pa, 0x1000);
+	arc_size = size;
+	if (!arc_db || arc_value(0) != 1u || arc_value(4) != ARC_MAGIC ||
+	    (arc_value(140) & 1u)) {
+		printf("POLARIS GPU ARC: DB header invalid; no GPU access\n");
+		return;
+	}
+	for (unsigned slot = 0; slot < 8; ++slot) {
+		uint32_t h = 8u + slot * 16u;
+		uint32_t slave = arc_half(h), head = ARC_HEADER + arc_half(h + 2u);
+		uint32_t aux = ARC_HEADER + arc_half(h + 4u), n = arc_half(h + 6u);
+		uint32_t version = arc_half(h + 8u);
+		if (!slave) {
+			break;
+		}
+		if ((head & 3u) || !arc_range(head, n * ARC_ENTRY) ||
+		    !arc_range(aux, 0)) {
+			printf("POLARIS GPU ARC: malformed slave header; no GPU access\n");
+			return;
+		}
+		for (unsigned e = 0; e < n; ++e) {
+			uint32_t entry = head + e * ARC_ENTRY;
+			for (unsigned k = 0; k < 3; ++k) {
+				if (!arc_id(entry, arc_names[k])) {
+					continue;
+				}
+				uint32_t address = arc_value(entry + 16u);
+				uint32_t bytes = arc_half(entry + 20u);
+				uint32_t offset = aux + arc_half(entry + 22u);
+				if (found[k] || slave != ARC_SLAVE ||
+				    ((address >> 16) & 7u) != ARC_SLAVE ||
+				    bytes < 4 || bytes > 32 || (bytes & 1u) ||
+				    !arc_range(offset, bytes)) {
+					printf("POLARIS GPU ARC: invalid %s; no GPU access\n", arc_names[k]);
+					return;
+				}
+				found[k] = 1;
+				addresses[k] = address;
+				versions[k] = version;
+				for (unsigned i = 0; i < bytes / 2u; ++i) {
+					uint32_t level = arc_half(offset + i * 2u);
+					if (!level || (counts[k] && level <= values[k][counts[k] - 1u])) {
+						break;
+					}
+					values[k][counts[k]++] = level;
+				}
+				if (!counts[k]) {
+					printf("POLARIS GPU ARC: empty %s; no GPU access\n", arc_names[k]);
+					return;
+				}
+			}
+		}
+	}
+	if (!found[0] || !found[1] || !found[2]) {
+		printf("POLARIS GPU ARC: missing gfx/cx/mx entry; no GPU access\n");
+		return;
+	}
+	for (unsigned k = 0; k < 3; ++k) {
+		printf("POLARIS GPU ARC: %s addr=%#x ver=%#x levels=%u (indices only)",
+		    arc_names[k], addresses[k], versions[k], counts[k]);
+		for (unsigned i = 0; i < counts[k]; ++i) {
+			printf(" %u", values[k][i]);
+		}
+		printf("\n");
+	}
+	printf("POLARIS GPU ARC: no RPMh vote or GPU/MMIO access performed\n");
+}
+#endif
