+/*
+ * 0285: the two steps dwc3-msm.c takes that this file never has.
+ *
+ * Reading the downstream wrapper driver (MiCode/Xiaomi_Kernel_OpenSource,
+ * polaris-o-oss, drivers/usb/dwc3/dwc3-msm.c) against this file turns up
+ * exactly two initialisation steps that are missing here. Everything else -
+ * the HS PIPE clock dance on QSCRATCH_GENERAL_CFG, the VBUS override, the
+ * GDSC, the GCC CBCRs including the AXI aggregator clock at 0x8201c - is
+ * already done.
+ *
+ *   1. dwc3_msm_qscratch_reg_init():
+ *
+ *        #define CGCTL_REG (QSCRATCH_REG_OFFSET + 0x28)
+ *        /*
+ *         * Enable master clock for RAMs to allow BAM to access RAMs when
+ *         * RAM clock gating is enabled via DWC3's GCTL. Otherwise issues
+ *         * are seen where RAM clocks get turned OFF in SS mode
+ *         *\/
+ *        dwc3_msm_write_reg(mdwc->base, CGCTL_REG,
+ *                           dwc3_msm_read_reg(mdwc->base, CGCTL_REG) | 0x18);
+ *
+ *     0xa600000 + 0xf8800 + 0x28 = 0xa6f8828. This file has never written it
+ *     and has never read it either, so the first half of this build is the
+ *     reading.
+ *
+ *   2. dwc3_msm_update_ref_clk(): GUCTL.REFCLKPER is set from the UTMI
+ *     reference clock - 52 for 19.2 MHz, 41 for 24 MHz - together with the
+ *     matching GFLADJ. The downstream driver hardcodes
+ *
+ *        mdwc->utmi_clk_rate = 19200000;
+ *
+ *     so 52 is the value for this board. A zero REFCLKPER means the core is
+ *     timing its PHY interface off a default that does not match the clock on
+ *     the board.
+ *
+ *     Field positions are taken from the same tree's core.h, not guessed:
+ *
+ *        #define DWC3_GUCTL                 0xc12c
+ *        #define DWC3_GUCTL_REFCLKPER       (0x3FF << 22)
+ *        #define DWC3_GFLADJ                0xc630
+ *        #define DWC3_GFLADJ_REFCLK_240MHZDECR_PLS1 (1 << 31)
+ *        #define DWC3_GFLADJ_REFCLK_240MHZ_DECR     (0x7F << 24)
+ *        #define DWC3_GFLADJ_REFCLK_LPM_SEL         (1 << 23)
+ *        #define DWC3_GFLADJ_REFCLK_FLADJ           (0x3FFF << 8)
+ *
+ * Neither of these explains a bus error at an address the core got right, and
+ * that is exactly why they are worth ruling out: after this build there is no
+ * remaining difference between what Linux programs into this wrapper and what
+ * this kernel does.
+ *
+ * sweetusbmsminit=0 skips both writes and only dumps.
+ */
+#define QSCRATCH_CGCTL		0x28
+#define DWC3_GUCTL_REG		0xc12c
+#define DWC3_GUCTL_REFCLKPER	(0x3ffu << 22)
+#define DWC3_GFLADJ_REG		0xc630
+
+static void
+ud_msm_qscratch_init(void)
+{
+	int fix = 1;
+	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
+
+	PE_parse_boot_argn("sweetusbmsminit", &fix, sizeof(fix));
+	if (qs == 0) {
+		printf("SWEET USB: 0285 QSCRATCH map failed\n");
+		ud_flush();
+		return;
+	}
+	uint32_t cgctl = usb_rd(qs, QSCRATCH_CGCTL);
+	uint32_t guctl = dwc_rd(DWC3_GUCTL_REG);
+
+	printf("SWEET USB: 0285 QSCRATCH GENERAL_CFG 0x%08x CGCTL 0x%08x | "
+	    "GUCTL 0x%08x GFLADJ 0x%08x\n",
+	    usb_rd(qs, QSCRATCH_GENERAL_CFG), cgctl, guctl,
+	    dwc_rd(DWC3_GFLADJ_REG));
+	ud_flush();
+
+	if (!fix) {
+		printf("SWEET USB: 0285 sweetusbmsminit=0, nothing written\n");
+		ud_flush();
+		return;
+	}
+
+	if ((cgctl & 0x18u) != 0x18u) {
+		usb_wr(qs, QSCRATCH_CGCTL, cgctl | 0x18u);
+		printf("SWEET USB: 0285 CGCTL 0x%08x -> 0x%08x (RAM clock masters)\n",
+		    cgctl, usb_rd(qs, QSCRATCH_CGCTL));
+		ud_flush();
+	}
+
+	if ((guctl & DWC3_GUCTL_REFCLKPER) == 0) {
+		uint32_t gfladj = dwc_rd(DWC3_GFLADJ_REG);
+
+		/* dwc3_msm_update_ref_clk(), utmi_clk_rate == 19200000 */
+		gfladj &= ~((0x7fu << 24) | (1u << 31) | (1u << 23) |
+		    (0x3fffu << 8));
+		gfladj |= (12u << 24) | (1u << 31) | (1u << 23) | (200u << 8);
+		dwc_wr(DWC3_GFLADJ_REG, gfladj);
+		dwc_wr(DWC3_GUCTL_REG, guctl | (52u << 22));
+		printf("SWEET USB: 0285 REFCLKPER was 0; 19.2 MHz -> GUCTL 0x%08x "
+		    "GFLADJ 0x%08x\n", dwc_rd(DWC3_GUCTL_REG),
+		    dwc_rd(DWC3_GFLADJ_REG));
+	} else {
+		printf("SWEET USB: 0285 REFCLKPER already %u, left alone\n",
+		    (unsigned)((guctl >> 22) & 0x3ffu));
+	}
+	ud_flush();
+}
