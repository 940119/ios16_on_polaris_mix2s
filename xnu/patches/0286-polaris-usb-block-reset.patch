 /*
+ * 0286: the whole-block reset dwc3-msm performs and this file never has.
+ *
+ * 0285 closed every register write Linux makes into the wrapper. One action was
+ * left out of that comparison because it is not a register write at all:
+ *
+ *   dwc3_msm_link_clk_reset(mdwc, true)   ->  reset_control_assert(core_reset)
+ *   dwc3_msm_link_clk_reset(mdwc, false)  ->  reset_control_deassert(core_reset)
+ *
+ * and dwc3-msm runs it around every suspend/resume and every restart. The reset
+ * is the USB30_PRIM block reset in GCC, and the offset is not a guess - it is in
+ * the same tree's drivers/clk/qcom/gcc-sdm845.c reset map:
+ *
+ *   [GCC_USB30_PRIM_BCR]    = { 0xf000 },
+ *   [GCC_QUSB2PHY_PRIM_BCR] = { 0x12000 },
+ *   [GCC_USB3_PHY_PRIM_BCR] = { 0x50000 },
+ *
+ * and the node agrees: resets = <0x22 0x0f>, reset-names = "core_reset".
+ *
+ * Why this is worth the boot: the previous owner of this controller is the
+ * UEFI/EDK2 ABL, whose FastbootLib drives the same DWC3 for fastboot. If it
+ * handed the block over with the AXI side in a latched state - an error
+ * response already recorded, a bridge held mid-transaction - then no amount of
+ * register programming from the new kernel clears it, because the state is not
+ * in a register that the driver owns. A block reset is.
+ *
+ * The BCR is read first: bit 0 set would mean the block is still being held in
+ * reset, which on its own would explain a master that cannot complete anything
+ * while config reads still work.
+ *
+ * Order matters. This runs before the first core access of the boot in this
+ * thread, so the attach path below reprograms DWC3, QSCRATCH (including the HS
+ * PIPE clock dance) and CGCTL from a clean slate.
+ *
+ * sweetusbreset=0 skips the toggle and only reports the BCR.
+ */
+#define GCC_USB30_PRIM_BCR	0x0f000
+
+static void
+ud_usb_block_reset(void)
+{
+	int do_reset = 1;
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+
+	PE_parse_boot_argn("sweetusbreset", &do_reset, sizeof(do_reset));
+	if (gcc == 0) {
+		printf("SWEET USB: 0286 GCC map failed\n");
+		ud_flush();
+		return;
+	}
+	uint32_t bcr = usb_rd(gcc, GCC_USB30_PRIM_BCR);
+
+	printf("SWEET USB: 0286 GCC_USB30_PRIM_BCR 0x%08x%s\n", bcr,
+	    (bcr & 1u) ? " (held in reset!)" : "");
+	ud_flush();
+
+	if (!do_reset) {
+		printf("SWEET USB: 0286 sweetusbreset=0, no toggle\n");
+		ud_flush();
+		return;
+	}
+	usb_wr(gcc, GCC_USB30_PRIM_BCR, bcr | 1u);
+	delay(2000);
+	usb_wr(gcc, GCC_USB30_PRIM_BCR, bcr & ~1u);
+	delay(2000);
+	printf("SWEET USB: 0286 block reset toggled, BCR now 0x%08x\n",
+	    usb_rd(gcc, GCC_USB30_PRIM_BCR));
+	ud_flush();
+}
+
