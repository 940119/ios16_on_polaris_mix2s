 extern void sweet_log_flush_now(void);
 
 /*
+ * 0273: one switch in front of every console flush this file issues.
+ *
+ * sweet_log_flush_now() is a synchronous, interrupt-masked, doorbell-polled
+ * UFS write. The attach bisect fires it at every step of four strategies,
+ * and the control experiment says sweetusb=1 (no gadget threads) reaches
+ * tick 13440 while sweetusb=2 (those threads) is dead by tick 2940. A
+ * plausible mechanism is that a polled write from the attach thread
+ * collides with the once-a-second log thread and wedges the UFS path,
+ * after which the PMIC watchdog resets the SoC. sweetusbflush=0 takes the
+ * USB threads out of that path entirely; the once-a-second log thread in
+ * the UFS driver still writes the console ring, so nothing is lost.
+ */
+static int ud_flush_ok = 1;
+
+static void
+ud_flush(void)
+{
+	if (ud_flush_ok) {
+		sweet_log_flush_now();
+	}
+}
