+/* 0338: the half of the servreg conversation that never existed.
+ *
+ * dipper srn_receive():2500-2545 is the authority.  A REGISTER_LISTENER
+ * response only tells us the state at registration time; the state that
+ * matters arrives later as a QMI INDICATION (type 4) with message
+ * SRN_STATE_UPDATED_IND 0x22, and the client must answer it with
+ * SRN_SET_ACK 0x23 or the PDR transition never completes.  EXP-0204:
+ * "ACKs its state changes, and only then does icnss reach WLFW";
+ * EXP-0203 saw msa_info answer INCOMPATIBLE_STATE without it.
+ *
+ * TLV layout, byte for byte from dipper srn_string()/srn_tlv():
+ *   0x01 = the PD name, raw bytes, no NUL, no inner length
+ *   0x02 = the transaction id from the indication, 2 bytes LE
+ * A 17-byte name plus both TLVs is 7 + 20 + 5 = 32 QMI bytes, which is
+ * exactly what md_qrtr_send_qmi() can carry in one 64 B packet. */
+static uint32_t
+md_srn_ack(uint32_t head, uint32_t node, uint32_t port,
+    const char *name, uint32_t nlen, uint32_t txn, uint32_t have_txn)
+{
+	uint8_t qmi[40];
+	uint32_t i, n, tlvs, before = head, after;
+
+	if (nlen == 0u || nlen > 22u) {
+		MD_SAY("POLARIS MODEM: 0338 VERDICT: SET_ACK skipped, PD "
+		    "name is %u bytes and does not fit one GLINK DATA "
+		    "frame\n", nlen);
+		return head;
+	}
+	tlvs = 3u + nlen + (have_txn != 0u ? 5u : 0u);
+	for (i = 0u; i < sizeof(qmi); i++) {
+		qmi[i] = 0;
+	}
+	md_srn_txn++;
+	qmi[0] = 0u;				/* request */
+	qmi[1] = (uint8_t)md_srn_txn;
+	qmi[2] = (uint8_t)(md_srn_txn >> 8);
+	qmi[3] = (uint8_t)(MD_SRN_SET_ACK & 0xffu);
+	qmi[4] = (uint8_t)(MD_SRN_SET_ACK >> 8);
+	qmi[5] = (uint8_t)(tlvs & 0xffu);
+	qmi[6] = (uint8_t)(tlvs >> 8);
+	qmi[7] = 0x01u;
+	qmi[8] = (uint8_t)nlen;
+	qmi[9] = 0u;
+	for (i = 0u; i < nlen; i++) {
+		qmi[10u + i] = (uint8_t)name[i];
+	}
+	n = 10u + nlen;
+	if (have_txn != 0u) {
+		qmi[n] = 0x02u;
+		qmi[n + 1u] = 2u;
+		qmi[n + 2u] = 0u;
+		qmi[n + 3u] = (uint8_t)(txn & 0xffu);
+		qmi[n + 4u] = (uint8_t)(txn >> 8);
+		n += 5u;
+	}
+	after = md_qrtr_send_qmi(head, node, port, qmi, n);
+	MD_SAY("POLARIS MODEM: 0338 VERDICT: SERVREG SET_ACK 0x23 for "
+	    "'%s' txn %u%s to node %u port %#x, %u QMI bytes, sent=%s, "
+	    "tx head %u -> %u\n", name, txn,
+	    have_txn != 0u ? "" : " (no txn TLV)", node, port, n,
+	    after != before ? "YES" : "NO", before, after);
+	return after;
+}
+
+/* 0338: every QMI indication the modem sends.  Before this version the
+ * receive path called md_qmi_dump() (which only prints) and then handed
+ * the packet to md_hostsvc_reply(); a type 4 packet is neither a request
+ * nor a response, so md_hostsvc_reply() dropped it and the one message
+ * the PDR state machine waits on was lost. */
+static uint32_t
+md_srn_indication(uint32_t head, uint32_t at, uint32_t len,
+    uint32_t node, uint32_t port)
+{
+	uint32_t p, t, l, i, nlen = 0u, state = 0u, txn = 0u, have_txn = 0u;
+	uint16_t msg, total;
+	char name[24];
+
+	if (len < 7u || md_smem_byte(at) != 4u) {
+		return head;
+	}
+	msg = (uint16_t)(md_smem_byte(at + 3u) |
+	    ((uint16_t)md_smem_byte(at + 4u) << 8));
+	total = (uint16_t)(md_smem_byte(at + 5u) |
+	    ((uint16_t)md_smem_byte(at + 6u) << 8));
+	if (7u + total > len) {
+		total = (uint16_t)(len - 7u);
+	}
+	p = 7u;
+	while (p + 3u <= 7u + total) {
+		t = md_smem_byte(at + p);
+		l = (uint32_t)md_smem_byte(at + p + 1u) |
+		    ((uint32_t)md_smem_byte(at + p + 2u) << 8);
+		if (p + 3u + l > 7u + total) {
+			break;
+		}
+		if (t == 0x01u && l >= 4u) {
+			state = (uint32_t)md_smem_byte(at + p + 3u) |
+			    ((uint32_t)md_smem_byte(at + p + 4u) << 8) |
+			    ((uint32_t)md_smem_byte(at + p + 5u) << 16) |
+			    ((uint32_t)md_smem_byte(at + p + 6u) << 24);
+		} else if (t == 0x02u && l >= 1u) {
+			/* leave room for the terminator: a name that
+			 * fills the buffer must not run %s off the end */
+			nlen = l < sizeof(name) - 1u ?
+			    l : (uint32_t)(sizeof(name) - 1u);
+			for (i = 0u; i < nlen; i++) {
+				name[i] = (char)md_smem_byte(at + p + 3u + i);
+			}
+		} else if (t == 0x03u && l >= 2u) {
+			txn = (uint32_t)md_smem_byte(at + p + 3u) |
+			    ((uint32_t)md_smem_byte(at + p + 4u) << 8);
+			have_txn = 1u;
+		}
+		p += 3u + l;
+	}
+	name[nlen] = 0;
+	/* printable, because the ring cuts a line at 255 bytes and a
+	 * binary name would cost a dozen bytes per character */
+	for (i = 0u; i < nlen; i++) {
+		if ((unsigned char)name[i] < 0x20u ||
+		    (unsigned char)name[i] > 0x7eu) {
+			name[i] = '.';
+		}
+	}
+	MD_SAY("POLARIS MODEM: 0338 VERDICT: QMI INDICATION msg %#x "
+	    "from node %u port %#x: '%s' state %#x = %s, txn %u%s\n",
+	    msg, node, port, name, state, md_srn_state_name(state), txn,
+	    have_txn != 0u ? "" : " (no txn TLV)");
+	if (msg != MD_SRN_STATE_UPDATED_IND) {
+		MD_SAY("POLARIS MODEM: 0338 VERDICT: indication %#x is not "
+		    "STATE_UPDATED_IND 0x22, no SET_ACK\n", msg);
+		return head;
+	}
+	if (nlen == 0u) {
+		/* dipper always acks with the name it was told; an
+		 * indication that omits it is about the PD we watch. */
+		for (i = 0u; i < sizeof(name) - 1u &&
+		    md_srn_names[0][i] != 0; i++) {
+			name[i] = md_srn_names[0][i];
+		}
+		nlen = i;
+		name[nlen] = 0;
+	}
+	return md_srn_ack(head, node, port, name, nlen, txn, have_txn);
+}
