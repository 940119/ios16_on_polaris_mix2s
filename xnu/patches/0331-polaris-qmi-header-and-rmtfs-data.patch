+static const char *
+md_hs_label(uint32_t what)
+{
+        switch (what) {
+        case 1u:
+                return "PDM 0x21";
+        case 2u:
+                return "RMTFS R_OPEN";
+        case 3u:
+                return "PDM PFR";
+        case 4u:
+                return "RMTFS R_RW";
+        case 5u:
+                return "RMTFS R_ALLOC";
+        case 6u:
+                return "RMTFS R_CLOSE";
+        case 7u:
+                return "RMTFS R_DEVERR";
+        case 8u:
+                return "RMTFS R_SYNC";
+        default:
+                return "refused";
+        }
+}
