+/* 0331: the four header bytes a QMI response has to carry.  dipper
+ * receive():360-390 does exactly this: response[0] = 2 and a
+ * byte-for-byte copy of the request's txn and message id.  Without it
+ * the client has nothing to match the answer against and the whole
+ * reply is dropped on the floor. */
+static void
+md_qmi_header(uint8_t *rsp, uint32_t req_at)
+{
+        uint32_t i;
+
+        rsp[0] = 2u;                            /* response */
+        for (i = 1u; i < 5u; i++) {
+                rsp[i] = md_smem_byte(req_at + i);
+        }
+}
+
+/* One little-endian 32-bit word out of the WCOMB SMEM map. */
+static uint32_t
+md_le32(uint32_t at)
+{
+        return (uint32_t)md_smem_byte(at) |
+            ((uint32_t)md_smem_byte(at + 1u) << 8) |
+            ((uint32_t)md_smem_byte(at + 2u) << 16) |
+            ((uint32_t)md_smem_byte(at + 3u) << 24);
+}
+
+/* An eight-byte TLV value, for R_ALLOC's physical address. */
+static uint32_t
+md_hs_number64(uint8_t *rsp, uint32_t at, uint8_t tag, uint64_t value)
+{
+        uint32_t i;
+
+        rsp[at] = tag;
+        rsp[at + 1u] = 8u;
+        rsp[at + 2u] = 0u;
+        for (i = 0u; i < 8u; i++) {
+                rsp[at + 3u + i] = (uint8_t)(value >> (8u * i));
+        }
+        return at + 11u;
+}
