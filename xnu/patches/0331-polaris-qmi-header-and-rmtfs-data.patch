+/* 0331: allocate the buffer the modem DMAs into.  kmem_alloc_contig is
+ * what 0095 uses for the USB gadget, and ml_vtophys turns the kernel VA
+ * into the physical address the modem has to be told.  It is mapped a
+ * second time through ml_io_map so that every access from here is
+ * uncached: the modem writes this memory behind our back and a cached
+ * read would return stale lines. */
+static bool
+md_rmtfs_alloc(uint32_t want)
+{
+        vm_offset_t va = 0;
+        uint64_t pa;
+
+        if (md_rmtfs_shared_va != 0u) {
+                return md_rmtfs_shared_size >= want;
+        }
+        if (want == 0u || want > MD_RMTFS_MAX) {
+                return FALSE;
+        }
+        want = (want + 0xfffu) & ~0xfffu;
+        if (kmem_alloc_contig(kernel_map, &va, want, PAGE_MASK, 0, 0,
+            KMA_DATA | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT)
+            != KERN_SUCCESS) {
+                return FALSE;
+        }
+        pa = (uint64_t)ml_vtophys(va);
+        if (pa == 0u || pa >= 0x100000000ull) {
+                return FALSE;           /* R_RW vectors carry 32 bits */
+        }
+        md_rmtfs_dev = ml_io_map((vm_offset_t)pa, want);
+        if (md_rmtfs_dev == 0u) {
+                return FALSE;
+        }
+        md_rmtfs_shared_va = va;
+        md_rmtfs_shared_pa = pa;
+        md_rmtfs_shared_size = want;
+        {
+                volatile uint8_t *p =
+                    (volatile uint8_t *)(uintptr_t)md_rmtfs_dev;
+                uint32_t i;
+
+                for (i = 0u; i < want; i++) {
+                        p[i] = 0u;
+                }
+        }
+        __sync_synchronize();
+        return TRUE;
+}
+
+static bool
+md_rmtfs_file(void)
+{
+        vm_offset_t va = 0;
+
+        if (md_rmtfs_file_va != 0u) {
+                return TRUE;
+        }
+        if (kmem_alloc_contig(kernel_map, &va, MD_RMTFS_FILE, PAGE_MASK,
+            0, 0, KMA_DATA | KMA_PERMANENT,
+            VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+                return FALSE;
+        }
+        md_rmtfs_file_va = va;
+        return TRUE;
+}
+
+/* Move bytes between the shadow and the modem's buffer.  Byte-wise and
+ * volatile on the device side, because it is an uncached mapping. */
+static void
+md_rmtfs_io(uint64_t shared, uint8_t *mem, uint32_t bytes, uint32_t to_shared)
+{
+        volatile uint8_t *p = (volatile uint8_t *)(uintptr_t)(md_rmtfs_dev +
+            (uint32_t)(shared - md_rmtfs_shared_pa));
+        uint32_t i;
+
+        __sync_synchronize();
+        for (i = 0u; i < bytes; i++) {
+                if (to_shared) {
+                        p[i] = mem[i];
+                } else {
+                        mem[i] = p[i];
+                }
+        }
+        __sync_synchronize();
+}
+
+/* 0331: R_RW.  TLV 0x01 handle(4), 0x02 direction(1), 0x03 =
+ * [count][sector(4) phys(4) sectors(4)]..., dipper rmtfs():262-285.
+ * direction 1 means "put the file's bytes in my buffer", 0 means "take
+ * what I wrote there", so the file is a RAM shadow and flash is never
+ * touched. */
+static uint32_t
+md_rmtfs_rw(uint32_t req_at, uint32_t req_len)
+{
+        uint32_t h_at, d_at, v_at, l1 = 0u, l2 = 0u, l3 = 0u;
+        uint32_t k, dir, n, bytes, sector, nsec, total = 0u;
+        uint64_t shared;
+
+        h_at = md_qmi_find(req_at, req_len, 1u, &l1);
+        d_at = md_qmi_find(req_at, req_len, 2u, &l2);
+        v_at = md_qmi_find(req_at, req_len, 3u, &l3);
+        if (h_at == 0u || l1 < 4u || d_at == 0u || l2 < 1u ||
+            v_at == 0u || l3 < 1u) {
+                return 1u;                      /* Q_MALFORMED */
+        }
+        dir = (uint32_t)md_smem_byte(d_at);
+        n = (uint32_t)md_smem_byte(v_at);
+        if (dir > 1u || n == 0u || l3 < 1u + 12u * n) {
+                return 48u;                     /* Q_INVAL */
+        }
+        if (md_rmtfs_dev == 0u || md_rmtfs_file_va == 0u) {
+                return 2u;                      /* Q_NOMEM */
+        }
+        for (k = 0u; k < n; k++) {
+                uint32_t q = v_at + 1u + 12u * k;
+
+                sector = md_le32(q);
+                shared = (uint64_t)md_le32(q + 4u);
+                nsec = md_le32(q + 8u);
+                bytes = nsec * 512u;
+                if (shared >= (uint64_t)md_rmtfs_shared_pa &&
+                    bytes != 0u &&
+                    shared - md_rmtfs_shared_pa < md_rmtfs_shared_size &&
+                    bytes <= md_rmtfs_shared_size -
+                        (uint32_t)(shared - md_rmtfs_shared_pa) &&
+                    ((uint64_t)sector + (uint64_t)nsec) * 512u <=
+                        MD_RMTFS_FILE) {
+                        md_rmtfs_io(shared,
+                            (uint8_t *)(uintptr_t)(md_rmtfs_file_va +
+                            sector * 512u), bytes, dir != 0u);
+                        md_rmtfs_last_sector = sector;
+                        md_rmtfs_last_bytes = bytes;
+                        total += nsec;
+                        if (dir != 0u) {
+                                md_rmtfs_reads++;
+                        } else {
+                                md_rmtfs_writes++;
+                        }
+                        continue;
+                }
+                md_rmtfs_denied++;
+                MD_SAY("POLARIS MODEM: 0331 VERDICT: RMTFS RW REFUSED "
+                    "dir %u vector %u/%u sector %u pa %#llx %u sectors, "
+                    "base %#llx size %#x\n", dir, k, n, sector, shared,
+                    nsec, md_rmtfs_shared_pa, md_rmtfs_shared_size);
+                return 48u;
+        }
+        MD_SAY("POLARIS MODEM: 0331 VERDICT: RMTFS RW dir %u, %u vectors, "
+            "%u sectors, last sector %u, %u bytes, handle %u\n",
+            dir, n, total, md_rmtfs_last_sector, md_rmtfs_last_bytes,
+            md_le32(h_at));
+        return 0u;
+}
