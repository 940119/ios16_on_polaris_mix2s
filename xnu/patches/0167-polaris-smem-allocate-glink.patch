+static int
+polaris_wifi_level(void)
 {
 	int optin = 0;
 
 	if (!PE_parse_boot_argn("polariswifi", &optin, sizeof(optin))) {
-		return false;
+		return 0;
 	}
-	return optin == 1;
+	return optin;
 }
 
