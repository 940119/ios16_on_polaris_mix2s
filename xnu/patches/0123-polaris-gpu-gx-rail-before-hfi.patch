+/* ---- the GX domain: the firmware itself raises the rail, the host only asks --------------------------- */
+
+#define PG_BOOT_SLUMBER_OPTION	0x23f8u		/* 0 = ask for the rail, 1 = back to slumber */
+#define PG_GX_VOTE_IDX		0x23f9u
+#define PG_MX_VOTE_IDX		0x23fau
+#define PG_RPMH_POWER_STATE	0x50ecu
+#define PG_SPTPRAC_CTRL		0x81u		/* GMU_GX_SPTPRAC_POWER_CONTROL */
+#define PG_SPTPRAC_STATUS	0x50d0u
+#define PG_OOB_BOOT_SLUMBER_SET	22u		/* legacy out-of-band bits */
+#define PG_OOB_BOOT_SLUMBER_ACK	30u
+
+/*
+ * a6xx_gmu_gfx_rail_on(): the legacy firmware powers the GX domain itself. The
+ * host names the level in gfx.lvl and mx.lvl, sets BOOT_SLUMBER_OPTION to 0 and
+ * rings the doorbell at bit 22; the firmware answers at bit 30 once the rail is
+ * up. a6xx_gmu_resume() does exactly this *before* the HFI is started when the
+ * firmware is a legacy one - which this one is (0xbabeface).
+ *
+ * The vote indices come from the RPMh command database in the device tree on
+ * Linux; index 0 of both tables is the lowest level, which is what a first
+ * bring-up wants, and the numbers only move when a frequency is asked for.
+ */
+static bool
+pg_step_gx_rail_on(bool hold)
+{
+	uint32_t before, after, status;
+	bool ack;
+
+	if (pg_gmu == 0 || pg_gpucc == 0) {
+		printf("POLARIS GPU: 12 no GMU or no GPUCC: the rail is not requested\n");
+		return false;
+	}
+	if (pg_rd(pg_gmu + PG_GMU_WORD(0x5000)) != 0) {
+		printf("POLARIS GPU: 12 the processor is not running; the rail is not requested\n");
+		return false;
+	}
+	before = pg_rd(pg_gpucc + PG_GPUCC_GX_GDSCR);
+	printf("POLARIS GPU: 12 before the request: GX GDSCR %#010x, RPMH_POWER_STATE %#x, SPTPRAC %#x, "
+	    "GMU2HOST %#010x\n", before, pg_rd(pg_gmu + PG_GMU_WORD(PG_RPMH_POWER_STATE)),
+	    pg_rd(pg_gmu + PG_GMU_WORD(PG_SPTPRAC_STATUS)), pg_rd(pg_gmu + PG_GMU_WORD(PG_G2H_INTR_INFO)));
+
+	pg_wr(pg_gmu + PG_GMU_WORD(PG_BOOT_SLUMBER_OPTION), 0);
+	pg_wr(pg_gmu + PG_GMU_WORD(PG_GX_VOTE_IDX), 0);
+	pg_wr(pg_gmu + PG_GMU_WORD(PG_MX_VOTE_IDX), 0);
+	printf("POLARIS GPU: 12 BOOT_SLUMBER_OPTION %#x GX_VOTE_IDX %#x MX_VOTE_IDX %#x, ringing bit %u\n",
+	    pg_rd(pg_gmu + PG_GMU_WORD(PG_BOOT_SLUMBER_OPTION)), pg_rd(pg_gmu + PG_GMU_WORD(PG_GX_VOTE_IDX)),
+	    pg_rd(pg_gmu + PG_GMU_WORD(PG_MX_VOTE_IDX)), PG_OOB_BOOT_SLUMBER_SET);
+	pg_wr(pg_gmu + PG_GMU_WORD(PG_H2G_INTR_SET), 1u << PG_OOB_BOOT_SLUMBER_SET);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ack = pg_poll(pg_gmu + PG_GMU_WORD(PG_G2H_INTR_INFO), 1u << PG_OOB_BOOT_SLUMBER_ACK,
+	    1u << PG_OOB_BOOT_SLUMBER_ACK, 1000, 100);
+	printf("POLARIS GPU: 12 GMU2HOST_INTR_INFO %#010x: ack bit %u %s\n",
+	    pg_rd(pg_gmu + PG_GMU_WORD(PG_G2H_INTR_INFO)), PG_OOB_BOOT_SLUMBER_ACK,
+	    ack ? "set, the rail is up" : "NOT set within 100 ms");
+	pg_wr(pg_gmu + PG_GMU_WORD(PG_G2H_INTR_CLR), 1u << PG_OOB_BOOT_SLUMBER_ACK);
+
+	after = pg_rd(pg_gpucc + PG_GPUCC_GX_GDSCR);
+	printf("POLARIS GPU: 12 after the request: GX GDSCR %#010x (%s), RPMH_POWER_STATE %#x, SPTPRAC %#x\n",
+	    after, (after & PG_GDSC_PWR_ON) ? "the power switch says on" : "the power switch still says off",
+	    pg_rd(pg_gmu + PG_GMU_WORD(PG_RPMH_POWER_STATE)), pg_rd(pg_gmu + PG_GMU_WORD(PG_SPTPRAC_STATUS)));
+
+	if (ack) {
+		/* a6xx_sptprac_enable: the host owns the SPTP power collapse at idle level ACTIVE */
+		pg_wr(pg_gmu + PG_GMU_WORD(PG_SPTPRAC_CTRL), 0x778000u);
+		status = pg_rd(pg_gmu + PG_GMU_WORD(PG_SPTPRAC_STATUS));
+		printf("POLARIS GPU: 12 SPTPRAC enable: status %#x (%s)\n", status,
+		    (status & 0x38) == 0x28 ? "on" : "NOT on");
+	}
+	if (hold) {
+		pg_gmu_hold();
+		printf("POLARIS GPU: 12 processor HELD in reset again (SYSRESET %#x)\n",
+		    pg_rd(pg_gmu + PG_GMU_WORD(0x5000)));
+	} else {
+		printf("POLARIS GPU: 12 the processor is left running for the next step\n");
+	}
+	return ack;
 }
 
