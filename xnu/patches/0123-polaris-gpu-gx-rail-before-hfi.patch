+static bool
+pg_poll(vm_offset_t reg, uint32_t mask, uint32_t want, uint32_t tries, uint32_t step_us)
+{
+	for (uint32_t i = 0; i < tries; i++) {
+		if ((pg_rd(reg) & mask) == want) {
+			return true;
+		}
+		pg_sleep_us(step_us);
+	}
+	return (pg_rd(reg) & mask) == want;
+}
