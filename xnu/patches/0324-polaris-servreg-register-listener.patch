+/* dipper srn_send() / srn_tlv() / srn_string() / srn_listen():
+ * QMI 0x20 REGISTER_LISTENER, TLV 0x01 = {1}, TLV 0x02 = the raw
+ * 17-byte "msm/modem/wlan_pd" string (no NUL and no inner length --
+ * with one the modem answered INVALID_HANDLE, EXP-0203g). */
+static uint32_t
+md_srn_listen(uint32_t head, uint32_t node, uint32_t port)
+{
+	static const char name[] = "msm/modem/wlan_pd";
+	uint8_t qmi[32];
+	uint32_t i, before = head, after;
+
+	for (i = 0u; i < sizeof(qmi); i++) {
+		qmi[i] = 0;
+	}
+	md_srn_txn++;
+	qmi[0] = 0u;				/* request */
+	qmi[1] = (uint8_t)md_srn_txn;
+	qmi[2] = (uint8_t)(md_srn_txn >> 8);
+	qmi[3] = (uint8_t)MD_SRN_REGISTER_LISTENER;
+	qmi[4] = 0u;
+	qmi[5] = 24u;				/* TLV byte count */
+	qmi[6] = 0u;
+	qmi[7] = 0x01u; qmi[8] = 1u; qmi[9] = 0u; qmi[10] = 1u;
+	qmi[11] = 0x02u; qmi[12] = 17u; qmi[13] = 0u;
+	for (i = 0u; i < 17u; i++) {
+		qmi[14u + i] = (uint8_t)name[i];
+	}
+	md_srn_node = node;
+	md_srn_port = port;
+	after = md_qrtr_send_qmi(head, node, port, qmi, 31u);
+	if (after != before) {
+		md_srn_listener_sent++;
+	}
+	MD_SAY("POLARIS MODEM: 0324 VERDICT: SERVREG "
+	    "REGISTER_LISTENER (QMI %#x) for '%s' to node %u "
+	    "port %#x, src port %#x, 31 QMI bytes, sent=%s, "
+	    "tx head %u -> %u\n", MD_SRN_REGISTER_LISTENER, name,
+	    node, port, MD_QRTR_LOCAL_PORT,
+	    after != before ? "YES" : "NO", before, after);
+	return after;
+}
+
+/* 0324: dump every QMI control frame and its TLVs.  The next version
+ * needs the real response/indication shape before it implements
+ * SET_ACK (0x23) -- dipper says the modem ACKs state changes with
+ * error 9 while wlan_pd is not up yet (EXP-0203f/g). */
+static void
+md_qmi_dump(uint32_t at, uint32_t len)
+{
+	uint32_t p, t, l, v, i;
+	uint16_t txn, msg, total;
+	char txt[33];
+
+	if (len < 7u || len > 96u) {
+		return;
+	}
+	txn = (uint16_t)(md_smem_byte(at + 1u) |
+	    ((uint16_t)md_smem_byte(at + 2u) << 8));
+	msg = (uint16_t)(md_smem_byte(at + 3u) |
+	    ((uint16_t)md_smem_byte(at + 4u) << 8));
+	total = (uint16_t)(md_smem_byte(at + 5u) |
+	    ((uint16_t)md_smem_byte(at + 6u) << 8));
+	MD_SAY("POLARIS MODEM: 0324: QMI type %u txn %u msg %#x "
+	    "tlvs %u payload %u\n", md_smem_byte(at), txn, msg,
+	    total, len);
+	p = 7u;
+	while (p + 3u <= 7u + total && p + 3u <= len) {
+		t = md_smem_byte(at + p);
+		l = (uint32_t)md_smem_byte(at + p + 1u) |
+		    ((uint32_t)md_smem_byte(at + p + 2u) << 8);
+		if (l > 64u || p + 3u + l > len) {
+			break;
+		}
+		v = 0u;
+		for (i = 0u; i < 4u && i < l; i++) {
+			v |= (uint32_t)md_smem_byte(at + p + 3u + i)
+			    << (8u * i);
+		}
+		for (i = 0u; i < l && i < 32u; i++) {
+			uint8_t c = md_smem_byte(at + p + 3u + i);
+
+			txt[i] = (c >= 0x20u && c < 0x7fu) ?
+			    (char)c : '.';
+		}
+		txt[i] = 0;
+		MD_SAY("POLARIS MODEM: 0324:   TLV %#x len %u "
+		    "word %#x '%s'\n", t, l, v, txt);
+		p += 3u + l;
+	}
+}
