+/* 0324: one byte out of the WCOMB SMEM map.  QMI TLVs are byte-packed,
+ * so a word-wise read is not enough.  No memcpy, no unmap (0310/0312). */
+static uint8_t
+md_smem_byte(uint32_t at)
+{
+	uint8_t b = 0;
+
+	if (!md_smem_peek(at, &b, 1u)) {
+		return 0;
+	}
+	return b;
+}
+
+static void
+md_pkt32(uint8_t *p, uint32_t at, uint32_t v)
+{
+	p[at] = (uint8_t)v;
+	p[at + 1u] = (uint8_t)(v >> 8);
+	p[at + 2u] = (uint8_t)(v >> 16);
+	p[at + 3u] = (uint8_t)(v >> 24);
+}
+
+/* dipper queue_packet():302 + flush():407.  A 64-byte QRTR v1 Q_DATA
+ * packet goes out as one 80-byte GLINK DATA frame on our local cid 1,
+ * using one of the modem's advertised foreign intents (0322: 30 x
+ * size 0x80, ids 0..29).  Returns the new tx head, or head unchanged
+ * when there is no usable intent. */
+static uint32_t
+md_qrtr_send_qmi(uint32_t head, uint32_t dst_node, uint32_t dst_port,
+    const uint8_t *qmi, uint32_t qlen)
+{
+	uint8_t pkt[64];
+	uint32_t i, iid = 0u, at = head, w;
+
+	if (qlen == 0u || qlen > 32u ||
+	    head + MD_GLINK_QMI_FRAME > MD_GLINK_FIFO_SIZE) {
+		return head;
+	}
+	for (i = 0u; i < MD_QRTR_QMI_PACKET; i++) {
+		pkt[i] = 0;
+	}
+	md_pkt32(pkt, 0u, 1u);			/* version */
+	md_pkt32(pkt, 4u, MD_QRTR_Q_DATA);
+	md_pkt32(pkt, 8u, MD_QRTR_LOCAL_NODE);
+	md_pkt32(pkt, 12u, MD_QRTR_LOCAL_PORT);
+	md_pkt32(pkt, 16u, 0u);		/* confirm_rx */
+	md_pkt32(pkt, 20u, qlen);		/* actual QMI length */
+	md_pkt32(pkt, 24u, dst_node);
+	md_pkt32(pkt, 28u, dst_port);
+	for (i = 0u; i < qlen; i++) {
+		pkt[32u + i] = qmi[i];
+	}
+	for (i = 0u; i < md_foreign_count; i++) {
+		if (md_foreign_size[i] >= MD_QRTR_QMI_PACKET &&
+		    md_foreign_id[i] != 0u) {
+			iid = md_foreign_id[i];
+			break;
+		}
+	}
+	if (iid == 0u) {
+		MD_SAY("POLARIS MODEM: 0324 VERDICT: no foreign intent "
+		    ">= %u B for the servreg QMI packet; NOT sent\n",
+		    MD_QRTR_QMI_PACKET);
+		return head;
+	}
+	md_smem_poke(md_glink_tx_at + at,
+	    MD_GLINK_DATA | (MD_GLINK_CID << 16));
+	md_smem_poke(md_glink_tx_at + at + 4u, iid);
+	md_smem_poke(md_glink_tx_at + at + 8u, MD_QRTR_QMI_PACKET);
+	md_smem_poke(md_glink_tx_at + at + 12u, 0u);
+	for (i = 0u; i < 16u; i++) {
+		w = (uint32_t)pkt[4u * i] |
+		    ((uint32_t)pkt[4u * i + 1u] << 8) |
+		    ((uint32_t)pkt[4u * i + 2u] << 16) |
+		    ((uint32_t)pkt[4u * i + 3u] << 24);
+		md_smem_poke(md_glink_tx_at + at + 16u + 4u * i, w);
+	}
+	return at + MD_GLINK_QMI_FRAME;
+}
