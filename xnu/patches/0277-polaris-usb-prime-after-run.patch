@@ -158,16 +158,23 @@
 static int ud_step = 3;
 
 /*
- * 0276: ep0-priming ladder. 0274 (no prime) runs 291 s / 839 swaps;
- * 0275 (prime + run + event thread) is dead at 77 s with 0 swaps, one
- * tick after "gadget armed". Everything between those two is one action,
- * so split it by boot-arg instead of guessing:
- *   0 = no prime                    (0274 behaviour)
- *   1 = prime, core stays stopped   (no host connect, no TRB DMA)
- *   2 = prime + RUN_STOP, but ud_thread NOT started (no event handling)
- *   3 = full                        (0275 behaviour)
+ * 0277: when to issue STARTTRANSFER on ep0 OUT.
+ *
+ * 0274 (no prime) = 291 s / 839 swaps. 0275 (prime before RUN_STOP) =
+ * 77 s / 0 swaps. 0276-p1 (prime before RUN_STOP, core left stopped) died
+ * even earlier - the ring ends at "epcmd ep0 PAR written, firing DEPCMD",
+ * i.e. dwc_wr(DEPCMD(0), 0x406) itself wedged the bus. So the fatal
+ * action is the endpoint command issued while the core is HALTED.
+ *
+ * Linux __dwc3_gadget_start() has the controller running before ep0 is
+ * armed. Move the prime to after RUN_STOP and see whether the command
+ * engine accepts it.
+ *   0 = no prime                       (0274 behaviour, control)
+ *   1 = prime BEFORE RUN_STOP           (0275/0276 behaviour, known bad)
+ *   2 = prime AFTER RUN_STOP            (new default)
+ *   3 = prime AFTER RUN_STOP + 100 ms   (settle time)
  */
-static int ud_prime = 3;
+static int ud_prime = 2;
 
