+/* 0325: PDR / servreg-notifier state names (Linux qcom_pdr.h).  0324's
+ * TLV 0x10 word 0x7fffffff is DOWN; dipper SRN_STATE_UP is 0x1fffffff. */
+static const char *
+md_srn_state_name(uint32_t v)
+{
+        if (v == MD_SRN_STATE_UP) {
+                return "UP (wlan_pd ready)";
+        }
+        if (v == MD_SRN_STATE_DOWN) {
+                return "DOWN (wlan_pd not up)";
+        }
+        if (v == 0x3fffffffu) {
+                return "UNINIT";
+        }
+        return "UNKNOWN";
+}
+
+/* 0325: QRTR v1 Q_NEW_LOOKUP (type 10) control packet, the Linux
+ * qrtr_send_new_lookup() equivalent.  dipper lookup_port():789 is
+ * XNU-simplified and registers its filter locally WITHOUT sending
+ * anything; the modem does implement QRTR control (Q_HELLO and
+ * Q_NEW_SERVER in 0322/0323), so ask it to (re)announce WLFW service
+ * 69 v1 inst0.  control():325 writes [type,a,b,c,d] into a 20 B
+ * payload; qrtr_input():530 reads service=get32(p+4) and
+ * packed=get32(p+8)=version|instance<<8.  52 B QRTR -> 72 B GLINK
+ * DATA frame, the same shape as 0323's Q_HELLO reply.  Returns the
+ * new tx head. */
+static uint32_t
+md_qrtr_new_lookup(uint32_t head)
+{
+        static const uint32_t pkt[13] = {
+                1u, MD_QRTR_Q_NEW_LOOKUP, MD_QRTR_LOCAL_NODE, MD_QRTR_CTRL,
+                0u, 20u, 0u, MD_QRTR_CTRL,
+                MD_QRTR_Q_NEW_LOOKUP, MD_SRN_WLFW_SERVICE, 1u, 0u, 0u
+        };
+        uint32_t i, iid = 0u, size = 0u, at = head;
+
+        for (i = 0u; i < md_foreign_count; i++) {
+                if (md_foreign_size[i] >= MD_QRTR_CTRL_LEN &&
+                    md_foreign_id[i] != 0u) {
+                        iid = md_foreign_id[i];
+                        size = md_foreign_size[i];
+                        break;
+                }
+        }
+        if (iid == 0u || head + MD_QRTR_CTRL_FRAME > MD_GLINK_FIFO_SIZE) {
+                MD_SAY("POLARIS MODEM: 0325 VERDICT: WLFW lookup NOT "
+                    "sent (foreign %u, tx head %u)\n",
+                    md_foreign_count, head);
+                return head;
+        }
+        md_smem_poke(md_glink_tx_at + at,
+            MD_GLINK_DATA | (MD_GLINK_CID << 16));
+        md_smem_poke(md_glink_tx_at + at + 4u, iid);
+        md_smem_poke(md_glink_tx_at + at + 8u, MD_QRTR_CTRL_LEN);
+        md_smem_poke(md_glink_tx_at + at + 12u, 0u);
+        for (i = 0u; i < 13u; i++) {
+                md_smem_poke(md_glink_tx_at + at + 16u + 4u * i, pkt[i]);
+        }
+        md_smem_poke(md_glink_tx_at + at + 68u, 0u);
+        md_wlfw_lookups++;
+        MD_SAY("POLARIS MODEM: 0325 VERDICT: WLFW Q_NEW_LOOKUP SENT "
+            "(service %u v1 inst0, QRTR type %u, 52 B, dst node 0 "
+            "port %#x, from %#x, cid %u, intent %u size %u, "
+            "tx head %u -> %u)\n", MD_SRN_WLFW_SERVICE,
+            MD_QRTR_Q_NEW_LOOKUP, MD_QRTR_CTRL, MD_QRTR_CTRL,
+            MD_GLINK_CID, iid, size, head, head + MD_QRTR_CTRL_FRAME);
+        return head + MD_QRTR_CTRL_FRAME;
+}
