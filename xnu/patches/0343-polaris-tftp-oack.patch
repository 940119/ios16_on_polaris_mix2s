+/* ---- 0343: TFTP options ------------------------------------------
+ *
+ * 0342 answered "ACK 0" to a WRQ that carried blksize, timeoutms and
+ * wsize.  A client asks for those precisely so the host can tell it
+ * what will be accepted; a bare ACK 0 says "no options", it cannot know
+ * what block size to send, and it retransmitted instead -- twice per
+ * port, 1000 ms apart, which is its own timeoutms, on port 31 then 65
+ * then 72.  RFC 2347: if the server honours any option it answers OACK.
+ *
+ * The values echoed back are ours, not the client's: blksize is capped
+ * at 1024 and rounded down to a multiple of four (0399: only word
+ * stores into SMEM), wsize at 4 because the whole tx FIFO is 16 KiB.
+ * ----------------------------------------------------------------- */
+static uint32_t
+md_tftp_same(const char *a, const char *b)
+{
+	uint32_t i = 0u;
+
+	for (;;) {
+		char x = a[i], y = b[i];
+
+		if (x >= 'A' && x <= 'Z') {
+			x = (char)(x - 'A' + 'a');
+		}
+		if (y >= 'A' && y <= 'Z') {
+			y = (char)(y - 'A' + 'a');
+		}
+		if (x != y) {
+			return 0u;
+		}
+		if (x == 0) {
+			return 1u;
+		}
+		i++;
+		if (i > 16u) {
+			return 0u;
+		}
+	}
+}
+
+static uint32_t
+md_tftp_dec(const char *s, uint32_t *out)
+{
+	uint32_t v = 0u, n = 0u;
+
+	while (s[n] >= '0' && s[n] <= '9' && n < 8u) {
+		v = v * 10u + (uint32_t)(s[n] - '0');
+		n++;
+	}
+	if (n == 0u || s[n] != 0) {
+		return 0u;
+	}
+	*out = v;
+	return 1u;
+}
+
+static void
+md_tftp_put(uint8_t *rsp, uint32_t *at, uint32_t cap, const char *s)
+{
+	while (*s != 0 && *at + 1u < cap) {
+		rsp[*at] = (uint8_t)*s;
+		(*at)++;
+		s++;
+	}
+	if (*at < cap) {
+		rsp[*at] = 0u;
+		(*at)++;
+	}
+}
+
+static void
+md_tftp_putn(uint8_t *rsp, uint32_t *at, uint32_t cap, uint32_t value)
+{
+	char digits[11];
+	uint32_t n = 0u;
+
+	do {
+		digits[n++] = (char)('0' + value % 10u);
+		value /= 10u;
+	} while (value != 0u && n < sizeof(digits));
+	while (n != 0u && *at + 1u < cap) {
+		n--;
+		rsp[*at] = (uint8_t)digits[n];
+		(*at)++;
+	}
+	if (*at < cap) {
+		rsp[*at] = 0u;
+		(*at)++;
+	}
+}
+
+/* The request is "<path>\0<mode>\0(<name>\0<value>\0)*".  Builds the
+ * OACK body at rsp[2..] and returns its total length, or 0 when the
+ * request named no option we speak -- the caller then answers exactly
+ * as 0342 did, so a plain WRQ still gets its ACK 0. */
+static uint32_t
+md_tftp_options(uint32_t req_at, uint32_t req_len, char *path, uint32_t pcap,
+    uint8_t *rsp, uint32_t cap, uint32_t *blksize, uint32_t *accepted)
+{
+	uint32_t at = 2u, n, out = 2u, opts = 0u, bs = MD_TFTP_BLOCK;
+	char key[24], val[24];
+
+	path[0] = 0;
+	*blksize = MD_TFTP_BLOCK;
+	*accepted = 0u;
+	if (req_len <= at) {
+		return 0u;
+	}
+	n = md_tftp_field(req_at + at, req_len - at, path, pcap);
+	at += n + 1u;
+	if (at >= req_len) {
+		return 0u;			/* path and nothing else */
+	}
+	n = md_tftp_field(req_at + at, req_len - at, key, sizeof(key));
+	at += n + 1u;				/* the mode: octet */
+	while (at < req_len) {
+		uint32_t value = 0u;
+
+		n = md_tftp_field(req_at + at, req_len - at, key, sizeof(key));
+		at += n + 1u;
+		if (n == 0u || at >= req_len) {
+			break;
+		}
+		n = md_tftp_field(req_at + at, req_len - at, val, sizeof(val));
+		at += n + 1u;
+		if (md_tftp_same(key, "blksize")) {
+			if (!md_tftp_dec(val, &value) || value < 8u) {
+				continue;
+			}
+			if (value > 1024u) {
+				value = 1024u;
+			}
+			value &= ~3u;
+			if (value < 8u) {
+				continue;
+			}
+			bs = value;
+		} else if (md_tftp_same(key, "timeoutms") ||
+		    md_tftp_same(key, "timeout")) {
+			if (!md_tftp_dec(val, &value) || value < 1u) {
+				continue;
+			}
+			if (value > 5000u) {
+				value = 5000u;
+			}
+		} else if (md_tftp_same(key, "wsize") ||
+		    md_tftp_same(key, "windowsize")) {
+			if (!md_tftp_dec(val, &value) || value < 1u) {
+				continue;
+			}
+			if (value > 4u) {
+				value = 4u;
+			}
+		} else if (md_tftp_same(key, "tsize")) {
+			if (!md_tftp_dec(val, &value)) {
+				continue;
+			}
+			value = 0u;		/* we keep no size table */
+		} else {
+			continue;		/* not a name we know */
+		}
+		md_tftp_put(rsp, &out, cap, key);
+		md_tftp_putn(rsp, &out, cap, value);
+		opts++;
+	}
+	if (opts == 0u) {
+		return 0u;
+	}
+	rsp[0] = 0u;
+	rsp[1] = 6u;				/* OACK */
+	*blksize = bs;
+	*accepted = opts;
+	return out;
+}
