+/* The raw tail of a request, so the next ring proves what the options
+ * really are instead of leaving it to arithmetic.  Three bytes per
+ * byte, 48 bytes maximum: one MD_SAY line, under the 255-char cap. */
+static void
+md_tftp_hex(uint32_t req_at, uint32_t from, uint32_t req_len)
+{
+	static const char dig[] = "0123456789abcdef";
+	char hex[3u * 48u + 1u];
+	uint32_t i, n = 0u;
+
+	if (from >= req_len) {
+		hex[0] = 0;
+	} else {
+		for (i = from; i < req_len && n + 4u < sizeof(hex); i++) {
+			uint8_t c = md_smem_byte(req_at + i);
+
+			hex[n++] = dig[c >> 4];
+			hex[n++] = dig[c & 15u];
+			hex[n++] = ' ';
+		}
+		hex[n] = 0;
+	}
+	MD_SAY("POLARIS MODEM: 0343 VERDICT: TFTP request bytes from %u: "
+	    "%s\n", from, hex);
+}
