+/*
+ * 0302: the held-key stream, kept as a negative control.
+ *
+ * iOS measures a long press from the down/up timestamps it already receives,
+ * so a real PMU does not need to repeat anything for that, and this variant is
+ * NOT expected to fix the power-off slider. It exists so one CI build can rule
+ * the hypothesis out on the phone instead of on paper: boot with
+ * sweetkeys_hold=800 and the ring will show the repeats being posted.
+ *
+ * kIOHIDEventOptionIsRepeat is 0x00010000, defined in IOHIDEvent.h.
+ *
+ * Deliberately silent: this runs every 100 ms while a key is held and would
+ * otherwise flood the persistent ring.
+ */
+void
+SweetHIDButtons::keyRepeat(UInt32 usage, bool down)
+{
+	IOHIDEvent *event = IOHIDEvent::keyboardEvent(mach_absolute_time(),
+	    kHIDPage_Consumer, usage, down, kIOHIDEventOptionIsRepeat);
+
+	if (event) {
 		dispatchEvent(event);
 		event->release();
 	}
