+/*
+ * 0302 (yinliang): what the power key does after the press is over.
+ *
+ * Read this with the ring in hand (boot-01-keys-0299.txt): a short press locks
+ * and wakes, a long press is measured and launches Siri, and the real iPhone X
+ * chord - power + volume held together for about two seconds - produced no
+ * slider. So the events are already right and the useful work here is
+ * *measurement*, plus one knob to replay the chord with exact timing:
+ *
+ *   sweetkeys_off=<ms>   hold a synthetic volume key for 2.5 s once the power
+ *                        key has been down that long. Side effect: the volume
+ *                        really does change while it is held.
+ *   sweetkeys_offkey=<1|2>  which volume key, 1 = up, 2 = down (default 2).
+ *                        The user tried volume up by hand, so this is the knob
+ *                        that says whether SpringBoard arms on only one.
+ *   sweetkeys_hold=<ms>  negative control: repeat the power down event every
+ *                        100 ms with kIOHIDEventOptionIsRepeat. Expected to
+ *                        change nothing - iOS measures a long press from the
+ *                        down/up timestamps, not from a repeat stream.
+ *
+ * Every window defaults to 0 = off, so a boot without these boot-args behaves
+ * exactly like 0294 v2 apart from the two measurement lines below.
+ */
+#define KEYS_REPEAT_MS		100u
+#define KEYS_OFF_CHORD_MS	2500u
+
+static uint32_t keys_hold_ms;		/* sweetkeys_hold, 0 = off */
+static uint32_t keys_off_ms;		/* sweetkeys_off,  0 = off */
+static int keys_off_key = 2;		/* sweetkeys_offkey: 1 up, 2 down */
+static uint64_t keys_power_since;	/* ns, 0 = power not held */
+static uint64_t keys_repeat_last;	/* ns of the last repeat */
+static uint64_t keys_off_release;	/* ns to let the synthetic volume go */
+static bool keys_off_sent;		/* synthetic press already fired */
+static bool keys_off_vol_down;		/* synthetic volume key is held */
+static bool keys_chord_seen;		/* power + volume down, logged once */
+static uint32_t keys_repeats;		/* repeats since the last release */
+static uint32_t keys_off_fired;		/* synthetic chords since boot */
+static uint32_t keys_chords;		/* physical chords since boot */
+
+static uint64_t
+keys_now_ns(void)
+{
+	uint64_t t, ns;
+
+	clock_get_uptime(&t);
+	absolutetime_to_nanoseconds(t, &ns);
+	return ns;
+}
+
+static uint32_t
+keys_ms_between(uint64_t now, uint64_t then)
+{
+	return (uint32_t)((now - then) / 1000000ull);
+}
 
