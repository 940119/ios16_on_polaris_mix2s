  * A frozen screen and a black screen look the same from the outside, and so do a
  * black frame the compositor handed us and a frame we failed to copy. This walks
  * the panel memory - which the panel scans out by itself, so this is the picture,
- * not a model of it - and prints it as a 24x24 luminance ramp plus a count of
- * non-black cells. Twenty lines a minute, so a boot says whether the last frame
- * had content and whether it ever changed.
+ * not a model of it - and prints it as characters.
+ *
+ * Build 0179 printed 24x24 and that was not enough to name the screen: the
+ * asterisk and the hash on a dialler keypad are thin glyphs that average into the
+ * white behind them, and a green call button and a white digit are the same
+ * brightness. So each cell is 18x18 pixels now, and a cell whose colour is
+ * saturated prints a hue letter instead of a brightness: R G B C M Y. White stays
+ * on the ramp. "G" in the bottom middle is a call button; "0" is not.
+ *
+ * 120 lines every two minutes, six dumps in twelve minutes.
  */
+#define SWEET_FB_THUMB_COLS	60
+#define SWEET_FB_THUMB_ROWS	120
+
+static char
+sweet_fb_hue(uint32_t r, uint32_t g, uint32_t b)
+{
+	uint32_t hi = r > g ? (r > b ? r : b) : (g > b ? g : b);
+	uint32_t lo = r < g ? (r < b ? r : b) : (g < b ? g : b);
+
+	if (hi < 48 || hi - lo < 28) {
+		return 0;			/* grey: use the ramp */
+	}
+	if (hi == r && hi == g) {
+		return 'Y';
+	}
+	if (hi == g && hi == b) {
+		return 'C';
+	}
+	if (hi == r && hi == b) {
+		return 'M';
+	}
+	if (hi == r) {
+		return 'R';
+	}
+	if (hi == g) {
+		return 'G';
+	}
+	return 'B';
+}
+
