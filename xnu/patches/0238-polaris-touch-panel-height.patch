--- a/bsd/dev/polaris_touch_i2c.c
+++ b/bsd/dev/polaris_touch_i2c.c
@@ -18,6 +18,14 @@
 
 extern bool polaris_touch_i2c_board(void);
 extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+/*
+ * 0238: the panel, and the space SweetHID normalizes contacts by. They differ,
+ * and that difference is the bug this build fixes - see pt_frame().
+ */
+#define PT_PANEL_W	1080
+#define PT_PANEL_H	2160
+#define PT_HID_H	2400
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern kern_return_t thread_terminate(thread_t);
 
@@ -346,9 +354,28 @@
 	 * Reject unknown object types and out-of-panel coordinates. */
 	*x = (int)((unsigned)b[1] | ((unsigned)b[2] << 8));
 	*y = (int)((unsigned)b[3] | ((unsigned)b[4] << 8));
-	if ((b[0] & 0x0f) != 1 || *x >= 1080 || *y >= 2160) {
-		return false;
-	}
+	if ((b[0] & 0x0f) != 1 || *x >= PT_PANEL_W || *y >= PT_PANEL_H) {
+		return false;
+	}
+	/*
+	 * 0238: report the contact in the space SweetHID divides by, not the
+	 * panel's own height.
+	 *
+	 * SweetHID::touch() normalizes a contact with x/1080 and y/2400, and flags
+	 * the edge tip with y > 2399 - 48. Both are the numbers of the phone this
+	 * driver was first written for. This panel is 1080x2160, so a contact read
+	 * here at the bottom row (y = 2159) left SweetHID at 0.8996 of the screen -
+	 * 10% short of the bottom - and the bottom 240 rows of the panel could not
+	 * be touched at all. That is exactly where the lock screen's swipe-up
+	 * starts, which is why the phone looked as if it had no touch on the lock
+	 * screen while taps elsewhere still landed.
+	 *
+	 * Scaling here rather than editing SweetHID keeps the fix in the file whose
+	 * every byte is known: 2159 becomes 2398, the bottom edge flag fires for the
+	 * last 44 panel rows, and a contact at any other row lands where the finger
+	 * is instead of 11% above it.
+	 */
+	*y = (int)(((int64_t)*y * PT_HID_H) / PT_PANEL_H);
 	*present = true;
 	return true;
 }
@@ -535,8 +562,11 @@
 					if (pt_down_logged < 8) {
