 						    raw + slot * FINGER_BYTES;
-						printf("POLARIS HID: down %u slot %u at %d,%d raw %02x %02x %02x %02x %02x %02x %02x %02x\n",
+						printf("POLARIS HID: down %u slot %u at %d,%d "
+						    "(panel %d,%d) raw %02x %02x %02x %02x %02x %02x %02x %02x\n",
 						    pt_down_logged, slot, x[slot], y[slot],
+						    x[slot],
+						    (int)(((int64_t)y[slot] * PT_PANEL_H) / PT_HID_H),
 						    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]);
 						pt_down_logged++;
 					}
