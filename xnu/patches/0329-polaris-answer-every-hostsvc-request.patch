+ * two replies, so "/boot/modem_fsg" (0x4001) and PDM 0x21 (0x4003) were
+ * never answered and the modem stopped dead -- QMI rx froze at 5 for the
+ * remaining 18 heartbeats.  Formats from dipper receive():360-390,
+ * rmtfs():217-300 and pdm():320-341:
+ *
+ *   header : [0] = 2 (response), [1..4] = req[1..4] (txn + msg echoed),
+ *            [5..6] = TLV byte count
+ *   result : TLV 0x02 len 4 = [result][error]; success 0/0, failure
+ *            1/code (setle(response + 10, error ? 1 : 0, 2) and
+ *            setle(response + 12, error, 2))
+ *   R_OPEN : + TLV 0x10 len 4 = handle id            (rmtfs():248)
+ *   PDM    : + 0x10 len 2 total, 0x11 len 2 = 1, 0x12 len 1 count
+ * Anything else still gets an explicit result so the modem never waits
+ * on us again.  Returns the new tx head. */
+
+/* QMI TLVs are packed after the 7 byte header as
+ * {tag, len_lo, len_hi, value...}.  Returns the value offset or 0. */
+static uint32_t
+md_qmi_find(uint32_t at, uint32_t len, uint32_t tag, uint32_t *out_len)
+{
+        uint32_t p = 7u, n;
+
+        while (p + 3u <= len) {
+                n = (uint32_t)md_smem_byte(at + p + 1u) |
+                    ((uint32_t)md_smem_byte(at + p + 2u) << 8);
+                if (p + 3u + n > len) {
+                        return 0u;
+                }
+                if ((uint32_t)md_smem_byte(at + p) == tag) {
+                        *out_len = n;
+                        return at + p + 3u;
+                }
+                p += 3u + n;
+        }
+        return 0u;
+}
+
+/* Append one little-endian TLV, return the offset just past it. */
+static uint32_t
+md_hs_number(uint8_t *rsp, uint32_t at, uint8_t tag, uint32_t value,
+    uint32_t bytes)
+{
+        uint32_t i;
+
+        rsp[at] = tag;
+        rsp[at + 1u] = (uint8_t)bytes;
+        rsp[at + 2u] = 0u;
+        for (i = 0u; i < bytes; i++) {
+                rsp[at + 3u + i] = (uint8_t)(value >> (8u * i));
+        }
+        return at + 3u + bytes;
+}
+
+static uint32_t
+md_hs_prefix(uint32_t at, uint32_t len, const char *prefix)
+{
+        uint32_t i;
+
+        for (i = 0u; prefix[i] != 0; i++) {
+                if (i >= len ||
+                    md_smem_byte(at + i) != (uint8_t)prefix[i]) {
+                        return 0u;
+                }
+        }
+        return 1u;
+}
