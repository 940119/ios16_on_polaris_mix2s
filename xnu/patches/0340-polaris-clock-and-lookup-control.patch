+/* 0340b: hand the radio its memory before the modem starts.
+ *
+ * W2e step 4 grants mba + mpss to the MSS and that is the whole of the
+ * modem's own memory.  wlan_fw_region is not in that grant: it stays
+ * with HLOS, so a modem that tried to put the radio's firmware there
+ * would be stopped by the XPU -- and 0311 is the round that proved the
+ * XPU is what stops this machine, because the MBA only ran once the
+ * owners changed.  dipper grants the same region at MSA_READY with
+ * MSS_MSA | WLAN | WLAN_CE (mi8_rproc.c:3054 wl_msa_assign).  We can
+ * never reach MSA_READY: it needs service 69, and service 69 is the
+ * thing wlan_pd never brings up.  So grant it up front and keep HLOS in
+ * the list, so this side can still read the region afterwards.
+ *
+ * polaris device tree /reserved-memory/wlan_fw_region@0x8e300000: 1 MiB,
+ * compatible "removed-dma-pool" (_dtb_all.txt:22776).  Same size as
+ * upstream's wlan-msa@8df00000 (_sdm845.dtsi:853) and as the icnss
+ * node's qcom,wlan-msa-memory = 0x100000.  It is also the region
+ * dipper tried for wlfw msa_info and got error 90 for -- which is what
+ * a region the radio was never given would answer. */
+#define MD_WLAN_MSA_PHYS	0x8e300000ull
+#define MD_WLAN_MSA_SIZE	0x00100000ull
+
+static uint64_t md_wlan_msa_owners = 1ull << MD_VMID_HLOS;
+
+static void
+md_wlan_msa_grant(void)
+{
+	uint64_t next = (1ull << MD_VMID_HLOS) | (1ull << MD_VMID_MSS_MSA) |
+	    (1ull << MD_VMID_WLAN) | (1ull << MD_VMID_WLAN_CE);
+	bool ok;
+
+	MD_SAY("POLARIS MODEM: 0340 VERDICT: wlan_fw_region %#llx +%#llx -> "
+	    "MSS_MSA|WLAN|WLAN_CE before the modem starts\n",
+	    (unsigned long long)MD_WLAN_MSA_PHYS,
+	    (unsigned long long)MD_WLAN_MSA_SIZE);
+	ok = md_assign_owners("wlan_fw_region", MD_WLAN_MSA_PHYS,
+	    MD_WLAN_MSA_SIZE, &md_wlan_msa_owners, next);
+	MD_SAY("POLARIS MODEM: 0340 VERDICT: wlan_fw_region owners %#llx "
+	    "(%s)\n", md_wlan_msa_owners, ok ? "granted" : "refused");
+}
