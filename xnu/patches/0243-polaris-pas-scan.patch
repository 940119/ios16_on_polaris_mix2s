+		    "secure monitor is asked which cores it will boot and no register "
+		    "is touched ========\n", level);
+		md_pas_scan();
+		MD_SAY("POLARIS MODEM: phase E done; nothing was written and no block "
+		    "was mapped\n");
 		return;
 	}
