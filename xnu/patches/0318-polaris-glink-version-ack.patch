+
+/* 0318: GLINK has its OWN doorbell bit, not the SMP2P one. */
+static void
+md_glink_ring(void)
+{
+	if (md_apcs == 0) {
+		md_apcs = ml_io_map((vm_offset_t)MD_APCS_PHYS, 0x1000);
+	}
+	if (md_apcs == 0) {
+		MD_SAY("POLARIS MODEM:   0318: no APCS map, GLINK doorbell NOT rung\n");
+		return;
+	}
+	*(volatile uint32_t *)(md_apcs + MD_APCS_IPC) = MD_IPC_GLINK_MODEM;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	MD_SAY("POLARIS MODEM:   0318: GLINK modem doorbell rung "
+	    "(APCS %#x + %#x = %#x)\n", (uint32_t)MD_APCS_PHYS,
+	    MD_APCS_IPC, MD_IPC_GLINK_MODEM);
+}
+
+/* 0318: answer the VERSION the modem already wrote into item 480.
+ * dipper progress() consumes the rx bytes FIRST (mi8_glink.c:675),
+ * then emit() writes the tx FIFO and advances our tx head (:230),
+ * then it rings.  Everything is byte-wise/word-wise volatile through
+ * the existing WCOMB map: no memcpy, no unmap (0312 / 0310). */
+static void
+md_glink_reply(uint32_t elapsed_ms)
+{
+	uint32_t d[4], cmd[2], i, rxhead, features;
+
+	if (md_glink_acked || md_glink_desc_at == 0 ||
+	    md_glink_tx_at == 0 || md_glink_rx_at == 0) {
+		return;
+	}
+	for (i = 0; i < 4u; i++) {
+		d[i] = 0;
+		if (!md_smem_peek(md_glink_desc_at + 4u * i, &d[i], 4u)) {
+			return;
+		}
+	}
+	rxhead = d[3];
+	if (rxhead < 8u || rxhead > MD_GLINK_FIFO_SIZE - 8u) {
+		return;
+	}
+	cmd[0] = 0;
+	cmd[1] = 0;
+	if (!md_smem_peek(md_glink_rx_at, cmd, 8u)) {
+		return;
+	}
+	/* header(): cmd in byte 0, cid in bytes 2..3, arg in bytes 4..7. */
+	if ((cmd[0] & 0xffu) != MD_GLINK_VERSION ||
+	    ((cmd[0] >> 16) & 0xffffu) != MD_GLINK_CID) {
+		MD_SAY("POLARIS MODEM:   0318: 480 first word %#x is not "
+		    "GLINK VERSION/cid=1; no ACK sent\n", cmd[0]);
+		return;
+	}
+	features = MD_GLINK_FEATURES & cmd[1];
+	MD_SAY("POLARIS MODEM:   0318: modem sent GLINK VERSION at t=+%u ms: "
+	    "cid %u, features %#x, rx head %u; answering with %#x\n",
+	    elapsed_ms, MD_GLINK_CID, cmd[1], rxhead, features);
+	md_smem_poke(md_glink_desc_at + 8u, rxhead);	/* rx tail: consumed */
+	md_smem_poke(md_glink_tx_at, MD_GLINK_VERSION_ACK | (MD_GLINK_CID << 16));
+	md_smem_poke(md_glink_tx_at + 4u, features);
+	md_smem_poke(md_glink_desc_at + 4u, 8u);	/* tx head: 8 bytes */
+	md_glink_ring();
+	md_glink_acked = TRUE;
+	MD_SAY("POLARIS MODEM: 0318 VERDICT: GLINK VERSION_ACK SENT "
+	    "(features %#x, tx head 8, rx tail %u); watching for "
+	    "OPEN IPCRTR / INTENT\n", features, rxhead);
+}
