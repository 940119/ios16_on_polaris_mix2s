+/* ---- the SMMU's context bank 2 and the tables behind it --------------------------------------------- */
+
+static vm_offset_t
+pg_smmu_cb(uint32_t n)
+{
+	return pg_smmu + pg_smmu_cb_base + pg_smmu_page_size * n;
+}
+
+/* One table of 4 KB pages, three levels. Every region lies inside the single
+ * 2 MB window 0x6000_0000 opens, so one page per level is all it takes. */
+static bool
+pg_smmu_tables(void)
+{
+	if (pg_l3_va != 0) {
+		return true;
+	}
+	if (kmem_alloc(kernel_map, &pg_l1_va, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    kmem_alloc(kernel_map, &pg_l2_va, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    kmem_alloc(kernel_map, &pg_l3_va, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("POLARIS GPU: 10 no memory for the SMMU's tables\n");
+		return false;
+	}
+	((uint64_t *)pg_l1_va)[(PG_GMU_IOVA_BASE >> 30) & 0x1ff] =
+	    kvtophys(pg_l2_va) | PG_PTE_TABLE;
+	((uint64_t *)pg_l2_va)[(PG_GMU_IOVA_BASE >> 21) & 0x1ff] =
+	    kvtophys(pg_l3_va) | PG_PTE_TABLE;
+	pg_to_memory(pg_l1_va, PAGE_SIZE);
+	pg_to_memory(pg_l2_va, PAGE_SIZE);
+	printf("POLARIS GPU: 10 SMMU tables: level 1 %#llx, level 2 %#llx, level 3 %#llx\n",
+	    kvtophys(pg_l1_va), kvtophys(pg_l2_va), kvtophys(pg_l3_va));
+	return true;
+}
+
+static bool
+pg_smmu_map(uint64_t iova, vm_offset_t va, uint32_t pages, const char *name)
+{
+	uint64_t *l3 = (uint64_t *)pg_l3_va;
+
+	if (!pg_smmu_tables()) {
+		return false;
+	}
+	if ((iova >> 21) != (PG_GMU_IOVA_BASE >> 21)) {
+		printf("POLARIS GPU: 10 %s at %#llx is outside the 2 MB the tables cover\n", name, iova);
+		return false;
+	}
+	for (uint32_t i = 0; i < pages; i++) {
+		l3[((iova >> 12) + i) & 0x1ff] =
+		    (kvtophys(va + (vm_offset_t)PG_GMU_PAGE_SIZE * i) & PG_PTE_ADDR) |
+		    PG_PTE_ATTR | PG_PTE_PAGE;
+	}
+	pg_to_memory(pg_l3_va, PAGE_SIZE);
+	printf("POLARIS GPU: 10 %s: %#llx -> %#llx\n", name, iova, kvtophys(va));
+	return true;
+}
