-	    !pt_write((uint8_t)(reg >> 8))) {
-		goto out;
-	}
+	pt_read_stage = 1;
+	if (!len || len > MAX_READ || !pt_start(false)) goto out;
+	pt_read_stage = 2;
+	if (!pt_write(I2C_ADDR << 1)) goto out;
+	pt_read_stage = 3;
+	if (!pt_write(0xff)) goto out;
+	pt_read_stage = 4;
