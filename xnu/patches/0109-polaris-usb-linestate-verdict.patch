+/* One line that says everything the core currently believes about the wire. */
+static void
+ud_live_state(const char *tag)
+{
+	uint32_t d = dwc_rd(DSTS);
+	uint32_t g = dwc_rd(GSTS);
+
+	printf("SWEET USB:   %-8s cs=%d spd=%u susp=%d hlt=%d bsessvld=%d DSTS 0x%08x GSTS 0x%08x ev 0x%08x\n",
+	    tag, !!(d & 1), (d >> 1) & 7u, !!(d & (1u << 8)), !!(d & DSTS_DEVCTRLHLT),
+	    !!(g & (1u << 30)), d, g, dwc_rd(GEVNTCOUNT) & 0xffff);
+}
+
+/*
+ * The self-contained linestate test.
+ *
+ * Powering the QUSB2 PHY down is a guaranteed disconnect from the PHY's side:
+ * the pull-up goes, the transceiver stops, and any core that is actually
+ * sampling the UTMI linestate has to see it. So run the sequence and print the
+ * core's opinion at each step, then say which of the two cases the readings
+ * support. No cable movement, no timing, no user.
+ */
+static void
+ud_cfg_linestate(void)
+{
+	vm_offset_t phy = ml_io_map(QUSB2_PA, QUSB2_SIZE);
+	uint32_t cs_off;
+
+	if (phy == 0) {
+		printf("SWEET USB:   PHY map failed\n");
+		return;
+	}
+	ud_live_state("before");
+	qusb2_wr(phy, QUSB2_PORT_POWERDOWN, 0x23);
+	ud_sleep_ms(1500);
+	printf("SWEET USB:   PHY POWERDOWN 0x%02x\n", qusb2_rd(phy, QUSB2_PORT_POWERDOWN));
+	ud_live_state("phy-off");
+	cs_off = dwc_rd(DSTS) & 1;
+	ud_qusb2_init();
+	ud_sleep_ms(1000);
+	ud_live_state("phy-on");
+	if (cs_off != (dwc_rd(DSTS) & 1)) {
+		printf("SWEET USB:   VERDICT: linestate is live - CS follows the PHY\n");
+	} else {
+		printf("SWEET USB:   VERDICT: linestate is FROZEN - CS did not move when the PHY was powered down\n");
+	}
+}
