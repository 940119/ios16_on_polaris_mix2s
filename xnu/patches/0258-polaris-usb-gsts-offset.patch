 /*
+ * 0258: the override that lives inside the controller, not the wrapper.
+ *
+ * QSCRATCH's UTMI_OTG_VBUS_VALID is a message to the wrapper: it asks the
+ * glue to emit a connect-done event. It does not change what the core believes
+ * about the wire, which is why 0255 could write it before every run_stop and
+ * still watch the link stay disconnected.
+ *
+ * GOTGCTL is different in kind. VBvalidOvval/VBvalidOvEn and
+ * BvalidOvval/BvalidOvEn are the OTG state machine's own inputs: with the
+ * override enabled the core is told, inside its own logic, that VBUS is valid
+ * and that a B-device session exists. That is upstream of the point where the
+ * core decides whether to drive UTMI TermSelect, and TermSelect is what closes
+ * the 1.5k pull-up on D+.
+ *
+ * Whether this block responds at all is the measurement. GHWPARAMS0's low
+ * bits read 2, which is op_mode OTG rather than the "device only" the earlier
+ * notes took them for, so it should. A read-back that matches the write means
+ * the block is live; a read-back unchanged means this controller does not
+ * expose it in the current mode and the next step is elsewhere.
+ */
+static void
+ud_otg_override(void)
+{
+	uint32_t before = dwc_rd(GOTGCTL);
+	uint32_t want = before | GOTGCTL_VBVALIDOVEN | GOTGCTL_VBVALIDOVVAL |
+	    GOTGCTL_BVALIDOVEN | GOTGCTL_BVALIDOVVAL;
+	uint32_t after;
+	uint32_t g;
+
+	dwc_wr(GOTGCTL, want);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	after = dwc_rd(GOTGCTL);
+	g = dwc_rd(GSTS);
+	printf("SWEET USB: GOTGCTL 0x%08x -> 0x%08x (wanted 0x%08x)%s\n",
+	    before, after, want, (after & want) == want ? " [took]" : " [REFUSED]");
+	printf("SWEET USB: GSTS 0x%08x (cable %d sess %d bvalid %d avalid %d csr %d curmod %d)\n",
+	    g, !!(g & GSTS_BCABLE), !!(g & GSTS_BSESSVLD), !!(g & GSTS_BVALID),
+	    !!(g & GSTS_AVALID), !!(g & GSTS_CSRTIMEOUT), !!(g & 1u));
+}
