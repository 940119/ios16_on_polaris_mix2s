+/* 0323: the modem advertised 30 INTENT frames on its own IPCRTR cid in
+ * the 0322 ring.  dipper pump():625 stores those as foreign intents --
+ * buffers the AP may fill with a DATA frame.  Remember the ones big
+ * enough for our 52-byte QRTR hello.  Reads are word-wise volatile
+ * through the WCOMB map (0310 / 0312): no memcpy, no unmap. */
+static void
+md_foreign_note(uint32_t at, uint32_t count)
+{
+	uint32_t j, size, id;
+
+	if (count == 0u || count > 16u) {
+		return;
+	}
+	for (j = 0u; j < count; j++) {
+		size = md_smem_word(md_glink_rx_at + at + 8u + 8u * j);
+		id = md_smem_word(md_glink_rx_at + at + 12u + 8u * j);
+		if (size < MD_QRTR_HELLO_LEN || id == 0u ||
+		    md_foreign_count >= MD_GLINK_MAX_FOREIGN) {
+			continue;
+		}
+		md_foreign_id[md_foreign_count] = id;
+		md_foreign_size[md_foreign_count] = size;
+		md_foreign_count++;
+	}
+}
