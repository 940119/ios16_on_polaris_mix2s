+/* dipper qrtr_input():487 + control():326 + queue_packet():302.
+ * A QRTR v1 control packet is 32 B of header + 20 B of payload.  The
+ * Q_HELLO case reads ONLY command = get32(p) and ignores the other four
+ * payload words, so 0322's payload 0x2 0x1ee3 0xa 0 0 is answered with
+ * 0x2 0 0 0 0.  sn is the src node of the modem's hello (0 in 0322);
+ * dipper replies to that exact node, and sets local_node to 1.
+ * Returns the new tx head. */
+static uint32_t
+md_qrtr_hello_reply(uint32_t head, uint32_t sn)
+{
+	static const uint32_t pkt[13] = {
+		1u, MD_QRTR_Q_HELLO, MD_QRTR_LOCAL_NODE, MD_QRTR_CTRL,
+		0u, 20u, 0u, MD_QRTR_CTRL,
+		MD_QRTR_Q_HELLO, 0u, 0u, 0u, 0u
+	};
+	uint32_t i, iid = 0u, size = 0u, at = head;
+
+	for (i = 0u; i < md_foreign_count; i++) {
+		if (md_foreign_size[i] >= MD_QRTR_HELLO_LEN &&
+		    md_foreign_id[i] != 0u) {
+			iid = md_foreign_id[i];
+			size = md_foreign_size[i];
+			break;
+		}
+	}
+	if (iid == 0u || head + MD_QRTR_HELLO_FRAME > MD_GLINK_FIFO_SIZE) {
+		MD_SAY("POLARIS MODEM: 0323 VERDICT: Q_HELLO received but NO "
+		    "usable foreign intent (have %u, tx head %u); reply "
+		    "NOT sent\n", md_foreign_count, head);
+		return head;
+	}
+	/* header(DATA=9, cid=1, arg=iid) + chunk + left (pump():612). */
+	md_smem_poke(md_glink_tx_at + at,
+	    MD_GLINK_DATA | (MD_GLINK_CID << 16));
+	md_smem_poke(md_glink_tx_at + at + 4u, iid);
+	md_smem_poke(md_glink_tx_at + at + 8u, MD_QRTR_HELLO_LEN);
+	md_smem_poke(md_glink_tx_at + at + 12u, 0u);
+	for (i = 0u; i < 13u; i++) {
+		md_smem_poke(md_glink_tx_at + at + 16u + 4u * i,
+		    i == 6u ? sn : pkt[i]);
+	}
+	md_smem_poke(md_glink_tx_at + at + 68u, 0u);	/* pad 68 -> 72 */
+	md_qrtr_hello_replies++;
+	MD_SAY("POLARIS MODEM: 0323 VERDICT: QRTR Q_HELLO REPLY SENT "
+	    "(cid %u, foreign intent id %u size %u, 52 B, dst node %u, "
+	    "src node %u, tx head %u -> %u)\n", MD_GLINK_CID, iid, size,
+	    sn, MD_QRTR_LOCAL_NODE, head,
+	    head + MD_QRTR_HELLO_FRAME);
+	return head + MD_QRTR_HELLO_FRAME;
+}
