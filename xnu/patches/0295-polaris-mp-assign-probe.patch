 /*
+ * 0295, level 12: dipper's W2d (mi8_rproc.c:2188-2227) on polaris.
+ *
+ * W2e needs SCM_MP_ASSIGN = SCM_CALL(0xc, 0x16) to hand mba/mpss from
+ * VMID_HLOS(3) to VMID_MSS_MSA(15) before it starts the Q6.  That is a
+ * SECOND TrustZone gate, separate from the AP's ability to write the region
+ * (0294) and from the PAS id-5 gate that 0291/0293 found shut.  Porting QMP,
+ * RPMh, seven GCC clocks, reset and SMP2P before knowing the answer would be
+ * a lot of work for a door that may simply be locked.
+ *
+ * So this build only does the round trip: give each region to the MSS, take
+ * it back, and read a marker written beforehand.  Nothing is read or written
+ * while the MSS owns the memory - that is exactly the XPU case that parks a
+ * thread.  No MBA.MBN, no QMP, no rail vote, no clock, no reset, no Q6.
+ *
+ * The descriptor page mirrors Linux qcom_scm_assign_mem():
+ *   +0x00  uint32_t src_vmid[]
+ *   +0x40  uint64_t { address, size }
+ *   +0x80  struct { vmid, perm, ctx, ctx_size, unused } dest[]  (24 B each)
+ *   +0x200 uint64_t extra[4] = { src_size, dest_ptr, dest_size, 0 }
+ * x2 = phys+0x40, x3 = 16, x4 = phys, x5 = phys+0x200, arginfo = 0x1117.
+ */
+#define MD_VMID_HLOS		3u
+#define MD_VMID_MSS_MSA		15u
+#define MD_PERM_RW		6u
+#define MD_PERM_RWX		7u
+#define MD_MBA_SIZE		0x00200000ull
+#define MD_MPSS_REGION		0x8e400000ull
+#define MD_MPSS_SIZE		0x07800000ull
+#define MD_SCM_MP_ASSIGN	0xc16ull	/* SCM_CALL(0xc, 0x16) */
+#define MD_SCM_MP_ARGS		0x1117u		/* QCOM_SCM_ARGS(7, ...) */
+#define MD_ASSIGN_PAGE_SIZE	4096u
+
+struct md_owner {
+	uint32_t vmid, perm;
+	uint64_t ctx;
+	uint32_t ctx_size, unused;
+};
+
+static uint8_t md_assign_page[MD_ASSIGN_PAGE_SIZE] __attribute__((aligned(4096)));
+
+static bool
+md_assign_owners(const char *name, uint64_t address, uint64_t size,
+    uint64_t *current, uint64_t next)
+{
+	uint32_t *src;
+	uint64_t *region, *extra, phys;
+	struct md_owner *dest;
+	unsigned sources = 0, dests = 0, i;
+	uint64_t res[3];
+	int64_t rc;
+
+	if (next == *current) {
+		return true;
+	}
+	/* no memset dependency: this file has no <string.h> */
+	for (i = 0; i < sizeof(md_assign_page); i++) {
+		md_assign_page[i] = 0;
+	}
+	src = (uint32_t *)(void *)md_assign_page;
+	region = (uint64_t *)(void *)(md_assign_page + 0x40);
+	dest = (struct md_owner *)(void *)(md_assign_page + 0x80);
+	extra = (uint64_t *)(void *)(md_assign_page + 0x200);
+	for (unsigned b = 0; b < 64; b++) {
+		if (*current & (1ull << b)) {
+			src[sources++] = b;
+		}
+	}
+	region[0] = address;
+	region[1] = size;
+	for (unsigned b = 0; b < 64; b++) {
+		if (next & (1ull << b)) {
+			dest[dests].vmid = b;
+			dest[dests].perm = b == MD_VMID_HLOS ? MD_PERM_RWX : MD_PERM_RW;
+			dests++;
+		}
+	}
+	phys = ml_vtophys((vm_offset_t)md_assign_page);
+	if (phys == 0) {
+		MD_SAY("POLARIS MODEM:   no physical address for the assign page; "
+		    "no SMC sent\n");
+		return false;
+	}
+	extra[0] = (uint64_t)sources * 4;
+	extra[1] = phys + 0x80;
+	extra[2] = (uint64_t)dests * sizeof(*dest);
+	extra[3] = 0;
+	/* TZ reads this page through the physical address, not our caches. */
+	for (vm_offset_t line = (vm_offset_t)md_assign_page;
+	    line < (vm_offset_t)md_assign_page + sizeof(md_assign_page); line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	MD_SAY("POLARIS MODEM:   %s %#llx..%#llx: owners %#llx -> %#llx "
+	    "(page PA %#llx, src %u, dest %u)\n", name, address, address + size,
+	    *current, next, (unsigned long long)phys, sources, dests);
+	res[0] = res[1] = res[2] = ~0ull;
+	rc = md_scm_call4(MD_SCM_64 | MD_SCM_SIP | MD_SCM_MP_ASSIGN,
+	    MD_SCM_MP_ARGS, phys + 0x40, 16, phys, phys + 0x200, res);
+	MD_SAY("POLARIS MODEM:   MP_ASSIGN(%s) rc %lld answer %#llx %#llx %#llx\n",
+	    name, rc, res[0], res[1], res[2]);
+	if (rc != 0 || res[0] != 0) {
+		MD_SAY("POLARIS MODEM:   MP_ASSIGN of %s FAILED: the owners stay "
+		    "%#llx\n", name, *current);
+		return false;
+	}
+	*current = next;
+	return true;
+}
+
+static bool
+md_assign_mem(const char *name, uint64_t address, uint64_t size,
+    uint64_t *current, bool local, bool remote)
+{
+	return md_assign_owners(name, address, size, current,
+	    (local ? 1ull << MD_VMID_HLOS : 0) |
+	    (remote ? 1ull << MD_VMID_MSS_MSA : 0));
+}
+
+static void
+md_mp_assign_probe(void)
+{
+	vm_offset_t va;
+	volatile uint32_t *p;
+	uint32_t before, after;
+	uint64_t mba_owners = 1ull << MD_VMID_HLOS;
+	uint64_t mpss_owners = 1ull << MD_VMID_HLOS;
+	bool ok = true, stuck = false;
+
+	MD_SAY("POLARIS MODEM: ======== build 0295 alive: does TZ allow "
+	    "MP_ASSIGN (dipper W2d round trip)? ========\n");
+	va = ml_io_map((vm_offset_t)MD_MBA_REGION, MD_MBA_PROBE_SIZE);
+	if (va == 0) {
+		MD_SAY("POLARIS MODEM:   mba_region did not map; no SMC attempted\n");
+		return;
+	}
+	p = (volatile uint32_t *)(void *)va;
+	before = *p;
+	*p = 0x4d424131u;			/* "MBA1", dipper's W2d marker */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	after = *p;
+	MD_SAY("POLARIS MODEM:   mba marker wrote %#x, read %#x\n",
+	    0x4d424131u, after);
+	if (after != 0x4d424131u) {
+		MD_SAY("POLARIS MODEM:   the AP still cannot write the MBA "
+		    "region: no SMC attempted\n");
+		return;
+	}
+	/* mba: HLOS -> MSS -> HLOS */
+	if (md_assign_mem("mba", MD_MBA_REGION, MD_MBA_SIZE, &mba_owners, false, true)) {
+		if (!md_assign_mem("mba", MD_MBA_REGION, MD_MBA_SIZE, &mba_owners, true, false) &&
+		    !md_assign_mem("mba", MD_MBA_REGION, MD_MBA_SIZE, &mba_owners, true, false)) {
+			stuck = true;
+		}
+	} else {
+		ok = false;
+	}
+	if (!stuck && ok) {
+		MD_SAY("POLARIS MODEM:   back with the kernel, the MBA marker "
+		    "reads %#x\n", *p);
+		/* mpss: HLOS -> HLOS+MSS -> MSS -> HLOS (two source VMIDs) */
+		if (md_assign_mem("mpss", MD_MPSS_REGION, MD_MPSS_SIZE, &mpss_owners, true, true) &&
+		    md_assign_mem("mpss", MD_MPSS_REGION, MD_MPSS_SIZE, &mpss_owners, false, true)) {
+			if (!md_assign_mem("mpss", MD_MPSS_REGION, MD_MPSS_SIZE, &mpss_owners, true, false) &&
+			    !md_assign_mem("mpss", MD_MPSS_REGION, MD_MPSS_SIZE, &mpss_owners, true, false)) {
+				stuck = true;
+			}
+		} else {
+			ok = false;
+			if (mpss_owners != (1ull << MD_VMID_HLOS) &&
+			    !md_assign_mem("mpss", MD_MPSS_REGION, MD_MPSS_SIZE, &mpss_owners, true, false)) {
+				stuck = true;
+			}
+		}
+	}
+	/* only touch the region again if we definitely own it */
+	if (!stuck) {
+		*p = before;
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	MD_SAY("POLARIS MODEM:   final owners: mba %#llx, mpss %#llx\n",
+	    mba_owners, mpss_owners);
+	MD_SAY("POLARIS MODEM: phase L done: no MBA copy, no QMP, no clock, "
+	    "no reset, no Q6 start, no SMP2P\n");
+	MD_SAY("POLARIS MODEM: 0295 VERDICT: %s\n",
+	    stuck ? "A REGION IS STILL THE MODEM'S: DO NOT TOUCH IT, RESET THE PHONE"
+	    : ok ? "MP_ASSIGN ACCEPTED: both regions went to the MSS and came back"
+	    : "MP_ASSIGN REFUSED: TZ will not hand the memory to the MSS");
+}
+
+static void
+md_mp_assign_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	md_mp_assign_probe();
+	MD_SAY("POLARIS MODEM: the mp_assign thread returned\n");
+}
+
+/*
  * Level 2 stops after the GCC block: every register there belongs to a
  * controller that is never powered down, and the GPU probe already read five of
  * them in this same boot, so that phase is the one that cannot hurt.
