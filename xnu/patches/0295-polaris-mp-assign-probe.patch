+/*
+ * 0295: SCM_MP_ASSIGN takes seven arguments.  Qualcomm puts the first three
+ * in x2..x4 and the remaining four in a physical buffer whose address goes
+ * in x5 - so the old three-argument helper cannot express this call at all.
+ */
+static int64_t
+md_scm_call4(uint64_t function, uint64_t arginfo, uint64_t a0, uint64_t a1,
+    uint64_t a2, uint64_t a3, uint64_t res[3])
+{
+	uint64_t session = 0;
+
+	for (unsigned i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i ? 1 : function;
+		register uint64_t x1 __asm__("x1") = arginfo;
+		register uint64_t x2 __asm__("x2") = a0;
+		register uint64_t x3 __asm__("x3") = a1;
+		register uint64_t x4 __asm__("x4") = a2;
+		register uint64_t x5 __asm__("x5") = a3;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4),
+		    "+r" (x5), "+r" (x6), "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14",
+		    "x15", "x16", "x17", "memory", "cc");
+		session = x6;
+		if (x0 != 1) {
+			res[0] = x1;
+			res[1] = x2;
+			res[2] = x3;
+			return (int32_t)x0;
+		}
+	}
+	return -1000;
+}
