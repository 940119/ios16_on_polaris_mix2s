+/*
+ * 0239: a picture on demand.
+ *
+ * The thumbnail above is printed twice a minute, which is the right rate for
+ * watching a boot and the wrong rate for watching a gesture: by the time it
+ * fires, the screen has moved on. This lets the touch driver ask for one and
+ * have it taken a few frames later, so the ring holds the screen as it was
+ * shortly after a swipe - which is the difference between "the compositor never
+ * drew the unlock" and "the unlock happened and the picture is the home screen".
+ *
+ * The countdown runs in vsyncFired rather than in a timer of its own because the
+ * frame being asked about is the one the panel is scanning out, and this is the
+ * only place that knows when that changes.
+ */
+static volatile int sweet_fb_dump_in;
+
+extern "C" void
+sweet_fb_dump_request(int frames)
+{
+	sweet_fb_dump_in = frames > 0 ? frames : 1;
+}
