+void
+polaris_gpu_unmap(uint64_t iova, uint64_t size)
+{
+	for (uint64_t off = 0; off < size; off += PG_GMU_PAGE_SIZE) {
+		uint64_t at = iova + off;
+		uint64_t *l3 = (uint64_t *)pg_smmu_l3(at);
+
+		if (l3 != NULL) {
+			l3[(at >> 12) & 0x1ff] = 0;
+		}
+	}
 }
 
