+/*
+ * One 4 KB page of a program's buffer into the user window. The address has to
+ * be one polaris_gpu_address() gave out: anything else would rewrite another
+ * window's descriptors, which is exactly what pg_smmu_l3() exists to prevent.
+ *
+ * read_only is not honoured yet - every page here gets the same attributes,
+ * the ones the CP's own buffers use. The SMMU on this block does have a
+ * read-only attribute, but nothing has yet proved which bit of it the A630
+ * honours, and guessing would only turn a wrong write into a silent one.
+ */
+bool
+polaris_gpu_map(uint64_t iova, uint64_t pa, bool read_only)
+{
+	uint64_t *l3;
+
+	(void)read_only;
+	if (iova < PG_USER_IOVA || iova >= PG_USER_IOVA + PG_USER_SIZE) {
+		return false;
+	}
+	l3 = (uint64_t *)pg_smmu_l3(iova);
+	if (l3 == NULL) {
+		return false;
+	}
+	l3[(iova >> 12) & 0x1ff] = (pa & PG_PTE_ADDR) | PG_PTE_ATTR | PG_PTE_PAGE;
+	return true;
+}
+
+/*
+ * One 4 KB page anywhere in the CP's window.
+ *
+ * polaris_gpu_map() refuses addresses outside the program's span because a
+ * client has no business rewriting another window's descriptors. The check in
+ * this file is not a client: it has to enter one physical page at several
+ * addresses, including the panel's, and it can only do that by writing those
+ * descriptors itself. The guard that remains is the window's own extent.
+ */
+bool
+polaris_gpu_map_at(uint64_t iova, uint64_t pa)
+{
+	uint64_t *l3;
+
+	if (iova < PG_CP_SQE_IOVA ||
+	    iova + PG_GMU_PAGE_SIZE >
+	    PG_CP_SQE_IOVA + (uint64_t)PG_CP_WINDOW_L2S * 0x200000ull) {
+		return false;
+	}
+	l3 = (uint64_t *)pg_smmu_l3(iova);
+	if (l3 == NULL) {
+		return false;
+	}
+	l3[(iova >> 12) & 0x1ff] = (pa & PG_PTE_ADDR) | PG_PTE_ATTR | PG_PTE_PAGE;
+	return true;
+}
+
+/*
+ * The descriptors are written; make the SMMU read them. One flush for a whole
+ * buffer, not one a page: 64 pages of descriptors are 512 bytes in one level 3
+ * page, and a dc civac each would be 64 of them for the same cache lines.
+ */
+void
+polaris_gpu_mapped(void)
+{
+	for (unsigned i = 0; i < PG_CP_WINDOW_L2S; i++) {
+		pg_to_memory(pg_l3b_va + (vm_offset_t)i * PG_GMU_PAGE_SIZE, PG_GMU_PAGE_SIZE);
+	}
+}
+
+void
+polaris_gpu_unmap(uint64_t iova, uint64_t size)
+{
+	for (uint64_t off = 0; off < size; off += PG_GMU_PAGE_SIZE) {
+		uint64_t at = iova + off;
+		uint64_t *l3 = (uint64_t *)pg_smmu_l3(at);
+
+		if (l3 != NULL) {
+			l3[(at >> 12) & 0x1ff] = 0;
+		}
+	}
+}
