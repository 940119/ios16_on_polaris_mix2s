+/* ---- the CP at an address the caller chose, for the service's own test ---------------------------- */
+
+#define PG_FILL_CHUNK	1024u		/* what step 17 uses: 1024 dwords in one CP_MEM_WRITE */
+#define PG_FILL_WORD	0xa5a5a5a5u
+
+/*
+ * Fill `words` dwords at `iova` through the CP and wait for the ring to drain.
+ *
+ * This is step 17's packet at an address the caller chose, and it exists for
+ * one reason: to prove that a buffer the program owns is really reachable by
+ * the GPU before anything is built on it. A descriptor the CPU reads back as
+ * correct proves nothing - build 0160 wrote exactly the right descriptors and
+ * the first write past the fifth table was still a translation fault, because
+ * what the code did with kvtophys() was not what it said.
+ */
+static bool
+pg_fill_span(uint64_t iova, uint32_t words)
+{
+	uint32_t wptr = pg_cp_wptr;
+	uint32_t sent = 0;
+	uint32_t rptr = 0;
+
+	while (sent < words) {
+		uint32_t n = words - sent < PG_FILL_CHUNK ? words - sent : PG_FILL_CHUNK;
+		uint64_t addr = iova + 4ull * sent;
+
+		pg_ring_put(wptr++, pg_pkt7(PG_CP_MEM_WRITE, n + 2u));
+		pg_ring_put(wptr++, (uint32_t)addr);
+		pg_ring_put(wptr++, (uint32_t)(addr >> 32));
+		for (uint32_t i = 0; i < n; i++) {
+			pg_ring_put(wptr++, PG_FILL_WORD);
+		}
+		sent += n;
+		wptr &= PG_RING_WORDS - 1u;
+	}
+	pg_ring_flush();
+	pg_wr(pg_gpu3d + 4u * PG_CP_RB_WPTR, wptr);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t i = 0; i < 20000; i++) {
+		rptr = pg_rd(pg_gpu3d + 4u * PG_CP_RB_RPTR) & (PG_RING_WORDS - 1u);
+		if (rptr == wptr) {
+			pg_cp_wptr = wptr;
+			return true;
+		}
+		pg_sleep_us(100);
+	}
+	printf("POLARIS GPU: 19 the CP did not drain the fill: RPTR %u WPTR %u\n", rptr, wptr);
+	return false;
+}
+
+bool
+polaris_gpu_fill(uint64_t iova, uint32_t words)
+{
+	if (pg_gpu3d == 0 || pg_ring_va[0] == 0 || words == 0 ||
+	    iova < PG_USER_IOVA || iova + 4ull * words > PG_USER_IOVA + PG_USER_SIZE) {
+		return false;
+	}
+	return pg_fill_span(iova, words);
+}
+
+/*
+ * The same fill, one packet per write-pointer update.
+ *
+ * Step 18 has written the panel on every build since 0162 and this function has
+ * never written anything, and the difference between them was taken to be the
+ * address. It is not, or not only: step 18 hands the CP PG_DRAW_PER_BATCH
+ * packets and then waits for RPTR to catch up before handing it the next batch,
+ * while this function builds all sixteen chunks first and updates the write
+ * pointer once. Sixteen chunks of 1027 dwords is 16432 dwords, which is more
+ * than the 16384-dword ring: that single burst wraps. Step 18's batches never
+ * do.
+ *
+ * So this is step 18's discipline at the address that has always failed. Same
+ * packet, same window, same pages - only the number of write-pointer updates
+ * changes.
+ */
+static bool
+pg_fill_one(uint64_t iova, uint32_t words)
+{
+	uint32_t wptr = pg_cp_wptr;
+	uint32_t rptr = 0;
+
+	pg_ring_put(wptr++, pg_pkt7(PG_CP_MEM_WRITE, words + 2u));
+	pg_ring_put(wptr++, (uint32_t)iova);
+	pg_ring_put(wptr++, (uint32_t)(iova >> 32));
+	for (uint32_t i = 0; i < words; i++) {
+		pg_ring_put(wptr++, PG_FILL_WORD);
+	}
+	wptr &= PG_RING_WORDS - 1u;
+	pg_ring_flush();
+	pg_wr(pg_gpu3d + 4u * PG_CP_RB_WPTR, wptr);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t i = 0; i < 20000; i++) {
+		rptr = pg_rd(pg_gpu3d + 4u * PG_CP_RB_RPTR) & (PG_RING_WORDS - 1u);
+		if (rptr == wptr) {
+			pg_cp_wptr = wptr;
+			return true;
+		}
+		pg_sleep_us(100);
+	}
+	printf("POLARIS GPU: 19 the CP did not drain the chunk at %#llx: RPTR %u WPTR %u\n",
+	    iova, rptr, wptr);
+	return false;
+}
+
+static bool
+pg_fill_batched(uint64_t iova, uint32_t words)
+{
+	uint32_t sent = 0;
+
+	while (sent < words) {
+		uint32_t n = words - sent < PG_FILL_CHUNK ? words - sent : PG_FILL_CHUNK;
+
+		if (!pg_fill_one(iova + 4ull * sent, n)) {
+			return false;
+		}
+		sent += n;
+	}
+	return true;
+}
