+/* ---- the program's buffers: addresses in the user window, and their mappings ---------------------- */
+
+/*
+ * A first-fit allocator over PG_USER_IOVA, with the free spans kept sorted and
+ * merged, so that a program that makes and gives back buffers of the same size
+ * (Mesa does: a texture per frame of an animation) gets the same address back
+ * rather than a new one each time.
+ *
+ * No lock here: the IOKit service takes its own around every call that reaches
+ * this, the way hakios.gpu.cpp keeps gGPULock around hakios_gpu_address().
+ */
+struct pg_addr_span {
+	uint64_t base, size;
+};
+
+static struct pg_addr_span pg_addr_free[PG_ADDR_SLOTS] = {
+	{ PG_USER_IOVA, PG_USER_SIZE },
+};
+static unsigned pg_addr_count = 1;
+static uint32_t pg_addr_live;
+
+uint64_t
+polaris_gpu_address(uint64_t size)
+{
+	if (size == 0 || size > PG_USER_SIZE) {
+		return 0;
+	}
+	size = round_page((vm_size_t)size);
+	if (size > PG_USER_SIZE) {
+		return 0;
+	}
+	for (unsigned i = 0; i < pg_addr_count; i++) {
+		uint64_t base;
+
+		if (pg_addr_free[i].size < size) {
+			continue;
+		}
+		base = pg_addr_free[i].base;
+		pg_addr_free[i].base += size;
+		pg_addr_free[i].size -= size;
+		if (pg_addr_free[i].size == 0) {
+			memmove(&pg_addr_free[i], &pg_addr_free[i + 1],
+			    (pg_addr_count - i - 1) * sizeof(pg_addr_free[0]));
+			pg_addr_count--;
+		}
+		pg_addr_live++;
+		return base;
+	}
+	printf("POLARIS GPU: 19 no room for %llu bytes of GPU addresses (%u free spans)\n",
+	    size, pg_addr_count);
+	return 0;
+}
+
+void
+polaris_gpu_address_free(uint64_t base, uint64_t size)
+{
+	unsigned i = 0;
+
+	if (size == 0 || size > PG_USER_SIZE ||
+	    base < PG_USER_IOVA || base + size > PG_USER_IOVA + PG_USER_SIZE) {
+		return;
+	}
+	size = round_page((vm_size_t)size);
+	while (i < pg_addr_count && pg_addr_free[i].base < base) {
+		i++;
+	}
+	/*
+	 * A span overlapping one already free is a second free of the same
+	 * buffer. Refusing it keeps the list sorted and mergeable; without the
+	 * check a double free produces overlapping free spans and the same
+	 * address is handed to two buffers, which the GPU then writes twice.
+	 */
+	if ((i > 0 && pg_addr_free[i - 1].base + pg_addr_free[i - 1].size > base) ||
+	    (i < pg_addr_count && base + size > pg_addr_free[i].base)) {
+		printf("POLARIS GPU: 19 %#llx+%llu is given back and overlaps a free span; refused\n",
+		    base, size);
+		return;
+	}
+	if (pg_addr_count >= PG_ADDR_SLOTS) {
+		printf("POLARIS GPU: 19 the address table is full; %#llx+%llu leaks\n", base, size);
+		return;
+	}
+	memmove(&pg_addr_free[i + 1], &pg_addr_free[i],
+	    (pg_addr_count - i) * sizeof(pg_addr_free[0]));
+	pg_addr_free[i].base = base;
+	pg_addr_free[i].size = size;
+	pg_addr_count++;
+	if (i + 1 < pg_addr_count &&
+	    pg_addr_free[i].base + pg_addr_free[i].size == pg_addr_free[i + 1].base) {
+		pg_addr_free[i].size += pg_addr_free[i + 1].size;
+		memmove(&pg_addr_free[i + 1], &pg_addr_free[i + 2],
+		    (pg_addr_count - i - 2) * sizeof(pg_addr_free[0]));
+		pg_addr_count--;
+	}
+	if (i > 0 && pg_addr_free[i - 1].base + pg_addr_free[i - 1].size == pg_addr_free[i].base) {
+		pg_addr_free[i - 1].size += pg_addr_free[i].size;
+		memmove(&pg_addr_free[i], &pg_addr_free[i + 1],
+		    (pg_addr_count - i - 1) * sizeof(pg_addr_free[0]));
+		pg_addr_count--;
+	}
+	if (pg_addr_live > 0) {
+		pg_addr_live--;
+	}
+}
