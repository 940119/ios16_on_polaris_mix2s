+	(void)read_only;
+	if (iova < PG_USER_IOVA || iova >= PG_USER_IOVA + PG_USER_SIZE) {
+		return false;
+	}
+	l3 = (uint64_t *)pg_smmu_l3(iova);
+	if (l3 == NULL) {
+		return false;
+	}
