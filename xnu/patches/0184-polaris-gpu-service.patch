+		return false;
+	}
+	l3 = (uint64_t *)pg_smmu_l3(iova);
+	if (l3 == NULL) {
+		return false;
+	}
+	l3[(iova >> 12) & 0x1ff] = (pa & PG_PTE_ADDR) | PG_PTE_ATTR | PG_PTE_PAGE;
+	return true;
+}
