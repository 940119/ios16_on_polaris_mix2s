+		uint64_t pi = PG_PANEL_IOVA;
+		uint64_t *pl3 = (uint64_t *)pg_smmu_l3(pi);
+		uint64_t pp = pl3 != NULL ? pl3[(pi >> 12) & 0x1ff] : 0;
+
+		printf("POLARIS GPU: 19 window panel %#llx: pte %#llx (attr %#llx) "
+		    "MAIR0 %#010x; the window's attr %#llx\n", pi, pp, pp & 0xeefull,
+		    pg_rd(cb + PG_CB_MAIR0),
+		    (l3 != NULL ? l3[slot] : 0) & 0xeeull);
+	}
+}
+/* ---- one packet, two windows, one variable at a time --------------------------------------------- */
+
+/*
+ * Everything about the client test that has failed since 0187 is the same on
+ * every build: the ring drains, the CP reports no fault, the descriptor reads
+ * back as a valid page with attribute index 0, the page tables are the ones the
+ * walk reaches, and the buffer comes back untouched. The panel, driven by the
+ * same CP with the same packet and a descriptor of the same form, is written
+ * and read back by the CPU. Two things differ between the two cases, and every
+ * build so far has varied them together:
+ *
+ *     physical address   0x103aac000, above 4 GB      against 0x9d400000
+ *     window             PG_USER_IOVA, entry 6        against PG_PANEL_IOVA
+ *
+ * So change one at a time, from a known-good starting point in each direction:
+ *
+ *   A  the panel's own first pages, at the address the CPU reads as pixels,
+ *      entered into the program's window. Same physical page the CP demonstrably
+ *      writes, different window. If this fills, the program's window is sound
+ *      and the window is not the variable.
+ *
+ *   B  the client's pages, at the address the client was given, entered into
+ *      the panel's window. Same physical pages that come back untouched,
+ *      different window. If this fills, the panel's window reaches memory above
+ *      4 GB and the address is not the variable.
+ *
+ * A filling and B not names the address. B filling and A not names the window.
+ * Neither filling means the difference is somewhere else again, and the fault
+ * record printed after each run says whether the SMMU saw the write at all.
+ *
+ * A writes 0xa5a5a5a5 over the top sixteen rows of the panel, which is visible
+ * on purpose: a grey band across the top of the screen is the same fact as the
+ * count below it, and the desktop repaints over it.
+ */
+#define PG_PA_PAGES	16u		/* 64 KB, the size the client test asks for */
+#define PG_PA_SENTINEL	0xdeadbeefu
+
+static uint32_t
+pg_pa_count(volatile uint32_t *words, uint64_t n, uint32_t *wrongp)
+{
+	uint32_t changed = 0, wrong = 0;
+
+	for (uint64_t i = 0; i < n; i++) {
+		uint32_t v = words[i];
+
+		if (v != PG_PA_SENTINEL) {
+			changed++;
+			if (v != PG_FILL_WORD) {
+				wrong++;
+			}
+		}
+	}
+	*wrongp = wrong;
+	return changed;
+}
+
+void
+polaris_gpu_pa_test(const uint64_t *pas, uint32_t pages, uint64_t bytes,
+    volatile uint32_t *cpu)
+{
+	uint64_t words, second;
+	uint64_t saved[PG_PA_PAGES];
+	uint64_t *pl3;
+	vm_offset_t view;
+	uint32_t changed, wrong, first;
+	bool filled, mapped;
+
+	if (pas == NULL || cpu == NULL || pages == 0 || pages > PG_PA_PAGES ||
+	    bytes != (uint64_t)pages * (uint64_t)PG_GMU_PAGE_SIZE) {
+		printf("POLARIS GPU: 19 pa test: %u pages and %llu bytes do not agree\n",
+		    pages, bytes);
+		return;
+	}
+	words = bytes / 4ull;
+
+	/*
+	 * A. The panel's first pages, at the address step 18 writes them to, in
+	 * the window the client's buffer lives in.
+	 */
+	if (pg_panel_phys == 0) {
+		printf("POLARIS GPU: 19 pa test A: no panel address to borrow\n");
+	} else if ((view = ml_io_map((vm_offset_t)pg_panel_phys, (vm_size_t)bytes)) == 0) {
+		printf("POLARIS GPU: 19 pa test A: the panel has no CPU view\n");
+	} else if ((second = polaris_gpu_address(bytes)) == 0) {
+		printf("POLARIS GPU: 19 pa test A: no second address in the program's window\n");
+	} else {
+		mapped = true;
+		for (uint32_t i = 0; i < pages && mapped; i++) {
+			mapped = polaris_gpu_map(second + (uint64_t)i * PG_GMU_PAGE_SIZE,
+			    pg_panel_phys + (uint64_t)i * PG_GMU_PAGE_SIZE, false);
+		}
+		polaris_gpu_mapped();
+		for (uint64_t i = 0; i < words; i++) {
+			((volatile uint32_t *)view)[i] = PG_PA_SENTINEL;
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		polaris_gpu_window_sync();
+		printf("POLARIS GPU: 19 pa test A: physical %#llx, the panel's own first %llu "
+		    "bytes, through the program's iova %#llx\n", pg_panel_phys, bytes, second);
+		if (!mapped) {
+			printf("POLARIS GPU: 19 pa test A: the window would not take it\n");
+		} else {
+			filled = polaris_gpu_fill_batched(second, (uint32_t)words);
+			polaris_gpu_window_report(second);
+			changed = pg_pa_count((volatile uint32_t *)view, words, &wrong);
+			printf("POLARIS GPU: 19 pa test A: the CP %s; %u of %llu words changed, "
+			    "%u of those are not 0xa5a5a5a5: %s\n",
+			    filled ? "drained" : "did NOT drain", changed, words, wrong,
+			    (filled && changed == words && wrong == 0) ?
+			    "THE PROGRAM'S WINDOW REACHES THE PANEL" :
+			    (changed > 0 ?
+			    "the panel changed but not to what the fill was told to write" :
+			    "the program's window does not reach the panel either"));
+		}
+		polaris_gpu_unmap(second, bytes);
+		polaris_gpu_mapped();
+		polaris_gpu_address_free(second, bytes);
+	}
+
+	/*
+	 * B. The client's pages, at the address the client was given, in the
+	 * window step 18 fills the panel through. The panel's descriptors are
+	 * saved and put back afterwards so the display's mapping survives the
+	 * test.
+	 */
+	pl3 = (uint64_t *)pg_smmu_l3(PG_PANEL_IOVA);
+	if (pl3 == NULL ||
+	    pg_smmu_l3(PG_PANEL_IOVA) !=
+	    pg_smmu_l3(PG_PANEL_IOVA + (uint64_t)(pages - 1u) * PG_GMU_PAGE_SIZE)) {
+		printf("POLARIS GPU: 19 pa test B: the panel window has no table to borrow\n");
+		return;
+	}
+	first = (uint32_t)((PG_PANEL_IOVA >> 12) & 0x1ff);
+	for (uint32_t i = 0; i < pages; i++) {
+		saved[i] = pl3[first + i];
+	}
+	mapped = true;
+	for (uint32_t i = 0; i < pages && mapped; i++) {
+		mapped = polaris_gpu_map_at(PG_PANEL_IOVA + (uint64_t)i * PG_GMU_PAGE_SIZE,
+		    pas[i]);
+	}
+	polaris_gpu_mapped();
+	for (uint64_t i = 0; i < words; i++) {
+		cpu[i] = PG_PA_SENTINEL;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	polaris_gpu_window_sync();
+	printf("POLARIS GPU: 19 pa test B: physical %#llx..%#llx, the client's own pages, "
+	    "through the panel's iova %#llx\n", pas[0],
+	    pas[pages - 1u] + PG_GMU_PAGE_SIZE - 1u, PG_PANEL_IOVA);
+	if (!mapped) {
+		printf("POLARIS GPU: 19 pa test B: the window would not take it\n");
+	} else {
+		filled = polaris_gpu_fill_window_batched(PG_PANEL_IOVA, (uint32_t)words);
+		polaris_gpu_window_report(PG_PANEL_IOVA);
+		changed = pg_pa_count(cpu, words, &wrong);
+		printf("POLARIS GPU: 19 pa test B: the CP %s; %u of %llu words changed, "
+		    "%u of those are not 0xa5a5a5a5: %s\n",
+		    filled ? "drained" : "did NOT drain", changed, words, wrong,
+		    (filled && changed == words && wrong == 0) ?
+		    "THE PANEL'S WINDOW REACHES MEMORY ABOVE 4 GB" :
+		    (changed > 0 ?
+		    "these pages changed but not to what the fill was told to write" :
+		    "the panel's window does not reach these pages either"));
+	}
+	for (uint32_t i = 0; i < pages; i++) {
+		pl3[first + i] = saved[i];
+	}
+	polaris_gpu_mapped();
+	polaris_gpu_window_sync();
+}
+
+/* ---- the same packet at an address below 4 GB, out of a reserved region ---------------------------- */
+
+/*
+ * 0194 finally separated the two variables, on a ring that was not wedged:
+ *
+ *   the panel's own pages, 0x9d400000, through the program's window
+ *       16384 of 16384 words changed, all 0xa5a5a5a5
+ *   the client's pages, 0x103ab4000, through the same window
+ *       2176 of 16384 words changed, in a run from word 1616 to 16383
+ *   the client's pages, through the panel's window
+ *       0 of 16384 words changed
+ *
+ * Same packet, same window, same page tables, same context bank; the address is
+ * the only difference left, and below 4 GB the fill is complete.
+ *
+ * Getting memory there is the problem. 0191 asked
+ * IOBufferMemoryDescriptor::inTaskWithPhysicalMask and the mask was ignored.
+ * 0195 asked kmem_alloc_contig with KMA_LOMEM - the flag the comment on
+ * pg_gmu_region() says starts the scan at page zero - and the allocator answered
+ * "nothing below 4 GB" on the first page. The GMU's own pages do not come from
+ * the allocator either; step 10 falls back to a reserved region for them. So the
+ * allocator is not the way.
+ *
+ * The device tree is. Three regions below 4 GB are reserved and dead:
+ *
+ *   ips_fw_region@0x8c400000       64 KB   the firmware's, avoid
+ *   cont_splash_region@0x9d400000  36 MB   the panel's, nine megabytes in use
+ *   ramdump_fb_region@0xaf000000   16 MB   written only by the crash dump
+ *
+ * The ramdump framebuffer is the one with nothing in it: sixteen pages from its
+ * start, each entered into the program's window at its own address, each read
+ * back on its own, the same packet as everywhere else. One verdict per page,
+ * because "one of sixteen" and "none of sixteen" are different faults.
+ */
+#define PG_POOL_PAGES		16u		/* 64 KB, the size the client test asks for */
+#define PG_POOL_BASE		0xaf000000ull	/* ramdump_fb_region: 16 MB, below 4 GB, dead */
+#define PG_POOL_SENTINEL	0xdeadbeefu
+
+/* ---- handing those pages out ---------------------------------------------------------------------- */
+
+/*
+ * A program's buffer has to be one of these pages, and there are only sixteen
+ * megabytes of them, so they are handed out and taken back rather than carved
+ * once: a program that makes and gives back a buffer of one size every frame
+ * would exhaust the region in seconds otherwise.
+ *
+ * First fit over a sorted, merging free list - the same shape as the address
+ * allocator at the top of this file, and for the same reason: the address a
+ * program gets back has to be the address it had, or Mesa's per-frame texture
+ * walks the window until it runs out. No lock: the user client holds gGPULock
+ * around every call that reaches this, and the boot-time test runs before a
+ * client can exist.
+ *
+ * The CPU side is one view at a time, of one buffer at a time, made by
+ * ml_io_map, which is uncached, and that part is the point: the GPU writes past
+ * the cache, so a cached view would read back whatever the CPU left there and
+ * call a working GPU broken.
+ *
+ * 0197 tried to make this cheaper by mapping the whole region once - "nothing
+ * to give back, so nothing to keep track of". The kernel's answer was
+ *
+ *   panic(cpu 8 caller 0xfffffff00797e04c): kalloc_alloc(0xffffffe100802040,
+ *         16777216, 0x8021): failed with 3 @vm_kern.c:178
+ *
+ * a sixteen megabyte kalloc and no room for one. The mapping is charged at the
+ * size asked for, so the size asked for is the buffer's.
+ *
+ * This kernel has no ml_io_unmap, so each view is a leak of the buffer's size
+ * in the kernel map. One slot is kept and reused while the same buffer is asked
+ * for again, which is the common case (zero it, fill it, read it back); a
+ * client that cycles through many buffers will leak a little per buffer, and
+ * the fix for that is an unmap or a zero written by the CP, not a bigger slot.
+ * PG_POOL_VIEW_MAX is what one view may ask for until the map's free space is
+ * measured rather than guessed.
+ */
+#define PG_POOL_SIZE		(16ull << 20)	/* ramdump_fb_region, whole */
+#define PG_POOL_SLOTS		64u
+
+struct pg_pool_span {
+	uint64_t base, size;
+};
+
+static struct pg_pool_span pg_pool_free[PG_POOL_SLOTS] = {
+	{ PG_POOL_BASE, PG_POOL_SIZE },
+};
+static unsigned pg_pool_count = 1;
+static uint64_t pg_pool_taken;
+static vm_offset_t pg_pool_window;	/* the one view this build holds */
+static uint64_t pg_pool_view_pa;
+static uint64_t pg_pool_view_bytes;
+
+uint64_t
+polaris_gpu_pool_alloc(uint64_t bytes)
+{
+	if (bytes == 0) {
+		return 0;
+	}
+	bytes = (bytes + PG_GMU_PAGE_SIZE - 1) & ~(uint64_t)(PG_GMU_PAGE_SIZE - 1);
+	for (unsigned i = 0; i < pg_pool_count; i++) {
+		uint64_t base;
+
+		if (pg_pool_free[i].size < bytes) {
+			continue;
+		}
+		base = pg_pool_free[i].base;
+		pg_pool_free[i].base += bytes;
+		pg_pool_free[i].size -= bytes;
+		if (pg_pool_free[i].size == 0) {
+			memmove(&pg_pool_free[i], &pg_pool_free[i + 1],
+			    (pg_pool_count - i - 1) * sizeof(pg_pool_free[0]));
+			pg_pool_count--;
+		}
+		pg_pool_taken += bytes;
+		return base;
+	}
+	printf("POLARIS GPU: 19 pool: no room for %llu bytes (%llu of %llu taken)\n",
+	    bytes, pg_pool_taken, (uint64_t)PG_POOL_SIZE);
+	return 0;
+}
+
+void
+polaris_gpu_pool_free(uint64_t base, uint64_t bytes)
+{
+	unsigned i = 0;
+
+	if (bytes == 0 || base < PG_POOL_BASE || base + bytes > PG_POOL_BASE + PG_POOL_SIZE) {
+		return;
+	}
+	bytes = (bytes + PG_GMU_PAGE_SIZE - 1) & ~(uint64_t)(PG_GMU_PAGE_SIZE - 1);
+	while (i < pg_pool_count && pg_pool_free[i].base < base) {
+		i++;
+	}
+	/*
+	 * Overlapping a span that is already free is a second free of the same
+	 * buffer; inserting it would hand the same page to two programs, which
+	 * the GPU would then write twice. Refuse it, the way the address
+	 * allocator above does.
+	 */
+	if ((i > 0 && pg_pool_free[i - 1].base + pg_pool_free[i - 1].size > base) ||
+	    (i < pg_pool_count && base + bytes > pg_pool_free[i].base)) {
+		printf("POLARIS GPU: 19 pool: %#llx+%llu is given back twice; refused\n", base, bytes);
+		return;
+	}
+	if (pg_pool_count >= PG_POOL_SLOTS) {
+		printf("POLARIS GPU: 19 pool: the free list is full; %#llx+%llu leaks\n", base, bytes);
+		return;
+	}
+	memmove(&pg_pool_free[i + 1], &pg_pool_free[i],
+	    (pg_pool_count - i) * sizeof(pg_pool_free[0]));
+	pg_pool_free[i].base = base;
+	pg_pool_free[i].size = bytes;
+	pg_pool_count++;
+	if (i + 1 < pg_pool_count &&
+	    pg_pool_free[i].base + pg_pool_free[i].size == pg_pool_free[i + 1].base) {
+		pg_pool_free[i].size += pg_pool_free[i + 1].size;
+		memmove(&pg_pool_free[i + 1], &pg_pool_free[i + 2],
+		    (pg_pool_count - i - 2) * sizeof(pg_pool_free[0]));
+		pg_pool_count--;
+	}
+	if (i > 0 && pg_pool_free[i - 1].base + pg_pool_free[i - 1].size == pg_pool_free[i].base) {
+		pg_pool_free[i - 1].size += pg_pool_free[i].size;
+		memmove(&pg_pool_free[i], &pg_pool_free[i + 1],
+		    (pg_pool_count - i - 1) * sizeof(pg_pool_free[0]));
+		pg_pool_count--;
+	}
+	if (pg_pool_taken >= bytes) {
+		pg_pool_taken -= bytes;
+	}
+}
+
+/*
+ * Where the CPU sees a pool buffer.
+ *
+ * One ml_io_map for the buffer, never for the region. 0197 asked for the whole
+ * sixteen megabytes once, on the reasoning that a mapping made once is a
+ * mapping that never has to be given back (this kernel has no ml_io_unmap);
+ * the kernel answered
+ *
+ *   panic: kalloc_alloc(0xffffffe100802040, 16777216, 0x8021): failed with 3
+ *
+ * - a sixteen megabyte kalloc, and there is no room for one. Whatever the
+ * mapping costs, it is charged at the size asked for, so ask for the size of
+ * the buffer. Sixteen pages of it, sixty-four kilobytes, is what 0196 mapped
+ * page by page without trouble.
+ *
+ * PG_POOL_VIEW_MAX is where that stops being safe rather than a preference: a
+ * request larger than it is refused with a line in the log instead of being
+ * handed to the allocator to panic on. Raising it needs a measurement of this
+ * kernel map's free space, not a guess.
+ */
+#define PG_POOL_VIEW_MAX	(64ull << 10)
+
+void *
+polaris_gpu_pool_view(uint64_t pa, uint64_t bytes)
+{
+	if (pa < PG_POOL_BASE || bytes == 0 || pa + bytes > PG_POOL_BASE + PG_POOL_SIZE) {
+		return NULL;
+	}
+	if (bytes > PG_POOL_VIEW_MAX) {
+		printf("POLARIS GPU: 19 pool: a view of %llu bytes is over the %llu this build "
+		    "asks the kernel map for\n", bytes, (uint64_t)PG_POOL_VIEW_MAX);
+		return NULL;
+	}
+	if (pg_pool_window != 0 && pg_pool_view_pa == pa && pg_pool_view_bytes == bytes) {
+		return (void *)pg_pool_window;
+	}
+	pg_pool_window = ml_io_map((vm_offset_t)pa, (vm_size_t)bytes);
+	if (pg_pool_window == 0) {
+		printf("POLARIS GPU: 19 pool: the pages at %#llx have no CPU view\n", pa);
+		return NULL;
+	}
+	pg_pool_view_pa = pa;
+	pg_pool_view_bytes = bytes;
+	return (void *)pg_pool_window;
+}
+
+void
+polaris_gpu_pool_test(void)
+{
+	vm_offset_t view[PG_POOL_PAGES];
+	uint64_t pa[PG_POOL_PAGES];
+	uint64_t iova, bytes = (uint64_t)PG_POOL_PAGES * (uint64_t)PG_GMU_PAGE_SIZE;
+	uint32_t have = 0, landed = 0, changed = 0, wrong = 0;
+	bool filled;
+
+	for (uint32_t i = 0; i < PG_POOL_PAGES; i++) {
+		pa[i] = PG_POOL_BASE + (uint64_t)i * PG_GMU_PAGE_SIZE;
+		view[i] = ml_io_map((vm_offset_t)pa[i], PG_GMU_PAGE_SIZE);
+		if (view[i] == 0) {
+			printf("POLARIS GPU: 19 pool: page %u at %#llx has no CPU view\n", i, pa[i]);
+			break;
+		}
+		have = i + 1u;
+	}
+	if (have == 0) {
+		printf("POLARIS GPU: 19 pool: nothing to test\n");
+		return;
+	}
+	iova = polaris_gpu_address(bytes);
+	if (iova == 0) {
+		printf("POLARIS GPU: 19 pool: no address in the program's window\n");
+		return;
+	}
+	for (uint32_t i = 0; i < have; i++) {
+		for (uint32_t w = 0; w < PG_GMU_PAGE_SIZE / 4u; w++) {
+			((volatile uint32_t *)view[i])[w] = PG_POOL_SENTINEL;
+		}
+		if (!polaris_gpu_map_at(iova + (uint64_t)i * PG_GMU_PAGE_SIZE, pa[i])) {
+			printf("POLARIS GPU: 19 pool: page %u will not enter the window\n", i);
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	polaris_gpu_mapped();
+	polaris_gpu_window_sync();
+	printf("POLARIS GPU: 19 pool: %u pages at %#llx..%#llx, out of the ramdump "
+	    "framebuffer, entered at %#llx\n", have, pa[0],
+	    pa[have - 1u] + PG_GMU_PAGE_SIZE - 1u, iova);
+	filled = polaris_gpu_fill_batched(iova, have * (PG_GMU_PAGE_SIZE / 4u));
+	polaris_gpu_window_report(iova);
+	for (uint32_t i = 0; i < have; i++) {
+		uint32_t page_changed = 0, page_wrong = 0;
+
+		for (uint32_t w = 0; w < PG_GMU_PAGE_SIZE / 4u; w++) {
+			uint32_t v = ((volatile uint32_t *)view[i])[w];
+
+			if (v != PG_POOL_SENTINEL) {
+				page_changed++;
+				if (v != PG_FILL_WORD) {
+					page_wrong++;
+				}
+			}
+		}
+		changed += page_changed;
+		wrong += page_wrong;
+		if (page_changed == PG_GMU_PAGE_SIZE / 4u && page_wrong == 0) {
+			landed++;
+		}
+		printf("POLARIS GPU: 19 pool: page %u at %#llx: %u of %u words\n", i, pa[i],
+		    page_changed, PG_GMU_PAGE_SIZE / 4u);
+	}
+	printf("POLARIS GPU: 19 pool: the CP %s; %u of %u pages took the fill, %u of %llu "
+	    "words changed, %u of those are not 0xa5a5a5a5\n",
+	    filled ? "drained" : "did NOT drain", landed, have, changed,
+	    (uint64_t)have * (PG_GMU_PAGE_SIZE / 4u), wrong);
+	printf("POLARIS GPU: 19 pool: %s\n",
+	    (filled && landed == have && wrong == 0) ?
+	    "THE GPU WRITES A POOL OF ORDINARY PAGES BELOW 4 GB" :
+	    "the reserved region below 4 GB is not written either");
+	polaris_gpu_unmap(iova, bytes);
+	polaris_gpu_mapped();
+	polaris_gpu_address_free(iova, bytes);
+}
+
+
+/* ---- step 19: a command buffer of the program's, run by address, and a fence ---------------------- */
+
+/*
+ * Everything so far has been this file writing packets into the ring itself.
+ * A program does not do that: it builds its own command buffer somewhere in its
+ * own memory and asks the kernel to have the CP run it (DRM's GEM_SUBMIT). The
+ * two packets that make that possible are the ones the Mi 8 port uses
+ * (bsd/dev/mi8_adreno.c:3010):
+ *
+ *   CP_INDIRECT_BUFFER(3)   address lo, address hi, dwords   - run that buffer
+ *   CP_EVENT_WRITE(4)       EVENT_CACHE_FLUSH_TS, addr, value - write a fence
+ *
+ * The fence is what replaces an interrupt on this port: nothing here has taken
+ * over the GPU's IRQ, so the only way to know a submission finished is to have
+ * the CP write a number into memory and read it back. That is not a shortcut -
+ * it is the same mechanism Linux's a6xx uses for its last fence.
+ *
+ * 0201 proved one submission. One is not a fence: the thing a wait depends on is
+ * that the numbers only go up, that waiting for an old one returns at once, and
+ * that waiting for one that was never submitted does not return at all. So this
+ * submits three, each with its own fill value, and then asks for an old fence
+ * and for one that does not exist.
+ */
+#define PG_SUB_DATA_WORDS	256u
+#define PG_SUB_IB_PAGE		0x0000u		/* within the four pages taken from the pool */
+#define PG_SUB_DATA_PAGE	0x1000u
+#define PG_SUB_FENCE_PAGE	0x2000u
+#define PG_SUB_BYTES		(4ull * PG_GMU_PAGE_SIZE)
+#define PG_SUB_SENTINEL		0xdeadbeefu
+
+static uint32_t pg_fence_seq;
+
+/*
+ * A command buffer: one CP_MEM_WRITE over `target`, `words` dwords of `value`.
+ * Written through a volatile pointer, word by word, because this is a device
+ * mapping where an access that is not naturally aligned faults instead of being
+ * split - and the header is three words, so the payload starts at offset twelve
+ * and clang turns a plain loop into sixteen-byte stores (0200 died on exactly
+ * that).
+ */
+static uint32_t
+pg_build_ib(volatile uint32_t *ib, uint64_t target, uint32_t words, uint32_t value)
+{
+	uint32_t at = 0;
+
+	ib[at++] = pg_pkt7(PG_CP_MEM_WRITE, words + 2u);
+	ib[at++] = (uint32_t)target;
+	ib[at++] = (uint32_t)(target >> 32);
+	for (uint32_t i = 0; i < words; i++) {
+		ib[at++] = value;
+	}
+	return at;
+}
+
+/*
+ * 0209: the same command buffer, for a submission that came in from a program.
+ *
+ * pg_build_ib() above always starts at word zero of a buffer this file owns. A
+ * program's command buffer is described by a handle and an offset, so the
+ * service needs one built at an arbitrary word - and it needs the header to be
+ * the one pg_pkt7() encodes, parity bits and all. Copying that encoding into
+ * the C++ half of the kext would be a second place to get it wrong, so it is
+ * exported instead.
+ */
+uint32_t
+polaris_gpu_build_memwrite(volatile uint32_t *ib, uint32_t at, uint64_t target,
+    uint32_t words, uint32_t value)
+{
+	ib[at++] = pg_pkt7(PG_CP_MEM_WRITE, words + 2u);
+	ib[at++] = (uint32_t)target;
+	ib[at++] = (uint32_t)(target >> 32);
+	for (uint32_t i = 0; i < words; i++) {
+		ib[at++] = value;
+	}
+	return at;
+}
+
+/* True once `*word` has reached `seq`; waits up to `tries` x 100 us for it. */
+static bool
+pg_fence_reached(volatile uint32_t *word, uint32_t seq, uint32_t tries)
+{
+	for (uint32_t i = 0; i < tries; i++) {
+		if (*word >= seq) {
+			return true;
+		}
+		pg_sleep_us(100);
+	}
+	return *word >= seq;
+}
+
+/* One submission of `ib_words` dwords at `ib_iova`, fenced at `fence_iova`. */
+static bool
+pg_submit_one(uint64_t ib_iova, uint32_t ib_words, uint64_t fence_iova, uint32_t seq)
+{
+	uint32_t wptr = pg_cp_wptr, rptr = 0;
+
+	pg_ring_put(wptr++, pg_pkt7(0x3fu, 3u));		/* CP_INDIRECT_BUFFER */
+	pg_ring_put(wptr++, (uint32_t)ib_iova);
+	pg_ring_put(wptr++, (uint32_t)(ib_iova >> 32));
+	pg_ring_put(wptr++, ib_words);
+	pg_ring_put(wptr++, pg_pkt7(0x46u, 4u));		/* CP_EVENT_WRITE */
+	pg_ring_put(wptr++, 0x04u);				/* EVENT_CACHE_FLUSH_TS */
+	pg_ring_put(wptr++, (uint32_t)fence_iova);
+	pg_ring_put(wptr++, (uint32_t)(fence_iova >> 32));
+	pg_ring_put(wptr++, seq);
+	wptr &= PG_RING_WORDS - 1u;
+	pg_ring_flush();
+	pg_wr(pg_gpu3d + 4u * PG_CP_RB_WPTR, wptr);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t i = 0; i < 20000; i++) {
+		rptr = pg_rd(pg_gpu3d + 4u * PG_CP_RB_RPTR) & (PG_RING_WORDS - 1u);
+		if (rptr == wptr) {
+			pg_cp_wptr = wptr;
+			return true;
+		}
+		pg_sleep_us(100);
+	}
+	printf("POLARIS GPU: 19 submit: the CP did not take seq %u: RPTR %u WPTR %u\n", seq, rptr, wptr);
+	return false;
+}
+
+/*
+ * Where the CP is, for the day something hangs.
+ *
+ * IB1/IB2 and their remaining counts are the Mi 8 port's report
+ * (mi8_adreno.c:3067) and the cheapest way to tell "the CP never took the
+ * buffer" from "the CP is inside it at word N". RBBM_STATUS bit 0 is the core
+ * being busy; the status register also carries the hang interrupt, which no
+ * build has seen yet.
+ */
+void
+polaris_gpu_cp_report(const char *why)
+{
+	uint64_t ib1, ib2;
+	uint32_t rem1, rem2;
+
+	if (pg_gpu3d == 0) {
+		return;
+	}
+	ib1 = ((uint64_t)pg_rd(pg_gpu3d + 4u * 0x0929) << 32) | pg_rd(pg_gpu3d + 4u * 0x0928);
+	rem1 = pg_rd(pg_gpu3d + 4u * 0x092a);
+	ib2 = ((uint64_t)pg_rd(pg_gpu3d + 4u * 0x092c) << 32) | pg_rd(pg_gpu3d + 4u * 0x092b);
+	rem2 = pg_rd(pg_gpu3d + 4u * 0x092d);
+	printf("POLARIS GPU: 19 cp: %s: IB1 %#llx remaining %u, IB2 %#llx remaining %u; "
+	    "RBBM_STATUS %#010x INT_0 %#010x; RPTR %u WPTR %u\n", why, ib1, rem1, ib2, rem2,
+	    pg_rd(pg_gpu3d + 4u * 0x0210), pg_rd(pg_gpu3d + 4u * 0x0201),
+	    pg_rd(pg_gpu3d + 4u * PG_CP_RB_RPTR) & (PG_RING_WORDS - 1u),
+	    pg_rd(pg_gpu3d + 4u * PG_CP_RB_WPTR));
+}
+
+void
+polaris_gpu_submit_test(void)
+{
+	static const uint32_t fills[3] = { 0x5a5a5a5au, 0x5b5b5b5bu, 0x5c5c5c5cu };
+	uint64_t pa, iova, bytes = PG_SUB_BYTES;
+	uint8_t *view;
+	volatile uint32_t *ib, *target, *fence;
+	uint32_t ib_words, seq, last = 0, wrote, i;
+	uint32_t passed = 0;
+	bool took, timed_out_as_it_should = false;
+
+	if (pg_gpu3d == 0 || pg_ring_va[0] == 0) {
+		printf("POLARIS GPU: 19 submit: the CP is not there\n");
+		return;
+	}
+	pa = polaris_gpu_pool_alloc(bytes);
+	if (pa == 0) {
+		return;
+	}
+	view = (uint8_t *)polaris_gpu_pool_view(pa, bytes);
+	if (view == NULL) {
+		polaris_gpu_pool_free(pa, bytes);
+		return;
+	}
+	iova = polaris_gpu_address(bytes);
+	if (iova == 0) {
+		polaris_gpu_pool_free(pa, bytes);
+		return;
+	}
+	for (i = 0; i < 4; i++) {
+		if (!polaris_gpu_map(iova + (uint64_t)i * PG_GMU_PAGE_SIZE,
+		    pa + (uint64_t)i * PG_GMU_PAGE_SIZE, false)) {
+			printf("POLARIS GPU: 19 submit: page %u will not enter the window\n", i);
+			polaris_gpu_address_free(iova, bytes);
+			polaris_gpu_pool_free(pa, bytes);
+			return;
+		}
+	}
+	polaris_gpu_mapped();
+
+	ib = (volatile uint32_t *)(view + PG_SUB_IB_PAGE);
+	target = (volatile uint32_t *)(view + PG_SUB_DATA_PAGE);
+	fence = (volatile uint32_t *)(view + PG_SUB_FENCE_PAGE);
+
+	for (uint32_t k = 0; k < 3u; k++) {
+		for (i = 0; i < PG_SUB_DATA_WORDS; i++) {
+			target[i] = PG_SUB_SENTINEL;
+		}
+		*fence = 0;
+		ib_words = pg_build_ib(ib, iova + PG_SUB_DATA_PAGE, PG_SUB_DATA_WORDS, fills[k]);
+		__asm__ volatile ("dsb sy" ::: "memory");
+
+		seq = ++pg_fence_seq;
+		took = pg_submit_one(iova + PG_SUB_IB_PAGE, ib_words,
+		    iova + PG_SUB_FENCE_PAGE, seq);
+		if (!took || !pg_fence_reached(fence, seq, 20000)) {
+			printf("POLARIS GPU: 19 submit: seq %u: the CP %s, the fence reads %u\n",
+			    seq, took ? "took the ring" : "did not take the ring", *fence);
+			break;
+		}
+		wrote = 0;
+		for (i = 0; i < PG_SUB_DATA_WORDS; i++) {
+			if (target[i] == fills[k]) {
+				wrote++;
+			}
+		}
+		printf("POLARIS GPU: 19 submit: seq %u, ib %u dwords at %#llx, fence reads %u, "
+		    "%u of %u target words are %#x\n", seq, ib_words, iova + PG_SUB_IB_PAGE,
+		    *fence, wrote, PG_SUB_DATA_WORDS, fills[k]);
+		if (wrote != PG_SUB_DATA_WORDS) {
+			break;
+		}
+		last = seq;
+		passed++;
+	}
+
+	if (passed == 3u) {
+		/*
+		 * An old fence must be true at once, and one that was never submitted
+		 * must not become true: 100 tries at 100 us is ten milliseconds, far
+		 * longer than the CP takes to write a fence it is going to write.
+		 */
+		bool old_at_once = pg_fence_reached(fence, 1u, 1u);
+		bool ahead = pg_fence_reached(fence, last + 1u, 100u);
+
+		timed_out_as_it_should = !ahead;
+		printf("POLARIS GPU: 19 submit: fence %u now; an old fence (1) %s; a fence that was "
+		    "never submitted (%u) %s\n", *fence,
+		    old_at_once ? "is already true" : "is NOT true, and it should be",
+		    last + 1u, ahead ? "came true, which cannot happen" : "did not come true in 10 ms");
+		printf("POLARIS GPU: 19 submit: %s\n",
+		    (old_at_once && timed_out_as_it_should) ?
+		    "THE FENCE IS MONOTONIC AND A WAIT FOR ONE THAT WAS NEVER SUBMITTED TIMES OUT" :
+		    "the fence does not behave like a fence");
+
+		/*
+		 * And now the same submission two thousand times, so the ring wraps.
+		 *
+		 * This is the shape of 0193: a write pointer that is not taken modulo
+		 * the ring, or a submission allowed to run past the end, leaves the CP
+		 * waiting for a payload that was never written and the GPU looks idle
+		 * forever. 2000 x 9 dwords is 18000, more than the 16384 the ring
+		 * holds, so it has to wrap at least once - and every fence still has
+		 * to arrive in order.
+		 */
+		{
+			uint32_t stalls = 0, submitted = 0;
+
+			for (uint32_t i = 0; i < 2000u; i++) {
+				seq = ++pg_fence_seq;
+				if (!pg_submit_one(iova + PG_SUB_IB_PAGE, ib_words,
+				    iova + PG_SUB_FENCE_PAGE, seq)) {
+					stalls++;
+					break;
+				}
+				submitted++;
+			}
+			printf("POLARIS GPU: 19 stress: %u submissions (%u dwords, the ring holds %u), "
+			    "fence reads %u of %u, %u stalls\n", submitted, submitted * 9u,
+			    PG_RING_WORDS, *fence, pg_fence_seq, stalls);
+			printf("POLARIS GPU: 19 stress: %s\n",
+			    (stalls == 0 && *fence == pg_fence_seq && submitted == 2000u) ?
+			    "THE RING WRAPS AND THE CP KEEPS UP: 2000 SUBMISSIONS, NO STALL" :
+			    "the submission path does not survive a wrapped ring");
+		}
+	}
+
+	polaris_gpu_cp_report("after the submissions");
+	polaris_gpu_unmap(iova, bytes);
+	polaris_gpu_mapped();
+	polaris_gpu_address_free(iova, bytes);
+	polaris_gpu_pool_free(pa, bytes);
+}
+
+
+/* ---- the three entry points the DRM service submits through -------------------------------------- */
+
+/*
+ * 0202 proved the mechanism; these are the same packets with the test stripped
+ * out, so that a program's command buffers can be handed in by the IOKit
+ * service instead of by this file's own self test.
+ *
+ * The room check is the one that matters and the one 0193 paid for: the ring is
+ * 16384 dwords, and a submission larger than what is left does not wrap - the
+ * CP reads the first packet header, eats the words that are there, and then
+ * waits for a payload that was never written. The GPU looks idle and always
+ * will. So ask first, and if there is no room, wait for the CP rather than
+ * write past the end.
+ */
+uint32_t
+polaris_gpu_ring_room(void)
+{
+	uint32_t rptr, wptr;
+
+	if (pg_gpu3d == 0) {
+		return 0;
+	}
+	rptr = pg_rd(pg_gpu3d + 4u * PG_CP_RB_RPTR) & (PG_RING_WORDS - 1u);
+	wptr = pg_cp_wptr & (PG_RING_WORDS - 1u);
+	return (rptr + PG_RING_WORDS - wptr - 1u) % PG_RING_WORDS;
+}
+
+uint32_t
+polaris_gpu_fence_next(void)
+{
+	return ++pg_fence_seq;
+}
+
+/*
+ * `count` command buffers, each an address and a dword count, followed by the
+ * fence. Returns false only when nothing was written: once the packets are in
+ * the ring the submission is the CP's, drain or no drain.
+ */
+bool
+polaris_gpu_submit_ibs(const uint64_t *iova, const uint32_t *words, uint32_t count,
+    uint64_t fence_iova, uint32_t seq)
+{
+	uint32_t need = 5u * count + 6u;
+	uint32_t wptr, rptr = 0;
+
+	if (pg_gpu3d == 0 || pg_ring_va[0] == 0 || iova == NULL || words == NULL ||
+	    count == 0 || count > 64u || seq == 0) {
+		return false;
+	}
+	for (uint32_t i = 0; i < 2000u && polaris_gpu_ring_room() < need; i++) {
+		pg_sleep_us(100);
+	}
+	if (polaris_gpu_ring_room() < need) {
+		printf("POLARIS GPU: 19 submit: no room in the ring for %u dwords (%u free)\n",
+		    need, polaris_gpu_ring_room());
+		return false;
+	}
+	wptr = pg_cp_wptr;
+	for (uint32_t i = 0; i < count; i++) {
+		pg_ring_put(wptr++, pg_pkt7(0x3fu, 3u));		/* CP_INDIRECT_BUFFER */
+		pg_ring_put(wptr++, (uint32_t)iova[i]);
+		pg_ring_put(wptr++, (uint32_t)(iova[i] >> 32));
+		pg_ring_put(wptr++, words[i]);
+	}
+	pg_ring_put(wptr++, pg_pkt7(0x46u, 4u));			/* CP_EVENT_WRITE */
+	pg_ring_put(wptr++, 0x04u);					/* EVENT_CACHE_FLUSH_TS */
+	pg_ring_put(wptr++, (uint32_t)fence_iova);
+	pg_ring_put(wptr++, (uint32_t)(fence_iova >> 32));
+	pg_ring_put(wptr++, seq);
+	wptr &= PG_RING_WORDS - 1u;
+	pg_ring_flush();
+	pg_wr(pg_gpu3d + 4u * PG_CP_RB_WPTR, wptr);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	pg_cp_wptr = wptr;
+	for (uint32_t i = 0; i < 2000u; i++) {
+		rptr = pg_rd(pg_gpu3d + 4u * PG_CP_RB_RPTR) & (PG_RING_WORDS - 1u);
+		if (rptr == wptr) {
+			return true;
+		}
+		pg_sleep_us(100);
+	}
+	printf("POLARIS GPU: 19 submit: the ring was written but the CP has not caught up: "
+	    "RPTR %u WPTR %u (the fence will say when)\n", rptr, wptr);
+	return true;
+}
+
+
+/* ---- a read-only look at the root volume --------------------------------------------------------- */
+
+/*
+ * The remaining work is all in user space, and this port has no adb, no ssh and
+ * no shell: the only thing that can put a program on the device is the kernel
+ * that already mounts the root volume read-write (`rootrw=1`). Before writing
+ * anything there - or writing code that writes there - three questions have to
+ * be answered, and all three are read-only:
+ *
+ *   is the root really mounted read-write,
+ *   does /System/Library/LaunchDaemons exist,
+ *   does a lookup of it succeed from kernel context at all.
+ *
+ * Nothing here creates, changes or removes anything.
+ */
+static void polaris_vfs_probe_thread(void *, int);
+
+void
+polaris_vfs_probe(void)
+{
+	thread_t thread = NULL;
+
+	if (kernel_thread_start((thread_continue_t) polaris_vfs_probe_thread, NULL,
+	    &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("POLARIS VFS: no thread to wait for the root with\n");
+	}
+}
+
+static void
+polaris_vfs_probe_thread(void * arg, int pending)
+{
+	static const char * paths[] = {
+		"/", "/System", "/System/Library", "/System/Library/LaunchDaemons",
+		"/usr", "/usr/lib", "/private/var",
+	};
+	vfs_context_t ctx;
+
+	(void) arg;
+	(void) pending;
+	/*
+	 * Not yet, most likely: this driver starts during the bring-up, before
+	 * the root volume is mounted, and the first run of this probe answered
+	 * ENOENT to every path including "/". Wait for it instead of guessing a
+	 * delay - sixty seconds at half a second a look.
+	 */
+	for (unsigned i = 0; i < 120; i++) {
+		vnode_t root = NULL;
+
+		if (vnode_lookup("/", 0, &root, vfs_context_current()) == 0 && root != NULL) {
+			vnode_put(root);
+			break;
+		}
+		pg_sleep_us(500 * 1000);
+	}
+	ctx = vfs_context_current();
+	for (unsigned i = 0; i < sizeof(paths) / sizeof(paths[0]); i++) {
+		vnode_t vp = NULL;
+		int err = vnode_lookup(paths[i], 0, &vp, ctx);
+
+		if (err != 0 || vp == NULL) {
+			printf("POLARIS VFS: %s: lookup failed (%d)\n", paths[i], err);
+			continue;
+		}
+		if (i == 0) {
+			mount_t mp = vnode_mount(vp);
+			uint64_t flags = vfs_flags(mp);
+
+			printf("POLARIS VFS: root %s: mount flags %#llx, read-only %s\n", paths[i],
+			    flags, (flags & MNT_RDONLY) != 0 ? "YES" : "no");
+		} else {
+			printf("POLARIS VFS: %s: exists\n", paths[i]);
+		}
+		vnode_put(vp);
+	}
+	printf("POLARIS VFS: ======== the root volume has been read, not written ========\n");
+}
+
 #endif
