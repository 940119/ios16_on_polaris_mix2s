+/*
+ * PolarisGPU: the IOKit service a program opens to use the Adreno 630, and the
+ * one CoreAnimation would draw through if it were ever given a GL context.
+ *
+ * Why it exists
+ * -------------
+ * bsd/dev/polaris_gpu.c drives the block from the kernel and stops there: it
+ * can fill memory through the CP, and nothing outside the kernel can ask it to.
+ * Mesa's freedreno, which is what HackiOS's port draws the screen with (and what
+ * the Mi 8 port borrows), is a user-space library that speaks Linux's msm DRM:
+ * it opens "msm", asks for buffers, maps them, submits command buffers and waits
+ * on fences. Between the two there is exactly one thing missing, and this file
+ * is it.
+ *
+ * The ABI is Linux's, unchanged. msm's request numbers are DRM_COMMAND_BASE plus
+ * the value in Mesa's drm-uapi/msm_drm.h, the structures are the ones that
+ * header declares, and the low byte of the ioctl code is the selector a call
+ * arrives on - which is what makes a 227-line libdrm stand-in possible on the
+ * other side (HackiOS's tools/mesa/hakios-drm/hakios.drm.c; ours is the same
+ * shape). Nothing here is invented, because an invented number would be a number
+ * Mesa does not send.
+ *
+ * What is here, and what is not
+ * -----------------------------
+ * Here: the service, a client, buffers (make, describe, give back), the map into
+ * the process, and the submit-queue requests that only need an id. A buffer is
+ * wired memory of this kernel's, entered page by page into the SMMU window that
+ * polaris_gpu.c now keeps for the purpose (PG_USER_IOVA, 64 MB).
+ *
+ * Not here: submit and fences. A submission is a command buffer the program
+ * wrote, and handing one to the CP means deciding what happens when it does not
+ * complete, what a fence is made of, and what the GPU is allowed to do to
+ * memory it was not given. polaris_gpu_fill() below proves the first half of
+ * that (the CP can write a program's buffer at all); the rest is the next build,
+ * and pretending otherwise would put a submit path in front of a fence that
+ * cannot yet say "done".
+ *
+ * How it is checked without a user space
+ * --------------------------------------
+ * `polarisgputest=1` makes the kernel run one round of what a client would do:
+ * make 64 KB, enter it into the GPU's address space, fill it with 0xdeadbeef
+ * from the CPU, have the CP overwrite it with 0xa5a5a5a5, read it back from the
+ * CPU, give it back. The count of words that came back changed is the answer,
+ * and it is the only answer that means anything: a descriptor the CPU reads back
+ * as correct says nothing about whether the GPU can use it (build 0160).
+ */
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <kern/clock.h>
+#include <kern/task.h>
+#include <mach/mach_time.h>
+#include <mach/vm_param.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+
+extern "C" {
+bool polaris_gpu_ready(void);
+uint64_t polaris_gpu_address(uint64_t size);
+void polaris_gpu_address_free(uint64_t address, uint64_t size);
+bool polaris_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+void polaris_gpu_mapped(void);
+void polaris_gpu_unmap(uint64_t address, uint64_t size);
+bool polaris_gpu_fill(uint64_t iova, uint32_t words);
+bool polaris_gpu_fill_batched(uint64_t iova, uint32_t words);
+bool polaris_gpu_fill_window(uint64_t iova, uint32_t words);
+void polaris_gpu_window_sync(void);
+void polaris_gpu_window_report(uint64_t iova);
+void polaris_gpu_pa_test(const uint64_t *pas, uint32_t pages, uint64_t bytes,
+    volatile uint32_t *cpu);
+void polaris_gpu_pool_test(void);
+void polaris_gpu_submit_test(void);
+uint32_t polaris_gpu_ring_room(void);
+uint32_t polaris_gpu_fence_next(void);
+bool polaris_gpu_submit_ibs(const uint64_t *iova, const uint32_t *words, uint32_t count,
+    uint64_t fence_iova, uint32_t seq);
+uint32_t polaris_gpu_build_memwrite(volatile uint32_t * ib, uint32_t at, uint64_t target,
+    uint32_t words, uint32_t value);
+void polaris_gpu_cp_report(const char *why);
+void polaris_vfs_probe(void);
+uint64_t polaris_gpu_pool_alloc(uint64_t bytes);
+void polaris_gpu_pool_free(uint64_t pa, uint64_t bytes);
+void * polaris_gpu_pool_view(uint64_t pa, uint64_t bytes);
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+/*
+ * Linux's, from Mesa's drm-uapi/msm_drm.h, field for field. The padding is not
+ * decoration: the structures cross a boundary between two compilers, and a
+ * struct that is a different size on either side is a request that arrives
+ * shifted. Every one below is 8-byte aligned the way the uapi declares it.
+ */
+struct msm_timespec {
+	int64_t seconds, nanoseconds;
+};
+struct msm_param {
+	uint32_t pipe, param;
+	uint64_t value;
+	uint32_t len, pad;
+};
+struct msm_gem_new {
+	uint64_t size;
+	uint32_t flags, handle;
+};
+struct msm_gem_info {
+	uint32_t handle, info;
+	uint64_t value;
+	uint32_t len, pad;
+};
+struct msm_gem_cpu_prep {
+	uint32_t handle, op;
+	struct msm_timespec timeout;
+};
+struct msm_gem_madvise {
+	uint32_t handle, madv, retained;
+};
+struct msm_submitqueue {
+	uint32_t flags, prio, id;
+};
+struct msm_submitqueue_query {
+	uint64_t data;
+	uint32_t id, param, len, pad;
+};
+struct drm_gem_close {
+	uint32_t handle, pad;
+};
+/*
+ * Linux's submit structures, field for field, from include/uapi/drm/msm_drm.h
+ * (a copy is in the workspace root, fetched from the kernel tree rather than
+ * remembered). A field out of place here would not fail - it would submit
+ * somebody else's addresses.
+ */
+struct drm_msm_gem_submit_cmd {
+	uint32_t type;           /* MSM_SUBMIT_CMD_x */
+	uint32_t submit_idx;     /* index into bos[] */
+	uint32_t submit_offset;  /* byte offset into that buffer */
+	uint32_t size;           /* bytes of command stream */
+	uint32_t pad;
+	uint32_t nr_relocs;
+	uint64_t relocs;         /* union with iova */
+};
+struct drm_msm_gem_submit_bo {
+	uint32_t flags;          /* MSM_SUBMIT_BO_x */
+	uint32_t handle;
+	uint64_t presumed;
+};
+struct drm_msm_gem_submit {
+	uint32_t flags;
+	uint32_t fence;          /* out */
+	uint32_t nr_bos;
+	uint32_t nr_cmds;
+	uint64_t bos;
+	uint64_t cmds;
+	int32_t fence_fd;
+	uint32_t queueid;
+	uint64_t in_syncobjs;
+	uint64_t out_syncobjs;
+	uint32_t nr_in_syncobjs;
+	uint32_t nr_out_syncobjs;
+	uint32_t syncobj_stride;
+	uint32_t pad;
+};
+struct drm_msm_wait_fence {
+	uint32_t fence;
+	uint32_t flags;
+	struct msm_timespec timeout;
+	uint32_t queueid;
+	uint32_t pad;
+};
+
+#define MSM_SUBMIT_CMD_BUF		0x0001
+#define MSM_PREP_NOSYNC			0x04
+#define MSM_SUBMIT_MAX_CMDS		8	/* one submission's command buffers */
+#define MSM_SUBMIT_MAX_BOS		8	/* one submission's buffers */
+
+enum {
+	kDrmGemClose            = 0x09,
+	kMsmGetParam            = 0x40,
+	kMsmSetParam            = 0x41,
+	kMsmGemNew              = 0x42,
+	kMsmGemInfo             = 0x43,
+	kMsmGemCpuPrep          = 0x44,
+	kMsmGemCpuFini          = 0x45,
+	kMsmGemSubmit           = 0x46,
+	kMsmWaitFence           = 0x47,
+	kMsmGemMadvise          = 0x48,
+	kMsmSubmitQueueNew      = 0x4a,
+	kMsmSubmitQueueClose    = 0x4b,
+	kMsmSubmitQueueQuery    = 0x4c,
+};
+
+#define MSM_BO_SCANOUT          0x00000001
+#define MSM_BO_GPU_READONLY     0x00000002
+#define MSM_BO_CACHED           0x00000100
+#define MSM_BO_WC               0x00000200
+#define MSM_BO_UNCACHED         0x00000400
+
+#define MSM_INFO_GET_OFFSET     0
+#define MSM_INFO_GET_IOVA       1
+
+#define GPU_BUFFERS             4096            /* a client's, at most */
+#define GPU_BUFFER_MAX          (256u << 20)    /* one buffer, as msm's own limit */
+
+static IOLock * gGPULock;                       /* around everything that is the GPU's */
+static bool gGPUReported;
+static uint32_t gParamAsked[16];                /* which MSM_PARAM_* were asked, and how often (the first 16) */
+static uint32_t gParamCount;
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+class PolarisGPU : public IOService
+{
+	OSDeclareDefaultStructors(PolarisGPU);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(PolarisGPU, IOService);
+
+/*
+ * 0209: the published instance, kept so that the boot-time test can open a
+ * client on it the way a program does. It is retained once for that pointer and
+ * never released: there is one GPU and one service, and this is the reference
+ * that outlives the local variable in polaris_gpu_service_start().
+ */
+static PolarisGPU * gPolarisGPUService;
+
+bool
+PolarisGPU::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	/*
+	 * The name is the one drmOpenWithType("msm") looks for: the libdrm
+	 * stand-in has no device nodes to walk, so it asks the registry for a
+	 * service by name and opens that.
+	 */
+	setProperty(kIOUserClientClassKey, "PolarisGPUUserClient");
+	setName("PolarisGPU");
+	registerService();
+	printf("POLARIS GPU: 19 the service is published (PolarisGPU)\n");
+	return true;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+struct gpu_buffer {
+	IOMemoryDescriptor *    memory;         /* NULL: this handle is free */
+	uint8_t *               kernel;         /* where it is in the kernel, when it is ours */
+	uint64_t                address;        /* the GPU's for it */
+	uint64_t                size;
+	uint32_t                flags;
+	/*
+	 * 0197: the pages a buffer is made of can now be the pool's, below 4 GB,
+	 * rather than this kernel's own memory above it. Such a buffer has a
+	 * physical address to give back and a descriptor wrapped around it, but
+	 * no allocation behind either, so the two are kept apart from `memory`.
+	 */
+	bool                    pool;
+	uint64_t                pa;             /* pool: the first page's physical address */
+};
+
+class PolarisGPUUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(PolarisGPUUserClient);
+
+	task_t                  fTask;
+	struct gpu_buffer *     fBuffers;       /* handle n is fBuffers[n - 1] */
+	uint32_t                fNextBuffer;    /* where the search for a free handle starts */
+	uint32_t                fBufferCount;
+	uint64_t                fBufferBytes;
+	uint32_t                fNextQueue;
+	uint32_t                fStrangers;     /* requests that named a buffer this client does not have */
+
+	struct gpu_buffer * buffer(uint32_t handle);
+	struct gpu_buffer * takeSlot(uint32_t * handle);
+	struct gpu_buffer * newBuffer(IOMemoryDescriptor * memory, uint64_t from, uint64_t size,
+	    uint32_t flags, uint32_t * handle);
+	struct gpu_buffer * newPoolBuffer(uint64_t pa, uint64_t size, uint32_t flags,
+	    uint32_t * handle);
+	static bool fillPoolBuffer(struct gpu_buffer * b, uint64_t pa, uint64_t size,
+	    uint32_t flags);
+	static void releaseBuffer(struct gpu_buffer * b);
+	void freeBuffer(struct gpu_buffer * b);
+	IOReturn gemNew(struct msm_gem_new * request);
+	IOReturn gemInfo(struct msm_gem_info * request);
+	IOReturn gemClose(struct drm_gem_close * request);
+	IOReturn gemSubmit(struct drm_msm_gem_submit * request);
+	IOReturn submitCore(struct drm_msm_gem_submit * request,
+	    const struct drm_msm_gem_submit_bo * bos,
+	    const struct drm_msm_gem_submit_cmd * cmds);
+	IOReturn waitFence(struct drm_msm_wait_fence * request);
+	IOReturn waitFor(uint32_t target, uint64_t limit_ns);
+
+public:
+	static void poolSelfTest(void);
+	static void paramSelfTest(void);
+	static void submitSelfTest(void);
+	virtual bool initWithTask(task_t owningTask, void * securityID, UInt32 type,
+	    OSDictionary * properties) APPLE_KEXT_OVERRIDE;
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientMemoryForType(UInt32 type, IOOptionBits * options,
+	    IOMemoryDescriptor ** memory) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+	/*
+	 * exportObjectToClient is deliberately not overridden here. This tree
+	 * declares it in IOUserClient.h and defines it in
+	 * iokit/Kernel/IOUserClient.cpp, and the two do not agree on
+	 * io_object_t, so the declaration's mangling has no symbol. The slot
+	 * is filled by defining the declaration itself, below this class.
+	 */
+};
+
+OSDefineMetaClassAndStructors(PolarisGPUUserClient, IOUserClient);
+
+bool
+PolarisGPUUserClient::initWithTask(task_t owningTask, void * securityID, UInt32 type,
+    OSDictionary * properties)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+		return false;
+	}
+	fTask = owningTask;
+	return true;
+}
+
+bool
+PolarisGPUUserClient::start(IOService * provider)
+{
+	if (!polaris_gpu_ready() || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fBuffers = IONewZero(struct gpu_buffer, GPU_BUFFERS);
+	if (fBuffers == NULL) {
+		printf("POLARIS GPU: 19 a client has no room for its buffer table\n");
+		return false;
+	}
+	printf("POLARIS GPU: 19 a client is attached\n");
+	return true;
+}
+
+struct gpu_buffer *
+PolarisGPUUserClient::buffer(uint32_t handle)
+{
+	if (handle == 0 || handle > GPU_BUFFERS || fBuffers[handle - 1].memory == NULL) {
+		if (handle != 0 && fStrangers++ < 16) {
+			printf("POLARIS GPU: 19 buffer %u is asked for and is not there\n", handle);
+		}
+		return NULL;
+	}
+	return &fBuffers[handle - 1];
+}
+
+/*
+ * The next free handle, round-robin so that a program that makes and drops
+ * buffers in a loop does not pay for the first slot's cache lines every time.
+ * Called with gGPULock held. A handle is free when it has no memory
+ * descriptor: a pool buffer has one too, wrapped around its physical pages,
+ * and that is deliberate - it is the thing a program maps.
+ */
+struct gpu_buffer *
+PolarisGPUUserClient::takeSlot(uint32_t * handle)
+{
+	struct gpu_buffer * b = NULL;
+
+	for (uint32_t n = 0; n < GPU_BUFFERS; n++) {
+		uint32_t i = (fNextBuffer + n) % GPU_BUFFERS;
+
+		if (fBuffers[i].memory == NULL) {
+			b = &fBuffers[i];
+			*handle = i + 1;
+			fNextBuffer = i + 1;
+			break;
+		}
+	}
+	if (b == NULL) {
+		printf("POLARIS GPU: 19 the client has no handles left\n");
+		return NULL;
+	}
+	bzero(b, sizeof(*b));
+	return b;
+}
+
+/*
+ * A handle and an address of the GPU's for `size` bytes of a memory descriptor,
+ * from byte `from` of it on, in whole pages. Called with gGPULock held; NULL
+ * means there was no room or the memory could not be entered.
+ */
+struct gpu_buffer *
+PolarisGPUUserClient::newBuffer(IOMemoryDescriptor * memory, uint64_t from, uint64_t size,
+    uint32_t flags, uint32_t * handle)
+{
+	struct gpu_buffer * b = takeSlot(handle);
+	bool mapped = true;
+
+	if (b == NULL) {
+		return NULL;
+	}
+	b->address = polaris_gpu_address(size);
+	if (b->address == 0) {
+		return NULL;
+	}
+	/*
+	 * Page by page, and the physical address asked for each one: this kernel
+	 * runs 16 KB pages while the SMMU's are 4 KB, and a descriptor is per 4 KB.
+	 * The GPU's window is 64 MB of IOVA, so a 256 MB buffer would not fit; the
+	 * limit is the window's, not this loop's.
+	 */
+	for (uint64_t offset = 0; offset < size && mapped; offset += 4096) {
+		IOByteCount length = 0;
+		addr64_t phys = memory->getPhysicalSegment(from + offset, &length, kIOMemoryMapperNone);
+
+		mapped = phys != 0 && polaris_gpu_map(b->address + offset, phys,
+		    (flags & MSM_BO_GPU_READONLY) != 0);
+	}
+	polaris_gpu_mapped();
+	if (!mapped) {
+		polaris_gpu_unmap(b->address, size);
+		polaris_gpu_address_free(b->address, size);
+		printf("POLARIS GPU: 19 a buffer of %llu bytes cannot be entered into the GPU's "
+		    "address space\n", size);
+		return NULL;
+	}
+	memory->retain();
+	b->memory = memory;
+	b->kernel = OSDynamicCast(IOBufferMemoryDescriptor, memory) != NULL ?
+	    (uint8_t *) OSDynamicCast(IOBufferMemoryDescriptor, memory)->getBytesNoCopy() : NULL;
+	b->size = size;
+	b->flags = flags;
+	fBufferCount++;
+	fBufferBytes += size;
+	return b;
+}
+
+/*
+ * A pool buffer: pages that exist already, below 4 GB, that the GPU has been
+ * proved to write (0196). There is no IOBufferMemoryDescriptor to ask for
+ * physical segments, because here the physical address is the input and not
+ * the answer: the pages are entered into the program's window from `pa`, and
+ * the descriptor the program maps is made around that range.
+ *
+ * The descriptor is what makes the handle usable from a program at all.
+ * clientMemoryForType() hands it to IOConnectMapMemory(), and without one the
+ * handle would exist and be unmappable. withPhysicalAddress is the same call
+ * the framebuffer service in this tree uses to wrap a physical range it did
+ * not allocate.
+ *
+ * The program's mapping keeps the descriptor's default cache mode. The GPU
+ * writes with the SMMU's Normal non-cacheable attributes (MAIR0 0xf404ff44,
+ * index 0), so a cached mapping would need an invalidate this build does not
+ * do - but nothing maps a client buffer yet, and putting option bits in now
+ * would be a guess in the one place where a wrong guess looks exactly like a
+ * working buffer. The CPU view below is the uncached window in polaris_gpu.c,
+ * so everything this kernel reads back is what the GPU wrote.
+ */
+bool
+PolarisGPUUserClient::fillPoolBuffer(struct gpu_buffer * b, uint64_t pa, uint64_t size,
+    uint32_t flags)
+{
+	uint8_t * view;
+	bool mapped = true;
+
+	b->address = polaris_gpu_address(size);
+	if (b->address == 0) {
+		return false;
+	}
+	for (uint64_t offset = 0; offset < size && mapped; offset += 4096) {
+		mapped = polaris_gpu_map(b->address + offset, pa + offset,
+		    (flags & MSM_BO_GPU_READONLY) != 0);
+	}
+	polaris_gpu_mapped();
+	if (!mapped) {
+		polaris_gpu_unmap(b->address, size);
+		polaris_gpu_mapped();
+		polaris_gpu_address_free(b->address, size);
+		b->address = 0;
+		printf("POLARIS GPU: 19 a pool buffer of %llu bytes will not enter the GPU's "
+		    "address space\n", size);
+		return false;
+	}
+	b->memory = IOMemoryDescriptor::withPhysicalAddress((IOPhysicalAddress) pa,
+	    (IOByteCount) size, kIODirectionInOut);
+	if (b->memory == NULL) {
+		polaris_gpu_unmap(b->address, size);
+		polaris_gpu_mapped();
+		polaris_gpu_address_free(b->address, size);
+		b->address = 0;
+		printf("POLARIS GPU: 19 the pool pages at %#llx will not wrap in a memory "
+		    "descriptor\n", pa);
+		return false;
+	}
+	view = (uint8_t *) polaris_gpu_pool_view(pa, size);
+	if (view == NULL) {
+		polaris_gpu_unmap(b->address, size);
+		polaris_gpu_mapped();
+		polaris_gpu_address_free(b->address, size);
+		b->address = 0;
+		OSSafeReleaseNULL(b->memory);
+		return false;
+	}
+	/*
+	 * Zeroed word by word, not with bzero.
+	 *
+	 * ml_io_map gives a device mapping - Normal non-cacheable at best, and
+	 * this kernel's is stricter - where an access that is not naturally
+	 * aligned faults instead of being split. bzero's vector path writes
+	 * sixteen bytes at a stride it chooses, and 0198 died on exactly that:
+	 *
+	 *   panic(cpu 8 caller ...): Unaligned kernel data abort
+	 *   pc 0xfffffff00738e5e4  esr 0x96000061 (alignment fault)
+	 *   far 0xffffffe13b17f048
+	 *
+	 * 0x48 is not a multiple of sixteen. The pool test in polaris_gpu.c has
+	 * always written these pages one aligned word at a time for the same
+	 * reason; this now does too.
+	 */
+	{
+		volatile uint32_t * words = (volatile uint32_t *) view;
+
+		for (uint64_t i = 0; i < size / 4; i++) {
+			words[i] = 0;
+		}
+	}
+	b->kernel = view;
+	b->pa = pa;
+	b->pool = true;
+	b->size = size;
+	b->flags = flags;
+	return true;
+}
+
+struct gpu_buffer *
+PolarisGPUUserClient::newPoolBuffer(uint64_t pa, uint64_t size, uint32_t flags,
+    uint32_t * handle)
+{
+	struct gpu_buffer * b = takeSlot(handle);
+
+	if (b == NULL) {
+		return NULL;
+	}
+	if (!fillPoolBuffer(b, pa, size, flags)) {
+		bzero(b, sizeof(*b));
+		return NULL;
+	}
+	fBufferCount++;
+	fBufferBytes += size;
+	return b;
+}
+
+/*
+ * Everything a buffer holds, given back. Called with gGPULock held and after
+ * the handle has been cleared, so a second close of it finds nothing; also
+ * called by the boot-time test, which has no handle at all.
+ *
+ * A pool buffer's pages go back to the pool: sixteen megabytes is all there is,
+ * and a window server that makes a surface every time the screen rotates would
+ * have none left by the third one. Its CPU view is not unmapped - it is the
+ * one window over the whole region, and it is not this buffer's to unmap.
+ */
+void
+PolarisGPUUserClient::releaseBuffer(struct gpu_buffer * b)
+{
+	polaris_gpu_unmap(b->address, b->size);
+	polaris_gpu_mapped();
+	polaris_gpu_address_free(b->address, b->size);
+	if (b->pool) {
+		polaris_gpu_pool_free(b->pa, b->size);
+	}
+	OSSafeReleaseNULL(b->memory);
+}
+
+/* Called with gGPULock held. Nothing has been submitted yet, so nothing can be in the GPU's hands. */
+void
+PolarisGPUUserClient::freeBuffer(struct gpu_buffer * slot)
+{
+	struct gpu_buffer saved = *slot;
+	struct gpu_buffer * b = &saved;
+
+	/* out of the handle first, so that a second close of it finds nothing */
+	slot->memory = NULL;
+	slot->kernel = NULL;
+	slot->pool = false;
+	if (fBufferCount > 0) {
+		fBufferCount--;
+	}
+	fBufferBytes -= b->size;
+
+	releaseBuffer(b);
+}
+
+IOReturn
+PolarisGPUUserClient::gemNew(struct msm_gem_new * request)
+{
+	uint64_t size = request->size;
+	uint64_t pa;
+	struct gpu_buffer * b;
+	uint32_t handle = 0;
+
+	if (size == 0 || size > GPU_BUFFER_MAX) {
+		return kIOReturnBadArgument;
+	}
+	size = round_page((vm_size_t) size);
+	/*
+	 * 0197: out of the pool, not out of this kernel's memory.
+	 *
+	 * Every buffer this service handed out until now was wired kernel memory,
+	 * and on this machine that is above 4 GB - where the GPU writes a few
+	 * hundred words of a page and stops (0194: 2176 of 16384, sparse). The
+	 * pages below 4 GB are the reserved region 0196 filled through the CP
+	 * without a single word wrong, so a program's buffers come from there.
+	 *
+	 * There is deliberately no fallback to the old path when the pool is
+	 * empty. A buffer above 4 GB is not a slow buffer, it is one the GPU
+	 * silently half-writes, and 0187-0193 were five builds spent looking for
+	 * a fault in the window while the address was the whole story. A refusal
+	 * a program can see beats a buffer that appears to work.
+	 */
+	/*
+	 * The pool's free list has no lock of its own - it is the GPU lock's, the
+	 * way the address allocator's is - so the pages are taken and entered
+	 * under one hold of it. Taking them outside would let two clients be
+	 * handed the same page.
+	 */
+	IOLockLock(gGPULock);
+	pa = polaris_gpu_pool_alloc(size);
+	if (pa == 0) {
+		IOLockUnlock(gGPULock);
+		printf("POLARIS GPU: 19 gemNew: %llu bytes, and the pool has none left\n", size);
+		return kIOReturnNoMemory;
+	}
+	b = newPoolBuffer(pa, size, request->flags, &handle);
+	if (b == NULL) {
+		polaris_gpu_pool_free(pa, size);
+	}
+	IOLockUnlock(gGPULock);
+	if (b == NULL) {
+		return kIOReturnNoMemory;
+	}
+	request->handle = handle;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+PolarisGPUUserClient::gemInfo(struct msm_gem_info * request)
+{
+	struct gpu_buffer * b;
+
+	IOLockLock(gGPULock);
+	b = buffer(request->handle);
+	if (b == NULL) {
+		IOLockUnlock(gGPULock);
+		return kIOReturnBadArgument;
+	}
+	switch (request->info) {
+	case MSM_INFO_GET_IOVA:
+		request->value = b->address;
+		break;
+	case MSM_INFO_GET_OFFSET:
+		request->value = 0;
+		break;
+	default:
+		IOLockUnlock(gGPULock);
+		return kIOReturnBadArgument;
+	}
+	IOLockUnlock(gGPULock);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+PolarisGPUUserClient::gemClose(struct drm_gem_close * request)
+{
+	struct gpu_buffer * b;
+
+	IOLockLock(gGPULock);
+	b = buffer(request->handle);
+	if (b == NULL) {
+		IOLockUnlock(gGPULock);
+		return kIOReturnBadArgument;
+	}
+	freeBuffer(b);
+	IOLockUnlock(gGPULock);
+	return kIOReturnSuccess;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+/*
+ * 0203: the fence page, the parameters, and the submit path.
+ *
+ * One pool page the CP writes a number into after every submission. It is the
+ * whole of this port's completion mechanism: no GPU interrupt is wired, so
+ * "is it done" is a word in memory, and the only question a wait can ask is
+ * whether that word has reached a number. 0202 proved the CP writes it and that
+ * the numbers only go up; this hands the same thing to a program.
+ */
+static uint64_t gFencePa;
+static uint64_t gFenceIova;
+static volatile uint32_t * gFenceView;
+static uint32_t gLastFence;
+
+/* Called with gGPULock held. One page, once. */
+static bool
+fencePage(void)
+{
+	uint64_t pa, iova;
+	void * view;
+
+	if (gFenceView != NULL) {
+		return true;
+	}
+	pa = polaris_gpu_pool_alloc(4096);
+	if (pa == 0) {
+		printf("POLARIS GPU: 19 submit: the pool has no page for the fence\n");
+		return false;
+	}
+	view = polaris_gpu_pool_view(pa, 4096);
+	if (view == NULL) {
+		polaris_gpu_pool_free(pa, 4096);
+		return false;
+	}
+	iova = polaris_gpu_address(4096);
+	if (iova == 0 || !polaris_gpu_map(iova, pa, false)) {
+		polaris_gpu_pool_free(pa, 4096);
+		printf("POLARIS GPU: 19 submit: the fence page will not enter the window\n");
+		return false;
+	}
+	polaris_gpu_mapped();
+	((volatile uint32_t *) view)[0] = 0;
+	gFencePa = pa;
+	gFenceIova = iova;
+	gFenceView = (volatile uint32_t *) view;
+	printf("POLARIS GPU: 19 submit: the fence lives at %#llx (physical %#llx)\n", iova, pa);
+	return true;
+}
+
+/*
+ * What this GPU is, in Linux's parameter numbers. Only the ones this port can
+ * answer from something it has measured are here; everything else stays
+ * kIOReturnUnsupported, which the log records, because a plausible guess about
+ * GPU_ID or VA_SIZE makes a client program the wrong registers or hand us
+ * addresses we cannot translate.
+ */
+static bool
+gpuParam(uint32_t id, uint64_t * value)
+{
+	switch (id) {
+	case 0x01:					/* MSM_PARAM_GPU_ID */
+		*value = 630;				/* the model, which is what a driver selects on */
+		break;
+	case 0x02:					/* MSM_PARAM_GMEM_SIZE */
+		*value = 0x80000ull;			/* 512 KB, a630's on-chip GMEM */
+		break;
+	case 0x03:					/* MSM_PARAM_CHIP_ID */
+		*value = 0x06030001ull;			/* read off this chip during bring-up */
+		break;
+	case 0x04:					/* MSM_PARAM_MAX_FREQ */
+		*value = 710000000ull;			/* a630's top bin on sdm845 */
+		break;
+	case 0x05:					/* MSM_PARAM_TIMESTAMP */
+		*value = 0;
+		break;
+	case 0x07:					/* MSM_PARAM_PRIORITIES */
+		*value = 1;				/* one submit queue exists */
+		break;
+	case 0x08:					/* MSM_PARAM_PP_PGTABLE */
+		*value = 0;				/* deprecated in Linux; zero there too */
+		break;
+	case 0x09:					/* MSM_PARAM_FAULTS */
+	case 0x0a:					/* MSM_PARAM_SUSPENDS */
+		*value = 0;				/* nothing has faulted; nothing suspends */
+		break;
+	case 0x0e:					/* MSM_PARAM_VA_START */
+		*value = 0x10c00000ull;			/* PG_USER_IOVA */
+		break;
+	case 0x0f:					/* MSM_PARAM_VA_SIZE */
+		*value = 64ull << 20;			/* PG_USER_SIZE */
+		break;
+	default:
+		return false;
+	}
+	return true;
+}
+
+/* Wait until the fence word has reached `target`. Zero means "ten seconds", never forever. */
+IOReturn
+PolarisGPUUserClient::waitFor(uint32_t target, uint64_t limit_ns)
+{
+	uint64_t began, elapsed = 0;
+
+	if (gFenceView == NULL) {
+		return kIOReturnNotReady;
+	}
+	if (limit_ns == 0) {
+		limit_ns = 10ull * 1000000000ull;
+	}
+	began = mach_absolute_time();
+	for (;;) {
+		if (*gFenceView >= target) {
+			return kIOReturnSuccess;
+		}
+		if (elapsed >= limit_ns) {
+			printf("POLARIS GPU: 19 submit: WAIT_FENCE %u: the fence is at %u after %llu us\n",
+			    target, *gFenceView, elapsed / 1000);
+			return kIOReturnTimeout;
+		}
+		IOSleep(1);
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &elapsed);
+	}
+}
+
+IOReturn
+PolarisGPUUserClient::waitFence(struct drm_msm_wait_fence * request)
+{
+	uint64_t limit = 0;
+
+	if (request->timeout.seconds > 0 || request->timeout.nanoseconds > 0) {
+		limit = (uint64_t)request->timeout.seconds * 1000000000ull +
+		    (uint64_t)request->timeout.nanoseconds;
+	}
+	return waitFor(request->fence, limit);
+}
+
+/*
+ * GEM_SUBMIT. The buffers are looked up by handle, each command's address is
+ * that buffer's GPU address plus its offset, and the whole set goes into the
+ * ring as one submission with one fence - which is what makes a wait after it
+ * mean "all of it", not "some of it".
+ *
+ * 0209: this half is only the copyin. Everything after it is submitCore(),
+ * which the boot-time test also calls - so that the arithmetic and the handle
+ * lookup are exercised by something other than the program that has not been
+ * written yet.
+ */
+IOReturn
+PolarisGPUUserClient::gemSubmit(struct drm_msm_gem_submit * request)
+{
+	struct drm_msm_gem_submit_bo bos[MSM_SUBMIT_MAX_BOS];
+	struct drm_msm_gem_submit_cmd cmds[MSM_SUBMIT_MAX_CMDS];
+
+	if (request->nr_cmds == 0 || request->nr_cmds > MSM_SUBMIT_MAX_CMDS ||
+	    request->nr_bos == 0 || request->nr_bos > MSM_SUBMIT_MAX_BOS ||
+	    request->bos == 0 || request->cmds == 0) {
+		return kIOReturnBadArgument;
+	}
+	if (copyin((user_addr_t) request->bos, bos,
+	    request->nr_bos * sizeof(bos[0])) != 0 ||
+	    copyin((user_addr_t) request->cmds, cmds,
+	    request->nr_cmds * sizeof(cmds[0])) != 0) {
+		return kIOReturnBadArgument;
+	}
+	return submitCore(request, bos, cmds);
+}
+
+/*
+ * The submission itself, with the two arrays already in kernel memory. `bos`
+ * and `cmds` are the program's, copied; `request` is the program's header,
+ * also already copied, and its `fence` field is written back.
+ */
+IOReturn
+PolarisGPUUserClient::submitCore(struct drm_msm_gem_submit * request,
+    const struct drm_msm_gem_submit_bo * bos,
+    const struct drm_msm_gem_submit_cmd * cmds)
+{
+	uint64_t iovas[MSM_SUBMIT_MAX_CMDS];
+	uint32_t words[MSM_SUBMIT_MAX_CMDS];
+	uint32_t count = 0, seq, total = 0;
+	IOReturn ret = kIOReturnSuccess;
+
+	if (request->nr_cmds == 0 || request->nr_cmds > MSM_SUBMIT_MAX_CMDS ||
+	    request->nr_bos == 0 || request->nr_bos > MSM_SUBMIT_MAX_BOS ||
+	    bos == NULL || cmds == NULL) {
+		return kIOReturnBadArgument;
+	}
+
+	IOLockLock(gGPULock);
+	if (!fencePage()) {
+		IOLockUnlock(gGPULock);
+		return kIOReturnNoMemory;
+	}
+	for (uint32_t i = 0; i < request->nr_cmds; i++) {
+		struct gpu_buffer * b;
+
+		if (cmds[i].type != MSM_SUBMIT_CMD_BUF) {
+			continue;			/* a restore buffer: nothing to run now */
+		}
+		if (cmds[i].submit_idx >= request->nr_bos || cmds[i].size == 0 ||
+		    (cmds[i].size & 3u) != 0) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		b = buffer(bos[cmds[i].submit_idx].handle);
+		if (b == NULL) {
+			printf("POLARIS GPU: 19 submit: a command names handle %u, which this "
+			    "client does not have\n", bos[cmds[i].submit_idx].handle);
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		/*
+		 * 0209: the offset and the length are the program's numbers, and a
+		 * program can be wrong. Without this check a command that starts past
+		 * the end of its buffer hands the CP an address belonging to whatever
+		 * follows it in the window - the same class of fault as 0194's pages
+		 * above 4 GB, except that this one is a bad request rather than a bad
+		 * allocator, and refusing it is the whole difference.
+		 */
+		if (cmds[i].submit_offset >= b->size ||
+		    cmds[i].size > b->size - cmds[i].submit_offset) {
+			printf("POLARIS GPU: 19 submit: a command asks for %u bytes at offset "
+			    "%u of a %llu-byte buffer\n", cmds[i].size,
+			    cmds[i].submit_offset, b->size);
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		iovas[count] = b->address + cmds[i].submit_offset;
+		words[count] = cmds[i].size / 4u;
+		total += words[count];
+		count++;
+	}
+	if (ret == kIOReturnSuccess && count == 0) {
+		ret = kIOReturnBadArgument;
+	}
+	if (ret == kIOReturnSuccess) {
+		seq = polaris_gpu_fence_next();
+		if (!polaris_gpu_submit_ibs(iovas, words, count, gFenceIova, seq)) {
+			ret = kIOReturnNoResources;
+		} else {
+			gLastFence = seq;
+			request->fence = seq;
+			printf("POLARIS GPU: 19 submit: %u buffers, %u words, fence %u\n",
+			    count, total, seq);
+		}
+	}
+	IOLockUnlock(gGPULock);
+	return ret;
+}
+
+/* The values a program will be given, printed at boot so that a wrong one is visible. */
+void
+PolarisGPUUserClient::paramSelfTest(void)
+{
+	static const uint32_t ids[] = { 0x01, 0x02, 0x03, 0x04, 0x05, 0x07, 0x08, 0x09, 0x0a,
+	    0x0e, 0x0f };
+	uint64_t value;
+
+	/*
+	 * 0204: the fence page is made here rather than on the first submit, so
+	 * that a boot log says whether the one page the whole completion
+	 * mechanism rests on can be taken and entered at all.
+	 */
+	if (fencePage()) {
+		printf("POLARIS GPU: 19 submit: the service's fence page is ready at %#llx\n",
+		    gFenceIova);
+	} else {
+		printf("POLARIS GPU: 19 submit: no fence page; a submission could not be waited on\n");
+	}
+	for (uint32_t i = 0; i < sizeof(ids) / sizeof(ids[0]); i++) {
+		if (gpuParam(ids[i], &value)) {
+			printf("POLARIS GPU: 19 param %#04x = %#llx\n", ids[i], value);
+		} else {
+			printf("POLARIS GPU: 19 param %#04x is asked and not answered\n", ids[i]);
+		}
+	}
+	printf("POLARIS GPU: 19 submit: %u dwords free in the ring\n", polaris_gpu_ring_room());
+	polaris_gpu_cp_report("after the parameter table");
+}
+
+/*
+ * 0209: the submit path with a caller that is not this file's own test.
+ *
+ * 0200 proved the CP runs a command buffer. What a program sends is different
+ * in every part that matters: buffers named by handle rather than by address, a
+ * byte offset into each one, a length in bytes, more than one command buffer in
+ * a single submission, and one fence covering all of them. None of that had
+ * ever run - gemSubmit() was reachable only from externalMethod(), and no
+ * program has opened this service - so the handle table and the offset
+ * arithmetic were code without a caller.
+ *
+ * So this opens a client the way the system opens one (newUserClient() on the
+ * published service, with the kernel's own task), takes two buffers through
+ * gemNew(), writes two command buffers into the first one 4096 bytes apart, and
+ * calls the same submitCore() that externalMethod() calls. Only copyin() is
+ * skipped.
+ *
+ * The two command buffers write two different values into two disjoint halves of
+ * the target, so a submission that ran both proves the offset was applied: an
+ * offset that was ignored would put the second value where the first one is, and
+ * one of the two halves would come back wrong.
+ *
+ * And four ways for a program to be wrong, each of which must be refused:
+ * a handle this client does not have, a command that starts past the end of its
+ * buffer, a length that is not a whole number of dwords, and nothing to run.
+ * A refusal is the answer - the last one is not allowed to reach the ring.
+ */
+void
+PolarisGPUUserClient::submitSelfTest(void)
+{
+	struct drm_msm_gem_submit_bo bos[2];
+	struct drm_msm_gem_submit_cmd cmds[2];
+	struct drm_msm_gem_submit submit;
+	struct msm_gem_new req;
+	struct gpu_buffer * ib = NULL;
+	struct gpu_buffer * tgt = NULL;
+	PolarisGPUUserClient * c = NULL;
+	IOUserClient * handler = NULL;
+	uint32_t ib_handle = 0, tgt_handle = 0;
+	uint32_t at = 0, first = 0, second = 0, untouched = 0, refusals = 0;
+	IOReturn ret;
+	bool ok;
+
+	if (gPolarisGPUService == NULL) {
+		printf("POLARIS GPU: 19 call: no published service, so no client to open\n");
+		return;
+	}
+	if (gPolarisGPUService->newUserClient(kernel_task, NULL, 0, NULL, &handler) !=
+	    kIOReturnSuccess || handler == NULL) {
+		printf("POLARIS GPU: 19 call: newUserClient() handed back nothing; the submit "
+		    "path keeps its untested caller\n");
+		return;
+	}
+	c = OSDynamicCast(PolarisGPUUserClient, handler);
+	if (c == NULL) {
+		printf("POLARIS GPU: 19 call: the client is not a PolarisGPUUserClient\n");
+		handler->release();
+		return;
+	}
+	printf("POLARIS GPU: 19 call: a client was opened on the service, the way a program "
+	    "opens one\n");
+
+	bzero(&req, sizeof(req));
+	req.size = 16384;				/* four pages: two command buffers 4096 apart */
+	if (c->gemNew(&req) != kIOReturnSuccess) {
+		printf("POLARIS GPU: 19 call: no command buffer from the pool\n");
+		goto out;
+	}
+	ib_handle = req.handle;
+
+	bzero(&req, sizeof(req));
+	req.size = 8192;
+	if (c->gemNew(&req) != kIOReturnSuccess) {
+		printf("POLARIS GPU: 19 call: no target buffer from the pool\n");
+		goto out;
+	}
+	tgt_handle = req.handle;
+
+	ib = c->buffer(ib_handle);
+	tgt = c->buffer(tgt_handle);
+	if (ib == NULL || tgt == NULL || ib->kernel == NULL || tgt->kernel == NULL) {
+		printf("POLARIS GPU: 19 call: the handles gemNew() returned are not usable\n");
+		goto out;
+	}
+
+	at = polaris_gpu_build_memwrite((volatile uint32_t *) ib->kernel, 0,
+	    tgt->address, 256, 0x0209a5a5u);
+	at = polaris_gpu_build_memwrite((volatile uint32_t *) ib->kernel, 1024,
+	    tgt->address + 4096, 256, 0x0209b6b6u);
+	printf("POLARIS GPU: 19 call: two command buffers in handle %u: one at byte 0, one "
+	    "at byte 4096; the second ends at word %u of that buffer\n", ib_handle, at);
+
+	bzero(bos, sizeof(bos));
+	bzero(cmds, sizeof(cmds));
+	bos[0].handle = ib_handle;
+	bos[1].handle = tgt_handle;
+	cmds[0].type = MSM_SUBMIT_CMD_BUF;
+	cmds[0].submit_idx = 0;
+	cmds[0].submit_offset = 0;
+	cmds[0].size = 259 * 4;			/* header 3 dwords + 256 of payload */
+	cmds[1].type = MSM_SUBMIT_CMD_BUF;
+	cmds[1].submit_idx = 0;
+	cmds[1].submit_offset = 4096;
+	cmds[1].size = 259 * 4;
+
+	bzero(&submit, sizeof(submit));
+	submit.nr_bos = 2;
+	submit.nr_cmds = 2;
+	ret = c->submitCore(&submit, bos, cmds);
+	if (ret != kIOReturnSuccess || submit.fence == 0) {
+		printf("POLARIS GPU: 19 call: the submission was refused (%#x)\n", ret);
+		goto out;
+	}
+	if (c->waitFor(submit.fence, 10000000000ull) != kIOReturnSuccess) {
+		printf("POLARIS GPU: 19 call: fence %u did not arrive\n", submit.fence);
+		goto out;
+	}
+
+	{
+		volatile uint32_t * back = (volatile uint32_t *) tgt->kernel;
+
+		for (uint32_t i = 0; i < 256; i++) {
+			if (back[i] == 0x0209a5a5u) {
+				first++;
+			}
+			if (back[1024 + i] == 0x0209b6b6u) {
+				second++;
+			}
+		}
+		for (uint32_t i = 256; i < 1024; i++) {
+			if (back[i] == 0) {
+				untouched++;
+			}
+		}
+		for (uint32_t i = 1280; i < 2048; i++) {
+			if (back[i] == 0) {
+				untouched++;
+			}
+		}
+	}
+
+	{
+		struct drm_msm_gem_submit_bo nbos[2];
+		struct drm_msm_gem_submit_cmd ncmds[2];
+		struct drm_msm_gem_submit nsubmit;
+
+		memcpy(nbos, bos, sizeof(nbos));
+		memcpy(ncmds, cmds, sizeof(ncmds));
+		bzero(&nsubmit, sizeof(nsubmit));
+		nsubmit.nr_bos = 2;
+		nsubmit.nr_cmds = 2;
+
+		nbos[0].handle = 0xdedeu;
+		if (c->submitCore(&nsubmit, nbos, ncmds) == kIOReturnBadArgument) {
+			refusals++;
+		}
+
+		nbos[0].handle = ib_handle;
+		ncmds[1].submit_offset = 16384;
+		if (c->submitCore(&nsubmit, nbos, ncmds) == kIOReturnBadArgument) {
+			refusals++;
+		}
+
+		ncmds[1].submit_offset = 4096;
+		ncmds[1].size = 1035;
+		if (c->submitCore(&nsubmit, nbos, ncmds) == kIOReturnBadArgument) {
+			refusals++;
+		}
+
+		ncmds[1].size = 259 * 4;
+		nsubmit.nr_cmds = 0;
+		if (c->submitCore(&nsubmit, nbos, ncmds) == kIOReturnBadArgument) {
+			refusals++;
+		}
+	}
+
+	ok = (first == 256 && second == 256 && untouched == 1536 && refusals == 4);
+	printf("POLARIS GPU: 19 call: fence %u; %u of 256 words at byte 0, %u of 256 at "
+	    "byte 4096, %u of 1536 left alone; %u of 4 bad requests refused\n", submit.fence,
+	    first, second, untouched, refusals);
+	printf("POLARIS GPU: 19 call: %s\n", ok ?
+	    "A PROGRAM'S SUBMISSION RUNS: HANDLES, AN OFFSET, TWO BUFFERS, ONE FENCE" :
+	    "the submit path is not the one a program will use");
+
+out:
+	IOLockLock(gGPULock);
+	if (c != NULL && ib_handle != 0) {
+		struct gpu_buffer * b = c->buffer(ib_handle);
+
+		if (b != NULL) {
+			c->freeBuffer(b);
+		}
+	}
+	if (c != NULL && tgt_handle != 0) {
+		struct gpu_buffer * b = c->buffer(tgt_handle);
+
+		if (b != NULL) {
+			c->freeBuffer(b);
+		}
+	}
+	IOLockUnlock(gGPULock);
+	if (handler != NULL) {
+		handler->release();
+	}
+}
+
+/*
+ * 0197's answer without a user space: make a buffer the way gemNew() makes one,
+ * look at what its descriptor says its pages are, have the CP write the whole
+ * of it, and read it back through the uncached window. All four are needed for
+ * a pass - the pool had room, the pages entered the window, the descriptor is
+ * over those pages, and the GPU wrote them - because each of them has failed
+ * on its own in an earlier build.
+ */
+void
+PolarisGPUUserClient::poolSelfTest(void)
+{
+	struct gpu_buffer b;
+	uint64_t size = 64u << 10;
+	uint64_t pa;
+	uint32_t pages = 0, matching = 0, changed = 0, wrong = 0;
+	IOByteCount length = 0;
+	bool filled;
+
+	bzero(&b, sizeof(b));
+	pa = polaris_gpu_pool_alloc(size);
+	if (pa == 0) {
+		printf("POLARIS GPU: 19 gemnew: the pool has nothing for %llu bytes\n", size);
+		return;
+	}
+	printf("POLARIS GPU: 19 gemnew: %llu bytes from the pool at %#llx..%#llx -- 0199: "
+	    "the view is zeroed a word at a time\n", size, pa, pa + size - 1);
+	if (!fillPoolBuffer(&b, pa, size, 0)) {
+		polaris_gpu_pool_free(pa, size);
+		return;
+	}
+	for (uint64_t off = 0; off < size; off += 4096) {
+		addr64_t phys = b.memory->getPhysicalSegment(off, &length, kIOMemoryMapperNone);
+
+		pages++;
+		if (phys == pa + off) {
+			matching++;
+		}
+	}
+	printf("POLARIS GPU: 19 gemnew: the handle's buffer sits at %#llx, the program's "
+	    "address is %#llx, %u of %u descriptor segments are the pool's pages\n",
+	    pa, b.address, matching, pages);
+	for (uint64_t w = 0; w < size / 4; w++) {
+		((volatile uint32_t *) b.kernel)[w] = 0xdeadbeefu;
+	}
+	filled = polaris_gpu_fill_batched(b.address, (uint32_t)(size / 4));
+	polaris_gpu_window_report(b.address);
+	for (uint64_t w = 0; w < size / 4; w++) {
+		uint32_t v = ((volatile uint32_t *) b.kernel)[w];
+
+		if (v != 0xdeadbeefu) {
+			changed++;
+			if (v != 0xa5a5a5a5u) {
+				wrong++;
+			}
+		}
+	}
+	printf("POLARIS GPU: 19 gemnew: the CP %s; %u of %llu words changed, %u of those "
+	    "are not 0xa5a5a5a5\n", filled ? "drained" : "did NOT drain", changed,
+	    size / 4, wrong);
+	printf("POLARIS GPU: 19 gemnew: %s\n",
+	    (filled && pages == size / 4096 && matching == pages &&
+	    changed == size / 4 && wrong == 0) ?
+	    "THE POOL BUFFER A CLIENT IS GIVEN IS ONE THE GPU WRITES" :
+	    "the client's pool buffer is not written by the GPU");
+	releaseBuffer(&b);
+}
+
+/* The program's mapping of a buffer: IOConnectMapMemory(type = handle) lands here. */
+IOReturn
+PolarisGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits * options,
+    IOMemoryDescriptor ** memory)
+{
+	struct gpu_buffer * b;
+	IOReturn ret = kIOReturnBadArgument;
+
+	IOLockLock(gGPULock);
+	b = buffer(type);
+	if (b != NULL) {
+		b->memory->retain();
+		*memory = b->memory;
+		*options = 0;
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gGPULock);
+	return ret;
+}
+
+IOReturn
+PolarisGPUUserClient::clientClose(void)
+{
+	if (fBuffers != NULL) {
+		IOLockLock(gGPULock);
+		for (uint32_t i = 0; i < GPU_BUFFERS; i++) {
+			if (fBuffers[i].memory != NULL) {
+				freeBuffer(&fBuffers[i]);
+			}
+		}
+		IOLockUnlock(gGPULock);
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+PolarisGPUUserClient::free(void)
+{
+	if (fBuffers != NULL) {
+		IODelete(fBuffers, struct gpu_buffer, GPU_BUFFERS);
+		fBuffers = NULL;
+	}
+	IOUserClient::free();
+}
+
+/*
+ * IOUserClient declares exportObjectToClient in IOUserClient.h and defines it
+ * in iokit/Kernel/IOUserClient.cpp, but the two do not agree on io_object_t.
+ * In the header this file sees, io_object_t is a port type; in the kernel's own
+ * translation unit it is OSObject *. The two spellings mangle differently, so
+ * the kernel carries
+ *
+ *   __ZN12IOUserClient20exportObjectToClientEP4taskP8OSObjectPS3_
+ *
+ * (PS3_ is a substitution for OSObject, so the third parameter there is
+ * OSObject *), while the vtable slot that any C++ subclass inherits asks for
+ * the same three parameters with a port pointer in the third place. Nothing in
+ * the kernel defines that one. No class in this tree derived from
+ * IOUserClient before this file, so nobody hit it - build 0184 was the first
+ * vtable to be emitted, and it failed to link:
+ *
+ *   "IOUserClient::exportObjectToClient(task*, OSObject*, ipc_port**)",
+ *   referenced from vtable for PolarisGPUUserClient
+ *
+ * An override cannot fix that, and the compiler said so on the next attempt:
+ * a parameter of type ipc_port_t ** does not override one of type
+ * io_object_t *. So the slot is filled by defining the declaration itself,
+ * spelled exactly as IOUserClient.h spells it. Whatever io_object_t turns out
+ * to be in this translation unit, this definition mangles the way the vtable
+ * that inherits it asks - the compiler derives both from the same line.
+ *
+ * What it does: this service hands no objects to its client. It maps memory
+ * and answers selectors, so the answer is kIOReturnUnsupported and no port.
+ */
+IOReturn
+IOUserClient::exportObjectToClient(task_t task, OSObject * obj, io_object_t * clientObj)
+{
+	(void)task;
+	if (clientObj != NULL) {
+		*clientObj = (io_object_t)(uintptr_t)0;
+	}
+	/*
+	 * LIBKERN_CONSUMED: the reference comes in either way, so it goes out
+	 * either way. Returning kIOReturnUnsupported without releasing would
+	 * leak one object per call, and a program that guessed at this selector
+	 * could do it in a loop.
+	 */
+	if (obj != NULL) {
+		obj->release();
+	}
+	return kIOReturnUnsupported;
+}
+
+IOReturn
+PolarisGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	union {
+		struct msm_param param;
+		struct msm_gem_new gemNew;
+		struct msm_gem_info gemInfo;
+		struct msm_gem_cpu_prep cpuPrep;
+		struct msm_gem_madvise madvise;
+		struct msm_submitqueue queue;
+		struct msm_submitqueue_query query;
+		struct drm_gem_close close;
+		struct drm_msm_gem_submit submit;
+		struct drm_msm_wait_fence wait;
+	} r;
+	size_t size = args->structureInputSize;
+	IOReturn ret = kIOReturnSuccess;
+
+	(void)dispatch;
+	(void)target;
+	(void)reference;
+
+	if (size > sizeof(r) || fBuffers == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (!polaris_gpu_ready()) {
+		return kIOReturnNotReady;
+	}
+	bzero(&r, sizeof(r));
+	if (size != 0) {
+		if (args->structureInput == NULL) {
+			return kIOReturnBadArgument;
+		}
+		memcpy(&r, args->structureInput, size);
+	}
+
+	switch (selector) {
+	case kMsmGetParam:
+		/*
+		 * Mesa asks what the hardware is before it will touch it, and the
+		 * answers are the one place where a plausible guess is worse than
+		 * nothing: a wrong GPU_ID makes it program the wrong register set.
+		 * 0203 answers the ones this port has measured (gpuParam), and keeps
+		 * recording the rest - each one that shows up here is an answer the
+		 * next build owes, and the log is where the list lives.
+		 */
+		if (gpuParam(r.param.param, &r.param.value)) {
+			break;
+		}
+		{
+			if (gParamCount < 16) {
+				bool seen = false;
+
+				for (uint32_t i = 0; i < gParamCount; i++) {
+					seen = seen || gParamAsked[i] == r.param.param;
+				}
+				if (!seen) {
+					gParamAsked[gParamCount++] = r.param.param;
+					printf("POLARIS GPU: 19 MSM_PARAM %#x is asked for and not "
+					    "answered\n", r.param.param);
+				}
+			}
+			ret = kIOReturnUnsupported;
+		}
+		break;
+	case kMsmSetParam:                              /* the program's name, for Linux's lists */
+	case kMsmGemCpuFini:
+	case kMsmSubmitQueueClose:
+		break;
+	case kMsmGemNew:
+		ret = gemNew(&r.gemNew);
+		break;
+	case kMsmGemInfo:
+		ret = gemInfo(&r.gemInfo);
+		break;
+	case kMsmGemCpuPrep:
+		/*
+		 * 0203: this used to be a no-op because nothing was ever submitted.
+		 * Now a submission may still be in the CP's hands, and the honest
+		 * answer to "may I touch this buffer" is to wait for the last fence -
+		 * unless the program says it does not want to wait.
+		 */
+		if ((r.cpuPrep.op & MSM_PREP_NOSYNC) == 0 && gLastFence != 0) {
+			uint64_t limit = 0;
+
+			if (r.cpuPrep.timeout.seconds > 0 || r.cpuPrep.timeout.nanoseconds > 0) {
+				limit = (uint64_t)r.cpuPrep.timeout.seconds * 1000000000ull +
+				    (uint64_t)r.cpuPrep.timeout.nanoseconds;
+			}
+			ret = waitFor(gLastFence, limit);
+		}
+		break;
+	case kMsmGemMadvise:                            /* freedreno asks about every buffer it reuses */
+		r.madvise.retained = 1;
+		break;
+	case kMsmSubmitQueueNew:
+		r.queue.id = ++fNextQueue;
+		break;
+	case kMsmSubmitQueueQuery:
+		if (r.query.data != 0 && r.query.len >= sizeof(uint64_t)) {
+			uint64_t zero = 0;
+
+			copyout(&zero, (user_addr_t) r.query.data, sizeof(zero));
+		}
+		break;
+	case kMsmGemSubmit:
+		ret = gemSubmit(&r.submit);
+		break;
+	case kMsmWaitFence:
+		ret = waitFence(&r.wait);
+		break;
+	case kDrmGemClose:
+		ret = gemClose(&r.close);
+		break;
+	default:
+		printf("POLARIS GPU: 19 selector %#x is not one of ours\n", selector);
+		ret = kIOReturnUnsupported;
+		break;
+	}
+
+	if (ret == kIOReturnSuccess && args->structureOutput != NULL) {
+		size_t out = args->structureOutputSize < size ? args->structureOutputSize : size;
+
+		memcpy(args->structureOutput, &r, out);
+	}
+	return ret;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+/*
+ * One round of what a client would do, in the kernel, because there is no user
+ * space to do it from yet. The question it answers is not "did the kernel keep
+ * its books" - it is "can the GPU write a page this kernel owns through the
+ * window the allocator gave out", and only the count of changed words says that.
+ */
+#define POLARIS_GPU_TEST_BYTES  (64u << 10)
+
+static void
+polaris_gpu_test(void)
+{
+	IOBufferMemoryDescriptor * memory;
+	IOMemoryMap * map;
+	volatile uint32_t * words;
+	uint64_t address, size;
+	IOByteCount length = 0;
+	uint32_t before = 0xdeadbeefu, changed = 0, wrong = 0;
+	bool filled;
+
+	/*
+	 * Below 4 GB on purpose.
+	 *
+	 * Every run of this test that has failed had its buffer above 4 GB -
+	 * 0x103abc000 in 0187, 0x103ab4000 in 0189 - while the panel, which the
+	 * CP demonstrably does write, sits at 0x9d400000. The descriptors for
+	 * the two are the same in form (valid page, attribute index 0, AF set),
+	 * the fault record is empty, the ring drains, and the packets are
+	 * 64-bit addressed, so the difference worth removing is simply where
+	 * the memory is. A physical mask asks the allocator for pages under
+	 * 4 GB; if the fill lands there, the ceiling was an address one.
+	 */
+	memory = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+	    kIODirectionInOut, POLARIS_GPU_TEST_BYTES, 0x00000000fffff000ull);
+	if (memory == NULL) {
+		printf("POLARIS GPU: 19 test: nothing under 4 GB; using ordinary memory\n");
+		memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIODirectionInOut, POLARIS_GPU_TEST_BYTES, PAGE_SIZE);
+	}
+	if (memory == NULL) {
+		printf("POLARIS GPU: 19 test: no memory\n");
+		return;
+	}
+	size = round_page((vm_size_t) memory->getLength());
+	/*
+	 * The CPU touches the buffer through a cache-inhibited alias, not through
+	 * getBytesNoCopy(). The first build of this test used the descriptor's own
+	 * kernel mapping, which is cacheable, and the read-back said "0 of 16384
+	 * words changed": the CPU had written 0xdeadbeef into L1/L2, the CP wrote
+	 * 0xa5a5a5a5 into DRAM behind it, and the read saw the CPU's own dirty
+	 * lines. A write by a bus master does not invalidate a CPU line, and those
+	 * dirty lines would also be written back over the GPU's data later.
+	 *
+	 * Reading through a mapping that is not cached at all removes the question:
+	 * every word comes from DRAM, which is the only copy the GPU ever touched.
+	 * If the GPU's write did not land, this reads 0xdeadbeef and says so; if it
+	 * landed, this reads 0xa5a5a5a5. The two outcomes are now distinguishable,
+	 * which they were not before.
+	 */
+	map = memory->createMappingInTask(kernel_task, 0,
+	    kIOMapInhibitCache | kIOMapAnywhere, 0, size);
+	if (map == NULL || map->getVirtualAddress() == 0) {
+		printf("POLARIS GPU: 19 test: no uncached view of the buffer\n");
+		OSSafeReleaseNULL(map);
+		memory->release();
+		return;
+	}
+	words = (volatile uint32_t *) map->getVirtualAddress();
+	for (uint64_t i = 0; i < size / 4; i++) {
+		words[i] = before;
+	}
+
+	IOLockLock(gGPULock);
+	address = polaris_gpu_address(size);
+	IOLockUnlock(gGPULock);
+	if (address == 0) {
+		printf("POLARIS GPU: 19 test: no address\n");
+		map->release();
+		memory->release();
+		return;
+	}
+	printf("POLARIS GPU: 19 test: %llu bytes at iova %#llx, physical %#llx\n",
+	    size, address, memory->getPhysicalSegment(0, &length, kIOMemoryMapperNone));
+	{
+		IOByteCount tail = 0;
+		addr64_t last = memory->getPhysicalSegment(size - PAGE_SIZE, &tail,
+		    kIOMemoryMapperNone);
+
+		printf("POLARIS GPU: 19 test: the buffer ends at physical %#llx, %s 4 GB\n",
+		    last + PAGE_SIZE - 1,
+		    (last + PAGE_SIZE - 1) < 0x100000000ull ? "under" : "over");
+	}
+	{
+		bool mapped = true;
+
+		for (uint64_t offset = 0; offset < size && mapped; offset += 4096) {
+			IOByteCount length = 0;
+			addr64_t phys = memory->getPhysicalSegment(offset, &length, kIOMemoryMapperNone);
+
+			mapped = phys != 0 && polaris_gpu_map(address + offset, phys, false);
+		}
+		polaris_gpu_mapped();
+		if (!mapped) {
+			printf("POLARIS GPU: 19 test: the buffer cannot be entered\n");
+			IOLockLock(gGPULock);
+			polaris_gpu_address_free(address, size);
+			IOLockUnlock(gGPULock);
+			map->release();
+			memory->release();
+			return;
+		}
+	}
+	/*
+	 * The window was just edited, so make the SMMU forget what it may have
+	 * cached for these addresses and clear the fault record, then say what the
+	 * four links in the chain actually hold before anything is asked of the
+	 * CP. If the fill comes back empty, the difference between these two
+	 * reports is the whole diagnosis.
+	 */
+	polaris_gpu_window_sync();
+	polaris_gpu_window_report(address);
+	/*
+	 * One packet per write-pointer update, which is what step 18 has always
+	 * done and what this test never did.
+	 *
+	 * 0193 ran the old single burst first and wedged the command processor:
+	 * sixteen chunks of 1027 dwords is 16432 dwords, more than the 16384-dword
+	 * ring, so the write pointer ended up 48 dwords past where it started and
+	 * the CP - which had already read the first packet's header promising 1027
+	 * dwords - consumed those 48 and then waited for a payload that was never
+	 * going to arrive. RPTR stopped at 5383 and every fill after it in that
+	 * boot read RPTR 5456 forever. The arithmetic is exact: 16432 mod 16384 is
+	 * 48, and 5287 + 48 is 5335, which is the value the ring printed.
+	 *
+	 * So the burst goes away rather than being compared against. It cannot be
+	 * run before anything else without poisoning the ring for the rest of the
+	 * boot, and it has never once written a word.
+	 */
+	filled = polaris_gpu_fill_batched(address, (uint32_t)(size / 4));
+	polaris_gpu_window_report(address);
+	/*
+	 * Where the changes are, not only how many. 0194 reported 1008 of 16384
+	 * and the count alone cannot say whether that is the first page and a
+	 * half, or sixteen pages with a few words each, and those are different
+	 * faults.
+	 */
+	{
+		uint64_t first = 0, last = 0;
+		bool seen = false;
+
+		for (uint64_t i = 0; i < size / 4; i++) {
+			if (words[i] != before) {
+				changed++;
+				if (!seen) {
+					first = i;
+					seen = true;
+				}
+				last = i;
+				if (words[i] != 0xa5a5a5a5u) {
+					wrong++;
+				}
+			}
+		}
+		if (seen) {
+			printf("POLARIS GPU: 19 test: the changes run from word %llu to %llu\n",
+			    first, last);
+		}
+	}
+	printf("POLARIS GPU: 19 test: one packet per write pointer, the CP %s; %u of %llu "
+	    "words changed, %u of those are not 0xa5a5a5a5\n",
+	    filled ? "drained" : "did NOT drain", changed, size / 4, wrong);
+	printf("POLARIS GPU: 19 test: %s\n",
+	    (filled && changed == size / 4 && wrong == 0) ?
+	    "THE BURST WAS THE WHOLE OF IT" : "the buffer is not what the GPU was told to write");
+
+	/*
+	 * 0192: the count above has said the same thing for five builds, so
+	 * repeating it again would not add anything. What has not been separated
+	 * is which of the two differences between this buffer and the panel is
+	 * the one that matters - where the memory is, or which window it is in -
+	 * and that is one experiment each, run from a known-good starting point.
+	 *
+	 * The step is 4 KB and not PAGE_SIZE: the window is built out of 4 KB
+	 * descriptors while the kernel's pages are 16 KB, so a 64 KB buffer is
+	 * sixteen of the former and four of the latter. Stepping by PAGE_SIZE
+	 * hands the check four pages and 64 KB of length, which it refuses - the
+	 * first build of this test did exactly that and said so.
+	 *
+	 * getPhysicalSegment() returns the byte address inside the run, not the
+	 * base of the page holding it, which is why the addresses below are used
+	 * as they come back. The check's own result proves it: if the window's
+	 * pages aliased each other, the fill would have written 0xa5a5a5a5 into
+	 * the first 4 KB of each physical page and the count would have read 4096
+	 * changed words instead of none.
+	 */
+	{
+		uint64_t pas[16];
+		uint32_t n = 0;
+		bool whole = true;
+
+		for (uint64_t offset = 0; offset < size && n < 16;
+		    offset += 4096, n++) {
+			IOByteCount length = 0;
+			addr64_t phys = memory->getPhysicalSegment(offset, &length,
+			    kIOMemoryMapperNone);
+
+			if (phys == 0 || (phys & 0xfffull) != 0) {
+				whole = false;
+				break;
+			}
+			pas[n] = phys;
+		}
+		if (whole && (uint64_t)n == size / 4096) {
+			polaris_gpu_pa_test(pas, n, size, words);
+		} else {
+			printf("POLARIS GPU: 19 pa test: %u of %llu pages have no address\n",
+			    n, size / 4096);
+		}
+	}
+
+	/*
+	 * 0196: and now an address below 4 GB that a client could be given.
+	 *
+	 * 0194 put the two variables apart on a ring that was not wedged: the
+	 * panel's pages fill completely through the program's window, the
+	 * client's pages hardly at all through either window. 0195 asked the
+	 * allocator for low memory with the one flag that was supposed to make
+	 * that work, and it answered "nothing below 4 GB" on the first page -
+	 * which is also why the GMU's own pages come out of a reserved region.
+	 * So this takes the sixteen pages from the ramdump framebuffer instead,
+	 * which is reserved, dead, and below 4 GB, and runs the same packet at
+	 * them. If they fill, a client buffer pool can be carved from there and
+	 * the GPU has somewhere to write.
+	 */
+	polaris_gpu_pool_test();
+
+	/*
+	 * 0197: and now the same pages the way a program will get them - through
+	 * the pool allocator, a handle, and a descriptor that IOConnectMapMemory
+	 * would hand to the program. The pool test above says the GPU writes that
+	 * region; this says a buffer taken out of it is a buffer a client can be
+	 * given.
+	 */
+	PolarisGPUUserClient::poolSelfTest();
+
+	/*
+	 * 0200: and now the thing a program actually asks for - a command buffer of
+	 * its own, run by address, with a fence the CP writes when it is done. This
+	 * is the kernel half of DRM's GEM_SUBMIT, proven without a user space.
+	 */
+	polaris_gpu_submit_test();
+	PolarisGPUUserClient::paramSelfTest();
+	/*
+	 * 0209: and now the same submission as a program sends it - by handle, with
+	 * an offset, two command buffers and one fence - through submitCore().
+	 */
+	PolarisGPUUserClient::submitSelfTest();
+	polaris_vfs_probe();
+
+	polaris_gpu_unmap(address, size);
+	polaris_gpu_mapped();
+	IOLockLock(gGPULock);
+	polaris_gpu_address_free(address, size);
+	IOLockUnlock(gGPULock);
+	map->release();
+	memory->release();
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+extern "C" void
+polaris_gpu_service_start(void)
+{
+	IOService * provider;
+	PolarisGPU * gpu;
+	int test = 0;
+
+	if (gGPULock == NULL) {
+		gGPULock = IOLockAlloc();
+	}
+	if (gGPULock == NULL) {
+		printf("POLARIS GPU: 19 no lock; no service\n");
+		return;
+	}
+	provider = IOService::getPlatform();
+	gpu = OSTypeAlloc(PolarisGPU);
+	if (gpu == NULL || provider == NULL || !gpu->init() || !gpu->attach(provider)) {
+		OSSafeReleaseNULL(gpu);
+		printf("POLARIS GPU: 19 cannot create the service\n");
+		return;
+	}
+	if (!gpu->start(provider)) {
+		gpu->detach(provider);
+		printf("POLARIS GPU: 19 the service did not start\n");
+	} else {
+		/*
+		 * 0209: kept for the boot-time test, which opens a client on it the way a
+		 * program does. Retained once for that pointer and never given back.
+		 */
+		gPolarisGPUService = gpu;
+		gpu->retain();
+	}
+	gpu->release();
+
+	if (PE_parse_boot_argn("polarisgputest", &test, sizeof(test)) && test != 0) {
+		polaris_gpu_test();
+	}
+}
