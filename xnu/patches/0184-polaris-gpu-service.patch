+/*
+ * Clear the context bank's fault record and make it walk the tables again.
+ *
+ * Both are no-ops when nothing is wrong, and both are what a mapping change
+ * owes the SMMU: FSR is one-to-clear and keeps the first fault until someone
+ * clears it, and a translation the SMMU has already cached is not affected by
+ * editing the descriptor underneath it.
+ */
+void
+polaris_gpu_window_sync(void)
+{
+	vm_offset_t cb = pg_smmu_cb(PG_GMU_CTX);
+
+	pg_wr(cb + PG_CB_FSR, 0xffffffffu);
+	pg_wr(cb + PG_CB_TLBIASID, PG_GMU_CTX);
+	pg_wr(cb + PG_CB_TLBSYNC, 1);
+	for (int i = 0; i < 100 && (pg_rd(cb + PG_CB_TLBSTATUS) & 1); i++) {
+		pg_sleep_us(10);
+	}
+}
