+/* 0344: what we actually wrote to the tx FIFO, not what we meant to write.
+ * Three characters per byte, at most 16 words per line, two MD_SAY lines
+ * so neither can be silently truncated at the 255-character cap. */
+static void
+md_tftp_hex_words(const uint32_t *w, uint32_t n, uint32_t base)
+{
+	static const char dig[] = "0123456789abcdef";
+	char hex[3u * 48u + 1u];
+	uint32_t i, k = 0u;
+
+	for (i = 0u; i < n && k + 12u < sizeof(hex); i++) {
+		uint32_t v = w[i], j;
+
+		for (j = 0u; j < 4u; j++) {
+			uint8_t c = (uint8_t)(v >> (8u * j));
+
+			hex[k++] = dig[c >> 4];
+			hex[k++] = dig[c & 15u];
+			hex[k++] = ' ';
+		}
+	}
+	hex[k] = 0;
+	MD_SAY("POLARIS MODEM: 0344 VERDICT: TFTP TX words @%u: %s\n",
+	    base, hex);
+}
