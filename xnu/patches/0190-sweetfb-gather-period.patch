+/*
+ * The same row, with the column map unfolded into constants.
+ *
+ * 0189 measured the loop above at 3.91 us per 1080-pixel row on this core -
+ * about six cycles per pixel, for one index load, one source load and one
+ * store. That is not arithmetic, it is the dependency: load map[x], then load
+ * srow[map[x]], two dependent loads with L1 latency apiece, and shapes E and F
+ * above show what happens when that dependency is traded for branches instead.
+ *
+ * There is a third way, and it comes from the stretch being a fraction rather
+ * than a table. 1080/750 reduces to 36/25, so
+ *
+ *     map[36k + j] = (36k + j) * 25 / 36 = 25k + (j * 25) / 36
+ *
+ * exactly, for every k. The map is periodic with period 36 and the block index
+ * only shifts the source base by 25 words. So a block of 36 panel columns needs
+ * 25 sequential source loads at compile-time offsets and 36 stores at
+ * compile-time offsets: no index load, no branch, no data-dependent address.
+ * Thirty blocks cover the row. _t_period.c checks the identity against the map
+ * the framebuffer builds and finds 0 mismatches in 1080 columns.
+ *
+ * Only valid for the whole row - the caller checks px0 == 0, px1 == fWidth and
+ * a source base of 0 - because the blocks assume source columns 0..749 exist.
+ */
+static void
+sweet_fb_gather_period(uint32_t *stage, const uint32_t *srow)
+{
+	int32_t k;
+
+	for (k = 0; k < SWEET_FB_BLKS; k++) {
+		const uint32_t *s = srow + SWEET_FB_SRC_BLK * k;
+		uint32_t *d = stage + SWEET_FB_PANEL_BLK * k;
+#define SWEET_FB_G(j)	d[j] = s[((j) * SWEET_FB_SRC_BLK) / SWEET_FB_PANEL_BLK]
+		SWEET_FB_G(0);  SWEET_FB_G(1);  SWEET_FB_G(2);  SWEET_FB_G(3);
+		SWEET_FB_G(4);  SWEET_FB_G(5);  SWEET_FB_G(6);  SWEET_FB_G(7);
+		SWEET_FB_G(8);  SWEET_FB_G(9);  SWEET_FB_G(10); SWEET_FB_G(11);
+		SWEET_FB_G(12); SWEET_FB_G(13); SWEET_FB_G(14); SWEET_FB_G(15);
+		SWEET_FB_G(16); SWEET_FB_G(17); SWEET_FB_G(18); SWEET_FB_G(19);
+		SWEET_FB_G(20); SWEET_FB_G(21); SWEET_FB_G(22); SWEET_FB_G(23);
+		SWEET_FB_G(24); SWEET_FB_G(25); SWEET_FB_G(26); SWEET_FB_G(27);
+		SWEET_FB_G(28); SWEET_FB_G(29); SWEET_FB_G(30); SWEET_FB_G(31);
+		SWEET_FB_G(32); SWEET_FB_G(33); SWEET_FB_G(34); SWEET_FB_G(35);
+#undef SWEET_FB_G
 	}
 }
 
